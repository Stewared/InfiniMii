    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cross-env": "^10.1.0",
    "double-metaphone": "^2.0.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "ffl.js": "github:ariankordi/FFL.js#f63076162584808715008a39f9cd7b606442cee3",
    "fflate": "^0.8.2",
    "fzstd": "^0.1.1",
    "form-data": "^4.0.4",
    "fs": "^0.0.1-security",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "miijs": "file:vendor/miijs-3.1.0-ltd-workspace.tgz",
    "mongodb-memory-server": "^11.0.1",
    "mongoose": "^9.1.1",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.5",
    "obscenity": "^0.4.5",
    "path": "^0.12.7",
    "prettier": "^2.8.8",
    "qrcode-generator": "^1.5.2",
    "sharp": "^0.34.5",
    "validator": "^13.15.26"
  }
