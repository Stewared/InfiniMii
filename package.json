{
  "name": "nodejs",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "cross-env NODE_ENV=development node index.js",
    "build:native-renderer": "cmake -S native/tomodachi -B native/tomodachi/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/tomodachi/build --config Release --parallel",
    "build:native-ltd-renderer": "node scripts/buildNativeLtdRenderer.js",
    "test:renderer-colors": "node --test tests/nativeTomodachiRenderer.colors.test.js",
    "test:external-mii-dates": "node --test tests/miiDateMetadata.test.js",
    "test:miicharacters-importer": "node --test tests/fillin.test.cjs",
    "migrate:tl-palette-selectors": "node scripts/backfillTomodachiPaletteSelectors.js",
    "backfill:mii-era": "node scripts/backfillMiiEra.js",
    "backfill:mii-facepaint": "node scripts/backfillMiiFacepaintUsage.js",
    "rerender:all-images": "node scripts/rerenderAllMiiImages.js",
    "test:native-renderer": "node --test spec/native-tomodachi-renderer.test.mjs",
    "test:native-c": "ctest --test-dir native/tomodachi/build -C Release --output-on-failure",
    "test": "node --test \"spec/*.test.mjs\" \"tests/*.test.js\" \"tests/*.test.cjs\"",
    "test:all": "npm test && npm run test:native-c"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
