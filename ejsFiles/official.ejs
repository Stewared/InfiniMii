<!DOCTYPE html>
<html lang="en">
    <head>
        <%
            const usesOffsetPagination = pagination?.mode === 'offset';
            const currentPageNumber = usesOffsetPagination ? null : (pagination?.currentPage || 1);
            const pageSuffix = currentPageNumber > 1 ? ` - Page ${currentPageNumber}` : '';
            const selectedOfficialCategoryPaths = (typeof selectedOfficialCategories !== 'undefined' && Array.isArray(selectedOfficialCategories))
                ? selectedOfficialCategories
                : (currentFilter ? [currentFilter] : []);
            const excludedOfficialCategoryPaths = (typeof excludedOfficialCategories !== 'undefined' && Array.isArray(excludedOfficialCategories))
                ? excludedOfficialCategories
                : [];
            const officialSearchQuery = typeof searchQuery === 'string' ? searchQuery.trim() : '';
            const officialCategoryByPath = new Map((Array.isArray(availableCategories) ? availableCategories : []).map(category => [category.path, category]));
            const selectedOfficialCategoryLabels = selectedOfficialCategoryPaths.map(path => (
                officialCategoryByPath.get(path)?.fullPath || officialCategoryByPath.get(path)?.name || path
            ));
            const excludedOfficialCategoryLabels = excludedOfficialCategoryPaths.map(path => (
                officialCategoryByPath.get(path)?.fullPath || officialCategoryByPath.get(path)?.name || path
            ));
            const hasOfficialFilters = Boolean(officialSearchQuery || selectedOfficialCategoryLabels.length > 0 || excludedOfficialCategoryLabels.length > 0);
            const officialFilterSummary = [
                officialSearchQuery ? `"${officialSearchQuery}"` : '',
                ...selectedOfficialCategoryLabels,
                ...excludedOfficialCategoryLabels.map(label => `not ${label}`)
            ].filter(Boolean).join(', ');
            const pageTitle = hasOfficialFilters
                ? `Official Mii Characters Matching ${officialFilterSummary}${pageSuffix} - InfiniMii`
                : `Official Nintendo Mii Characters${pageSuffix} - InfiniMii`;
            const pageDesc = hasOfficialFilters
                ? `Browse official Mii characters matching ${officialFilterSummary} on InfiniMii.`
                : 'Browse official Nintendo Mii characters from games, promotions, and system sources preserved on InfiniMii.';
            const canonicalUrl = `${baseUrl}${currentPath || '/official'}`;
            const keywords = hasOfficialFilters
                ? `official miis, ${officialFilterSummary}, nintendo miis`
                : 'official miis, official nintendo miis, preserved miis';
            const breadcrumbs = [
                { name: 'Home', url: '/' },
                { name: 'Official Miis', url: '/official' }
            ];
            if (selectedOfficialCategoryLabels.length === 1) {
                breadcrumbs.push({ name: selectedOfficialCategoryLabels[0], url: `/official?category=${encodeURIComponent(selectedOfficialCategoryPaths[0])}` });
            }
            const schemaType = 'CollectionPage';
            const listOffset = usesOffsetPagination
                ? (pagination?.start || 0)
                : ((pagination?.currentPage || 1) - 1) * (pagination?.perPage || displayedMiis.length || 0);
            const schemaGraphs = Array.isArray(displayedMiis) && displayedMiis.length > 0
                ? [{
                    "@context": "https://schema.org",
                    "@type": "ItemList",
                    "name": hasOfficialFilters ? `Official Miis Matching ${officialFilterSummary}` : 'Official Mii Characters',
                    "numberOfItems": pagination?.total || displayedMiis.length,
                    "itemListElement": displayedMiis
                        .filter((miiItem) => miiItem && miiItem.id)
                        .map((miiItem, index) => ({
                            "@type": "ListItem",
                            "position": listOffset + index + 1,
                            "url": `${baseUrl}/mii/${miiItem.id}`,
                            "name": miiItem?.meta?.name || miiItem?.name || 'Unknown Mii'
                        }))
                }]
                : [];
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, keywords, prevUrl, nextUrl }) %>
        <%- include('structuredData') %>
        <link rel="stylesheet" href="/global.css?v=<%= encodeURIComponent(assetVersion || '20260513-tri-state-search-filters') %>">
        <link rel="stylesheet" href="/utilityPages.css">
        <link rel="stylesheet" href="/official.css?v=<%= encodeURIComponent(assetVersion || '20260513-home-mobile-cards') %>">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <div class="content">
            <%- include('sidebar') %>
            
            <div class="official-miis-page">
                <div class="official-header">
                    <h1>Official Miis</h1>
                    <p class="subtitle">Miis that appear officially in games and promotions<br>
                        Want to upload Official Miis? You can apply for the Researcher role from our <a target="_blank" href="https://discord.gg/mTFKpBcvae">Discord server</a>.
                    </p>
                </div>

                <%- include('advancedSearchControls', {
                    formAction: '/official',
                    query,
                    controlUiIdPrefix: 'official-search',
                    searchAriaLabel: 'Search official Miis',
                    searchInputPlaceholder: 'Search official Miis...',
                    submitLabel: 'Search',
                    selectedSearchFields,
                    searchFieldsExplicitlyConfigured,
                    availableCategories,
                    selectedCategories: selectedOfficialCategoryPaths,
                    excludedCategories: excludedOfficialCategoryPaths,
                    categoryName: 'category',
                    excludeCategoryName: 'excludeCategory',
                    renderSearchFields: true,
                    renderTagFilters: false,
                    renderCategoryFilters: true,
                    advancedOpen: hasOfficialFilters
                }) %>

                <% if(hasOfficialFilters) { %>
                    <div class="current-filter">
                        Showing: <strong><%= officialFilterSummary %></strong>
                        <a href="/official" class="clear-filter"><%- include('icon', { name: 'x', size: 14 }) %> Clear Search</a>
                    </div>
                <% } %>

                <!-- Miis Grid -->
                <% if(displayedMiis.length > 0) { %>
                    <div
                        id="browse-miis"
                        class="browse-miis-balanced"
                        data-full-row-grid="1"
                        data-full-row-start="<%= pagination?.start || 0 %>"
                        data-full-row-total="<%= pagination?.total ?? displayedMiis.length %>"
                        data-full-row-request-limit="<%= pagination?.requestLimit || displayedMiis.length || 1 %>"
                        data-full-row-base-count="<%= pagination?.baseCount || 16 %>"
                        data-full-row-allow-partial-last="1"
                    >
                        <% for(var i=0; i<displayedMiis.length; i++){ %>
                            <%
                                const officialMii = displayedMiis[i];
                                const shouldEagerLoadImage = i < 6;
                                const shouldPrioritizeImage = i < 3;
                            %>
                            <%- include('miiCard', {
                                mii: officialMii,
                                user,
                                cardDomId: officialMii.id,
                                imageEagerLoad: shouldEagerLoadImage,
                                imagePriorityLoad: shouldPrioritizeImage,
                                descriptionMaxLength: 75,
                                metadataType: 'tags',
                                metadataItemLimit: 3
                            }) %>
                        <% } %>
                    </div>
                    
                    <!-- Pagination Controls -->
                    <% if (pagination && pagination.mode === 'offset') { %>
                        <div class="pagination" data-full-row-controls-for="browse-miis">
                            <a
                                <% if (pagination.prevUrl) { %>href="<%= pagination.prevUrl %>"<% } %>
                                class="pagination-btn"
                                data-pagination-prev
                                <%= pagination.prevUrl ? '' : 'aria-disabled="true" tabindex="-1"' %>
                            >&larr; Previous</a>
                            
                            <span
                                class="pagination-info"
                                data-pagination-mode="offset"
                                data-current-page="<%= pagination.currentPage %>"
                                data-total-pages="<%= pagination.totalPages %>"
                                data-page-size="<%= pagination.requestLimit %>"
                                data-start="<%= pagination.start %>"
                                data-total-items="<%= pagination.total %>"
                            >
                                Page
                                <button type="button" class="pagination-current-page" aria-label="Jump to page">
                                    <%= pagination.currentPage %>
                                </button>
                                <input
                                    type="number"
                                    class="pagination-page-input"
                                    min="1"
                                    max="<%= pagination.totalPages %>"
                                    value="<%= pagination.currentPage %>"
                                    inputmode="numeric"
                                    aria-label="Type page number"
                                >
                                of <span data-pagination-total-pages><%= pagination.totalPages %></span>
                                (<span data-pagination-total><%= pagination.total %></span> Miis)
                            </span>
                            
                            <a
                                <% if (pagination.nextUrl) { %>href="<%= pagination.nextUrl %>"<% } %>
                                class="pagination-btn"
                                data-pagination-next
                                <%= pagination.nextUrl ? '' : 'aria-disabled="true" tabindex="-1"' %>
                            >Next &rarr;</a>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="no-results">
                        <h3>No official Miis found<% if(hasOfficialFilters) { %> for <%= officialFilterSummary %><% } %></h3>
                        <% if(hasOfficialFilters) { %>
                            <a href="/official" class="btn-primary">View All Official Miis</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
            
            <%- include('featuredMiis') %>
        </div>
        <%- include('footer') %>
    </body>
</html>
