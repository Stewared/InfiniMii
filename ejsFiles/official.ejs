<!DOCTYPE html>
<html lang="en">
    <head>
        <%
            const currentPageNumber = pagination?.currentPage || 1;
            const pageSuffix = currentPageNumber > 1 ? ` - Page ${currentPageNumber}` : '';
            const pageTitle = currentFilter
                ? `Official Mii Characters in ${currentFilter}${pageSuffix} - InfiniMii`
                : `Official Nintendo Mii Characters${pageSuffix} - InfiniMii`;
            const pageDesc = currentFilter
                ? `Browse official Mii characters filed under ${currentFilter} on InfiniMii.`
                : 'Browse official Nintendo Mii characters from games, promotions, and system sources preserved on InfiniMii.';
            const canonicalQuery = currentFilter
                ? `${currentPageNumber > 1 ? `?category=${encodeURIComponent(currentFilter)}&page=${currentPageNumber}` : `?category=${encodeURIComponent(currentFilter)}`}`
                : (currentPageNumber > 1 ? `?page=${currentPageNumber}` : '');
            const canonicalUrl = `${baseUrl}/official${canonicalQuery}`;
            const keywords = currentFilter
                ? `official miis, ${currentFilter}, nintendo miis`
                : 'official miis, official nintendo miis, preserved miis';
            const breadcrumbs = [
                { name: 'Home', url: '/' },
                { name: 'Official Miis', url: '/official' }
            ];
            if (currentFilter) {
                breadcrumbs.push({ name: currentFilter, url: `/official?category=${encodeURIComponent(currentFilter)}` });
            }
            const schemaType = 'CollectionPage';
            const listOffset = ((pagination?.currentPage || 1) - 1) * (pagination?.perPage || displayedMiis.length || 0);
            const schemaGraphs = Array.isArray(displayedMiis) && displayedMiis.length > 0
                ? [{
                    "@context": "https://schema.org",
                    "@type": "ItemList",
                    "name": currentFilter ? `Official Miis in ${currentFilter}` : 'Official Mii Characters',
                    "numberOfItems": pagination?.total || displayedMiis.length,
                    "itemListElement": displayedMiis
                        .filter((miiItem) => miiItem && miiItem.id)
                        .map((miiItem, index) => ({
                            "@type": "ListItem",
                            "position": listOffset + index + 1,
                            "url": `${baseUrl}/mii/${miiItem.id}`,
                            "name": miiItem?.meta?.name || miiItem?.name || 'Unknown Mii'
                        }))
                }]
                : [];
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, keywords, prevUrl, nextUrl }) %>
        <%- include('structuredData') %>
        <link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="/utilityPages.css">
        <link rel="stylesheet" href="/official.css?v=20260411-mobile-fix">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <div class="content">
            <%- include('sidebar') %>
            
            <div class="official-miis-page">
                <div class="official-header">
                    <h1><%- include('icon', { name: 'sparkles', size: 28, class: 'icon-inline icon-gold' }) %> Official Miis</h1>
                    <p class="subtitle">Miis that appear officially in games and promotions</p>
                </div>

                <!-- Category Filter -->
                <div class="category-filter">
                    <details class="category-dropdown" <%= currentFilter ? 'open' : '' %>>
                        <summary>
                            <span class="summary-label">Filter by Category</span>
                            <span class="summary-current"><%= currentFilter || 'All Categories' %></span>
                        </summary>
                        <div class="filter-buttons">
                            <a href="/official" class="filter-btn <%= !currentFilter ? 'active' : '' %>">
                                All (<%= displayedMiis.length %>)
                                <span class="category-path">Everything</span>
                            </a>
                            <% availableCategories.forEach(category => { %>
                                <a href="/official?category=<%= encodeURIComponent(category.path) %>" 
                                class="filter-btn <%= currentFilter === category.path ? 'active' : '' %>"
                                style="--category-color: <%= category.color || '#999999' %>;">
                                    <%= category.name %>
                                    <% if(category.fullPath) { %>
                                        <span class="category-path"><%= category.fullPath %></span>
                                    <% } %>
                                </a>
                            <% }); %>
                        </div>
                    </details>
                </div>

                <% if(currentFilter) { %>
                    <div class="current-filter">
                        Showing: <strong><%= currentFilter %></strong>
                        <a href="/official" class="clear-filter"><%- include('icon', { name: 'x', size: 14 }) %> Clear Filter</a>
                    </div>
                <% } %>

                <!-- Miis Grid -->
                <% if(displayedMiis.length > 0) { %>
                    <div id="browse-miis" class="browse-miis-balanced">
                        <% for(var i=0; i<displayedMiis.length; i++){ %>
                            <%
                                const officialMii = displayedMiis[i];
                                const shouldEagerLoadImage = i < 6;
                                const shouldPrioritizeImage = i < 3;
                            %>
                            <%- include('miiCard', {
                                mii: officialMii,
                                user,
                                cardDomId: officialMii.id,
                                imageEagerLoad: shouldEagerLoadImage,
                                imagePriorityLoad: shouldPrioritizeImage,
                                descriptionMaxLength: 75,
                                includeLikeButton: true,
                                likeButtonClass: 'official-card-like-button',
                                likeIconSize: 18,
                                metadataType: 'categories',
                                metadataItems: officialMii.officialCategories,
                                metadataItemLimit: 3,
                                badgeEnabled: true,
                                badgeText: 'Official'
                            }) %>
                        <% } %>
                    </div>
                    
                    <!-- Pagination Controls -->
                    <% if (pagination && pagination.totalPages > 1) { %>
                        <div class="pagination">
                            <% if (pagination.currentPage > 1) { %>
                                <a href="?page=<%= pagination.currentPage - 1 %><%= currentFilter ? '&category=' + encodeURIComponent(currentFilter) : '' %>" class="pagination-btn">&larr; Previous</a>
                            <% } %>
                            
                            <span class="pagination-info" data-current-page="<%= pagination.currentPage %>" data-total-pages="<%= pagination.totalPages %>">
                                Page
                                <button type="button" class="pagination-current-page" aria-label="Jump to page">
                                    <%= pagination.currentPage %>
                                </button>
                                <input
                                    type="number"
                                    class="pagination-page-input"
                                    min="1"
                                    max="<%= pagination.totalPages %>"
                                    value="<%= pagination.currentPage %>"
                                    inputmode="numeric"
                                    aria-label="Type page number"
                                >
                                of <%= pagination.totalPages %>
                                (<%= pagination.total %> Miis)
                            </span>
                            
                            <% if (pagination.currentPage < pagination.totalPages) { %>
                                <a href="?page=<%= pagination.currentPage + 1 %><%= currentFilter ? '&category=' + encodeURIComponent(currentFilter) : '' %>" class="pagination-btn">Next &rarr;</a>
                            <% } %>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="no-results">
                        <h3>No official Miis found<% if(currentFilter) { %> in <%= currentFilter %><% } %></h3>
                        <% if(currentFilter) { %>
                            <a href="/official" class="btn-primary">View All Official Miis</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
            
            <%- include('featuredMiis') %>
        </div>
        <%- include('footer') %>
    </body>
</html>

