<!DOCTYPE html>
<html lang="en">
    <head>
        <%
            const currentPathName = currentPath.split('?')[0];
            const browseQrExportsEnabled = (Array.isArray(exportFormats) ? exportFormats : [])
                .some((format) => String(format?.value || '').trim().toLowerCase() === 'qr');
            const usesOffsetPagination = pagination?.mode === 'offset';
            const isRandomPage = currentPathName === '/random';
            const currentPageNumber = usesOffsetPagination ? null : (pagination?.currentPage || 1);
            const pageSuffix = currentPageNumber > 1 ? ` - Page ${currentPageNumber}` : '';
            const hasSelectedTags = Array.isArray(selectedTags) && selectedTags.length > 0;
            const hasExcludedTags = Array.isArray(excludedTags) && excludedTags.length > 0;
            const tagSummary = hasSelectedTags ? selectedTags.join(', ') : '';
            const excludedTagSummary = hasExcludedTags ? excludedTags.join(', ') : '';
            const tagFilterSummary = [
                hasSelectedTags ? `including tags: ${tagSummary}` : '',
                hasExcludedTags ? `excluding tags: ${excludedTagSummary}` : ''
            ].filter(Boolean).join('; ');
            const hasTagFilters = Boolean(tagFilterSummary);
            const safeSearchQuery = typeof searchQuery === 'string' ? searchQuery.trim() : '';
            const isLikedMiisPage = currentPathName === '/myLikedMiis';
            const likedMiisSort = typeof likedSort !== 'undefined' && likedSort === 'likes'
                ? 'likes'
                : 'latest';
            const likedMiisDirection = typeof likedSortDirection !== 'undefined' && likedSortDirection === 'asc'
                ? 'asc'
                : 'desc';
            const hasTextSearchSort = Boolean(
                safeSearchQuery
                && typeof selectedSearchFields !== 'undefined'
                && Array.isArray(selectedSearchFields)
                && selectedSearchFields.length > 0
            );
            const resultSortValues = [
                ...(hasTextSearchSort ? ['relevance'] : []),
                'alphabetical',
                'trending',
                'top',
                'latest'
            ];
            const selectedResultSort = typeof searchSort !== 'undefined' && resultSortValues.includes(searchSort)
                ? searchSort
                : (hasTextSearchSort ? 'relevance' : 'top');
            const defaultResultDirection = selectedResultSort === 'alphabetical' ? 'asc' : 'desc';
            const selectedResultDirection = typeof searchDirection !== 'undefined' && ['asc', 'desc'].includes(searchDirection)
                ? searchDirection
                : defaultResultDirection;
            const resultDirectionLabels = {
                relevance: { asc: 'Least relevant first', desc: 'Best match first' },
                alphabetical: { asc: 'A to Z', desc: 'Z to A' },
                trending: { asc: 'Least trending first', desc: 'Most trending first' },
                top: { asc: 'Least liked first', desc: 'Most liked first' },
                latest: { asc: 'Oldest first', desc: 'Newest first' }
            }[selectedResultSort];
            const canonicalUrl = `${baseUrl}${currentPath}`;
            const breadcrumbs = [{ name: 'Home', url: '/' }];
            let pageTitle = title || 'Browse Mii Characters - InfiniMii';
            let pageDesc = 'Browse Mii characters from the InfiniMii collection, including official Nintendo Miis and community uploads.';
            let keywords = 'mii characters, browse miis, nintendo miis, download miis';
            let pageRobots;
            let introHeading = 'Browse Mii Characters';
            let introBody = browseQrExportsEnabled
                ? 'Open a Mii to download its files, view compatible QR codes, or read its recreation details.'
                : 'Open a Mii to download its LTD file or read its recreation details.';

            if (currentPathName === '/trending') {
                pageTitle = `Trending Mii Characters${pageSuffix} - InfiniMii`;
                pageDesc = 'Browse the Mii characters currently getting the most attention on InfiniMii.';
                keywords = 'trending miis, popular mii characters, hot miis';
                introHeading = 'Trending Mii Characters';
                introBody = 'These Miis are receiving the most attention on InfiniMii right now.';
                breadcrumbs.push({ name: 'Trending', url: '/trending' });
            } else if (currentPathName === '/top') {
                pageTitle = `Top Rated Mii Characters${pageSuffix} - InfiniMii`;
                pageDesc = 'Browse the highest-rated Mii characters on InfiniMii, including fan favorites and standout recreations.';
                keywords = 'top miis, best mii characters, top rated miis';
                introHeading = 'Top Rated Mii Characters';
                introBody = 'Browse the highest-rated Miis on InfiniMii, from fan favorites to standout recreations.';
                breadcrumbs.push({ name: 'Top Miis', url: '/top' });
            } else if (currentPathName === '/recent') {
                pageTitle = `Recent Mii Uploads${pageSuffix} - InfiniMii`;
                pageDesc = 'See the latest Mii character uploads added to InfiniMii.';
                keywords = 'recent miis, latest mii uploads, new mii characters';
                introHeading = 'Recent Mii Uploads';
                introBody = 'See the newest community uploads and official additions.';
                breadcrumbs.push({ name: 'Recent', url: '/recent' });
            } else if (currentPathName === '/random') {
                pageTitle = `Random Mii Characters${pageSuffix} - InfiniMii`;
                pageDesc = 'Browse a random set of Mii characters from InfiniMii.';
                keywords = 'random miis, surprise mii characters, explore miis';
                pageRobots = 'noindex, follow, noarchive';
                introHeading = 'Random Mii Characters';
                introBody = 'Load a different selection from the archive each time.';
                breadcrumbs.push({ name: 'Random', url: '/random' });
            } else if (isLikedMiisPage) {
                const likedSortTitle = likedMiisSort === 'likes'
                    ? ` - Like Count: ${likedMiisDirection === 'asc' ? 'Low to High' : 'High to Low'}`
                    : (likedMiisDirection === 'asc' ? ' - Oldest First' : '');
                pageTitle = `My Liked Miis${likedSortTitle}${pageSuffix} - InfiniMii`;
                pageDesc = 'Browse the public Miis you have liked on InfiniMii.';
                keywords = 'liked miis, favorite miis, saved likes';
                pageRobots = 'noindex, follow, noarchive';
                introHeading = 'My Liked Miis';
                introBody = likedMiisSort === 'likes'
                    ? `Browse the public Miis you have liked on InfiniMii, sorted from ${likedMiisDirection === 'asc' ? 'fewest to most' : 'most to fewest'} likes.`
                    : `Browse the public Miis you have liked on InfiniMii, ${likedMiisDirection === 'asc' ? 'oldest first' : 'newest first'}.`;
                breadcrumbs.push({ name: 'My Liked Miis', url: '/myLikedMiis' });
            } else if (currentPathName === '/searchResults') {
                pageTitle = safeSearchQuery
                    ? `Search Results for ${safeSearchQuery}${pageSuffix} - InfiniMii`
                    : `Search Results${pageSuffix} - InfiniMii`;
                pageDesc = safeSearchQuery
                    ? `Search results for "${safeSearchQuery}" on InfiniMii${hasTagFilters ? ` with filters ${tagFilterSummary}.` : '.'}`
                    : 'Search results from the InfiniMii Mii character database.';
                keywords = `search miis, mii search results${safeSearchQuery ? `, ${safeSearchQuery}` : ''}${tagSummary ? `, ${tagSummary}` : ''}${excludedTagSummary ? `, ${excludedTagSummary}` : ''}`;
                pageRobots = 'noindex, follow, noarchive';
                introHeading = safeSearchQuery ? `Search Results for "${safeSearchQuery}"` : 'Search Results';
                introBody = hasTagFilters
                    ? `Showing Miis ${tagFilterSummary}.`
                    : 'Showing Miis that match your search.';
                breadcrumbs.push({ name: 'Search', url: '/search' });
            }

            const listOffset = usesOffsetPagination
                ? (pagination?.start || 0)
                : ((pagination?.currentPage || 1) - 1) * (pagination?.perPage || displayedMiis.length || 0);
            const schemaType = 'CollectionPage';
            const schemaGraphs = (!pageRobots && Array.isArray(displayedMiis) && displayedMiis.length > 0)
                ? [{
                    "@context": "https://schema.org",
                    "@type": "ItemList",
                    "name": introHeading,
                    "numberOfItems": pagination?.total || displayedMiis.length,
                    "itemListElement": displayedMiis
                        .filter((miiItem) => miiItem && miiItem.id)
                        .map((miiItem, index) => ({
                            "@type": "ListItem",
                            "position": listOffset + index + 1,
                            "url": `${baseUrl}/mii/${miiItem.id}`,
                            "name": miiItem?.meta?.name || miiItem?.name || 'Unknown Mii'
                        }))
                }]
                : [];
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, keywords, pageRobots, prevUrl, nextUrl }) %>
        <%- include('structuredData') %>
        <link href="/global.css?v=<%= encodeURIComponent(assetVersion || '20260513-tri-state-search-filters') %>" rel="stylesheet">
    </head>

    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <div class="content">
            <%- include('sidebar') %>
            <div class="main-content">
                <section class="browse-page-intro" aria-labelledby="browse-heading">
                    <h1 id="browse-heading"><%= introHeading %></h1>
                    <p><%= introBody %></p>
                </section>
                <%
                    const selectedTagParams = Array.isArray(selectedTags) ? selectedTags : [];
                    const encodedTagQuery = selectedTagParams.map(tag => '&tags=' + encodeURIComponent(tag)).join('');
                    const selectedSearchFieldParams = Array.isArray(selectedSearchFields) ? selectedSearchFields : [];
                    const encodedSortQuery = query.sort ? '&sort=' + encodeURIComponent(query.sort) : '';
                    const encodedDirectionQuery = query.direction ? '&direction=' + encodeURIComponent(query.direction) : '';
                    const encodedSearchFieldQuery = currentPath.startsWith('/searchResults')
                        ? '&searchFieldsConfigured=1' + selectedSearchFieldParams.map(field => '&searchIn=' + encodeURIComponent(field)).join('')
                        : '';
                    const hasActiveSearchQuery = Boolean(query.q && selectedSearchFieldParams.length > 0);
                    const hasActiveAdvancedSearch = Boolean(advancedSearchFilters?.isActive);
                    const shouldUseFullRowGrid = usesOffsetPagination || isRandomPage;
                    const fullRowGridStart = usesOffsetPagination ? (pagination?.start || 0) : 0;
                    const fullRowGridTotal = usesOffsetPagination ? (pagination?.total ?? displayedMiis.length) : displayedMiis.length;
                    const fullRowRequestLimit = usesOffsetPagination
                        ? (pagination?.requestLimit || displayedMiis.length || 1)
                        : (displayedMiis.length || 1);
                    const fullRowBaseCount = pagination?.baseCount || 16;
                %>

                <% if (currentPath.startsWith('/searchResults')) { %>
                    <section class="search-results-search" aria-label="Search">
                        <%- include('advancedSearchControls', {
                            formAction: '/searchResults',
                            query,
                            controlUiIdPrefix: 'search-results',
                            searchAriaLabel: 'Search Mii characters',
                            searchInputPlaceholder: 'Search by text...',
                            submitLabel: 'Search',
                            selectedSearchFields,
                            searchFieldsExplicitlyConfigured,
                            availableTags,
                            selectedTags,
                            excludedTags,
                            isModerator,
                            renderSearchFields: true,
                            renderMiiAdvancedFilters: true,
                            renderTagFilters: true,
                            renderCategoryFilters: false,
                            advancedSearchFilters,
                            favoriteColorOptions,
                            birthdayMonthOptions,
                            birthdayDayOptions,
                            selectedResultSort,
                            selectedResultDirection
                        }) %>
                        <div class="results-sort-toolbar">
                            <form class="results-sort-form" method="GET" action="/searchResults">
                                <%
                                    Object.entries(query || {}).forEach(([paramName, paramValue]) => {
                                        if (['sort', 'direction', 'start', 'page'].includes(paramName)) return;
                                        const values = Array.isArray(paramValue) ? paramValue : [paramValue];
                                        values.forEach((value) => {
                                            if (typeof value === 'undefined' || value === null || typeof value === 'object') return;
                                %>
                                    <input type="hidden" name="<%= paramName %>" value="<%= value %>">
                                <%
                                        });
                                    });
                                %>
                                <label for="search-results-sort">Sort by</label>
                                <select
                                    id="search-results-sort"
                                    name="sort"
                                    onchange="if (this.form) { if (this.form.requestSubmit) { this.form.requestSubmit(); } else { this.form.submit(); } }"
                                >
                                    <% if (hasTextSearchSort) { %>
                                        <option value="relevance" <%= selectedResultSort === 'relevance' ? 'selected' : '' %>>Best match</option>
                                    <% } %>
                                    <option value="alphabetical" <%= selectedResultSort === 'alphabetical' ? 'selected' : '' %>>Alphabetical</option>
                                    <option value="trending" <%= selectedResultSort === 'trending' ? 'selected' : '' %>>Trending</option>
                                    <option value="top" <%= selectedResultSort === 'top' ? 'selected' : '' %>>Top</option>
                                    <option value="latest" <%= selectedResultSort === 'latest' ? 'selected' : '' %>>Latest</option>
                                </select>
                                <label for="search-results-direction">Direction</label>
                                <select
                                    id="search-results-direction"
                                    name="direction"
                                    aria-label="Sort direction"
                                    onchange="if (this.form) { if (this.form.requestSubmit) { this.form.requestSubmit(); } else { this.form.submit(); } }"
                                >
                                    <option value="asc" <%= selectedResultDirection === 'asc' ? 'selected' : '' %>><%= resultDirectionLabels.asc %></option>
                                    <option value="desc" <%= selectedResultDirection === 'desc' ? 'selected' : '' %>><%= resultDirectionLabels.desc %></option>
                                </select>
                            </form>
                        </div>
                        <% if (hasActiveSearchQuery || (Array.isArray(selectedTags) && selectedTags.length > 0) || (Array.isArray(excludedTags) && excludedTags.length > 0) || hasActiveAdvancedSearch) { %>
                            <p class="search-results-summary">
                                <%= pagination?.total ?? displayedMiis.length %> result<%= (pagination?.total ?? displayedMiis.length) === 1 ? '' : 's' %>
                                <% if (hasActiveSearchQuery) { %>
                                    for "<%= query.q %>"
                                <% } %>
                                <% if (Array.isArray(selectedTags) && selectedTags.length > 0) { %>
                                    <span class="search-results-tag-summary">with tag<%= selectedTags.length === 1 ? '' : 's' %>: <%= selectedTags.join(', ') %></span>
                                <% } %>
                                <% if (Array.isArray(excludedTags) && excludedTags.length > 0) { %>
                                    <span class="search-results-tag-summary">excluding tag<%= excludedTags.length === 1 ? '' : 's' %>: <%= excludedTags.join(', ') %></span>
                                <% } %>
                                <% if (hasActiveAdvancedSearch) { %>
                                    <span class="search-results-tag-summary">with advanced filters</span>
                                <% } %>
                            </p>
                        <% } %>
                    </section>
                <% } else if (isLikedMiisPage) { %>
                    <section class="search-results-search" aria-label="Sort liked Miis">
                        <form class="results-sort-form" method="GET" action="/myLikedMiis">
                            <label for="liked-miis-sort">Sort by</label>
                            <select
                                id="liked-miis-sort"
                                name="sort"
                                aria-label="Sort liked Miis"
                                onchange="if (this.form) { if (this.form.requestSubmit) { this.form.requestSubmit(); } else { this.form.submit(); } }"
                            >
                                <option value="latest" <%= likedMiisSort === 'latest' ? 'selected' : '' %>>Upload date</option>
                                <option value="likes" <%= likedMiisSort === 'likes' ? 'selected' : '' %>>Like count</option>
                            </select>
                            <label for="liked-miis-direction">Direction</label>
                            <select
                                id="liked-miis-direction"
                                name="direction"
                                aria-label="Sort liked Miis direction"
                                onchange="if (this.form) { if (this.form.requestSubmit) { this.form.requestSubmit(); } else { this.form.submit(); } }"
                            >
                                <option value="asc" <%= likedMiisDirection === 'asc' ? 'selected' : '' %>><%= likedMiisSort === 'likes' ? 'Least liked first' : 'Oldest first' %></option>
                                <option value="desc" <%= likedMiisDirection === 'desc' ? 'selected' : '' %>><%= likedMiisSort === 'likes' ? 'Most liked first' : 'Newest first' %></option>
                            </select>
                        </form>
                        <p class="search-results-summary">
                            <%= pagination?.total ?? displayedMiis.length %> liked Mii<%= (pagination?.total ?? displayedMiis.length) === 1 ? '' : 's' %>
                        </p>
                    </section>
                <% } %>

                <%
                    let emptyStateTitle = 'No Miis found';
                    let emptyStateBody = 'There are no public Miis to show here yet.';
                    let emptyStateIconPath = 'M479.82 976 423.36 925.85Q311 824.46 235.5 749.5 160 674.54 114.5 608.77q-45.5-65.77-62-120.85Q36 432.85 36 385.15q0-96 64.5-160.58Q165 160 260 160q54 0 102 24.5t82 70.5q34-46 82-70.5t102-24.5q95 0 159.5 64.57Q852 288.15 852 384.15q0 48.7-16.5 104-16.5 55.31-62 121.08-45.5 65.77-121.12 140.88-75.61 75.12-188.1 175.74L479.82 976Z';

                    if (currentPathName === '/searchResults') {
                        emptyStateTitle = 'No search results';
                        emptyStateBody = safeSearchQuery || hasSelectedTags
                            ? 'Try a broader search, fewer tags, or another spelling.'
                            : 'Enter a search term or choose tags to find Miis.';
                        emptyStateIconPath = 'M784 936 532 684q-30 24-69 38t-83 14q-109 0-184.5-75.5T120 476q0-109 75.5-184.5T380 216q109 0 184.5 75.5T640 476q0 44-14 83t-38 69l252 252-56 56ZM380 656q75 0 127.5-52.5T560 476q0-75-52.5-127.5T380 296q-75 0-127.5 52.5T200 476q0 75 52.5 127.5T380 656Z';
                    } else if (isLikedMiisPage) {
                        emptyStateTitle = 'No liked Miis yet';
                        emptyStateBody = 'Like a few Miis and they will show up here.';
                    } else if (currentPathName === '/official') {
                        emptyStateTitle = 'No official Miis found';
                        emptyStateBody = 'No official Miis match this category yet.';
                    }
                %>

                <% if (displayedMiis.length > 0) { %>
                    <div
                        id="browse-miis"
                        class="browse-miis-balanced"
                        <% if (shouldUseFullRowGrid) { %>
                            data-full-row-grid="1"
                            data-full-row-start="<%= fullRowGridStart %>"
                            data-full-row-total="<%= fullRowGridTotal %>"
                            data-full-row-request-limit="<%= fullRowRequestLimit %>"
                            data-full-row-base-count="<%= fullRowBaseCount %>"
                            data-full-row-allow-partial-last="<%= usesOffsetPagination ? '1' : '0' %>"
                        <% } %>
                    >
                        <% for (var i = 0; i < displayedMiis.length; i++) { %>
                            <%
                                const miiItem = displayedMiis[i];
                                if (!miiItem || !miiItem.id) {
                                    continue;
                                }
                                const shouldEagerLoadImage = i < 6;
                                const shouldPrioritizeImage = i < 3;
                            %>
                            <%- include('miiCard', {
                                mii: miiItem,
                                user,
                                cardDomId: miiItem.id,
                                imageEagerLoad: shouldEagerLoadImage,
                                imagePriorityLoad: shouldPrioritizeImage,
                                descriptionMaxLength: 75,
                                metadataType: 'tags',
                                metadataItemLimit: 3
                            }) %>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="empty-state browse-empty-state">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 96 960 960">
                            <path d="<%= emptyStateIconPath %>" />
                        </svg>
                        <h3><%= emptyStateTitle %></h3>
                        <p><%= emptyStateBody %></p>
                    </div>
                <% } %>

                <% if (pagination?.mode === 'offset' && displayedMiis.length > 0) { %>
                    <div class="pagination" data-full-row-controls-for="browse-miis">
                        <a
                            <% if (pagination.prevUrl) { %>href="<%= pagination.prevUrl %>"<% } %>
                            class="pagination-btn"
                            data-pagination-prev
                            <%= pagination.prevUrl ? '' : 'aria-disabled="true" tabindex="-1"' %>
                        >&larr; Previous</a>

                        <span
                            class="pagination-info"
                            data-pagination-mode="offset"
                            data-current-page="<%= pagination.currentPage %>"
                            data-total-pages="<%= pagination.totalPages %>"
                            data-page-size="<%= pagination.requestLimit %>"
                            data-start="<%= pagination.start %>"
                            data-total-items="<%= pagination.total %>"
                        >
                            Page
                            <button type="button" class="pagination-current-page" aria-label="Jump to page">
                                <%= pagination.currentPage %>
                            </button>
                            <input
                                type="number"
                                class="pagination-page-input"
                                min="1"
                                max="<%= pagination.totalPages %>"
                                value="<%= pagination.currentPage %>"
                                inputmode="numeric"
                                aria-label="Type page number"
                            >
                            of <span data-pagination-total-pages><%= pagination.totalPages %></span>
                            (<span data-pagination-total><%= pagination.total %></span> Miis)
                        </span>

                        <a
                            <% if (pagination.nextUrl) { %>href="<%= pagination.nextUrl %>"<% } %>
                            class="pagination-btn"
                            data-pagination-next
                            <%= pagination.nextUrl ? '' : 'aria-disabled="true" tabindex="-1"' %>
                        >Next &rarr;</a>
                    </div>
                <% } else if (isRandomPage && displayedMiis.length > 0) { %>
                    <div class="pagination" data-full-row-controls-for="browse-miis">
                        <a href="/random" class="pagination-btn">Refresh</a>
                        <span class="pagination-info">
                            Showing
                            <span data-random-visible-count><%= displayedMiis.length %></span>
                            random Miis
                        </span>
                    </div>
                <% } else if (pagination && pagination.mode !== 'offset' && pagination.mode !== 'random' && pagination.totalPages > 1) { %>
                    <div class="pagination">
                        <a
                            <% if (pagination.currentPage > 1) { %>href="?page=<%= pagination.currentPage - 1 %><%= query.q ? '&q=' + encodeURIComponent(query.q) : '' %><%= query.category ? '&category=' + encodeURIComponent(query.category) : '' %><%= pagination.seed ? '&seed=' + pagination.seed : '' %><%= encodedTagQuery %><%= encodedSearchFieldQuery %><%= encodedSortQuery %><%= encodedDirectionQuery %>"<% } %>
                            class="pagination-btn"
                            <%= pagination.currentPage > 1 ? '' : 'aria-disabled="true" tabindex="-1"' %>
                        >&larr; Previous</a>

                        <span class="pagination-info" data-current-page="<%= pagination.currentPage %>" data-total-pages="<%= pagination.totalPages %>">
                            Page
                            <button type="button" class="pagination-current-page" aria-label="Jump to page">
                                <%= pagination.currentPage %>
                            </button>
                            <input
                                type="number"
                                class="pagination-page-input"
                                min="1"
                                max="<%= pagination.totalPages %>"
                                value="<%= pagination.currentPage %>"
                                inputmode="numeric"
                                aria-label="Type page number"
                            >
                            of <%= pagination.totalPages %>
                            (<%= pagination.total %> Miis)
                        </span>

                        <a
                            <% if (pagination.currentPage < pagination.totalPages) { %>href="?page=<%= pagination.currentPage + 1 %><%= query.q ? '&q=' + encodeURIComponent(query.q) : '' %><%= query.category ? '&category=' + encodeURIComponent(query.category) : '' %><%= pagination.seed ? '&seed=' + pagination.seed : '' %><%= encodedTagQuery %><%= encodedSearchFieldQuery %><%= encodedSortQuery %><%= encodedDirectionQuery %>"<% } %>
                            class="pagination-btn"
                            <%= pagination.currentPage < pagination.totalPages ? '' : 'aria-disabled="true" tabindex="-1"' %>
                        >Next &rarr;</a>
                    </div>
                <% } %>
            </div>
            <%- include('featuredMiis') %>
        </div>
        <%- include('footer') %>
    </body>
</html>
