<!DOCTYPE html>
<html>
    <head>
        <title>
            <%= title %>
        </title>
        <link rel="search" type="application/opensearchdescription+xml" title="InfiniMii Search" href="/opensearch.xml">
        <link href="./global.css" rel="stylesheet">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </head>

    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <div class="content">
            <%- include('sidebar') %>
            <div class="main-content">
                <%
                    const selectedTagParams = Array.isArray(selectedTags) ? selectedTags : [];
                    const encodedTagQuery = selectedTagParams.map(tag => '&tags=' + encodeURIComponent(tag)).join('');
                    const selectedSearchFieldParams = Array.isArray(selectedSearchFields) ? selectedSearchFields : [];
                    const encodedSearchFieldQuery = currentPath.startsWith('/searchResults')
                        ? '&searchFieldsConfigured=1' + selectedSearchFieldParams.map(field => '&searchIn=' + encodeURIComponent(field)).join('')
                        : '';
                    const hasActiveSearchQuery = Boolean(query.q && selectedSearchFieldParams.length > 0);
                %>

                <% if (currentPath.startsWith('/searchResults')) { %>
                    <section class="search-results-search" aria-label="Search">
                        <form method="GET" action="/searchResults" role="search">
                            <label for="search-results-query" class="sr-only">Search Mii characters</label>
                            <input
                                id="search-results-query"
                                name="q"
                                type="search"
                                autocomplete="off"
                                placeholder="Search by text..."
                                value="<%= query.q || '' %>"
                            >
                            <%- include('searchFieldFilters', { selectedSearchFields, searchFieldsExplicitlyConfigured, searchFieldUiIdPrefix: 'search-results-fields' }) %>
                            <%- include('tagFilters', { availableTags, selectedTags, isModerator, tagUiIdPrefix: 'search-results', renderTagFilters: true, renderTagManagement: false }) %>
                            <input type="submit" value="Search">
                        </form>
                        <% if (hasActiveSearchQuery || (Array.isArray(selectedTags) && selectedTags.length > 0)) { %>
                            <p class="search-results-summary">
                                <%= pagination?.total ?? displayedMiis.length %> result<%= (pagination?.total ?? displayedMiis.length) === 1 ? '' : 's' %>
                                <% if (hasActiveSearchQuery) { %>
                                    for "<%= query.q %>"
                                <% } %>
                                <% if (Array.isArray(selectedTags) && selectedTags.length > 0) { %>
                                    <span class="search-results-tag-summary">with tag<%= selectedTags.length === 1 ? '' : 's' %>: <%= selectedTags.join(', ') %></span>
                                <% } %>
                            </p>
                        <% } %>
                    </section>
                <% } %>

                <div id="browse-miis" class="browse-miis-balanced">
                    <% for (var i = 0; i < displayedMiis.length; i++) { %>
                        <%
                            const miiItem = displayedMiis[i];
                            if (!miiItem || !miiItem.id) {
                                continue;
                            }
                            const miiItemName = miiItem?.meta?.name || miiItem?.name || 'Unknown Mii';
                            const miiItemDesc = typeof miiItem?.desc === 'string' ? miiItem.desc : '';
                        %>
                        <div class="mii-card" style="--favorite-color: <%= decodeColor(miiItem.general?.favoriteColor) || decodeColor(0) %>;" id="<%= miiItem.id %>">
                            <a href="<%= '/mii/' + miiItem.id %>"><img src="miiImgs/<%= miiItem.id %>.png" alt="<%= miiItemName %>"></a>
                            <div class="flex">
                                <div>
                                    <h3><%= miiItemName %></h3>
                                    <a href="<%= '/user/' + encodeURIComponent(miiItem.uploader) %>"><%= miiItem.uploader %></a>
                                    <% if (miiItem.official && miiItem.contributor) { %>
                                        <small class="uploader-subtext">Uploaded by <a href="/user/<%= encodeURIComponent(miiItem.contributor) %>"><%= miiItem.contributor %></a></small>
                                    <% } %>
                                    <p><%= miiItemDesc.length > 75 ? miiItemDesc.slice(0, 73) + "..." : miiItemDesc %></p>
                                    <% if (miiItem.tags && miiItem.tags.length > 0) { %>
                                        <div class="mii-card-tags">
                                            <% miiItem.tags.slice(0, 3).forEach(tag => { %>
                                                <a class="mii-card-tag" href="/searchResults?tags=<%= encodeURIComponent(tag) %>"><%= tag %></a>
                                            <% }) %>
                                            <% if (miiItem.tags.length > 3) { %>
                                                <span class="mii-card-tag mii-card-tag-more">+<%= miiItem.tags.length - 3 %></span>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

                <% if (pagination && pagination.totalPages > 1 && !title.toLowerCase().includes("random")) { %>
                    <div class="pagination">
                        <% if (pagination.currentPage > 1) { %>
                            <a href="?page=<%= pagination.currentPage - 1 %><%= query.q ? '&q=' + encodeURIComponent(query.q) : '' %><%= query.category ? '&category=' + encodeURIComponent(query.category) : '' %><%= pagination.seed ? '&seed=' + pagination.seed : '' %><%= encodedTagQuery %><%= encodedSearchFieldQuery %>" class="pagination-btn">&larr; Previous</a>
                        <% } %>

                        <span class="pagination-info" data-current-page="<%= pagination.currentPage %>" data-total-pages="<%= pagination.totalPages %>">
                            Page
                            <button type="button" class="pagination-current-page" aria-label="Jump to page">
                                <%= pagination.currentPage %>
                            </button>
                            <input
                                type="number"
                                class="pagination-page-input"
                                min="1"
                                max="<%= pagination.totalPages %>"
                                value="<%= pagination.currentPage %>"
                                inputmode="numeric"
                                aria-label="Type page number"
                            >
                            of <%= pagination.totalPages %>
                            (<%= pagination.total %> Miis)
                        </span>

                        <% if (pagination.currentPage < pagination.totalPages) { %>
                            <a href="?page=<%= pagination.currentPage + 1 %><%= query.q ? '&q=' + encodeURIComponent(query.q) : '' %><%= query.category ? '&category=' + encodeURIComponent(query.category) : '' %><%= pagination.seed ? '&seed=' + pagination.seed : '' %><%= encodedTagQuery %><%= encodedSearchFieldQuery %>" class="pagination-btn">Next &rarr;</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
            <%- include('featuredMiis') %>
        </div>
        <%- include('footer') %>
    </body>
</html>
