<%
    const searchFieldCatalog = [
        { value: 'uploader', label: 'Uploader' },
        { value: 'name', label: 'Name' },
        { value: 'creatorName', label: 'Creator Name' },
        { value: 'description', label: 'Description' }
    ];
    const selectedFieldSource = Array.isArray(selectedSearchFields) ? selectedSearchFields : [];
    const hasExplicitSelection = Boolean(searchFieldsExplicitlyConfigured);
    const activeFieldValues = selectedFieldSource.length > 0
        ? selectedFieldSource
        : (hasExplicitSelection ? [] : searchFieldCatalog.map(field => field.value));
    const selectedFieldSet = new Set(activeFieldValues.map(field => String(field || '').toLowerCase()));
    const fieldPanelPrefix = (typeof searchFieldUiIdPrefix === 'string' && searchFieldUiIdPrefix.trim())
        ? searchFieldUiIdPrefix.trim()
        : 'search-fields';
%>

<section class="search-fields-panel" aria-labelledby="<%= fieldPanelPrefix %>-title">
    <header class="advanced-filter-heading search-fields-heading">
        <div>
            <h3 class="search-fields-title" id="<%= fieldPanelPrefix %>-title">Search in</h3>
            <p id="<%= fieldPanelPrefix %>-help">Choose which text fields the search should check.</p>
        </div>
    </header>
    <input type="hidden" name="searchFieldsConfigured" value="1">
    <div class="search-field-options" aria-describedby="<%= fieldPanelPrefix %>-help">
        <% searchFieldCatalog.forEach(field => { %>
            <% const inputId = `${fieldPanelPrefix}-${field.value}`; %>
            <label class="search-field-option" for="<%= inputId %>">
                <input
                    id="<%= inputId %>"
                    type="checkbox"
                    name="searchIn"
                    value="<%= field.value %>"
                    <%= selectedFieldSet.has(field.value.toLowerCase()) ? 'checked' : '' %>
                >
                <span><%= field.label %></span>
            </label>
        <% }) %>
    </div>
</section>
