<!DOCTYPE html>

<!-- Citation guidance -->
 
<html lang="en">
<head>
    <%
    const pageTitle = 'Cite InfiniMii - Citation and Attribution';
    const pageDesc = 'Citation examples for InfiniMii pages, Mii data, tools, and transfer guides.';
    const canonicalUrl = `${baseUrl}/cite`;
    const breadcrumbs = [
        { name: 'Home', url: '/' },
        { name: 'Cite InfiniMii', url: '/cite' }
    ];
    const currentYear = new Date().getFullYear();
    %>
    <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl }) %>
    <%- include('structuredData') %>
    
    <link rel="stylesheet" href="/global.css">
</head>
<body>
    <%- include('globalStyle') %>
    <%- include('header') %>
    <%- include('accountDisplay') %>
    
    <main class="content">
        <%- include('sidebar') %>
        
        <article class="cite-page">
            <h1>Citing InfiniMii</h1>
            <p>Use these examples when citing InfiniMii or one of its tools.</p>
            
            <section class="citation-format">
                <h2>Citation examples</h2>
                
                <p>InfiniMii publishes Mii character data, conversion tools, and format references. Adapt these examples to the citation style your publication uses:</p>
                
                <h3>General citation</h3>
                <div class="citation-box">
                    <code>InfiniMii. (<%= currentYear %>). Mii Character Archive and Tools. Retrieved from <%= baseUrl %></code>
                </div>
                
                <h3>Specific tools</h3>
                <div class="citation-box">
                    <code>InfiniMii. (<%= currentYear %>). Mii Dashboard: File Inspection, Rendering, and Conversion. Retrieved from <%= baseUrl %>/miiDashboard</code>
                </div>
                
                <h3>Transfer guides</h3>
                <div class="citation-box">
                    <code>InfiniMii. (<%= currentYear %>). Guide to Transferring Miis Between Nintendo Systems. Retrieved from <%= baseUrl %>/guides/transfer</code>
                </div>
            </section>
            
            <section class="attribution-guidelines">
                <h2>Attribution</h2>
                
                <h3>Recommended attribution</h3>
                <ul>
                    <li>Link to the InfiniMii page that contains the data or tool</li>
                    <li>Credit InfiniMii when converted output is part of your work</li>
                    <li>Cite the relevant guide rather than the home page when possible</li>
                    <li>Follow your required citation style for academic work</li>
                </ul>
                
                <h3>Examples</h3>
                <p>"According to the InfiniMii Mii archive..."</p>
                <p>"As explained in InfiniMii's transfer guide..."</p>
                <p>"Using tools like InfiniMii's Mii Dashboard..."</p>
            </section>
            
            <section class="data-accuracy">
                <h2>What InfiniMii documents</h2>
                <p>The site includes:</p>
                <ul>
                    <li><strong>Mii format notes</strong> - File structures and implementation details</li>
                    <li><strong>System compatibility</strong> - Known support and limitations</li>
                    <li><strong>Transfer methods</strong> - Instructions for supported Nintendo systems</li>
                    <li><strong>Official Mii archive</strong> - Known Miis from Nintendo sources</li>
                </ul>
            </section>
            
            <section class="contact-info">
                <h2>Questions for the maintainers</h2>
                <p>For questions about Mii data, file formats, or the site's sources:</p>
                <ul>
                    <li>Join our Discord: <a href="<%= discordInvite %>" target="_blank" rel="noopener noreferrer"><%= discordInvite %></a></li>
                    <li>View our GitHub: <a href="https://github.com/Stewared/MiiJS" target="_blank" rel="noopener noreferrer">github.com/Stewared/MiiJS</a></li>
                    <li>Reference our documentation: <a href="/faq">InfiniMii FAQ</a></li>
                </ul>
            </section>
        </article>
        
        <%- include('featuredMiis') %>
    </main>
    
    <%- include('footer') %>
</body>
</html>
