<!DOCTYPE html>
<html>
    <head>
        <%
        const pageTitle = 'Error - InfiniMii';
        const pageDesc = 'InfiniMii could not open the requested page.';
        const canonicalUrl = baseUrl + '/error';
        const keywords = 'search mii, find mii character, mii database, mii search engine';
        const pageRobots = 'noindex, nofollow, noarchive';
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, keywords, pageRobots }) %>
        <%- include('structuredData') %>
        
        <link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="/utilityPages.css">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <main class="content" role="main">
            <%- include('sidebar') %>
            <section class="utility-container error-shell" aria-labelledby="error-heading">
                <div class="error-panel">
                    <p class="error-eyebrow">Page error</p>
                    <h1 id="error-heading"><%= status || 'Error' %></h1>
                    <p class="error-message"><%= message || 'An unexpected error occurred.' %></p>
                    <p class="error-help">Try the previous page or return to the home page.</p>
                    <div class="error-actions">
                        <button type="button" onclick="history.back()" class="error-btn error-btn-primary">Go Back</button>
                        <a href="/" class="error-btn error-btn-secondary">Home</a>
                    </div>
                </div>
            </section>
            <%- include('featuredMiis') %>
        </main>
        <%- include('footer') %>
    </body>
</html>
