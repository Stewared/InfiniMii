<!DOCTYPE html>
<html lang="en">
    <head>
        <%
        const dashboardPath = '/miiDashboard';
        const dashboardUrl = `${baseUrl}${dashboardPath}`;
        const dashboardExportFormats = Array.isArray(exportFormats) ? exportFormats : [];
        const dashboardExportValues = dashboardExportFormats
            .map((format) => String(format?.value || '').trim().toLowerCase())
            .filter(Boolean);
        const legacyDashboardExportsEnabled = dashboardExportValues.some((value) => value !== 'ltd');
        const dashboardQrExportsEnabled = dashboardExportValues.includes('qr');
        const defaultDashboardExportFormat = dashboardExportValues[0] || '';
        const pageTitle = dashboardQrExportsEnabled
            ? 'Mii Converter, QR Generator & Renderer - InfiniMii'
            : 'Mii Converter & LTD Renderer - InfiniMii';
        const pageDesc = dashboardQrExportsEnabled
            ? 'Convert Mii files and QR images, generate compatible QR codes, edit decoded data, and render Mii previews in your browser.'
            : 'Inspect Mii files and QR images, edit decoded data, render Mii previews, and export the result as an LTD file.';
        const canonicalUrl = `${baseUrl}${dashboardPath}`;
        const ogImageAlt = dashboardQrExportsEnabled
            ? 'InfiniMii Mii converter, QR generator, and renderer dashboard'
            : 'InfiniMii Mii converter and LTD renderer dashboard';
        const dashboardKeywordSeeds = [
            'mii converter',
            'mii qr scanner',
            'mii file converter',
            'mii format converter',
            'convert mii file',
            'convert mii qr',
            ...(dashboardQrExportsEnabled ? [
                'mii qr generator',
                'mii qr code generator',
                '3ds mii qr code',
                'wii u mii qr code',
                'tomodachi life mii qr code',
                'mii qr png'
            ] : [
                'ltd mii converter',
                'ltd mii download'
            ]),
            'mii renderer',
            'render mii',
            'mii json editor',
            'miijs',
            'special mii converter',
            'wii mii converter',
            '3ds mii converter',
            'wii u mii converter',
            'switch mii converter',
            'mii studio converter',
            'charinfo converter',
            'mii dashboard',
            'mii recreation instructions'
        ];
        const keywords = dashboardKeywordSeeds.join(', ');
        const breadcrumbs = [
            { name: 'Home', url: '/' },
            { name: 'Mii Dashboard', url: dashboardPath }
        ];
        const dashboardFeatureList = [
            legacyDashboardExportsEnabled
                ? 'Decode uploaded Mii files, QR images, raw Mii data, and InfiniMii Mii IDs'
                : 'Decode uploaded Mii files, QR images, and raw Mii data',
            dashboardQrExportsEnabled
                ? 'Convert Mii data to the formats listed by InfiniMii'
                : 'Convert supported Mii inputs to the LTD format',
            ...(dashboardQrExportsEnabled ? ['Generate compatible Mii QR codes'] : []),
            dashboardQrExportsEnabled
                ? 'Download the formats listed by InfiniMii'
                : 'Download LTD files',
            'Render head and full body Mii previews',
            'Edit decoded MiiJS JSON before exporting',
            ...(legacyDashboardExportsEnabled ? ['Create Special Mii exports'] : []),
            'View recreation instructions',
            'Run Kidomatic child and life-stage generation'
        ];
        const schemaGraphs = [{
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "@id": `${dashboardUrl}#mii-converter-app`,
            "name": dashboardQrExportsEnabled ? "InfiniMii Mii Converter and QR Generator" : "InfiniMii Mii Converter and LTD Renderer",
            "alternateName": dashboardQrExportsEnabled
                ? ["InfiniMii Mii Dashboard", "InfiniMii Mii QR Generator", "InfiniMii Mii Renderer"]
                : ["InfiniMii Mii Dashboard", "InfiniMii LTD Converter", "InfiniMii Mii Renderer"],
            "applicationCategory": "UtilitiesApplication",
            "applicationSubCategory": dashboardQrExportsEnabled ? "Mii converter and QR generator" : "Mii converter and LTD renderer",
            "operatingSystem": "Web Browser",
            "url": dashboardUrl,
            "description": pageDesc,
            "keywords": dashboardKeywordSeeds,
            "featureList": dashboardFeatureList,
            "isAccessibleForFree": true,
            "inLanguage": "en-US",
            "mainEntityOfPage": {
                "@id": `${dashboardUrl}#webpage`
            },
            "image": {
                "@type": "ImageObject",
                "url": `${baseUrl}/banner.png`,
                "contentUrl": `${baseUrl}/banner.png`,
                "width": 669,
                "height": 373,
                "encodingFormat": "image/png"
            },
            "audience": {
                "@type": "Audience",
                "audienceType": "Nintendo Mii creators, collectors, and preservation users"
            },
            "about": [
                { "@type": "Thing", "name": "Mii format conversion" },
                ...(dashboardQrExportsEnabled ? [{ "@type": "Thing", "name": "Mii QR codes" }] : []),
                { "@type": "Thing", "name": "Nintendo Mii characters" }
            ],
            "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "USD"
            }
        }];
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, ogImageAlt, keywords }) %>
        <%- include('structuredData', { title: pageTitle, description: pageDesc, canonicalUrl, ogImageAlt, keywords, breadcrumbs, schemaGraphs }) %>

        <link rel="stylesheet" href="/global.css?v=<%= encodeURIComponent(assetVersion || '1') %>">
        <link rel="stylesheet" href="/utilityPages.css?v=<%= encodeURIComponent(assetVersion || '1') %>">
        <link rel="stylesheet" href="/miiChild.css?v=<%= encodeURIComponent(assetVersion || '1') %>">
        <link rel="stylesheet" href="/miiDashboard.css?v=<%= encodeURIComponent(assetVersion || '1') %>">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>

        <main class="content" role="main">
            <%- include('sidebar') %>

            <section class="utility-container child-maker-container mii-dashboard-container">
                <header class="child-maker-intro mii-dashboard-intro">
                    <h1>Mii Dashboard</h1>
                    <p>Inspect one Mii, edit its data, create previews, convert formats, or generate child stages.</p>
                </header>

                <form id="miiDashboardForm" method="POST" enctype="multipart/form-data" action="/miiDashboard/analyze">
                    <fieldset>
                        <legend>Inspect a Mii</legend>

                        <p class="note">
                            Choose one input: a supported Mii file or QR image, raw Mii data, or an InfiniMii ID.
                        </p>

                        <div class="dashboard-input-grid">
                            <div>
                                <label for="dashboardMiiFile">Mii file or QR image</label>
                                <input type="file" id="dashboardMiiFile" name="mii" aria-required="false">
                            </div>
                            <div>
                                <label for="dashboardMiiId">InfiniMii Mii ID</label>
                                <input type="text" id="dashboardMiiId" name="miiId" autocomplete="off" spellcheck="false" placeholder="Example: average">
                            </div>
                            <div>
                                <label for="dashboardMiiData">Or paste raw Mii data</label>
                                <textarea id="dashboardMiiData" name="miiData" rows="4" placeholder="Paste base64, hex, or JSON..."></textarea>
                            </div>
                        </div>

                        <div id="dashboardMessage" class="form-message" style="display: none;"></div>
                        <input type="submit" value="Open Dashboard">
                    </fieldset>
                </form>

                <section id="dashboardResults" class="dashboard-results" hidden>
                    <div class="dashboard-results-header">
                        <div>
                            <h2 id="dashboardMiiName">Decoded Mii</h2>
                            <p class="note" id="dashboardCreatedOn"></p>
                        </div>
                        <div class="dashboard-primary-actions">
                            <button type="button" id="dashboardDownloadBtn"><%- include('icon', { name: 'download', size: 16, class: 'icon-inline' }) %> Download</button>
                            <button type="button" id="dashboardUploadBtn" class="btn-secondary"><%- include('icon', { name: 'upload', size: 16, class: 'icon-inline' }) %> Upload</button>
                            <button type="button" id="dashboardRenderAsBtn" class="btn-secondary" aria-haspopup="true" aria-expanded="false">Render As</button>
                            <div id="dashboardRenderAsMenu" class="dashboard-render-as-menu" hidden>
                                <span class="dashboard-render-as-label">Renderer:</span>
                                <button type="button" class="btn-secondary" data-renderer-profile="TL">TL</button>
                                <button type="button" class="btn-secondary" data-renderer-profile="LTD">LTD</button>
                                <span id="dashboardRendererStatus" class="note"></span>
                            </div>
                            <button type="button" id="dashboardInstructionsBtn" class="btn-secondary"><%- include('icon', { name: 'scroll', size: 16, class: 'icon-inline' }) %> Recreation Instructions</button>
                            <button type="button" id="dashboardKidomaticBtn" class="btn-secondary"><%- include('icon', { name: 'sparkles', size: 16, class: 'icon-inline' }) %> Kidomatic</button>
                            <div id="dashboardActionMessage" class="form-message dashboard-local-message" style="display: none;"></div>
                        </div>
                    </div>

                    <div class="dashboard-preview-grid">
                        <article class="dashboard-preview-card">
                            <h3>Face preview</h3>
                            <img id="dashboardRender" class="dashboard-preview-image" src="" alt="Decoded Mii render" width="512" height="512" loading="lazy" decoding="async">
                        </article>

                        <article class="dashboard-preview-card">
                            <h3>Full-body preview</h3>
                            <img id="dashboardFullBodyRender" class="dashboard-preview-image dashboard-full-body-image" src="" alt="Decoded Mii full body render" width="512" height="512" loading="lazy" decoding="async">
                        </article>

                        <% if (dashboardQrExportsEnabled) { %>
                            <article id="dashboardQrCard" class="dashboard-preview-card" hidden>
                                <h3>QR Code</h3>
                                <div id="dashboardQrPreview" class="qr-preview-window is-qr-3ds" data-qr-preview data-qr3ds-src="" data-qr-wiiu-src="" data-qr-tomodachi-src="" data-qr-miitopia-src="">
                                    <div class="qr-console-tabs" role="tablist" aria-label="QR console type">
                                        <button type="button" class="qr-console-tab is-active" data-qr-tab="3DS" role="tab" aria-selected="true">3DS</button>
                                        <button type="button" class="qr-console-tab" data-qr-tab="WIIU" role="tab" aria-selected="false">Wii U</button>
                                        <button type="button" class="qr-console-tab" data-qr-tab="TOMODACHI" role="tab" aria-selected="false" aria-label="Tomodachi Life 3DS QR" title="Tomodachi Life 3DS QR" hidden>TL</button>
                                        <% /* MT QR tab temporarily disabled on the InfiniMii site. */ %>
                                        <!-- <button type="button" class="qr-console-tab" data-qr-tab="MIITOPIA" role="tab" aria-selected="false" aria-label="Miitopia 3DS QR" title="Miitopia 3DS QR" hidden>MT</button> -->
                                    </div>
                                    <a id="dashboardQrLink" class="qr-preview-link" href="#" target="_blank" rel="noopener noreferrer" data-qr-link>
                                        <img id="dashboardQr" class="qr-code-image" src="" alt="Decoded Mii QR code" width="150" height="150" loading="lazy" decoding="async" data-qr-image data-qr-console="3DS">
                                    </a>
                                </div>
                            </article>
                        <% } %>

                        <article class="dashboard-info-card">
                            <h3>Mii data</h3>
                            <div id="dashboardInfoGrid" class="dashboard-info-grid"></div>
                        </article>

                        <article id="dashboardTomodachiCard" class="dashboard-info-card" hidden>
                            <h3>Tomodachi data</h3>
                            <div id="dashboardTomodachiGrid" class="dashboard-info-grid"></div>
                        </article>
                    </div>

                    <form id="dashboardUploadForm" action="/uploadMii" method="post" class="dashboard-upload-panel" hidden>
                        <fieldset>
                            <legend>Upload a Mii to the Website</legend>
                            <div id="dashboardUploadMessage" class="form-message" style="display: none;"></div>
                            <% if (user) { %>
                                <input type="hidden" name="dashboardUpload" value="true">
                                <input type="hidden" name="miiData" id="dashboardUploadMiiData">
                                <input type="hidden" name="sourceMiiId" id="dashboardUploadSourceMiiId">
                                <input type="hidden" name="downloadPolicyToken" id="dashboardUploadDownloadPolicyToken">
                                <input type="hidden" name="downloadPolicyMiiData" id="dashboardUploadDownloadPolicyMiiData">
                                <label for="dashboardUploadDesc">Description (max <%= miiDescriptionMaxLength %> characters)</label>
                                <input id="dashboardUploadDesc" size="50" placeholder="Description..." name="desc" type="text" maxlength="<%= miiDescriptionMaxLength %>" required aria-required="true">
                                <input id="dashboardUploadSubmit" type="submit" value="Upload">
                            <% } else { %>
                                <p class="note">Log in to upload this Mii to your private collection.</p>
                                <a class="btn btn-primary" href="/login?next=%2FmiiDashboard">Log In</a>
                            <% } %>
                        </fieldset>
                    </form>

                    <details class="dashboard-json-details">
                        <summary>MiiJS Decoded JSON</summary>
                        <label for="dashboardJsonOutput" class="sr-only">Editable MiiJS decoded JSON</label>
                        <textarea id="dashboardJsonOutput" class="dashboard-json-output" rows="18" spellcheck="false"></textarea>
                        <div class="dashboard-json-actions">
                            <button type="button" id="dashboardApplyJsonBtn" class="btn-secondary">Apply JSON Edits</button>
                            <button type="button" id="dashboardJsonDownloadBtn" class="btn-secondary"><%- include('icon', { name: 'download', size: 16, class: 'icon-inline' }) %> Download</button>
                            <% if (isAdmin) { %>
                                <button type="button" id="dashboardSaveJsonBtn" class="btn-secondary" hidden>Save</button>
                            <% } %>
                            <div id="dashboardJsonMessage" class="form-message dashboard-local-message" style="display: none;"></div>
                            <p class="note">Apply JSON edits before downloading, creating a QR code or instructions, uploading, or running Kidomatic. If Save is available, it checks the editor before saving.</p>
                        </div>
                    </details>
                </section>

                <section id="dashboardKidomaticResults" class="child-results" hidden>
                    <h3>Kidomatic Stages</h3>
                    <p class="note">The same six life stages shown in the Mii Child Generator.</p>
                    <div id="dashboardKidomaticGrid" class="child-results-grid"></div>
                </section>

                <div id="dashboardExportModal" class="child-download-modal-overlay" hidden>
                    <div class="child-download-modal" role="dialog" aria-modal="true" aria-labelledby="dashboardExportModalTitle">
                        <div class="child-download-modal-header">
                            <h4 id="dashboardExportModalTitle">Export Mii</h4>
                            <button type="button" id="dashboardExportModalClose" class="child-download-modal-close" aria-label="Close export options">x</button>
                        </div>

                        <div class="child-download-modal-body">
                            <p id="dashboardExportLabel" class="note child-download-stage-label"></p>

                            <label for="dashboardExportFormat">Export format</label>
                            <input type="text" id="dashboardExportFormat" name="format" list="dashboardExportFormatOptions" value="<%= defaultDashboardExportFormat %>" placeholder="Choose an export format..." required<%- legacyDashboardExportsEnabled ? '' : ' readonly aria-readonly="true"' %>>

                            <% if (legacyDashboardExportsEnabled || dashboardQrExportsEnabled) { %>
                                <div class="child-download-options-row">
                                    <% if (legacyDashboardExportsEnabled) { %>
                                        <label id="dashboardExportSpecialOption" class="child-download-inline-label">
                                            <input type="checkbox" id="dashboardExportSpecial" name="special">
                                            Download as Special Mii
                                        </label>
                                    <% } %>
                                    <% if (dashboardQrExportsEnabled) { %>
                                        <label id="dashboardExportQrOption" for="dashboardExportQrConsole" class="child-download-inline-label">
                                            QR Console:
                                            <select id="dashboardExportQrConsole" name="qrConsole">
                                                <option value="3DS">3DS</option>
                                                <option value="WIIU">Wii U</option>
                                                <option value="TOMODACHI">Tomodachi Life (TL 3DS)</option>
                                                <% /* MT QR export temporarily disabled on the InfiniMii site. */ %>
                                                <!-- <option value="MIITOPIA">Miitopia (MT 3DS)</option> -->
                                            </select>
                                        </label>
                                    <% } %>
                                </div>
                            <% } %>

                            <p id="dashboardExportNote" class="note child-download-note">Available formats match the Mii download pages.</p>
                            <div id="dashboardExportMessage" class="form-message" style="display: none;"></div>
                        </div>

                        <div class="child-download-modal-actions">
                            <button type="button" id="dashboardExportDownloadBtn">Download</button>
                            <button type="button" id="dashboardExportCopyHexBtn" class="btn-secondary">Copy Hex</button>
                            <button type="button" id="dashboardExportCopyBase64Btn" class="btn-secondary">Copy Base64</button>
                        </div>
                    </div>
                </div>

                <datalist id="dashboardExportFormatOptions">
                    <% dashboardExportFormats.forEach(fmt => { %>
                        <option value="<%= fmt.value %>" label="<%= fmt.label %>" data-dashboard-export-format></option>
                    <% }) %>
                </datalist>
            </section>

            <%- include('featuredMiis') %>
        </main>

        <%- include('footer') %>
        <script>
            window.miiDashboardConfig = {
                downloadIconSvg: <%- toScriptJson(include('icon', { name: 'download', size: 18, class: 'child-stage-download-icon' })) %>,
                isAdmin: <%= isAdmin ? 'true' : 'false' %>,
                allowedExportFormats: <%- toScriptJson(dashboardExportValues) %>,
                defaultExportFormat: <%- toScriptJson(defaultDashboardExportFormat) %>,
                legacyExportsEnabled: <%= legacyDashboardExportsEnabled ? 'true' : 'false' %>,
                qrExportsEnabled: <%= dashboardQrExportsEnabled ? 'true' : 'false' %>
            };
        </script>
        <script src="/miiDashboardFormatPolicy.js?v=<%= encodeURIComponent(assetVersion || '1') %>"></script>
        <script src="/miiDashboard.js?v=<%= encodeURIComponent(assetVersion || '1') %>"></script>
    </body>
</html>
