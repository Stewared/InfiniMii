                    const miiName = <%- toScriptJson(mii.meta.name || "") %>;
                    showConfirm(`Are you ABSOLUTELY SURE you want to DELETE the Mii "${miiName}"?\n\nThis action CANNOT be undone!`, () => {
                        const doubleCheck = prompt(`Type "DELETE" to confirm deletion of ${miiName}:`);
                        if (doubleCheck !== 'DELETE') {
                            showAlert('Deletion cancelled.', 3000, { title: 'Cancelled' });
                            return;
                        }

                        (async () => {
                            try {
                                const response = await fetch('/deleteMii', {
                                    method: 'POST',
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ id: '<%= mii.id %>' })
                                });
                                const result = await response.json();
                                
                                if (!result.error) {
                                    showAlert('Mii deleted successfully', 2000, { title: 'Success', type: 'success' });
                                    setTimeout(() => window.location.href = result.redirect || '/', 2000);
                                }
                                else {
                                    showAlert('Error deleting Mii', 5000, { title: 'Error', type: 'error' });
                                }
                            }
                            catch (error) {
                                console.error('Error:', error);
                                showAlert('Failed to delete Mii', 5000, { title: 'Error', type: 'error' });
                            }
                        })();
                    }, null, { title: 'Delete Mii', confirmText: 'Continue' });
                }

            </script>
        <% } %>
    </body>
</html>
