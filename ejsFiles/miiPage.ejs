            function getMiiMetadataEditConfig(field) {
                const configs = {
                    name: {
                        endpointField: 'name',
                        label: 'name',
                        maxLength: 10,
                        required: true,
                        fallback: 'Unknown Mii'
                    },
                    desc: {
                        endpointField: 'desc',
                        label: 'description',
                        maxLength: <%= miiDescriptionMaxLength %>,
                        required: true,
                        fallback: <%- toScriptJson(archiveIntro) %>
                    },
                    creatorName: {
                        endpointField: 'creatorName',
                        label: 'creator name',
                        maxLength: 10,
                        required: false,
                        fallback: 'Not Set'
                    }
                };

                return configs[field] || null;
            }

            function getInlineMiiEditorElement(field, role) {
                return document.querySelector(`[data-inline-edit-${role}="${field}"]`);
            }

            function normalizeMiiMetadataEditorValue(field, value) {
                if (field === 'name' || field === 'creatorName') {
                    return String(value ?? '').trim();
                }

                return String(value ?? '');
            }

            function validateMiiMetadataEditorValue(field, value) {
                const config = getMiiMetadataEditConfig(field);
                if (!config) {
                    showAlert('Invalid field.', 5000, { title: 'Error', type: 'error' });
                    return false;
                }

                const normalizedValue = normalizeMiiMetadataEditorValue(field, value);
                if (config.required && normalizedValue.trim() === '') {
                    showAlert(`Please enter a valid ${config.label}.`, 5000, { title: 'Error', type: 'error' });
                    return false;
                }

                if (config.maxLength && normalizedValue.length > config.maxLength) {
                    showAlert(`${config.label.charAt(0).toUpperCase()}${config.label.slice(1)} must be ${config.maxLength} characters or fewer.`, 5000, { title: 'Error', type: 'error' });
                    return false;
                }

                return true;
            }

            function setInlineMiiEditorOpen(field, isOpen) {
