            function setSaveButtonBusy(button, isBusy) {
                if (!button) return;
                if (!button.dataset.defaultLabel) {
                    button.dataset.defaultLabel = button.innerHTML;
                }

                button.disabled = isBusy;
                button.innerHTML = isBusy
                    ? 'Saving...'
                    : button.dataset.defaultLabel;
            }

            async function saveStagedEditorChanges(changes, button, title = 'Save Changes') {
                if (changes.length === 0) {
                    showAlert('No changes to save.', 3000, { title: 'Nothing to Save' });
                    return;
                }

                showConfirm(`Save ${changes.length} change${changes.length === 1 ? '' : 's'}?`, async () => {
                    setSaveButtonBusy(button, true);
                    try {
                        for (const change of changes) {
                            const result = await change.run();
                            if (result?.error) {
                                showAlert(`Error saving ${change.label}: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                                return;
                            }
                        }

                        showAlert('Changes saved successfully!', 3000, { title: 'Success', type: 'success' });
                        setTimeout(() => location.reload(), 1500);
                    } catch (error) {
                        console.error('Error saving changes:', error);
                        showAlert('Failed to save changes. Some updates may not have been applied.', 6000, { title: 'Error', type: 'error' });
                    } finally {
                        setSaveButtonBusy(button, false);
                    }
                }, null, { title, confirmText: 'Save' });
            }

