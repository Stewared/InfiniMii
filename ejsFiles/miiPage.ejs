                            <p><%= archiveSearchIntro %></p>
                        <% } %>
                    </section>

                    <section class="mii-seo-panel" aria-labelledby="mii-facts-heading" hidden>
                        <h2 id="mii-facts-heading">Searchable Archive Details</h2>
