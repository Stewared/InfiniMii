                                    <%
                                        const isTomodachiRowEditable = Boolean(canEditTomodachiLifeFields && row.editable && row.editField);
                                    %>
                                    <div class="tomodachi-field" <%- isTomodachiRowEditable ? `data-tomodachi-edit-field="${row.editField}"` : '' %>>
                                        <% if(isTomodachiRowEditable) { %>
                                            <div class="tomodachi-field-label-row">
                                                <span class="tomodachi-field-label"><%= row.label %></span>
                                                <button type="button" class="inline-edit-icon-button" data-tomodachi-edit-trigger="<%= row.editField %>" onclick="openTomodachiInlineEditor('<%= row.editField %>')" aria-label="Edit <%= row.label %>" title="Edit <%= row.label %>">
                                                    <%- include('icon', { name: 'edit', size: 14 }) %>
                                                </button>
                                            </div>
                                            <span class="tomodachi-field-value <%= row.multiline ? 'is-multiline' : '' %>" data-tomodachi-edit-display="<%= row.editField %>"><%= row.value %></span>
                                            <div class="inline-edit-controls tomodachi-inline-edit-controls" data-tomodachi-edit-controls="<%= row.editField %>" hidden>
                                                <% if(row.editField === 'tomodachiFullName') { %>
                                                    <label class="tomodachi-inline-label">
                                                        <span>First</span>
                                                        <input type="text" class="inline-edit-input tomodachi-inline-input" data-tomodachi-edit-input="tomodachiFullName" data-tomodachi-name-part="firstName" value="<%= tomodachiRaw.firstName || '' %>" maxlength="16" autocomplete="off" spellcheck="false">
                                                    </label>
                                                    <label class="tomodachi-inline-label">
                                                        <span>Last</span>
                                                        <input type="text" class="inline-edit-input tomodachi-inline-input" data-tomodachi-edit-input="tomodachiFullName" data-tomodachi-name-part="lastName" value="<%= tomodachiRaw.lastName || '' %>" maxlength="16" autocomplete="off" spellcheck="false">
                                                    </label>
                                                <% } else if(row.editField === 'tomodachiFullBirthday') { %>
                                                    <label class="tomodachi-inline-label">
                                                        <span>Month</span>
                                                        <select class="inline-edit-input tomodachi-inline-input" data-tomodachi-edit-input="tomodachiFullBirthday" data-tomodachi-birthday-part="birthMonth">
                                                            <option value="">Not Set</option>
                                                            <% birthdayMonthOptions.forEach(month => { %>
                                                                <option value="<%= month.value %>" <%= String(month.value) === String(tomodachiBirthdayMonth || '') ? 'selected' : '' %>><%= month.label %></option>
                                                            <% }); %>
                                                        </select>
                                                    </label>
                                                    <label class="tomodachi-inline-label">
                                                        <span>Day</span>
                                                        <select class="inline-edit-input tomodachi-inline-input" data-tomodachi-edit-input="tomodachiFullBirthday" data-tomodachi-birthday-part="birthday">
                                                            <option value="">Not Set</option>
                                                            <% birthdayDayOptions.forEach(day => { %>
                                                                <option value="<%= day.value %>" <%= String(day.value) === String(tomodachiBirthdayDay || '') ? 'selected' : '' %>><%= day.label %></option>
                                                            <% }); %>
                                                        </select>
                                                    </label>
                                                <% } else if(row.editField === 'tomodachiIslandName') { %>
                                                    <input type="text" class="inline-edit-input tomodachi-inline-input" data-tomodachi-edit-input="tomodachiIslandName" value="<%= tomodachiRaw?.island?.name || '' %>" maxlength="9" autocomplete="off" spellcheck="false">
                                                <% } else if(row.editField === 'tomodachiAgeGroup') { %>
                                                    <div class="tomodachi-age-toggle" role="radiogroup" aria-label="Age group">
                                                        <label class="tomodachi-age-option">
                                                            <input type="radio" name="tomodachiAgeGroup-<%= mii.id %>" data-tomodachi-edit-input="tomodachiAgeGroup" value="child" <%= tomodachiRaw.isAdult === false ? 'checked' : '' %>>
                                                            <span>Child</span>
                                                        </label>
                                                        <label class="tomodachi-age-option">
                                                            <input type="radio" name="tomodachiAgeGroup-<%= mii.id %>" data-tomodachi-edit-input="tomodachiAgeGroup" value="adult" <%= tomodachiRaw.isAdult === true ? 'checked' : '' %>>
                                                            <span>Adult</span>
                                                        </label>
                                                    </div>
                                                <% } else if(row.editField === 'tomodachiPersonality') { %>
                                                    <div class="tomodachi-personality-sliders">
                                                        <% [
                                                            { key: 'movement', label: 'Movement' },
                                                            { key: 'speech', label: 'Speech' },
                                                            { key: 'expressiveness', label: 'Expressiveness' },
                                                            { key: 'attitude', label: 'Attitude' }
                                                        ].forEach(slider => { %>
                                                            <label class="tomodachi-slider-label">
                                                                <span><%= slider.label %> <output data-tomodachi-personality-output="<%= slider.key %>"><%= tomodachiPersonalityRaw[slider.key] || 4 %></output></span>
                                                                <input type="range" min="1" max="8" step="1" value="<%= tomodachiPersonalityRaw[slider.key] || 4 %>" data-tomodachi-edit-input="tomodachiPersonality" data-tomodachi-personality-part="<%= slider.key %>">
                                                            </label>
                                                        <% }); %>
                                                        <span class="tomodachi-personality-preview" data-tomodachi-personality-preview><%= row.value %></span>
                                                    </div>
                                                <% } else if(row.editField === 'tomodachiCatchphrase') { %>
                                                    <input type="text" class="inline-edit-input tomodachi-inline-input" data-tomodachi-edit-input="tomodachiCatchphrase" value="<%= tomodachiRaw.catchphrase || '' %>" maxlength="16" autocomplete="off" spellcheck="false">
                                                <% } %>
                                                <div class="inline-edit-actions tomodachi-inline-actions">
                                                    <button type="button" class="inline-edit-save-button" data-tomodachi-edit-save="<%= row.editField %>" onclick="saveTomodachiInlineField('<%= row.editField %>')">
                                                        <%- include('icon', { name: 'check', size: 15 }) %> Save
                                                    </button>
                                                    <button type="button" class="inline-edit-cancel-button" onclick="cancelTomodachiInlineEdit('<%= row.editField %>')" aria-label="Cancel <%= row.label %> edit" title="Cancel">
                                                        <%- include('icon', { name: 'x', size: 15 }) %>
                                                    </button>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <span class="tomodachi-field-label"><%= row.label %></span>
                                            <span class="tomodachi-field-value <%= row.multiline ? 'is-multiline' : '' %>"><%= row.value %></span>
                                        <% } %>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    </section>
                <% } %>

                <!-- Description -->
                <div class="id-card-description">
                    <div class="editable-label-row">
                        <h3 class="info-label">Description</h3>
                        <% if(canInlineEditMiiMetadata) { %>
                            <button type="button" class="inline-edit-icon-button" data-inline-edit-trigger="desc" onclick="openMiiInlineEditor('desc')" aria-label="Edit description" title="Edit description">
                                <%- include('icon', { name: 'edit', size: 14 }) %>
                            </button>
                        <% } %>
                    </div>
                    <p itemprop="description" data-inline-edit-display="desc"><%= (mii.desc && mii.desc.length > 0) ? mii.desc : archiveIntro %></p>
                    <% if(canInlineEditMiiMetadata) { %>
                        <div class="inline-edit-controls inline-edit-controls-wide" data-inline-edit-controls="desc" hidden>
                            <textarea id="inlineEditDesc" class="inline-edit-input inline-edit-textarea" data-inline-edit-input="desc" rows="4" maxlength="<%= miiDescriptionMaxLength %>"><%= mii.desc || '' %></textarea>
                            <div class="inline-edit-actions">
                                <button type="button" class="inline-edit-save-button" data-inline-edit-save="desc" onclick="saveInlineMiiField('desc')">
                                    <%- include('icon', { name: 'check', size: 15 }) %> Save
                                </button>
                                <button type="button" class="inline-edit-cancel-button" onclick="cancelInlineMiiEdit('desc')" aria-label="Cancel description edit" title="Cancel">
                                    <%- include('icon', { name: 'x', size: 15 }) %>
                                </button>
                            </div>
                        </div>
                    <% } %>
                    <div class="id-card-description-actions">
                        <div class="vote-section">
                            <%
                                const userVotedFor = Array.isArray(user?.votedFor) ? user.votedFor : [];
                                const isLikeLocked = Boolean(
                                    !mii.official &&
                                    user?.username &&
                                    (mii.uploader === user.username || mii.contributor === user.username)
                                );
                                const hasLikedMii = userVotedFor.includes(mii.id) || isLikeLocked;
                            %>
                            <button
                                onclick="likeMii(this,'<%= mii.id %>','<%= highlightedMii %>','<%= isModerator %>')"
                                class="like-button <%= hasLikedMii ? 'is-liked' : 'is-unliked' %><%= isLikeLocked ? ' is-like-locked' : '' %>"
                                data-mii-id="<%= mii.id %>"
                                data-liked="<%= hasLikedMii ? 'true' : 'false' %>"
                                data-like-locked="<%= isLikeLocked ? 'true' : 'false' %>"
                                aria-pressed="<%= hasLikedMii ? 'true' : 'false' %>"
                                aria-label="<%= isLikeLocked ? 'You permanently like Miis you upload' : (hasLikedMii ? 'Unlike this Mii' : 'Like this Mii') %>"
                            >
                                <%- include('icon', { name: 'heart', size: 26, class: 'like-icon' }) %>
                                <span class="vote-count" itemprop="interactionStatistic" itemscope itemtype="https://schema.org/InteractionCounter">
                                    <meta itemprop="interactionType" content="https://schema.org/LikeAction">
                                    <meta itemprop="userInteractionCount" content="<%= mii.votes || 0 %>">
                                    <%= mii.votes||0 %>
                                </span>
                            </button>

                            <% if(isModerator || mii.uploader === user?.username){ %>
                                <button class="trash-button" onclick="deleteMii('<%= mii.id %>')">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="trash-icon" viewBox="0 96 960 960" fill="currentColor">
                                        <path d="M261 936q-24.75 0-42.375-17.625T201 876V306h-41v-60h188v-30h264v30h188v60h-41v570q0 24-18 42t-42 18H261Zm438-630H261v570h438V306ZM367 790h60V391h-60v399Zm166 0h60V391h-60v399ZM261 306v570-570Z"/>
                                    </svg>
                                </button>
                            <% } %>
                            <button type="button" class="report-button" onclick="openReportProblemModal(event, this)" aria-label="Report a problem with this Mii">
                                <svg xmlns="http://www.w3.org/2000/svg" class="report-icon" viewBox="0 -960 960 960" fill="currentColor">
                                    <path d="M200-120v-680h360l16 80h224v400H520l-16-80H280v280h-80Zm300-440Zm86 160h134v-240H510l-16-80H280v240h290l16 80Z"/>
                                </svg>
                                <span class="report-button-label">Report Problem</span>
                            </button>
                            <% if(canHideMiiFromAccount) { %>
                                <button type="button" class="report-button hide-mii-button" onclick="hideCurrentMii(event, this)" aria-label="Hide this Mii from your account">
                                    <%- include('icon', { name: 'ban', size: 20, class: 'hide-icon' }) %>
                                    <span class="report-button-label">Hide</span>
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="id-card-actions">
                    <%
                        const normalizedExportFormats = miiPageExportFormats
                            .map((fmt) => ({
                                value: String(fmt?.value || '').trim(),
                                label: String(fmt?.label || fmt?.value || '').trim()
                            }))
                            .filter((fmt) => fmt.value.length > 0);
                        const exportFormatByValue = new Map(
                            normalizedExportFormats.map((fmt) => [fmt.value.toLowerCase(), fmt])
                        );

                        const quickExportFormats = [];
                        const usedQuickValues = new Set();
                        const addQuickFormat = (format) => {
                            if (!format || !format.value) return;
                            const normalizedValue = String(format.value).toLowerCase();
                            if (usedQuickValues.has(normalizedValue)) return;
                            usedQuickValues.add(normalizedValue);
                            quickExportFormats.push({
                                key: format.key || format.value,
                                value: format.value,
                                label: format.label,
                                valueText: format.valueText || format.value,
                                labelText: format.labelText || format.label,
                                qrConsole: format.qrConsole || ''
                            });
                        };

                        const qrFormat = exportFormatByValue.get('qr');
                        if (qrFormat) {
                            quickExportFormats.push({
                                key: 'qr:3DS',
                                value: 'qr',
                                label: 'QR Code (3DS)',
                                valueText: '3DS QR',
                                labelText: qrFormat.label,
                                qrConsole: '3DS'
                            });
                            quickExportFormats.push({
                                key: 'qr:WIIU',
                                value: 'qr',
                                label: 'QR Code (Wii U)',
                                valueText: 'Wii U QR',
                                labelText: qrFormat.label,
                                qrConsole: 'WIIU'
                            });
                            if (hasTomodachiLifeData) {
                                quickExportFormats.push({
                                    key: 'qr:TOMODACHI',
                                    value: 'qr',
                                    label: 'QR Code (TL 3DS)',
                                    valueText: 'TL 3DS QR',
                                    labelText: qrFormat.label,
                                    qrConsole: 'TOMODACHI'
                                });
                            }
                            // MT QR quick export temporarily disabled.
                            if (hasMiitopiaQr) {
                                quickExportFormats.push({
                                    key: 'qr:MIITOPIA',
                                    value: 'qr',
                                    label: 'QR Code (Miitopia 3DS)',
                                    valueText: 'Miitopia QR',
                                    labelText: qrFormat.label,
                                    qrConsole: 'MIITOPIA'
                                });
                            }
                            usedQuickValues.add('qr');
                        }

                        addQuickFormat(exportFormatByValue.get('mnms'));
                        addQuickFormat(exportFormatByValue.get('rcd'));
                        addQuickFormat(exportFormatByValue.get('charinfo'));
                        addQuickFormat(exportFormatByValue.get('ltd'));

                        normalizedExportFormats.forEach((fmt) => {
                            if (quickExportFormats.length >= 5) return;
                            addQuickFormat(fmt);
                        });

                        const remainingExportFormats = normalizedExportFormats
                            .filter((fmt) => !usedQuickValues.has(fmt.value.toLowerCase()))
                            .map((fmt) => ({
                                key: fmt.value,
                                value: fmt.value,
                                label: fmt.label,
                                valueText: fmt.value,
                                labelText: fmt.label,
                                qrConsole: ''
                            }));
                    %>
                    <h3 class="info-label export-section-title">Download this Mii</h3>
                    <form id="miiExportForm" class="export-form<%= miiPageLtdConversionPending ? ' has-export-format' : '' %>" method="GET" action="/exportMii">
                        <input type="hidden" name="id" value="<%= mii.id %>">
                        <input type="hidden" id="export-format-<%= mii.id %>" name="format" value="<%= miiPageLtdConversionPending ? 'ltd' : '' %>">
                        <% if (miiPageQrExportsEnabled) { %>
                            <input type="hidden" name="qrConsole" value="<%= defaultQrConsole %>" data-export-qr-console-input data-default-qr-console="<%= defaultQrConsole %>">
                        <% } %>
                        <input type="hidden" value="<%= miiPageLtdConversionPending ? 'ltd' : '' %>" data-export-selection-key>

                        <div class="export-top-row">
                            <div
                                class="export-format-picker<%= miiPageLtdConversionPending ? ' is-conversion-locked' : '' %>"
                                data-export-picker
                                data-export-picker-disabled="<%= miiPageLtdConversionPending ? 'true' : 'false' %>"
                            >
                                <div
                                    class="export-format-control<%= miiPageLtdConversionPending ? ' is-disabled' : '' %>"
                                    <% if (miiPageLtdConversionPending) { %>
                                        role="group"
                                        tabindex="0"
                                        aria-label="Export format unavailable"
                                        aria-describedby="ltd-conversion-tooltip"
                                    <% } %>
                                >
                                    <button
                                        type="button"
                                        class="export-format-trigger"
                                        data-export-picker-toggle
                                        aria-haspopup="true"
                                        aria-expanded="false"
                                        aria-controls="export-format-menu-<%= mii.id %>"
                                        <% if (miiPageLtdConversionPending) { %>
                                            disabled
                                            aria-disabled="true"
                                            aria-describedby="ltd-conversion-tooltip"
                                        <% } %>
                                    >
                                        <span class="export-format-selected" data-export-selected-label><%= miiPageLtdConversionPending ? 'LTD file (.ltd)' : 'Select format' %></span>
                                        <span class="export-format-trigger-caret" aria-hidden="true">▼</span>
                                    </button>
                                    <% if (miiPageLtdConversionPending) { %>
                                        <span id="ltd-conversion-tooltip" class="export-format-tooltip" role="tooltip"><%= miiPageLtdConversionTooltip %></span>
                                    <% } %>
                                </div>
                                <div class="export-format-menu" id="export-format-menu-<%= mii.id %>" hidden>
                                    <div class="export-format-search-wrap">
                                        <input
                                            type="text"
                                            class="export-format-search"
                                            data-export-search
                                            autocomplete="off"
                                            spellcheck="false"
                                            placeholder="Search formats"
                                            aria-label="Search export formats"
                                        >
                                    </div>

                                    <div class="export-format-search-results" data-export-search-results role="listbox" aria-label="Search results" hidden></div>

                                    <div class="export-format-list" role="listbox" aria-label="Top formats">
                                        <% quickExportFormats.forEach(fmt => { %>
                                            <button
                                                type="button"
                                                class="export-format-option export-format-option-quick"
                                                data-export-key="<%= fmt.key %>"
                                                data-export-value="<%= fmt.value %>"
                                                data-export-label="<%= fmt.labelText %>"
                                                data-export-display="<%= fmt.label %>"
                                                data-export-qr-console="<%= fmt.qrConsole %>"
                                                title="<%= fmt.labelText %>"
                                            >
                                                <span class="export-option-value"><%= fmt.valueText %></span>
                                                <span class="export-option-label"><%= fmt.labelText %></span>
                                            </button>
                                        <% }) %>
                                        <% if(remainingExportFormats.length > 0) { %>
                                            <button
                                                type="button"
                                                class="export-format-option export-format-flyout-trigger"
                                                data-export-flyout-trigger
                                                aria-haspopup="true"
                                                aria-expanded="false"
                                            >
                                                <span class="export-option-value">Other formats</span>
                                                <span class="export-option-label">Browse the full export list</span>
                                                <span class="export-option-flyout-arrow" aria-hidden="true">></span>
                                            </button>
                                        <% } %>
                                    </div>

                                    <% if(remainingExportFormats.length > 0) { %>
                                        <div class="export-format-flyout-panel" data-export-flyout-panel hidden>
                                            <button
                                                type="button"
                                                class="export-format-flyout-back"
                                                data-export-flyout-back
                                                aria-label="Back to default formats"
                                            >
                                                <span aria-hidden="true">&lt;</span>
                                                <span>Back</span>
                                            </button>
                                            <div class="export-format-flyout-list" role="listbox" aria-label="Other formats">
                                                <% remainingExportFormats.forEach(fmt => { %>
                                                    <button
                                                        type="button"
                                                        class="export-format-option export-format-option-other"
                                                        data-export-key="<%= fmt.key %>"
                                                        data-export-value="<%= fmt.value %>"
                                                        data-export-label="<%= fmt.labelText %>"
                                                        data-export-display="<%= fmt.label %>"
                                                        data-export-qr-console="<%= fmt.qrConsole %>"
                                                        title="<%= fmt.labelText %>"
                                                    >
                                                        <span class="export-option-value"><%= fmt.valueText %></span>
                                                        <span class="export-option-label"><%= fmt.labelText %></span>
                                                    </button>
                                                <% }) %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <div class="export-format-empty" data-export-no-results hidden>No formats match your search.</div>
                                </div>
                            </div>

                            <% if (showMiiWorkspaceTools) { %>
                                <button type="button" class="btn-secondary export-instructions-btn" onclick="openMiiInstructions(event)">Recreation Instructions</button>
                                <a class="btn-secondary export-instructions-btn" href="/miiDashboard?id=<%= encodeURIComponent(mii.id) %>">Open Dashboard</a>
                                <a class="btn-secondary export-instructions-btn" href="/miiDashboard?id=<%= encodeURIComponent(mii.id) %>&amp;kidomatic=1">Kidomatic</a>
                            <% } %>
                        </div>

                        <div class="export-action-reveal" data-export-action-reveal aria-live="polite">
                            <% if (miiPageLegacyExportsEnabled) { %>
                                <label class="export-inline-toggle export-inline-toggle-reveal">
                                    <input type="checkbox" name="special">
                                    <span>Special Mii</span>
                                </label>
                            <% } %>
                            <button type="submit" class="btn-primary export-main-action" data-export-action <% if (!miiPageLtdConversionPending) { %>disabled<% } %>><%= miiPageLtdConversionPending ? 'Download LTD' : 'Download' %></button>
                            <button type="button" class="btn-secondary export-main-action" data-export-action <% if (!miiPageLtdConversionPending) { %>disabled<% } %> onclick="copyMiiExportText('miiExportForm', 'hex')">Copy Hex</button>
                            <button type="button" class="btn-secondary export-main-action" data-export-action <% if (!miiPageLtdConversionPending) { %>disabled<% } %> onclick="copyMiiExportText('miiExportForm', 'base64')">Copy Base64</button>
                        </div>
                    </form>
                </div>

                <!-- Uploader Information -->
                <div class="id-card-footer">
                    <div class="uploader-info">
                        <% if(isExternalMii){ %>
                            <% if(mii.official){ %>
                                <span class="official-badge"><%- include('icon', { name: 'star-filled', size: 14, class: 'icon-gold' }) %> Official Mii</span>
                            <% } %>
                            <span class="label">From</span>
                            <a class="external-source-link" href="<%= externalSource.url %>" target="_blank" rel="noopener noreferrer external">
                                <span><%= externalSource.title %></span>
                            </a>
                            <% if(externalSource.user && externalSource.userUrl) { %>
                                <small class="uploader-subtext">Uploaded by <a href="<%= externalSource.userUrl %>" target="_blank" rel="noopener noreferrer external"><%= externalSource.user %></a></small>
                            <% } else if(mii.official && mii.contributor) { %>
                                <small class="uploader-subtext">Uploaded by <a href="/user/<%= encodeURIComponent(mii.contributor) %>"><%= mii.contributor %></a></small>
                            <% } else if(mii.uploader) { %>
                                <small class="uploader-subtext">Uploaded by <a href="/user/<%= encodeURIComponent(mii.uploader) %>"><%= mii.uploader %></a></small>
                            <% } %>
                        <% } else if(mii.official){ %>
                            <span class="official-badge"><%- include('icon', { name: 'star-filled', size: 14, class: 'icon-gold' }) %> Official Mii</span>
                            <span class="label">Source</span>
                            <a class="uploader-with-pfp" href="/user/<%= encodeURIComponent(mii.uploader) %>">
                                <img
                                    class="uploader-pfp"
                                    src="/miiImgs/<%= uploaderPfp %>.png"
                                    alt="<%= officialSourceName %>'s profile Mii"
                                    onerror="this.src='/miiImgs/00000.png'"
                                    loading="lazy"
                                    decoding="async"
                                    fetchpriority="low"
                                    width="28"
                                    height="28"
                                >
                                <span><%= officialSourceName %></span>
                            </a>
                            <% if(mii.contributor) { %>
                                <small class="uploader-subtext">Uploaded by <a href="/user/<%= encodeURIComponent(mii.contributor) %>"><%= mii.contributor %></a></small>
                            <% } %>
                        <% } else { %>
                            <span class="label">Uploaded by</span>
                            <a class="uploader-with-pfp" href="/user/<%= encodeURIComponent(mii.uploader) %>">
                                <img
                                    class="uploader-pfp"
                                    src="/miiImgs/<%= uploaderPfp %>.png"
                                    alt="<%= mii.uploader %>'s profile Mii"
                                    onerror="this.src='/miiImgs/00000.png'"
                                    loading="lazy"
                                    decoding="async"
                                    fetchpriority="low"
                                    width="28"
                                    height="28"
                                >
                                <span><%= mii.uploader %></span>
                            </a>
                        <% } %>
                        <% if(displayedUploadedDate) { %>
                            <time class="date" datetime="<%= publishedTime %>" itemprop="datePublished">on <%= displayedUploadedDate.toLocaleDateString() %></time>
                        <% } %>
                    </div>
                </div>

                <div class="mii-seo-sections">
                    <section class="mii-seo-panel" aria-labelledby="mii-archive-heading" hidden>
                        <h2 id="mii-archive-heading">About This <%= miiName %> Mii</h2>
                        <p><%= archiveIntro %></p>
                    </section>

                    <section class="mii-seo-panel" aria-labelledby="mii-facts-heading" hidden>
                        <h2 id="mii-facts-heading">Details</h2>
                        <dl class="mii-fact-list">
                            <div class="mii-fact">
                                <dt>Name</dt>
                                <dd><%= miiName %></dd>
                            </div>
                            <div class="mii-fact">
                                <dt>Archive Type</dt>
                                <dd><%= archiveTypeLabel %></dd>
                            </div>
                            <div class="mii-fact">
                                <dt>Mii Type</dt>
                                <dd><%= typeLabel %></dd>
                            </div>
                            <% if(creatorName) { %>
                                <div class="mii-fact">
                                    <dt>Creator Name</dt>
                                    <dd><%= creatorName %></dd>
                                </div>
                            <% } %>
                            <% if(!isExternalMii && mii.official && officialSourceLabel) { %>
                                <div class="mii-fact">
                                    <dt>Official Source</dt>
                                    <dd><%= officialSourceLabel %></dd>
                                </div>
                            <% } %>
                            <% if(isExternalMii) { %>
                                <div class="mii-fact">
                                    <dt>From</dt>
                                    <dd><a class="external-source-link" href="<%= externalSource.url %>" target="_blank" rel="noopener noreferrer external"><%= externalSource.title %></a></dd>
                                </div>
                            <% } %>
                            <% if(isExternalMii && externalSource.user) { %>
                                <div class="mii-fact">
                                    <dt>External Uploader</dt>
                                    <dd><a href="<%= externalSource.userUrl %>" target="_blank" rel="noopener noreferrer external"><%= externalSource.user %></a></dd>
                                </div>
                            <% } %>
                            <% if(mii.uploader) { %>
                                <div class="mii-fact">
                                    <dt>Uploader</dt>
                                    <dd><%= mii.uploader %></dd>
                                </div>
                            <% } %>
                            <% if(mii.contributor) { %>
                                <div class="mii-fact">
                                    <dt>Contributor</dt>
                                    <dd><%= mii.contributor %></dd>
                                </div>
                            <% } %>
                            <% if(birthdayLabel) { %>
                                <div class="mii-fact">
                                    <dt>Birthday</dt>
                                    <dd><%= birthdayLabel %></dd>
                                </div>
                            <% } %>
                            <% if(favoriteColorName) { %>
                                <div class="mii-fact">
                                    <dt>Favorite Color</dt>
                                    <dd><%= favoriteColorName %></dd>
                                </div>
                            <% } %>
                            <% if(categoryDetails.length > 0) { %>
                                <div class="mii-fact">
                                    <dt>Official Categories</dt>
                                    <dd><%= categoryDetails.map(category => category.fullPath || category.name).join(', ') %></dd>
                                </div>
                            <% } %>
                            <% if(tagList.length > 0) { %>
                                <div class="mii-fact">
                                    <dt>Tags</dt>
                                    <dd><%= tagList.join(', ') %></dd>
                                </div>
                            <% } %>
                        </dl>
                    </section>

                    <section class="mii-seo-panel" aria-labelledby="mii-links-heading" hidden>
                        <h2 id="mii-links-heading">Related</h2>
                        <p>Browse related names, uploaders, tags, and official categories.</p>
                        <div class="mii-chip-list">
                            <a class="mii-chip mii-chip-link" href="<%= nameSearchUrl %>"><span class="tag-marquee-content"><%= miiName %></span></a>
                            <% if(creatorSearchUrl) { %>
                                <a class="mii-chip mii-chip-link" href="<%= creatorSearchUrl %>"><span class="tag-marquee-content">Creator: <%= creatorName %></span></a>
                            <% } %>
                            <a class="mii-chip mii-chip-link" href="<%= archiveOwnerProfileUrl %>"><span class="tag-marquee-content"><%= archiveOwnerLabel %> profile</span></a>
                            <a class="mii-chip mii-chip-link" href="<%= uploaderSearchUrl %>"><span class="tag-marquee-content"><%= mii.uploader %> uploads</span></a>
                            <% categoryDetails.forEach(category => { %>
                                <a class="mii-chip mii-chip-link" href="<%= category.url %>"><span class="tag-marquee-content"><%= category.name %></span></a>
                            <% }) %>
                            <% tagList.forEach(tag => { %>
                                <a class="mii-chip mii-chip-link" href="/searchResults?tags=<%= encodeURIComponent(tag) %>"><span class="tag-marquee-content"><%= tag %></span></a>
                            <% }) %>
                        </div>
                    </section>

                    <section class="mii-seo-panel" aria-labelledby="mii-download-heading" hidden>
                        <h2 id="mii-download-heading">Downloads</h2>
                        <p>Use the Download section to see the formats available for <%= miiName %>.</p>
                    </section>

                    <section class="mii-seo-panel" aria-labelledby="mii-faq-heading" hidden>
                        <h2 id="mii-faq-heading">About this Mii</h2>
                        <div class="mii-faq-list">
                            <% faqEntries.forEach((entry) => { %>
                                <article class="mii-faq-item">
                                    <h3><%= entry.question %></h3>
                                    <p><%= entry.answer %></p>
                                </article>
                            <% }) %>
                        </div>
                    </section>

                    <% if(Array.isArray(relatedCollections) && relatedCollections.length > 0) { %>
                        <% relatedCollections.forEach((collection) => { %>
                            <section class="mii-seo-panel" aria-labelledby="related-<%= collection.title.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>">
                                <h2 id="related-<%= collection.title.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"><%= collection.title %></h2>
                                <% if(collection.description) { %>
                                    <p><%= collection.description %></p>
                                <% } %>
                                <div class="related-mii-grid">
                                    <% collection.items.forEach((relatedMii) => { %>
                                        <% const relatedMiiAttribution = getMiiAttribution(relatedMii); %>
                                        <article class="related-mii-card" style="--favorite-color: <%= decodeColor(relatedMii.general?.favoriteColor) || decodeColor(0) %>;">
                                            <a class="related-mii-image" href="/mii/<%= relatedMii.id %>">
                                                <img src="/miiImgs/<%= relatedMii.id %>.png" alt="<%= relatedMii.meta?.name || relatedMii.name %> Mii character preview" width="256" height="256" loading="lazy" decoding="async" fetchpriority="low">
                                            </a>
