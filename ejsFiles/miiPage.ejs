                const controls = getInlineMiiEditorElement(field, 'controls');
                const trigger = getInlineMiiEditorElement(field, 'trigger');

                if (display) display.hidden = isOpen;
                if (controls) controls.hidden = !isOpen;
                if (trigger) trigger.hidden = isOpen;
            }

            function openMiiInlineEditor(field) {
