                }

                setInlineMiiEditorOpen(field, false);
            }

            const tomodachiPersonalityLabels = Object.freeze([
                Object.freeze(['Independent Lone Wolf', 'Independent Thinker', 'Confident Brainiac', 'Confident Go-getter']),
                Object.freeze(['Independent Free Spirit', 'Independent Artist', 'Confident Designer', 'Confident Adventurer']),
                Object.freeze(['Easygoing Buddy', 'Easygoing Dreamer', 'Outgoing Charmer', 'Outgoing Leader']),
                Object.freeze(['Easygoing Softie', 'Easygoing Optimist', 'Outgoing Trendsetter', 'Outgoing Entertainer'])
            ]);

            function getTomodachiInlineEditorElement(field, role) {
                return document.querySelector(`[data-tomodachi-edit-${role}="${field}"]`);
            }

            function getTomodachiInlineEditorInputs(field) {
                return Array.from(document.querySelectorAll(`[data-tomodachi-edit-input="${field}"]`));
            }

            function cloneTomodachiEditorValue(value) {
                if (value && typeof value === 'object') {
                    return JSON.parse(JSON.stringify(value));
                }
                return value;
            }

            function getTomodachiPersonalityLabel(personality) {
                if (!personality || typeof personality !== 'object') return '';

                let movement = Number.parseInt(personality.movement, 10);
                let speech = Number.parseInt(personality.speech, 10);
                let expressiveness = Number.parseInt(personality.expressiveness, 10);
                let attitude = Number.parseInt(personality.attitude, 10);

                if ([movement, speech, expressiveness, attitude].some(value => !Number.isInteger(value) || value < 1 || value > 8)) {
                    return '';
                }

                movement--;
                speech--;
                expressiveness--;
                attitude--;

                if (speech > 3) speech++;
                if (attitude > 3) attitude++;

                const x = movement + speech;
                const y = expressiveness + attitude;
                return tomodachiPersonalityLabels[Math.floor(y / 4)]?.[Math.floor(x / 4)] || '';
            }

            function getTomodachiBirthdayLabel(value) {
                const month = Number.parseInt(value?.birthMonth, 10);
                const day = Number.parseInt(value?.birthday, 10);
                const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                if (!Number.isInteger(month) || month < 1 || month > 12 || !Number.isInteger(day) || day < 1 || day > 31) {
                    return 'Not Set';
                }
                return `${monthNames[month - 1]} ${day}`;
            }

            function getTomodachiDisplayValue(field, value) {
                if (field === 'tomodachiFullName') {
                    return [value?.firstName, value?.lastName].map(part => String(part || '').trim()).filter(Boolean).join(' ') || 'Not Set';
                }
                if (field === 'tomodachiFullBirthday') {
                    return getTomodachiBirthdayLabel(value);
                }
                if (field === 'tomodachiAgeGroup') {
                    return value === 'adult' ? 'Adult' : (value === 'child' ? 'Child' : 'Not Set');
                }
                if (field === 'tomodachiPersonality') {
                    return getTomodachiPersonalityLabel(value) || 'Not Set';
                }

                return String(value || '').trim() || 'Not Set';
            }

            function setTomodachiInlineEditorOpen(field, isOpen) {
                const display = getTomodachiInlineEditorElement(field, 'display');
                const controls = getTomodachiInlineEditorElement(field, 'controls');
                const trigger = getTomodachiInlineEditorElement(field, 'trigger');

                if (display) display.hidden = isOpen;
                if (controls) controls.hidden = !isOpen;
                if (trigger) trigger.hidden = isOpen;
            }

            function setTomodachiPersonalityOutputs(field) {
                if (field !== 'tomodachiPersonality') return;

                const controls = getTomodachiInlineEditorElement(field, 'controls');
                if (!controls) return;

                const value = collectTomodachiInlineValue(field, { showErrors: false });
                controls.querySelectorAll('[data-tomodachi-personality-output]').forEach((output) => {
                    const key = output.dataset.tomodachiPersonalityOutput;
                    output.textContent = String(value?.[key] || 4);
                });

                const preview = controls.querySelector('[data-tomodachi-personality-preview]');
                if (preview) {
                    preview.textContent = getTomodachiDisplayValue(field, value);
                }
            }

            function populateTomodachiInlineEditor(field) {
                const value = tomodachiMiiEditorState[field];
                const inputs = getTomodachiInlineEditorInputs(field);

                if (field === 'tomodachiFullName') {
                    inputs.forEach((input) => {
                        input.value = value?.[input.dataset.tomodachiNamePart] || '';
                    });
                    return;
                }

                if (field === 'tomodachiFullBirthday') {
                    inputs.forEach((input) => {
                        input.value = value?.[input.dataset.tomodachiBirthdayPart] || '';
                    });
                    return;
                }

                if (field === 'tomodachiAgeGroup') {
                    inputs.forEach((input) => {
                        input.checked = input.value === value;
                    });
                    return;
                }

                if (field === 'tomodachiPersonality') {
                    inputs.forEach((input) => {
                        input.value = value?.[input.dataset.tomodachiPersonalityPart] || 4;
                    });
                    setTomodachiPersonalityOutputs(field);
                    return;
                }

                const input = inputs[0];
                if (input) input.value = value || '';
            }

            function openTomodachiInlineEditor(field) {
                const controls = getTomodachiInlineEditorElement(field, 'controls');
                if (!controls) return;

                populateTomodachiInlineEditor(field);
                setTomodachiInlineEditorOpen(field, true);

                const firstInput = getTomodachiInlineEditorInputs(field)[0];
                if (firstInput) {
                    firstInput.focus();
                    if (firstInput.type === 'text' && typeof firstInput.select === 'function') {
                        firstInput.select();
                    }
                }
            }

            function cancelTomodachiInlineEdit(field) {
                populateTomodachiInlineEditor(field);
                setTomodachiInlineEditorOpen(field, false);
            }

            function collectTomodachiInlineValue(field, options = {}) {
                const showErrors = options.showErrors !== false;
                const inputs = getTomodachiInlineEditorInputs(field);

                if (field === 'tomodachiFullName') {
                    const value = { firstName: '', lastName: '' };
                    inputs.forEach((input) => {
                        value[input.dataset.tomodachiNamePart] = String(input.value || '').replace(/\s+/g, ' ').trim();
                    });
                    return value;
                }

                if (field === 'tomodachiFullBirthday') {
                    const value = { birthMonth: '', birthday: '' };
                    inputs.forEach((input) => {
                        value[input.dataset.tomodachiBirthdayPart] = input.value || '';
                    });
                    return value;
                }

                if (field === 'tomodachiAgeGroup') {
                    return inputs.find(input => input.checked)?.value || '';
                }

                if (field === 'tomodachiPersonality') {
                    const value = {};
                    inputs.forEach((input) => {
                        value[input.dataset.tomodachiPersonalityPart] = Number.parseInt(input.value, 10);
                    });
                    return value;
                }

                const input = inputs[0];
                if (!input) {
                    if (showErrors) showAlert('Invalid Tomodachi Life field.', 5000, { title: 'Error', type: 'error' });
                    return '';
                }
                return String(input.value || '').replace(/\s+/g, ' ').trim();
            }

            function validateTomodachiInlineValue(field, value) {
                if (field === 'tomodachiFullName') {
                    if (String(value.firstName || '').length > 16 || String(value.lastName || '').length > 16) {
                        showAlert('First and last name must each be 16 characters or fewer.', 5000, { title: 'Error', type: 'error' });
                        return false;
                    }
                } else if (field === 'tomodachiFullBirthday') {
                    const hasMonth = String(value.birthMonth || '') !== '';
                    const hasDay = String(value.birthday || '') !== '';
                    if (hasMonth !== hasDay) {
                        showAlert('Birthday must include both month and day.', 5000, { title: 'Error', type: 'error' });
                        return false;
                    }
                } else if (field === 'tomodachiIslandName' && String(value || '').length > 9) {
                    showAlert('Island name must be 9 characters or fewer.', 5000, { title: 'Error', type: 'error' });
                    return false;
                } else if (field === 'tomodachiAgeGroup' && !['child', 'adult'].includes(value)) {
                    showAlert('Choose child or adult.', 5000, { title: 'Error', type: 'error' });
                    return false;
                } else if (field === 'tomodachiPersonality') {
                    const sliderValues = Object.values(value || {});
                    if (sliderValues.length !== 4 || sliderValues.some(part => !Number.isInteger(part) || part < 1 || part > 8)) {
                        showAlert('Personality sliders must be whole numbers from 1 to 8.', 5000, { title: 'Error', type: 'error' });
                        return false;
                    }
                } else if (field === 'tomodachiCatchphrase' && String(value || '').length > 16) {
                    showAlert('Catchphrase must be 16 characters or fewer.', 5000, { title: 'Error', type: 'error' });
                    return false;
                }

                return true;
            }

            function tomodachiValuesEqual(left, right) {
                return JSON.stringify(left) === JSON.stringify(right);
            }

            function applyTomodachiRows(rows) {
                if (!Array.isArray(rows)) return;

                rows.forEach((row) => {
                    if (row?.key === 'islandAddress') {
                        const addressDisplay = document.querySelector('[data-tomodachi-address-display]');
                        if (addressDisplay) addressDisplay.textContent = row.value || 'Not Set';
                    }

                    if (!row?.editField) return;
                    const display = getTomodachiInlineEditorElement(row.editField, 'display');
                    if (display) display.textContent = row.value || 'Not Set';
                    if (row.editField === 'tomodachiFullBirthday') {
                        const birthdayDisplay = document.querySelector('[data-mii-birthday-display]');
                        if (birthdayDisplay) birthdayDisplay.textContent = row.value || 'Not Set';
                    }
                });
            }

            function withUpdatedUrlVersion(url, version) {
                if (!url || !version) return url;
                try {
                    const parsed = new URL(url, window.location.origin);
                    parsed.searchParams.set('v', String(version));
                    return parsed.pathname + parsed.search + parsed.hash;
                } catch (error) {
                    const separator = url.includes('?') ? '&' : '?';
                    return `${url}${separator}v=${encodeURIComponent(version)}`;
                }
            }

            function refreshQrPreviewVersion(version) {
                if (!version) return;
                document.querySelectorAll('[data-qr-preview]').forEach((preview) => {
                    ['qr3dsSrc', 'qrWiiSrc', 'qrWiiuSrc', 'qrTomodachiSrc', 'qrMiitopiaSrc'].forEach((key) => {
                        if (preview.dataset[key]) {
                            preview.dataset[key] = withUpdatedUrlVersion(preview.dataset[key], version);
                        }
                    });
                    setQrPreviewConsole(preview, preview.querySelector('[data-qr-image]')?.dataset.qrConsole || preview.dataset.defaultQrConsole || '3DS');
                });
            }

            async function saveTomodachiInlineField(field) {
                if (!Object.prototype.hasOwnProperty.call(tomodachiMiiEditorState, field)) return;

                const nextValue = collectTomodachiInlineValue(field);
                if (!validateTomodachiInlineValue(field, nextValue)) return;

                if (tomodachiValuesEqual(nextValue, tomodachiMiiEditorState[field])) {
                    cancelTomodachiInlineEdit(field);
                    showAlert('No changes to save.', 2500, { title: 'Nothing to Save' });
                    return;
                }

                const button = getTomodachiInlineEditorElement(field, 'save');
                setSaveButtonBusy(button, true);
                try {
                    const result = await submitMiiFieldUpdate(field, nextValue);
                    if (result?.error) {
                        showAlert(`Error: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                        return;
                    }

                    tomodachiMiiEditorState[field] = cloneTomodachiEditorValue(nextValue);
                    const display = getTomodachiInlineEditorElement(field, 'display');
                    if (display) display.textContent = getTomodachiDisplayValue(field, nextValue);
                    applyTomodachiRows(result?.tomodachiRows);
                    refreshQrPreviewVersion(result?.qrVersion);
                    setTomodachiInlineEditorOpen(field, false);
                    showAlert('Saved.', 2500, { title: 'Success', type: 'success' });
                } catch (error) {
                    console.error('Error saving Tomodachi Life field:', error);
                    showAlert('Failed to save changes.', 6000, { title: 'Error', type: 'error' });
                } finally {
                    setSaveButtonBusy(button, false);
                }
            }

            async function saveInlineMiiField(field) {
                const config = getMiiMetadataEditConfig(field);
                const input = getInlineMiiEditorElement(field, 'input');
                const display = getInlineMiiEditorElement(field, 'display');
                const button = getInlineMiiEditorElement(field, 'save');

                if (!config || !input || !display) return;

                const nextValue = normalizeMiiMetadataEditorValue(field, input.value);
                if (!validateMiiMetadataEditorValue(field, nextValue)) return;

                if (nextValue === inlineMiiEditorState[field]) {
                    cancelInlineMiiEdit(field);
                    showAlert('No changes to save.', 2500, { title: 'Nothing to Save' });
                    return;
                }

                setSaveButtonBusy(button, true);
                try {
                    const result = await submitMiiFieldUpdate(config.endpointField, nextValue);
                    if (result?.error) {
                        showAlert(`Error: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                        return;
                    }

                    inlineMiiEditorState[field] = nextValue;
                    display.textContent = nextValue || config.fallback;
                    input.value = nextValue;
                    setInlineMiiEditorOpen(field, false);
                    showAlert('Saved.', 2500, { title: 'Success', type: 'success' });
                } catch (error) {
                    console.error('Error saving Mii field:', error);
                    showAlert('Failed to save changes.', 6000, { title: 'Error', type: 'error' });
                } finally {
                    setSaveButtonBusy(button, false);
                }
            }

            function initializeInlineMiiEditors() {
                document.querySelectorAll('[data-inline-edit-input]').forEach((input) => {
                    const field = input.dataset.inlineEditInput;
                    input.addEventListener('keydown', (event) => {
                        if (event.key === 'Escape') {
                            event.preventDefault();
                            cancelInlineMiiEdit(field);
                            return;
                        }

                        if (event.key === 'Enter' && field !== 'desc') {
                            event.preventDefault();
                            saveInlineMiiField(field);
                        }
                    });
                });

                document.querySelectorAll('[data-tomodachi-edit-input]').forEach((input) => {
                    const field = input.dataset.tomodachiEditInput;
                    input.addEventListener('keydown', (event) => {
                        if (event.key === 'Escape') {
                            event.preventDefault();
                            cancelTomodachiInlineEdit(field);
                            return;
                        }

                        if (event.key === 'Enter' && input.type !== 'range') {
                            event.preventDefault();
                            saveTomodachiInlineField(field);
                        }
                    });

                    if (input.dataset.tomodachiPersonalityPart) {
                        input.addEventListener('input', () => setTomodachiPersonalityOutputs(field));
                    }
                });
            }

            async function saveStagedEditorChanges(changes, button, title = 'Save Changes') {
                if (changes.length === 0) {
                    showAlert('No changes to save.', 3000, { title: 'Nothing to Save' });
                    return;
                }

                showConfirm(`Save ${changes.length} change${changes.length === 1 ? '' : 's'}?`, async () => {
                    setSaveButtonBusy(button, true);
                    try {
                        for (const change of changes) {
                            const result = await change.run();
                            if (result?.error) {
                                showAlert(`Error saving ${change.label}: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                                return;
                            }
                        }

                        showAlert('Changes saved successfully!', 3000, { title: 'Success', type: 'success' });
                        setTimeout(() => location.reload(), 1500);
                    } catch (error) {
                        console.error('Error saving changes:', error);
                        showAlert('Failed to save changes. Some updates may not have been applied.', 6000, { title: 'Error', type: 'error' });
                    } finally {
                        setSaveButtonBusy(button, false);
                    }
                }, null, { title, confirmText: 'Save' });
            }

            async function submitMiiTagsUpdate(tags) {
                const response = await fetch('/updateMiiTags', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        miiId: '<%= mii.id %>',
                        tags
                    })
                });

                return await response.json();
            }

            async function submitOfficialStatusUpdate(official) {
                const response = await fetch('/toggleMiiOfficial', {
                    method: 'POST',
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        id: '<%= mii.id %>',
                        official
                    })
                });

                return await response.json();
            }

            function validateEditorValue(value, label) {
                if (String(value ?? '').trim() !== '') return true;
                showAlert(`Please enter a valid ${label}.`, 5000, { title: 'Error', type: 'error' });
                return false;
            }

            async function saveModeratorEdits() {
                const button = document.getElementById('saveModeratorEditsButton');
                const changes = [];

                const uploaderInput = document.getElementById('editUploader');
                const uploader = uploaderInput?.value ?? '';
                if (uploaderInput && uploader !== originalMiiEditorState.uploader) {
                    if (!validateEditorValue(uploader, 'uploader')) return;
                    changes.push({
                        label: 'uploader',
                        run: () => submitMiiFieldUpdate('uploader', uploader)
                    });
                }

                const userEditLockCheckbox = document.getElementById('userEditLockCheckbox');
                if (userEditLockCheckbox && userEditLockCheckbox.checked !== originalMiiEditorState.lockedFromUserEdits) {
                    changes.push({
                        label: 'uploader edit lock',
                        run: () => submitMiiFieldUpdate('lockedFromUserEdits', userEditLockCheckbox.checked)
                    });
                }

                const tags = Array.from(selectedMiiTags);
                if (!arraysEqualAsSets(tags, originalMiiEditorState.tags)) {
                    changes.push({
                        label: 'tags',
                        run: () => submitMiiTagsUpdate(tags)
                    });
                }

                const categories = Array.from(selectedPaths);
                if (!arraysEqualAsSets(categories, originalMiiEditorState.categories) && document.querySelector('.category-trigger-summary')) {
                    changes.push({
                        label: 'official categories',
                        run: () => updateCategories(categories)
                    });
                }

                const officialCheckbox = document.getElementById('officialCheckbox');
                if (officialCheckbox && officialCheckbox.checked !== originalMiiEditorState.official) {
                    changes.push({
                        label: 'official status',
                        run: () => submitOfficialStatusUpdate(officialCheckbox.checked)
                    });
                }

                await saveStagedEditorChanges(changes, button, 'Save Moderator Changes');
            }

            async function saveOfficialEditorChanges() {
                const button = document.getElementById('saveOfficialEditorButton');
                const changes = [];

                const name = normalizeMiiMetadataEditorValue('name', document.getElementById('researcherEditMiiName')?.value ?? '');
                if (name !== originalMiiEditorState.name) {
                    if (!validateMiiMetadataEditorValue('name', name)) return;
                    changes.push({
                        label: 'name',
                        run: () => submitMiiFieldUpdate('name', name)
                    });
                }

                const desc = normalizeMiiMetadataEditorValue('desc', document.getElementById('researcherEditDesc')?.value ?? '');
                if (desc !== originalMiiEditorState.desc) {
                    if (!validateMiiMetadataEditorValue('desc', desc)) return;
                    changes.push({
                        label: 'description',
                        run: () => submitMiiFieldUpdate('desc', desc)
                    });
                }

                const creatorName = normalizeMiiMetadataEditorValue('creatorName', document.getElementById('researcherEditCreatorName')?.value ?? '');
                if (creatorName !== originalMiiEditorState.creatorName) {
                    if (!validateMiiMetadataEditorValue('creatorName', creatorName)) return;
                    changes.push({
                        label: 'creator name',
                        run: () => submitMiiFieldUpdate('creatorName', creatorName)
                    });
                }

                const categories = Array.from(selectedPaths);
                if (!arraysEqualAsSets(categories, originalMiiEditorState.categories)) {
                    changes.push({
                        label: 'official categories',
                        run: () => updateCategories(categories)
                    });
                }

                await saveStagedEditorChanges(changes, button, 'Save Changes');
            }

            let relatedMiiGridLayoutFrame = 0;
            let relatedMiiGridResizeObserver = null;

            function updateRelatedMiiGridSingleRow() {
                const relatedGrids = document.querySelectorAll('.related-mii-grid');
                if (relatedGrids.length === 0) return;

                relatedGrids.forEach((grid) => {
                    const cards = Array.from(grid.children).filter((child) => child.classList.contains('related-mii-card'));
                    if (cards.length === 0) return;

                    cards.forEach((card) => {
                        card.hidden = false;
                    });

                    const firstRowTop = cards[0].offsetTop;
                    cards.forEach((card) => {
                        if (card.offsetTop > firstRowTop + 1) {
                            card.hidden = true;
                        }
                    });
                });
            }

            function scheduleRelatedMiiGridSingleRowUpdate() {
                if (relatedMiiGridLayoutFrame) {
                    cancelAnimationFrame(relatedMiiGridLayoutFrame);
                }

                relatedMiiGridLayoutFrame = requestAnimationFrame(() => {
                    relatedMiiGridLayoutFrame = 0;
                    updateRelatedMiiGridSingleRow();
                });
            }

            function initializeMiiPageEditorState() {
                initializeInlineMiiEditors();
                updateCategoryEditorTriggers();
                updateTagEditorTriggers();
                updateOfficialCheckboxLabel();
                try {
                    initializeQrPreviewTabs();
                } catch (error) {
                    console.error('Error initializing QR preview tabs:', error);
                }

                try {
                    initializeMiiExportPicker();
                } catch (error) {
                    console.error('Error initializing export picker:', error);
                }
                const officialCheckbox = document.getElementById('officialCheckbox');
                officialCheckbox?.addEventListener('change', updateOfficialCheckboxLabel);

                const hasRelatedMiiGrid = Boolean(document.querySelector('.related-mii-grid'));
                if (!hasRelatedMiiGrid) {
                    return;
                }

                scheduleRelatedMiiGridSingleRowUpdate();
                window.addEventListener('resize', scheduleRelatedMiiGridSingleRowUpdate, { passive: true });
                window.addEventListener('load', scheduleRelatedMiiGridSingleRowUpdate, { once: true });

                if (typeof ResizeObserver === 'function' && !relatedMiiGridResizeObserver) {
                    relatedMiiGridResizeObserver = new ResizeObserver(() => {
                        scheduleRelatedMiiGridSingleRowUpdate();
                    });

                    document.querySelectorAll('.related-mii-grid').forEach((grid) => {
                        relatedMiiGridResizeObserver.observe(grid);
                    });
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initializeMiiPageEditorState);
            } else {
                initializeMiiPageEditorState();
            }
        </script>

        <!--Moderator Tools Functions - Because EJS runs server side, and the client only sees the result of the compilation, this prevents unnecessary JS from loading that doesn't need to be sent-->
        <% if (isModerator) { %>
            <script>
                async function submitMiiIdChange(payload, button, successMessage) {
                    const targetButton = button instanceof HTMLElement
                        ? button
                        : document.getElementById('headerRegenerateMiiIdButton');

                    setSaveButtonBusy(targetButton, true);

                    try {
                        const response = await fetch('/changeMiiId', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                miiId: '<%= mii.id %>',
                                ...payload
                            })
                        });
                        const result = await response.json();

                        if (result.error) {
                            showAlert(`Error: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                            return;
                        }

                        showAlert(`${successMessage} New ID: ${result.newId}`, 3500, { title: 'Success', type: 'success' });
                        const redirectTarget = typeof getSafeClientRedirectTarget === 'function'
                            ? getSafeClientRedirectTarget(result.redirect, `/mii/${encodeURIComponent(result.newId || '')}`)
                            : (result.redirect || `/mii/${encodeURIComponent(result.newId || '')}`);

                        setTimeout(() => {
                            window.location.href = redirectTarget;
                        }, 1200);
                    } catch (error) {
                        console.error('Error changing Mii ID:', error);
                        showAlert('Failed to change Mii ID', 6000, { title: 'Error', type: 'error' });
                    } finally {
                        setSaveButtonBusy(targetButton, false);
                    }
                }

                async function regenerateMiiId(button = null) {
                    showConfirm(
                        'Generate a brand new ID for this Mii? Every stored reference will be updated automatically.',
                        async () => {
                            await submitMiiIdChange({}, button, 'Mii ID regenerated.');
                        },
                        null,
                        { title: 'Generate New Mii ID', confirmText: 'Generate' }
                    );
                }

                async function setMiiIdDirectly() {
                    const input = document.getElementById('directMiiIdInput');
                    const button = document.getElementById('setMiiIdButton');
                    const newId = (input?.value || '').trim();

                    if (!newId) {
                        showAlert('Enter a new Mii ID first.', 5000, { title: 'Error', type: 'error' });
                        return;
                    }
                    if (!/^[A-Za-z0-9]{1,10}$/.test(newId)) {
                        showAlert('Mii IDs must be alphanumeric and 10 characters or fewer.', 5000, { title: 'Error', type: 'error' });
                        return;
                    }
                    if (newId === '<%= mii.id %>') {
                        showAlert('That is already the current Mii ID.', 4000, { title: 'Notice' });
                        return;
                    }

                    showConfirm(
                        `Set this Mii ID to "${newId}"? Every stored reference will be updated automatically.`,
                        async () => {
                            await submitMiiIdChange({ newId }, button, 'Mii ID updated.');
                        },
                        null,
                        { title: 'Set Mii ID', confirmText: 'Set ID' }
                    );
                }

                async function blockMiiFromPublishing() {
                    const reason = prompt('Enter reason for blocking (optional):');
                    if (reason === null) return; // User cancelled
                    
                    try {
                        const response = await fetch('/blockMiiFromPublishing', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                miiId: '<%= mii.id %>',
                                reason: reason 
                            })
                        });
                        
                        const result = await response.json();
                        if (!result.error) {
                            showAlert('Mii blocked from publishing', 3000, { title: 'Success', type: 'success' });
                            setTimeout(() => location.reload(), 3000);
                        } else {
                            showAlert('Error: ' + (result.error || 'Failed to block Mii'), 5000, { title: 'Error', type: 'error' });
                        }
                    } catch (error) {
                        showAlert('Error blocking Mii', 5000, { title: 'Error', type: 'error' });
                    }
                }
                
                async function unblockMiiFromPublishing() {
                    showConfirm('Unblock this Mii from publishing?', async () => {
                        try {
                            const response = await fetch('/unblockMiiFromPublishing', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ miiId: '<%= mii.id %>' })
                            });
                            
                            const result = await response.json();
                            if (!result.error) {
                                showAlert('Mii unblocked', 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            } else {
                                showAlert('Error: ' + (result.error || 'Failed to unblock Mii'), 5000, { title: 'Error', type: 'error' });
                            }
                        } catch (error) {
                            showAlert('Error unblocking Mii', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Unblock Mii', confirmText: 'Unblock' });
                }
                <% if (miiPageQrExportsEnabled) { %>
                async function regenerateQR() {
                    showConfirm('Are you sure you want to regenerate the QR code?', async () => {
                        const statusEl = document.getElementById('qrStatus');
                        const qrConsole = document.getElementById('regenQrConsole')?.value || '3DS';
                        statusEl.textContent = 'Regenerating...';
                        statusEl.style.color = '#FFA500';

                        try {
                            const response = await fetch('/regenerateQR', {
                                method: "POST",
                                body: JSON.stringify({ id: "<%= mii.id %>", qrConsole }),
                                headers: { "Content-Type": "application/json" },
                            });
                            const result = await response.json();
                            
                            if (!result.error) {
                                statusEl.textContent = '✓ Done!';
                                statusEl.style.color = '#4CAF50';
                                setTimeout(() => {
                                    location.reload();
                                }, 1000);
                            }
                            else {
                                statusEl.textContent = `Error: ${result.error}`;
                                statusEl.style.color = '#f44336';
                                if (typeof window.scrollToUserError === 'function') {
                                    window.scrollToUserError(statusEl, { force: true });
                                }
                            }
                        }
                        catch (error) {
                            console.error('Error:', error);
                            statusEl.textContent = '✗ Failed';
                            statusEl.style.color = '#f44336';
                            if (typeof window.scrollToUserError === 'function') {
                                window.scrollToUserError(statusEl, { force: true });
                            }
                        }
                    }, null, { title: 'Regenerate QR Code', confirmText: 'Regenerate' });
                }
                <% } %>

                async function regenerateRender() {
                    showConfirm('Are you sure you want to regenerate the render image?', async () => {
                        const statusEl = document.getElementById('renderStatus');
                        statusEl.textContent = 'Regenerating...';
                        statusEl.style.color = '#FFA500';

                        try {
                            const response = await fetch('/regenerateRender', {
                                method: "POST",
                                body: JSON.stringify({ id: "<%= mii.id %>" }),
                                headers: { "Content-Type": "application/json" },
                            });
