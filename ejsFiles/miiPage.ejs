        <%- include('footer') %>

        <!--Due to needing access to EJS variables, we unfortunately cannot move these contents to a dedicated JS file-->
        <script>
            function copyMiiId(el, id){
                const labelEl = el?.querySelector?.('.copy-label') || el;
                const originalText = labelEl?.textContent || '';

                navigator.clipboard.writeText(id).then(() => {
                    if (labelEl) {
                        labelEl.textContent = '✓ Copied!';
                        setTimeout(() => {
                            labelEl.textContent = originalText;
                        }, 2000);
                    }
                }).catch(() => {
                    if (labelEl && typeof showAlert === 'function') {
                        showAlert('Failed to copy Mii ID', 4000, { title: 'Error', type: 'error' });
                    }
                });
            }
            function report(){
                var what=prompt("What would you like to report this Mii for?");
                fetch("/reportMii", {
                    method: "POST",
                    body: JSON.stringify({
                        id: "<%= mii.id %>",
                        what: what
                    }),
                    headers: { "Content-Type": "application/json" },
                });
            }
            async function publishThisMii() {
                showConfirm('Are you sure you want to publish this Mii? It will become visible to everyone.', async () => {
                    try {
                        const response = await fetch('/publishMii', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ miiId: '<%= mii.id %>' })
                        });
                        const result = await response.json();

                        if (!result.error) {
                            showAlert('Mii published successfully!', 3000, { title: 'Success', type: 'success' });
                            setTimeout(() => location.reload(), 3000);
                        } else {
                            showAlert(`Error: ${result.error || 'Failed to publish Mii'}`, 5000, { title: 'Error', type: 'error' });
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        showAlert('Error publishing Mii', 5000, { title: 'Error', type: 'error' });
                    }
                }, null, { title: 'Publish Mii', confirmText: 'Publish' });
            }
            async function openMiiInstructions(event) {
                event.preventDefault();
                if (typeof showMiiInstructionsModal !== 'function') {
                    if (typeof showAlert === 'function') {
                        showAlert('Instructions modal is unavailable on this page.', 4000, { title: 'Error', type: 'error' });
                    }
                    return;
                }

                showMiiInstructionsModal(async ({ consoleType }) => {
                    const response = await fetch(`/getInstructions?id=<%= mii.id %>&console=${encodeURIComponent(consoleType)}`, {
                        headers: { "Content-Type": "application/json" },
                    });
                    return await response.json();
                }, {
                    title: "Recreation Instructions",
                    defaultConsole: "3DS",
                    miiName: <%- JSON.stringify(mii.meta.name || "Mii") %>
                });
            }

            async function copyMiiExportText(formId, encoding) {
                const form = document.getElementById(formId);
                if (!form) return;
                const normalizedEncoding = String(encoding || '').trim().toLowerCase();
                if (normalizedEncoding === 'base64') {
                    await copyExportBase64FromForm(form);
                    return;
                }
                await copyExportHexFromForm(form);
            }

            function toggleOfficialEditorTools() {
                const content = document.getElementById('officialEditorToolsContent');
                const arrow = document.getElementById('officialEditorToolsArrow');
                if (!content || !arrow) return;

                content.classList.toggle('expanded');
                arrow.classList.toggle('rotated');
            }

            async function updateMiiField(field, value) {
                if (!value || value.trim() === '') {
                    showAlert('Please enter a valid value', 5000, { title: 'Error', type: 'error' });
                    return;
                }

                showConfirm(`Are you sure you want to update the ${field}?`, async () => {
                    try {
                        const response = await fetch('/updateMiiField', {
                            method: 'POST',
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                id: '<%= mii.id %>',
                                field: field,
                                value: value
                            })
                        });

                        const result = await response.json();

                        if (!result.error) {
                            showAlert(`Successfully updated ${field}!`, 3000, { title: 'Success', type: 'success' });
                            setTimeout(() => location.reload(), 3000);
                        }
                        else {
                            showAlert(`Error: ${result.error || 'Unknown error'}`, 5000, { title: 'Error', type: 'error' });
                        }
                    }
                    catch (error) {
                        console.error('Error:', error);
                        showAlert('Failed to update. Please try again.', 5000, { title: 'Error', type: 'error' });
                    }
                }, null, { title: 'Update Field', confirmText: 'Update' });
            }
        </script>

        <!--Moderator Tools Functions - Because EJS runs server side, and the client only sees the result of the compilation, this prevents unnecessary JS from loading that doesn't need to be sent-->
        <% if (isModerator) { %>
            <script>
                async function blockMiiFromPublishing() {
                    const reason = prompt('Enter reason for blocking (optional):');
                    if (reason === null) return; // User cancelled
                    
                    try {
                        const response = await fetch('/blockMiiFromPublishing', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                miiId: '<%= mii.id %>',
                                reason: reason 
                            })
                        });
                        
                        const result = await response.json();
                        if (!result.error) {
                            showAlert('Mii blocked from publishing', 3000, { title: 'Success', type: 'success' });
                            setTimeout(() => location.reload(), 3000);
                        } else {
                            showAlert('Error: ' + (result.error || 'Failed to block Mii'), 5000, { title: 'Error', type: 'error' });
                        }
                    } catch (error) {
                        showAlert('Error blocking Mii', 5000, { title: 'Error', type: 'error' });
                    }
                }
                
                async function unblockMiiFromPublishing() {
                    showConfirm('Unblock this Mii from publishing?', async () => {
                        try {
                            const response = await fetch('/unblockMiiFromPublishing', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ miiId: '<%= mii.id %>' })
                            });
                            
                            const result = await response.json();
                            if (!result.error) {
                                showAlert('Mii unblocked', 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            } else {
                                showAlert('Error: ' + (result.error || 'Failed to unblock Mii'), 5000, { title: 'Error', type: 'error' });
                            }
                        } catch (error) {
                            showAlert('Error unblocking Mii', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Unblock Mii', confirmText: 'Unblock' });
                }
                function toggleModTools() {
                    const content = document.getElementById('modToolsContent');
                    const arrow = document.getElementById('modToolsArrow');
                    
                    content.classList.toggle('expanded');
                    arrow.classList.toggle('rotated');
                }

                function renderModMiiTagList() {
                    const container = document.getElementById('modMiiTagList');
                    if (!container) return;

                    container.innerHTML = '';

                    if (!Array.isArray(availableMiiTags) || availableMiiTags.length === 0) {
                        const emptyState = document.createElement('p');
                        emptyState.className = 'mod-tag-empty';
                        emptyState.innerHTML = 'No tags created yet. <a href="/search">Create tags on the Search page</a>.';
                        container.appendChild(emptyState);
                        return;
                    }

                    availableMiiTags.forEach((tag) => {
                        const label = document.createElement('label');
                        label.className = 'mod-tag-option';

                        const checkbox = document.createElement('input');
                        checkbox.type = 'checkbox';
                        checkbox.value = tag;
                        checkbox.checked = selectedMiiTags.has(tag);
                        checkbox.addEventListener('change', (event) => {
                            if (event.target.checked) {
                                selectedMiiTags.add(tag);
                            } else {
                                selectedMiiTags.delete(tag);
                            }
                        });

                        const text = document.createElement('span');
                        text.textContent = tag;

                        label.appendChild(checkbox);
                        label.appendChild(text);
                        container.appendChild(label);
                    });
                }

                async function saveMiiTags() {
                    if (!Array.isArray(availableMiiTags) || availableMiiTags.length === 0) {
                        showAlert('Create at least one tag on the Search page first.', 5000, { title: 'Error', type: 'error' });
                        return;
                    }

                    const tags = Array.from(selectedMiiTags);

                    showConfirm('Update tags for this Mii?', async () => {
                        try {
                            const response = await fetch('/updateMiiTags', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    miiId: '<%= mii.id %>',
                                    tags
                                })
                            });

                            const result = await response.json();
                            if (!result.error) {
                                showAlert('Tags updated successfully!', 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            } else {
                                showAlert(`Error: ${result.error || 'Failed to update tags'}`, 5000, { title: 'Error', type: 'error' });
                            }
                        } catch (error) {
                            console.error('Error updating tags:', error);
                            showAlert('Failed to update tags', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Update Mii Tags', confirmText: 'Update' });
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', renderModMiiTagList);
                } else {
                    renderModMiiTagList();
                }

                async function regenerateQR() {
                    showConfirm('Are you sure you want to regenerate the QR code?', async () => {
                        const statusEl = document.getElementById('qrStatus');
                        const qrConsole = document.getElementById('regenQrConsole')?.value || '3DS';
                        statusEl.textContent = 'Regenerating...';
                        statusEl.style.color = '#FFA500';

                        try {
                            const response = await fetch('/regenerateQR', {
                                method: "POST",
                                body: JSON.stringify({ id: "<%= mii.id %>", qrConsole }),
                                headers: { "Content-Type": "application/json" },
                            });
                            const result = await response.json();
                            
                            if (!result.error) {
                                statusEl.textContent = '✓ Done!';
                                statusEl.style.color = '#4CAF50';
                                setTimeout(() => {
                                    location.reload();
                                }, 1000);
                            }
                            else {
                                statusEl.textContent = `Error: ${result.error}`;
                                statusEl.style.color = '#f44336';
                            }
                        }
                        catch (error) {
                            console.error('Error:', error);
                            statusEl.textContent = '✗ Failed';
                            statusEl.style.color = '#f44336';
                        }
                    }, null, { title: 'Regenerate QR Code', confirmText: 'Regenerate' });
                }

                async function confirmDeleteMii() {
                    const miiName = '<%= mii.meta.name %>';
                    showConfirm(`Are you ABSOLUTELY SURE you want to DELETE the Mii "${miiName}"?\n\nThis action CANNOT be undone!`, () => {
                        const doubleCheck = prompt(`Type "DELETE" to confirm deletion of ${miiName}:`);
                        if (doubleCheck !== 'DELETE') {
                            showAlert('Deletion cancelled.', 3000, { title: 'Cancelled' });
                            return;
                        }

                        (async () => {
                            try {
                                const response = await fetch('/deleteMii', {
                                    method: 'POST',
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ id: '<%= mii.id %>' })
                                });
                                const result = await response.json();
                                
                                if (!result.error) {
                                    showAlert('Mii deleted successfully', 2000, { title: 'Success', type: 'success' });
                                    setTimeout(() => window.location.href = result.redirect || '/', 2000);
                                }
                                else {
                                    showAlert('Error deleting Mii', 5000, { title: 'Error', type: 'error' });
                                }
                            }
                            catch (error) {
                                console.error('Error:', error);
                                showAlert('Failed to delete Mii', 5000, { title: 'Error', type: 'error' });
                            }
                        })();
                    }, null, { title: 'Delete Mii', confirmText: 'Continue' });
                }

                async function toggleOfficial() {
                    const isOfficial = document.getElementById('officialCheckbox').checked;
                    
                    showConfirm(`Are you sure you want to mark this Mii as ${isOfficial ? 'OFFICIAL' : 'NOT OFFICIAL'}?\n\nOfficial Miis are shown with a special badge.`, async () => {
                        try {
                            const response = await fetch('/toggleMiiOfficial', {
                                method: 'POST',
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    id: '<%= mii.id %>',
                                    official: isOfficial
                                })
                            });

                            const result = await response.json();
                            
                            if (!result.error) {
                                showAlert(`Mii official status updated!`, 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            }
                            else {
                                showAlert(`Error: ${result.error || 'Unknown error'}`, 5000, { title: 'Error', type: 'error' });
                            }
                        } 
                        catch (error) {
                            console.error('Error:', error);
                            showAlert('Failed to update official status', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Toggle Official Status', confirmText: 'Update' });
            }
            </script>
        <% } %>
    </body>
</html>
