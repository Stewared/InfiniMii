                function renderModMiiTagList() {
                    const container = document.getElementById('modMiiTagList');
                    if (!container) return;

                    container.innerHTML = '';

                    if (!Array.isArray(availableMiiTags) || availableMiiTags.length === 0) {
                        const emptyState = document.createElement('p');
                        emptyState.className = 'mod-tag-empty';
                        emptyState.innerHTML = 'No tags created yet. <a href="/search">Create tags on the Search page</a>.';
                        container.appendChild(emptyState);
                        return;
                    }

                    availableMiiTags.forEach((tag) => {
                        const label = document.createElement('label');
                        label.className = 'mod-tag-option';

                        const checkbox = document.createElement('input');
                        checkbox.type = 'checkbox';
                        checkbox.value = tag;
                        checkbox.checked = selectedMiiTags.has(tag);
                        checkbox.addEventListener('change', (event) => {
                            if (event.target.checked) {
                                selectedMiiTags.add(tag);
                            } else {
                                selectedMiiTags.delete(tag);
                            }
                        });

                        const text = document.createElement('span');
                        text.textContent = tag;

                        label.appendChild(checkbox);
                        label.appendChild(text);
                        container.appendChild(label);
                    });
                }

