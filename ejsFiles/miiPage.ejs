                            if (!result.error) {
                                statusEl.textContent = '✓ Done!';
                                statusEl.style.color = '#4CAF50';
                                setTimeout(() => {
                                    location.reload();
                                }, 1000);
                            }
                            else {
                                statusEl.textContent = `Error: ${result.error}`;
                                statusEl.style.color = '#f44336';
                                if (typeof window.scrollToUserError === 'function') {
                                    window.scrollToUserError(statusEl, { force: true });
                                }
                            }
                        }
                        catch (error) {
                            console.error('Error:', error);
                            statusEl.textContent = '✗ Failed';
                            statusEl.style.color = '#f44336';
                            if (typeof window.scrollToUserError === 'function') {
                                window.scrollToUserError(statusEl, { force: true });
                            }
                        }
                    }, null, { title: 'Regenerate Render', confirmText: 'Regenerate' });
                }

                async function clearMiiTlData() {
                    const button = document.getElementById('clearTlDataButton');
                    showConfirm(
                        'Clear stored Tomodachi Life data for this Mii? This also removes the Tomodachi Life tag and regenerates QR previews.',
                        async () => {
                            setSaveButtonBusy(button, true);
                            try {
                                const response = await fetch('/clearMiiTlData', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ id: '<%= mii.id %>' })
                                });
                                const result = await response.json();

                                if (result.error) {
                                    showAlert(`Error: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                                    return;
                                }

                                showAlert(
                                    result.unchanged ? 'No Tomodachi Life data was stored for this Mii.' : 'Tomodachi Life data cleared.',
                                    3000,
                                    { title: result.unchanged ? 'No Changes' : 'Success', type: result.unchanged ? 'info' : 'success' }
                                );
                                setTimeout(() => location.reload(), 1000);
                            } catch (error) {
                                console.error('Error clearing TL data:', error);
                                showAlert('Failed to clear Tomodachi Life data', 6000, { title: 'Error', type: 'error' });
                            } finally {
                                setSaveButtonBusy(button, false);
                            }
                        },
                        null,
                        { title: 'Clear TL Data', confirmText: 'Clear TL Data' }
                    );
                }

                async function confirmDeleteMii() {
                    const miiName = <%- toScriptJson(mii.meta.name || "") %>;
                    showConfirm(`Are you ABSOLUTELY SURE you want to DELETE the Mii "${miiName}"?\n\nThis action CANNOT be undone!`, () => {
                        const doubleCheck = prompt(`Type "DELETE" to confirm deletion of ${miiName}:`);
                        if (doubleCheck !== 'DELETE') {
                            showAlert('Deletion cancelled.', 3000, { title: 'Cancelled' });
                            return;
                        }

                        (async () => {
                            try {
                                const response = await fetch('/deleteMii', {
                                    method: 'POST',
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ id: '<%= mii.id %>' })
                                });
                                const result = await response.json();
                                
                                if (!result.error) {
                                    showAlert('Mii deleted successfully', 2000, { title: 'Success', type: 'success' });
                                    setTimeout(() => window.location.href = result.redirect || '/', 2000);
                                }
                                else {
                                    showAlert('Error deleting Mii', 5000, { title: 'Error', type: 'error' });
                                }
                            }
                            catch (error) {
                                console.error('Error:', error);
                                showAlert('Failed to delete Mii', 5000, { title: 'Error', type: 'error' });
                            }
                        })();
                    }, null, { title: 'Delete Mii', confirmText: 'Continue' });
                }

            </script>
        <% } %>
    </body>
