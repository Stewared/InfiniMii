        <script src="/js/miiExportPicker.js"></script>

        <!--Due to needing access to EJS variables, we unfortunately cannot move these contents to a dedicated JS file-->
        <script>
            function copyMiiId(el, id){
                const labelEl = el?.querySelector?.('.copy-label') || el;
                const originalText = labelEl?.textContent || '';

                navigator.clipboard.writeText(id).then(() => {
                    if (labelEl) {
                        labelEl.textContent = '✓ Copied!';
                        setTimeout(() => {
                            labelEl.textContent = originalText;
                        }, 2000);
                    }
                }).catch(() => {
                    if (labelEl && typeof showAlert === 'function') {
                        showAlert('Failed to copy Mii ID', 4000, { title: 'Error', type: 'error' });
                    }
                });
            }
            function openReportProblemModal(event, triggerButton = null) {
                event?.preventDefault?.();

                if (typeof createModalOverlay !== 'function' || typeof closeModal !== 'function') {
                    showAlert('Report modal is unavailable on this page.', 4000, { title: 'Error', type: 'error' });
                    return;
                }

                const overlay = createModalOverlay();
                overlay.className = 'custom-modal-overlay custom-modal-report';

                const restoreFocusTarget = triggerButton instanceof HTMLElement
                    ? triggerButton
                    : (document.activeElement instanceof HTMLElement ? document.activeElement : null);

                const modal = document.createElement('div');
                modal.className = 'custom-modal report-problem-modal';
                modal.setAttribute('role', 'dialog');
                modal.setAttribute('aria-modal', 'true');
                modal.setAttribute('aria-labelledby', 'reportProblemTitle');

                const header = document.createElement('div');
                header.className = 'custom-modal-header';
                header.innerHTML = `
                    <h3 id="reportProblemTitle">Report Problem</h3>
                    <button class="custom-modal-close" aria-label="Close">&times;</button>
                `;

                const body = document.createElement('div');
                body.className = 'custom-modal-body report-modal-body';
                body.innerHTML = `
                    <p class="report-modal-intro">Tell us what is wrong with <strong>${escapeHtml(reportProblemContext.miiName)}</strong>. Reports go straight to the InfiniMii admins.</p>
                    <div class="report-modal-support" id="reportProblemSupport">
                        <div class="report-modal-support-copy">
                            <p class="report-modal-support-title">Need faster follow-up?</p>
                            <p>You can also bring the issue to the team in Discord.</p>
                        </div>
                        <a class="btn-secondary report-modal-discord-link" id="reportProblemDiscordLink" target="_blank" rel="noopener noreferrer">Join Discord</a>
                    </div>
                    <form id="reportProblemForm" class="report-modal-form">
                        <label class="report-modal-field" for="reportProblemCategory">
                            <span>Issue Category</span>
                            <select id="reportProblemCategory" name="category" required>
                                <option value="">Select a category</option>
                                ${reportMiiCategories.map((category) => `<option value="${escapeHtml(category)}">${escapeHtml(category)}</option>`).join('')}
                            </select>
                        </label>
                        <label class="report-modal-field" for="reportProblemEmail">
                            <span>Email</span>
                            <input
                                id="reportProblemEmail"
                                name="email"
                                type="email"
                                autocomplete="email"
                                placeholder="Optional email for follow-up"
                            >
                            <small>Email is optional, but it allows InfiniMii to follow up with you.</small>
                        </label>
                        <label class="report-modal-field" for="reportProblemDetails">
                            <span>Extra Details</span>
                            <textarea
                                id="reportProblemDetails"
                                name="details"
                                rows="7"
                                maxlength="4000"
                                required
                                placeholder="Please explain what is wrong with this Mii."
                            ></textarea>
                            <small>This box is required so the admins know what to look for.</small>
                        </label>
                    </form>
                    <p class="report-modal-status" id="reportProblemStatus" hidden></p>
                `;

                const footer = document.createElement('div');
                footer.className = 'custom-modal-footer';
                footer.innerHTML = `
                    <button type="button" class="custom-modal-btn custom-modal-btn-secondary" data-action="cancel">Cancel</button>
                    <button type="submit" class="custom-modal-btn custom-modal-btn-primary report-modal-submit" data-action="submit" form="reportProblemForm">Send Report</button>
                `;

                modal.appendChild(header);
                modal.appendChild(body);
                modal.appendChild(footer);
                overlay.innerHTML = '';
                overlay.appendChild(modal);

                const closeBtn = modal.querySelector('.custom-modal-close');
                const cancelBtn = modal.querySelector('[data-action="cancel"]');
                const submitBtn = modal.querySelector('[data-action="submit"]');
                const form = modal.querySelector('#reportProblemForm');
                const supportPanel = modal.querySelector('#reportProblemSupport');
                const discordLink = modal.querySelector('#reportProblemDiscordLink');
                const categorySelect = modal.querySelector('#reportProblemCategory');
                const emailInput = modal.querySelector('#reportProblemEmail');
                const detailsInput = modal.querySelector('#reportProblemDetails');
                const statusEl = modal.querySelector('#reportProblemStatus');

                let isSubmitting = false;

                if (discordLink && reportProblemContext.discordInvite) {
                    discordLink.href = reportProblemContext.discordInvite;
                } else if (supportPanel) {
                    supportPanel.hidden = true;
                }

                const syncDetailsValidity = () => {
                    const hasDetails = Boolean(detailsInput?.value?.trim());
                    if (detailsInput) {
                        detailsInput.setCustomValidity(hasDetails ? '' : 'Please include extra details about the issue.');
                    }
                    return hasDetails;
                };

                const setStatus = (message = '', type = 'info') => {
                    if (!statusEl) return;
                    statusEl.textContent = message;
                    statusEl.hidden = !message;
                    statusEl.dataset.type = message ? type : '';
                };

                const setSubmitting = (nextSubmitting) => {
                    isSubmitting = Boolean(nextSubmitting);
                    const hasDetails = syncDetailsValidity();

                    if (submitBtn) {
                        submitBtn.disabled = isSubmitting || !hasDetails;
                        submitBtn.textContent = isSubmitting ? 'Sending...' : 'Send Report';
                    }

                    [closeBtn, cancelBtn, categorySelect, emailInput, detailsInput].forEach((element) => {
                        if (element) {
                            element.disabled = isSubmitting;
                        }
                    });
                };

                const handleClose = () => {
                    if (isSubmitting) return;
                    closeModal(overlay);
                    document.removeEventListener('keydown', handleEscape);
                    if (restoreFocusTarget) {
                        setTimeout(() => restoreFocusTarget.focus(), 0);
                    }
                };

                const handleEscape = (e) => {
                    if (e.key === 'Escape') {
                        handleClose();
                    }
                };

                detailsInput?.addEventListener('input', () => {
                    setSubmitting(false);
                });
                form?.addEventListener('input', () => setStatus(''));
                form?.addEventListener('change', () => setStatus(''));

                closeBtn?.addEventListener('click', handleClose);
                cancelBtn?.addEventListener('click', handleClose);
                overlay.addEventListener('click', (e) => {
                    if (e.target === overlay) {
                        handleClose();
                    }
                });

                form?.addEventListener('submit', async (submitEvent) => {
                    submitEvent.preventDefault();
                    syncDetailsValidity();

                    if (!form.reportValidity()) {
                        return;
                    }

                    const payload = {
                        id: reportProblemContext.miiId,
                        category: categorySelect.value,
                        email: emailInput.value.trim(),
                        details: detailsInput.value.trim()
                    };

                    try {
                        setStatus('');
                        setSubmitting(true);

                        const response = await fetch('/reportMii', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify(payload)
                        });
                        const result = await response.json().catch(() => ({}));

                        if (!response.ok || result.error) {
                            throw new Error(result.error || 'Failed to submit report');
                        }

                        isSubmitting = false;
                        handleClose();

                        const successMessage = result.warning
                            ? `Report ${result.reportReference || ''} was sent. ${result.warning}`.trim()
                            : `Report ${result.reportReference || ''} sent successfully.${result.followUpEmailSent ? ' We started a follow-up email thread.' : ''}`;

                        showAlert(successMessage, result.warning ? 7000 : 5000, {
                            title: result.warning ? 'Report Sent With Warning' : 'Report Sent',
                            type: result.warning ? 'info' : 'success'
                        });
                    } catch (error) {
                        console.error('Error submitting Mii report:', error);
                        setStatus(error.message || 'Failed to submit report', 'error');
                        setSubmitting(false);
                    }
                });

                document.addEventListener('keydown', handleEscape);
                setSubmitting(false);
                setTimeout(() => overlay.classList.add('active'), 10);
                categorySelect?.focus();
            }
            async function publishThisMii() {
                showConfirm('Are you sure you want to publish this Mii? It will become visible to everyone.', async () => {
                    try {
                        const response = await fetch('/publishMii', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ miiId: '<%= mii.id %>' })
                        });
                        const result = await response.json();

                        if (!result.error) {
                            showAlert('Mii published successfully!', 3000, { title: 'Success', type: 'success' });
                            setTimeout(() => location.reload(), 3000);
                        } else {
                            showAlert(`Error: ${result.error || 'Failed to publish Mii'}`, 5000, { title: 'Error', type: 'error' });
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        showAlert('Error publishing Mii', 5000, { title: 'Error', type: 'error' });
                    }
                }, null, { title: 'Publish Mii', confirmText: 'Publish' });
            }
            async function openMiiInstructions(event) {
                event.preventDefault();
                if (typeof showMiiInstructionsModal !== 'function') {
                    if (typeof showAlert === 'function') {
                        showAlert('Instructions modal is unavailable on this page.', 4000, { title: 'Error', type: 'error' });
                    }
                    return;
                }

                showMiiInstructionsModal(async ({ consoleType }) => {
                    const response = await fetch(`/getInstructions?id=<%= mii.id %>&console=${encodeURIComponent(consoleType)}`, {
                        headers: { "Content-Type": "application/json" },
                    });
                    return await response.json();
                }, {
                    title: "Recreation Instructions",
                    defaultConsole: "3DS",
                    miiName: <%- toScriptJson(mii.meta.name || "Mii") %>
                });
            }

            async function copyMiiExportText(formId, encoding) {
                const form = document.getElementById(formId);
                if (!form) return;

                const selectedFormat = form.querySelector('input[name="format"]')?.value?.trim();
                if (!selectedFormat) {
                    if (typeof showAlert === 'function') {
                        showAlert('Choose an export format first.', 3500, { title: 'Format Required' });
                    }
                    return;
                }

                const normalizedEncoding = String(encoding || '').trim().toLowerCase();
                if (normalizedEncoding === 'base64') {
                    await copyExportBase64FromForm(form);
                    return;
                }
                await copyExportHexFromForm(form);
            }

            function initializeMiiExportPicker() {
                if (typeof window.initMiiExportPicker === 'function') {
                    window.initMiiExportPicker();
                }
            }

            function normalizeQrPreviewConsole(consoleType) {
                const normalizedConsole = String(consoleType || '').trim().toUpperCase();
                return normalizedConsole === 'WII' ? 'WIIU' : normalizedConsole;
            }

            function getQrPreviewSources(preview) {
                if (!(preview instanceof HTMLElement)) return null;
                const source3ds = String(preview.dataset.qr3dsSrc || '').trim();
                const sourceWiiu = String(preview.dataset.qrWiiuSrc || preview.dataset.qrWiiSrc || '').trim() || source3ds;
                if (!source3ds) return null;

                return {
                    '3DS': source3ds,
                    'WIIU': sourceWiiu,
                    'WII': sourceWiiu
                };
            }

            function setQrPreviewConsole(tabOrPreview, consoleType) {
                let preview = null;
                let targetConsole = consoleType;

                if (tabOrPreview instanceof HTMLElement && tabOrPreview.matches('[data-qr-tab]')) {
                    preview = tabOrPreview.closest('[data-qr-preview]');
                    targetConsole = tabOrPreview.dataset.qrTab || consoleType;
                } else if (tabOrPreview instanceof HTMLElement && tabOrPreview.matches('[data-qr-preview]')) {
                    preview = tabOrPreview;
                } else {
                    preview = document.querySelector('[data-qr-preview]');
                }

                if (!preview) return false;

                const image = preview.querySelector('[data-qr-image]');
                const link = preview.querySelector('[data-qr-link]');
                const tabs = Array.from(preview.querySelectorAll('[data-qr-tab]'));
                const sourceByConsole = getQrPreviewSources(preview);

                if (!image || tabs.length === 0 || !sourceByConsole) {
                    return false;
                }

                const normalizedConsole = normalizeQrPreviewConsole(targetConsole || image.dataset.qrConsole || '3DS');
                const nextSrc = sourceByConsole[normalizedConsole];
                if (!nextSrc) {
                    return false;
                }

                preview.classList.toggle('is-qr-3ds', normalizedConsole === '3DS');
                preview.classList.toggle('is-qr-wiiu', normalizedConsole === 'WIIU');

                tabs.forEach((tab) => {
                    const tabConsole = normalizeQrPreviewConsole(tab.dataset.qrTab || '');
                    const isSelected = tabConsole === normalizedConsole;
                    tab.classList.toggle('is-active', isSelected);
                    tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
                });

                image.dataset.qrConsole = normalizedConsole;
                if (link) {
                    link.href = nextSrc;
                }

                if (image.src !== nextSrc) {
                    image.classList.remove('is-loaded');
                    image.classList.add('is-switching');
                    image.src = nextSrc;
                } else if (image.complete && image.naturalWidth > 0) {
                    image.classList.remove('is-switching');
                    image.classList.add('is-loaded');
                }

                return true;
            }

            function initializeQrPreviewTabs() {
                const preview = document.querySelector('[data-qr-preview]');
                if (!preview) return;
                if (preview.dataset.qrTabsInitialized === 'true') return;
                preview.dataset.qrTabsInitialized = 'true';

                const image = preview.querySelector('[data-qr-image]');
                const tabs = Array.from(preview.querySelectorAll('[data-qr-tab]'));
                const sourceByConsole = getQrPreviewSources(preview);

                if (!image || tabs.length === 0 || !sourceByConsole) {
                    return;
                }

                const loadedConsoles = new Set();

                const setLoadedState = () => {
                    image.classList.remove('is-switching');
                    image.classList.add('is-loaded');
                    const currentConsole = normalizeQrPreviewConsole(image.dataset.qrConsole || '');
                    if (currentConsole) {
                        loadedConsoles.add(currentConsole);
                    }
                };

                image.addEventListener('load', () => {
                    setLoadedState();
                });

                tabs.forEach((tab) => {
                    const tabConsole = normalizeQrPreviewConsole(tab.dataset.qrTab || '');
                    tab.addEventListener('keydown', (event) => {
                        if (event.key !== 'Enter' && event.key !== ' ') {
                            return;
                        }
                        event.preventDefault();
                        setQrPreviewConsole(preview, tabConsole);
                    });

                    tab.addEventListener('mouseenter', () => {
                        const src = sourceByConsole[tabConsole];
                        if (!src || loadedConsoles.has(tabConsole)) return;
                        const preload = new Image();
                        preload.decoding = 'async';
                        preload.loading = 'lazy';
                        preload.src = src;
                    });
                });

                if (image.complete && image.naturalWidth > 0) {
                    setLoadedState();
                } else {
                    image.classList.add('is-switching');
                }

                setQrPreviewConsole(preview, '3DS');
            }

            function buildQrPreviewMnmsCopyForm() {
                const sourceForm = document.getElementById('miiQrExportForm');
                if (!sourceForm) return null;

                const copyForm = document.createElement('form');
                copyForm.method = 'GET';
                copyForm.action = '/exportMii';

                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'id';
                idInput.value = sourceForm.querySelector('input[name="id"]')?.value || '<%= mii.id %>';
                copyForm.appendChild(idInput);

                const formatInput = document.createElement('input');
                formatInput.type = 'hidden';
                formatInput.name = 'format';
                formatInput.value = 'mnms';
                copyForm.appendChild(formatInput);

                return copyForm;
            }

            async function copyQrPreviewMnmsText(encoding) {
                const form = buildQrPreviewMnmsCopyForm();
                if (!form) return;
                const normalizedEncoding = String(encoding || '').trim().toLowerCase();
                if (normalizedEncoding === 'base64') {
                    await copyExportBase64FromForm(form);
                    return;
                }
                await copyExportHexFromForm(form);
            }

            function toggleOfficialEditorTools() {
                const content = document.getElementById('officialEditorToolsContent');
                const arrow = document.getElementById('officialEditorToolsArrow');
                if (!content || !arrow) return;

                content.classList.toggle('expanded');
                arrow.classList.toggle('rotated');
            }

            async function submitMiiFieldUpdate(field, value) {
                const response = await fetch('/updateMiiField', {
                    method: 'POST',
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        id: '<%= mii.id %>',
                        field,
                        value
                    })
                });

                return await response.json();
            }

            function setSaveButtonBusy(button, isBusy) {
                if (!button) return;
                if (!button.dataset.defaultLabel) {
                    button.dataset.defaultLabel = button.innerHTML;
                }

                button.disabled = isBusy;
                button.innerHTML = isBusy
                    ? 'Saving...'
                    : button.dataset.defaultLabel;
            }

            function getMiiMetadataEditConfig(field) {
                const configs = {
                    name: {
                        endpointField: 'name',
                        label: 'name',
                        maxLength: 10,
                        required: true,
                        fallback: 'Unknown Mii'
                    },
                    desc: {
                        endpointField: 'desc',
                        label: 'description',
                        required: true,
                        fallback: <%- toScriptJson(`${archiveIntro} ${archiveOwnerStatsLabel}`.trim()) %>
                    },
                    creatorName: {
                        endpointField: 'creatorName',
                        label: 'creator name',
                        maxLength: 10,
                        required: false,
                        fallback: 'Not Set'
                    }
                };

                return configs[field] || null;
            }

            function getInlineMiiEditorElement(field, role) {
                return document.querySelector(`[data-inline-edit-${role}="${field}"]`);
            }

            function normalizeMiiMetadataEditorValue(field, value) {
                if (field === 'name' || field === 'creatorName') {
                    return String(value ?? '').trim();
                }

                return String(value ?? '');
            }

            function validateMiiMetadataEditorValue(field, value) {
                const config = getMiiMetadataEditConfig(field);
                if (!config) {
                    showAlert('Invalid field.', 5000, { title: 'Error', type: 'error' });
                    return false;
                }

                const normalizedValue = normalizeMiiMetadataEditorValue(field, value);
                if (config.required && normalizedValue.trim() === '') {
                    showAlert(`Please enter a valid ${config.label}.`, 5000, { title: 'Error', type: 'error' });
                    return false;
                }

                if (config.maxLength && normalizedValue.length > config.maxLength) {
                    showAlert(`${config.label.charAt(0).toUpperCase()}${config.label.slice(1)} must be ${config.maxLength} characters or fewer.`, 5000, { title: 'Error', type: 'error' });
                    return false;
                }

                return true;
            }

            function setInlineMiiEditorOpen(field, isOpen) {
                const display = getInlineMiiEditorElement(field, 'display');
                const controls = getInlineMiiEditorElement(field, 'controls');
                const trigger = getInlineMiiEditorElement(field, 'trigger');

                if (display) display.hidden = isOpen;
                if (controls) controls.hidden = !isOpen;
                if (trigger) trigger.hidden = isOpen;
            }

            function openMiiInlineEditor(field) {
                const input = getInlineMiiEditorElement(field, 'input');
                if (!input) return;

                input.value = inlineMiiEditorState[field] ?? '';
                setInlineMiiEditorOpen(field, true);
                input.focus();

                if (typeof input.select === 'function') {
                    input.select();
                }
            }

            function cancelInlineMiiEdit(field) {
                const input = getInlineMiiEditorElement(field, 'input');
                if (input) {
                    input.value = inlineMiiEditorState[field] ?? '';
                }

                setInlineMiiEditorOpen(field, false);
            }

            async function saveInlineMiiField(field) {
                const config = getMiiMetadataEditConfig(field);
                const input = getInlineMiiEditorElement(field, 'input');
                const display = getInlineMiiEditorElement(field, 'display');
                const button = getInlineMiiEditorElement(field, 'save');

                if (!config || !input || !display) return;

                const nextValue = normalizeMiiMetadataEditorValue(field, input.value);
                if (!validateMiiMetadataEditorValue(field, nextValue)) return;

                if (nextValue === inlineMiiEditorState[field]) {
                    cancelInlineMiiEdit(field);
                    showAlert('No changes to save.', 2500, { title: 'Nothing to Save' });
                    return;
                }

                setSaveButtonBusy(button, true);
                try {
                    const result = await submitMiiFieldUpdate(config.endpointField, nextValue);
                    if (result?.error) {
                        showAlert(`Error: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                        return;
                    }

                    inlineMiiEditorState[field] = nextValue;
                    display.textContent = nextValue || config.fallback;
                    input.value = nextValue;
                    setInlineMiiEditorOpen(field, false);
                    showAlert('Saved.', 2500, { title: 'Success', type: 'success' });
                } catch (error) {
                    console.error('Error saving Mii field:', error);
                    showAlert('Failed to save changes.', 6000, { title: 'Error', type: 'error' });
                } finally {
                    setSaveButtonBusy(button, false);
                }
            }

            function initializeInlineMiiEditors() {
                document.querySelectorAll('[data-inline-edit-input]').forEach((input) => {
                    const field = input.dataset.inlineEditInput;
                    input.addEventListener('keydown', (event) => {
                        if (event.key === 'Escape') {
                            event.preventDefault();
                            cancelInlineMiiEdit(field);
                            return;
                        }

                        if (event.key === 'Enter' && field !== 'desc') {
                            event.preventDefault();
                            saveInlineMiiField(field);
                        }
                    });
                });
            }

            async function saveStagedEditorChanges(changes, button, title = 'Save Changes') {
                if (changes.length === 0) {
                    showAlert('No changes to save.', 3000, { title: 'Nothing to Save' });
                    return;
                }

                showConfirm(`Save ${changes.length} change${changes.length === 1 ? '' : 's'}?`, async () => {
                    setSaveButtonBusy(button, true);
                    try {
                        for (const change of changes) {
                            const result = await change.run();
                            if (result?.error) {
                                showAlert(`Error saving ${change.label}: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                                return;
                            }
                        }

                        showAlert('Changes saved successfully!', 3000, { title: 'Success', type: 'success' });
                        setTimeout(() => location.reload(), 1500);
                    } catch (error) {
                        console.error('Error saving changes:', error);
                        showAlert('Failed to save changes. Some updates may not have been applied.', 6000, { title: 'Error', type: 'error' });
                    } finally {
                        setSaveButtonBusy(button, false);
                    }
                }, null, { title, confirmText: 'Save' });
            }

            async function submitMiiTagsUpdate(tags) {
                const response = await fetch('/updateMiiTags', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        miiId: '<%= mii.id %>',
                        tags
                    })
                });

                return await response.json();
            }

            async function submitOfficialStatusUpdate(official) {
                const response = await fetch('/toggleMiiOfficial', {
                    method: 'POST',
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        id: '<%= mii.id %>',
                        official
                    })
                });

                return await response.json();
            }

            function validateEditorValue(value, label) {
                if (String(value ?? '').trim() !== '') return true;
                showAlert(`Please enter a valid ${label}.`, 5000, { title: 'Error', type: 'error' });
                return false;
            }

            async function saveModeratorEdits() {
                const button = document.getElementById('saveModeratorEditsButton');
                const changes = [];

                const uploaderInput = document.getElementById('editUploader');
                const uploader = uploaderInput?.value ?? '';
                if (uploaderInput && uploader !== originalMiiEditorState.uploader) {
                    if (!validateEditorValue(uploader, 'uploader')) return;
                    changes.push({
                        label: 'uploader',
                        run: () => submitMiiFieldUpdate('uploader', uploader)
                    });
                }

                const userEditLockCheckbox = document.getElementById('userEditLockCheckbox');
                if (userEditLockCheckbox && userEditLockCheckbox.checked !== originalMiiEditorState.lockedFromUserEdits) {
                    changes.push({
                        label: 'uploader edit lock',
                        run: () => submitMiiFieldUpdate('lockedFromUserEdits', userEditLockCheckbox.checked)
                    });
                }

                const tags = Array.from(selectedMiiTags);
                if (!arraysEqualAsSets(tags, originalMiiEditorState.tags)) {
                    changes.push({
                        label: 'tags',
                        run: () => submitMiiTagsUpdate(tags)
                    });
                }

                const categories = Array.from(selectedPaths);
                if (!arraysEqualAsSets(categories, originalMiiEditorState.categories) && document.querySelector('.category-trigger-summary')) {
                    changes.push({
                        label: 'official categories',
                        run: () => updateCategories(categories)
                    });
                }

                const officialCheckbox = document.getElementById('officialCheckbox');
                if (officialCheckbox && officialCheckbox.checked !== originalMiiEditorState.official) {
                    changes.push({
                        label: 'official status',
                        run: () => submitOfficialStatusUpdate(officialCheckbox.checked)
                    });
                }

                await saveStagedEditorChanges(changes, button, 'Save Moderator Changes');
            }

            async function saveOfficialEditorChanges() {
                const button = document.getElementById('saveOfficialEditorButton');
                const changes = [];

                const name = normalizeMiiMetadataEditorValue('name', document.getElementById('researcherEditMiiName')?.value ?? '');
                if (name !== originalMiiEditorState.name) {
                    if (!validateMiiMetadataEditorValue('name', name)) return;
                    changes.push({
                        label: 'name',
                        run: () => submitMiiFieldUpdate('name', name)
                    });
                }

                const desc = normalizeMiiMetadataEditorValue('desc', document.getElementById('researcherEditDesc')?.value ?? '');
                if (desc !== originalMiiEditorState.desc) {
                    if (!validateMiiMetadataEditorValue('desc', desc)) return;
                    changes.push({
                        label: 'description',
                        run: () => submitMiiFieldUpdate('desc', desc)
                    });
                }

                const creatorName = normalizeMiiMetadataEditorValue('creatorName', document.getElementById('researcherEditCreatorName')?.value ?? '');
                if (creatorName !== originalMiiEditorState.creatorName) {
                    if (!validateMiiMetadataEditorValue('creatorName', creatorName)) return;
                    changes.push({
                        label: 'creator name',
                        run: () => submitMiiFieldUpdate('creatorName', creatorName)
                    });
                }

                const categories = Array.from(selectedPaths);
                if (!arraysEqualAsSets(categories, originalMiiEditorState.categories)) {
                    changes.push({
                        label: 'official categories',
                        run: () => updateCategories(categories)
                    });
                }

                await saveStagedEditorChanges(changes, button, 'Save Changes');
            }

            let relatedMiiGridLayoutFrame = 0;
            let relatedMiiGridResizeObserver = null;

            function updateRelatedMiiGridSingleRow() {
                const relatedGrids = document.querySelectorAll('.related-mii-grid');
                if (relatedGrids.length === 0) return;

                relatedGrids.forEach((grid) => {
                    const cards = Array.from(grid.children).filter((child) => child.classList.contains('related-mii-card'));
                    if (cards.length === 0) return;

                    cards.forEach((card) => {
                        card.hidden = false;
                    });

                    const firstRowTop = cards[0].offsetTop;
                    cards.forEach((card) => {
                        if (card.offsetTop > firstRowTop + 1) {
                            card.hidden = true;
                        }
                    });
                });
            }

            function scheduleRelatedMiiGridSingleRowUpdate() {
                if (relatedMiiGridLayoutFrame) {
                    cancelAnimationFrame(relatedMiiGridLayoutFrame);
                }

                relatedMiiGridLayoutFrame = requestAnimationFrame(() => {
                    relatedMiiGridLayoutFrame = 0;
                    updateRelatedMiiGridSingleRow();
                });
            }

            function initializeMiiPageEditorState() {
                initializeInlineMiiEditors();
                updateCategoryEditorTriggers();
                updateOfficialCheckboxLabel();
                try {
                    initializeQrPreviewTabs();
                } catch (error) {
                    console.error('Error initializing QR preview tabs:', error);
                }

                try {
                    initializeMiiExportPicker();
                } catch (error) {
                    console.error('Error initializing export picker:', error);
                }
                const officialCheckbox = document.getElementById('officialCheckbox');
                officialCheckbox?.addEventListener('change', updateOfficialCheckboxLabel);

                const hasRelatedMiiGrid = Boolean(document.querySelector('.related-mii-grid'));
                if (!hasRelatedMiiGrid) {
                    return;
                }

                scheduleRelatedMiiGridSingleRowUpdate();
                window.addEventListener('resize', scheduleRelatedMiiGridSingleRowUpdate, { passive: true });
                window.addEventListener('load', scheduleRelatedMiiGridSingleRowUpdate, { once: true });

                if (typeof ResizeObserver === 'function' && !relatedMiiGridResizeObserver) {
                    relatedMiiGridResizeObserver = new ResizeObserver(() => {
                        scheduleRelatedMiiGridSingleRowUpdate();
                    });

                    document.querySelectorAll('.related-mii-grid').forEach((grid) => {
                        relatedMiiGridResizeObserver.observe(grid);
                    });
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initializeMiiPageEditorState);
            } else {
                initializeMiiPageEditorState();
            }
        </script>

        <!--Moderator Tools Functions - Because EJS runs server side, and the client only sees the result of the compilation, this prevents unnecessary JS from loading that doesn't need to be sent-->
        <% if (isModerator) { %>
            <script>
                async function submitMiiIdChange(payload, button, successMessage) {
                    const targetButton = button instanceof HTMLElement
                        ? button
                        : document.getElementById('headerRegenerateMiiIdButton');

                    setSaveButtonBusy(targetButton, true);

                    try {
                        const response = await fetch('/changeMiiId', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                miiId: '<%= mii.id %>',
                                ...payload
                            })
                        });
                        const result = await response.json();

                        if (result.error) {
                            showAlert(`Error: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                            return;
                        }

                        showAlert(`${successMessage} New ID: ${result.newId}`, 3500, { title: 'Success', type: 'success' });
                        const redirectTarget = typeof getSafeClientRedirectTarget === 'function'
                            ? getSafeClientRedirectTarget(result.redirect, `/mii/${encodeURIComponent(result.newId || '')}`)
                            : (result.redirect || `/mii/${encodeURIComponent(result.newId || '')}`);

                        setTimeout(() => {
                            window.location.href = redirectTarget;
                        }, 1200);
                    } catch (error) {
                        console.error('Error changing Mii ID:', error);
                        showAlert('Failed to change Mii ID', 6000, { title: 'Error', type: 'error' });
                    } finally {
                        setSaveButtonBusy(targetButton, false);
                    }
                }

                async function regenerateMiiId(button = null) {
                    showConfirm(
                        'Generate a brand new ID for this Mii? Every stored reference will be updated automatically.',
                        async () => {
                            await submitMiiIdChange({}, button, 'Mii ID regenerated.');
                        },
                        null,
                        { title: 'Generate New Mii ID', confirmText: 'Generate' }
                    );
                }

                async function setMiiIdDirectly() {
                    const input = document.getElementById('directMiiIdInput');
                    const button = document.getElementById('setMiiIdButton');
                    const newId = (input?.value || '').trim();

                    if (!newId) {
                        showAlert('Enter a new Mii ID first.', 5000, { title: 'Error', type: 'error' });
                        return;
                    }
                    if (!/^[A-Za-z0-9]{1,10}$/.test(newId)) {
                        showAlert('Mii IDs must be alphanumeric and 10 characters or fewer.', 5000, { title: 'Error', type: 'error' });
                        return;
                    }
                    if (newId === '<%= mii.id %>') {
                        showAlert('That is already the current Mii ID.', 4000, { title: 'Notice' });
                        return;
                    }

                    showConfirm(
                        `Set this Mii ID to "${newId}"? Every stored reference will be updated automatically.`,
                        async () => {
                            await submitMiiIdChange({ newId }, button, 'Mii ID updated.');
                        },
                        null,
                        { title: 'Set Mii ID', confirmText: 'Set ID' }
                    );
                }

                async function blockMiiFromPublishing() {
                    const reason = prompt('Enter reason for blocking (optional):');
                    if (reason === null) return; // User cancelled
                    
                    try {
                        const response = await fetch('/blockMiiFromPublishing', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                miiId: '<%= mii.id %>',
                                reason: reason 
                            })
                        });
                        
                        const result = await response.json();
                        if (!result.error) {
                            showAlert('Mii blocked from publishing', 3000, { title: 'Success', type: 'success' });
                            setTimeout(() => location.reload(), 3000);
                        } else {
                            showAlert('Error: ' + (result.error || 'Failed to block Mii'), 5000, { title: 'Error', type: 'error' });
                        }
                    } catch (error) {
                        showAlert('Error blocking Mii', 5000, { title: 'Error', type: 'error' });
                    }
                }
                
                async function unblockMiiFromPublishing() {
                    showConfirm('Unblock this Mii from publishing?', async () => {
                        try {
                            const response = await fetch('/unblockMiiFromPublishing', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ miiId: '<%= mii.id %>' })
                            });
                            
                            const result = await response.json();
                            if (!result.error) {
                                showAlert('Mii unblocked', 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            } else {
                                showAlert('Error: ' + (result.error || 'Failed to unblock Mii'), 5000, { title: 'Error', type: 'error' });
                            }
                        } catch (error) {
                            showAlert('Error unblocking Mii', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Unblock Mii', confirmText: 'Unblock' });
                }
                function toggleModTools() {
                    const content = document.getElementById('modToolsContent');
                    const arrow = document.getElementById('modToolsArrow');
                    
                    content.classList.toggle('expanded');
                    arrow.classList.toggle('rotated');
                }

                function renderModMiiTagList() {
                    const container = document.getElementById('modMiiTagList');
                    if (!container) return;

                    container.innerHTML = '';

                    if (!Array.isArray(availableMiiTags) || availableMiiTags.length === 0) {
                        const emptyState = document.createElement('p');
                        emptyState.className = 'mod-tag-empty';
                        emptyState.innerHTML = 'No tags created yet. <a href="/search">Create tags on the Search page</a>.';
                        container.appendChild(emptyState);
                        return;
                    }

                    availableMiiTags.forEach((tag) => {
                        const label = document.createElement('label');
                        label.className = 'mod-tag-option';

                        const checkbox = document.createElement('input');
                        checkbox.type = 'checkbox';
                        checkbox.value = tag;
                        checkbox.checked = selectedMiiTags.has(tag);
                        checkbox.addEventListener('change', (event) => {
                            if (event.target.checked) {
                                selectedMiiTags.add(tag);
                            } else {
                                selectedMiiTags.delete(tag);
                            }
                        });

                        const text = document.createElement('span');
                        text.textContent = tag;

                        label.appendChild(checkbox);
                        label.appendChild(text);
                        container.appendChild(label);
                    });
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', renderModMiiTagList);
                } else {
                    renderModMiiTagList();
                }

                async function regenerateQR() {
                    showConfirm('Are you sure you want to regenerate the QR code?', async () => {
                        const statusEl = document.getElementById('qrStatus');
                        const qrConsole = document.getElementById('regenQrConsole')?.value || '3DS';
                        statusEl.textContent = 'Regenerating...';
                        statusEl.style.color = '#FFA500';

                        try {
                            const response = await fetch('/regenerateQR', {
                                method: "POST",
                                body: JSON.stringify({ id: "<%= mii.id %>", qrConsole }),
                                headers: { "Content-Type": "application/json" },
                            });
                            const result = await response.json();
                            
                            if (!result.error) {
                                statusEl.textContent = '✓ Done!';
                                statusEl.style.color = '#4CAF50';
                                setTimeout(() => {
                                    location.reload();
                                }, 1000);
                            }
                            else {
                                statusEl.textContent = `Error: ${result.error}`;
                                statusEl.style.color = '#f44336';
                            }
                        }
                        catch (error) {
                            console.error('Error:', error);
                            statusEl.textContent = '✗ Failed';
                            statusEl.style.color = '#f44336';
                        }
                    }, null, { title: 'Regenerate QR Code', confirmText: 'Regenerate' });
                }

                async function regenerateRender() {
                    showConfirm('Are you sure you want to regenerate the render image?', async () => {
                        const statusEl = document.getElementById('renderStatus');
                        statusEl.textContent = 'Regenerating...';
                        statusEl.style.color = '#FFA500';

                        try {
                            const response = await fetch('/regenerateRender', {
                                method: "POST",
                                body: JSON.stringify({ id: "<%= mii.id %>" }),
                                headers: { "Content-Type": "application/json" },
                            });
                            const result = await response.json();

                            if (!result.error) {
                                statusEl.textContent = '✓ Done!';
                                statusEl.style.color = '#4CAF50';
                                setTimeout(() => {
                                    location.reload();
                                }, 1000);
                            }
                            else {
                                statusEl.textContent = `Error: ${result.error}`;
                                statusEl.style.color = '#f44336';
                            }
                        }
                        catch (error) {
                            console.error('Error:', error);
                            statusEl.textContent = '✗ Failed';
                            statusEl.style.color = '#f44336';
                        }
                    }, null, { title: 'Regenerate Render', confirmText: 'Regenerate' });
                }

                async function clearMiiTlData() {
                    const button = document.getElementById('clearTlDataButton');
                    showConfirm(
                        'Clear stored Tomodachi Life data for this Mii? This also removes the Tomodachi Life tag and regenerates QR previews.',
                        async () => {
                            setSaveButtonBusy(button, true);
                            try {
                                const response = await fetch('/clearMiiTlData', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ id: '<%= mii.id %>' })
                                });
                                const result = await response.json();

                                if (result.error) {
                                    showAlert(`Error: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                                    return;
                                }

                                showAlert(
                                    result.unchanged ? 'No Tomodachi Life data was stored for this Mii.' : 'Tomodachi Life data cleared.',
                                    3000,
                                    { title: result.unchanged ? 'No Changes' : 'Success', type: result.unchanged ? 'info' : 'success' }
                                );
                                setTimeout(() => location.reload(), 1000);
                            } catch (error) {
                                console.error('Error clearing TL data:', error);
                                showAlert('Failed to clear Tomodachi Life data', 6000, { title: 'Error', type: 'error' });
                            } finally {
                                setSaveButtonBusy(button, false);
                            }
                        },
                        null,
                        { title: 'Clear TL Data', confirmText: 'Clear TL Data' }
                    );
                }

                async function confirmDeleteMii() {
                    const miiName = <%- toScriptJson(mii.meta.name || "") %>;
                    showConfirm(`Are you ABSOLUTELY SURE you want to DELETE the Mii "${miiName}"?\n\nThis action CANNOT be undone!`, () => {
                        const doubleCheck = prompt(`Type "DELETE" to confirm deletion of ${miiName}:`);
                        if (doubleCheck !== 'DELETE') {
                            showAlert('Deletion cancelled.', 3000, { title: 'Cancelled' });
                            return;
                        }

                        (async () => {
                            try {
                                const response = await fetch('/deleteMii', {
                                    method: 'POST',
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ id: '<%= mii.id %>' })
                                });
                                const result = await response.json();
                                
                                if (!result.error) {
                                    showAlert('Mii deleted successfully', 2000, { title: 'Success', type: 'success' });
                                    setTimeout(() => window.location.href = result.redirect || '/', 2000);
                                }
                                else {
                                    showAlert('Error deleting Mii', 5000, { title: 'Error', type: 'error' });
                                }
                            }
                            catch (error) {
                                console.error('Error:', error);
                                showAlert('Failed to delete Mii', 5000, { title: 'Error', type: 'error' });
                            }
                        })();
                    }, null, { title: 'Delete Mii', confirmText: 'Continue' });
                }

            </script>
        <% } %>
    </body>
