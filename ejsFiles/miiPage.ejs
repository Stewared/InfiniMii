            async function copyMiiExportText(formId, encoding) {
                const form = document.getElementById(formId);
                if (!form) return;
                const normalizedEncoding = String(encoding || '').trim().toLowerCase();
                if (normalizedEncoding === 'base64') {
                    await copyExportBase64FromForm(form);
                    return;
                }
                await copyExportHexFromForm(form);
            }

            function buildQrPreviewMnmsCopyForm() {
                const sourceForm = document.getElementById('miiQrExportForm');
                if (!sourceForm) return null;

                const copyForm = document.createElement('form');
                copyForm.method = 'GET';
                copyForm.action = '/exportMii';

                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'id';
                idInput.value = sourceForm.querySelector('input[name="id"]')?.value || '<%= mii.id %>';
                copyForm.appendChild(idInput);

                const formatInput = document.createElement('input');
                formatInput.type = 'hidden';
                formatInput.name = 'format';
                formatInput.value = 'mnms';
                copyForm.appendChild(formatInput);

                const specialCheckbox = sourceForm.querySelector('input[name="special"]');
                if (specialCheckbox?.checked) {
                    const specialInput = document.createElement('input');
                    specialInput.type = 'hidden';
                    specialInput.name = 'special';
                    specialInput.value = specialCheckbox.value || 'on';
                    copyForm.appendChild(specialInput);
                }

                return copyForm;
            }

            async function copyQrPreviewMnmsText(encoding) {
                const form = buildQrPreviewMnmsCopyForm();
                if (!form) return;
                const normalizedEncoding = String(encoding || '').trim().toLowerCase();
                if (normalizedEncoding === 'base64') {
                    await copyExportBase64FromForm(form);
                    return;
                }
                await copyExportHexFromForm(form);
            }

