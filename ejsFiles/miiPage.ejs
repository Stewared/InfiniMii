        <script>
            (() => {
                const externalMiiPromptConfig = {
                    url: <%- toScriptJson(
                        typeof externalMiiSource !== 'undefined' ? String(externalMiiSource?.url || '').trim() : ''
                    ) %>,
                    title: <%- toScriptJson(
                        typeof externalMiiSource !== 'undefined' ? String(externalMiiSource?.title || '').trim() : ''
                    ) %>,
                    preference: <%- toScriptJson(
                        typeof externalMiiPreference !== 'undefined'
                            ? externalMiiPreference
                            : (user?.externalMiiPreference || 'ask')
                    ) %>,
                    isSignedIn: <%- toScriptJson(Boolean(user?.username)) %>
                };
                const externalMiiPreferenceValues = new Set(['ask', 'stay', 'go']);
                const guestPreferenceStorageKey = 'infinimii.externalMiiPreference';

                function normalizeExternalMiiPagePreference(value) {
                    const normalized = typeof value === 'string' ? value.trim().toLowerCase() : '';
                    return externalMiiPreferenceValues.has(normalized) ? normalized : 'ask';
                }

                function getSafeExternalMiiUrl(value) {
                    try {
                        const parsed = new URL(String(value || '').trim());
                        if (!['http:', 'https:'].includes(parsed.protocol)) return '';
                        if (parsed.username || parsed.password) return '';
                        return parsed.href;
                    } catch (error) {
                        return '';
                    }
                }

                function getExternalMiiPagePreference() {
                    if (externalMiiPromptConfig.isSignedIn) {
                        return normalizeExternalMiiPagePreference(externalMiiPromptConfig.preference);
                    }

                    try {
                        return normalizeExternalMiiPagePreference(localStorage.getItem(guestPreferenceStorageKey));
                    } catch (error) {
                        return 'ask';
                    }
                }

                function reportExternalMiiPreferenceSaveFailure(error) {
                    console.warn(error?.message || error || 'Could not save the external Mii preference.');
                    if (typeof showAlert === 'function') {
                        showAlert('Your external Mii preference could not be saved.', 5000, {
                            title: 'Preference Not Saved',
                            type: 'error'
                        });
                    }
                }

                function persistExternalMiiPagePreference(preference) {
                    const normalized = normalizeExternalMiiPagePreference(preference);
                    externalMiiPromptConfig.preference = normalized;

                    if (!externalMiiPromptConfig.isSignedIn) {
                        try {
                            localStorage.setItem(guestPreferenceStorageKey, normalized);
                        } catch (error) {
                            reportExternalMiiPreferenceSaveFailure(error);
                        }
                        return;
                    }

                    fetch('/updateExternalMiiPreference', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ preference: normalized }),
                        keepalive: true
                    }).then(async (response) => {
                        if (response.ok) return;
                        const result = await response.json().catch(() => ({}));
                        throw new Error(result.error || 'Could not save the external Mii preference.');
                    }).catch((error) => {
                        reportExternalMiiPreferenceSaveFailure(error);
                    });
                }

                function openExternalMiiPage(url) {
                    let openedWindow = null;
                    try {
                        openedWindow = window.open('', '_blank');
                    } catch (error) {
                        return false;
                    }
                    if (!openedWindow) return false;
                    try {
                        openedWindow.opener = null;
                        openedWindow.location.replace(url);
                    } catch (error) {
                        openedWindow.close();
                        return false;
                    }
                    return true;
                }

                function showExternalMiiSourceModal(url, title) {
                    if (typeof createModalOverlay !== 'function' || typeof closeModal !== 'function') return;

                    const overlay = createModalOverlay();
                    overlay.className = 'custom-modal-overlay external-mii-source-overlay';

                    const modal = document.createElement('div');
                    modal.className = 'custom-modal external-mii-source-modal';
                    modal.setAttribute('role', 'dialog');
                    modal.setAttribute('aria-modal', 'true');
                    modal.setAttribute('aria-labelledby', 'externalMiiSourceTitle');
                    modal.setAttribute('aria-describedby', 'externalMiiSourceDescription');

                    const header = document.createElement('div');
                    header.className = 'custom-modal-header';

                    const heading = document.createElement('h3');
                    heading.id = 'externalMiiSourceTitle';
                    heading.textContent = 'External Mii';

                    const closeButton = document.createElement('button');
                    closeButton.type = 'button';
                    closeButton.className = 'custom-modal-close';
                    closeButton.setAttribute('aria-label', 'Stay on InfiniMii');
                    closeButton.innerHTML = '&times;';

                    header.appendChild(heading);
                    header.appendChild(closeButton);

                    const body = document.createElement('div');
                    body.className = 'custom-modal-body external-mii-source-body';

                    const description = document.createElement('p');
                    description.id = 'externalMiiSourceDescription';
                    description.textContent = `This Mii is from ${title}, do you wish to view it there?`;

                    const alwaysLabel = document.createElement('label');
                    alwaysLabel.className = 'external-mii-always-option';

                    const alwaysCheckbox = document.createElement('input');
                    alwaysCheckbox.type = 'checkbox';
                    alwaysCheckbox.id = 'alwaysUseExternalMiiOption';

                    const alwaysText = document.createElement('span');
                    alwaysText.textContent = 'Always use this option';

                    alwaysLabel.appendChild(alwaysCheckbox);
                    alwaysLabel.appendChild(alwaysText);
                    body.appendChild(description);
                    body.appendChild(alwaysLabel);

                    const footer = document.createElement('div');
                    footer.className = 'custom-modal-footer';

                    const stayButton = document.createElement('button');
                    stayButton.type = 'button';
                    stayButton.className = 'custom-modal-btn custom-modal-btn-secondary';
                    stayButton.textContent = 'Stay on InfiniMii';

                    const goLink = document.createElement('a');
                    goLink.className = 'custom-modal-btn custom-modal-btn-primary external-mii-go-link';
                    goLink.href = url;
                    goLink.target = '_blank';
                    goLink.rel = 'noopener noreferrer';
                    goLink.textContent = `Go to ${title}`;

                    footer.appendChild(stayButton);
                    footer.appendChild(goLink);
                    modal.appendChild(header);
                    modal.appendChild(body);
                    modal.appendChild(footer);
                    overlay.appendChild(modal);

                    let isClosed = false;
                    const dismiss = () => {
                        if (isClosed) return;
                        isClosed = true;
                        document.removeEventListener('keydown', handleEscape);
                        closeModal(overlay);
                    };
                    const handleEscape = (event) => {
                        if (event.key === 'Escape') dismiss();
                    };

                    closeButton.addEventListener('click', dismiss);
                    stayButton.addEventListener('click', () => {
                        if (alwaysCheckbox.checked) persistExternalMiiPagePreference('stay');
                        dismiss();
                    });
                    goLink.addEventListener('click', () => {
                        if (alwaysCheckbox.checked) persistExternalMiiPagePreference('go');
                        dismiss();
                    });
                    overlay.addEventListener('click', (event) => {
                        if (event.target === overlay) dismiss();
                    });
                    document.addEventListener('keydown', handleEscape);

                    setTimeout(() => overlay.classList.add('active'), 10);
                    stayButton.focus();
                }

                function initializeExternalMiiSourcePrompt() {
                    const url = getSafeExternalMiiUrl(externalMiiPromptConfig.url);
                    const title = String(externalMiiPromptConfig.title || '').trim();
                    if (!url || !title) return;

                    const preference = getExternalMiiPagePreference();
                    if (preference === 'stay') return;
                    if (preference === 'go') {
                        if (openExternalMiiPage(url)) return;

                        // Browsers can reject an automatic _blank tab because this
                        // visit is not itself a user gesture. Honor the saved choice
                        // without showing the disabled modal again; the modal's Go
                        // link remains target="_blank" for interactive choices.
                        try {
                            window.location.replace(url);
                            return;
                        } catch (error) {
                            // If navigation is unavailable, retain the interactive
                            // prompt instead of leaving the visitor without a choice.
                        }
                    }

                    showExternalMiiSourceModal(url, title);
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initializeExternalMiiSourcePrompt, { once: true });
                } else {
                    initializeExternalMiiSourcePrompt();
                }
            })();
        </script>

        <script src="/js/miiExportPicker.js"></script>

        <!--Due to needing access to EJS variables, we unfortunately cannot move these contents to a dedicated JS file-->
        <script>
            function copyMiiId(el, id){
                const labelEl = el?.querySelector?.('.copy-label') || el;
                const originalText = labelEl?.textContent || '';

                navigator.clipboard.writeText(id).then(() => {
                    if (labelEl) {
                        labelEl.textContent = '✓ Copied!';
                        setTimeout(() => {
                            labelEl.textContent = originalText;
                        }, 2000);
                    }
                }).catch(() => {
                    if (labelEl && typeof showAlert === 'function') {
                        showAlert('Failed to copy Mii ID', 4000, { title: 'Error', type: 'error' });
                    }
                });
            }

            function hideCurrentMii(event, button = null) {
                event?.preventDefault?.();

                const runHide = async () => {
                    if (button) button.disabled = true;
                    try {
                        const response = await fetch('/hideMii', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id: <%- toScriptJson(mii.id) %> })
                        });
                        const result = await response.json();

                        if (result.error) {
                            showAlert(result.error, 5000, { title: 'Error', type: 'error' });
                            if (button) button.disabled = false;
                            return;
                        }

                        showAlert('Mii hidden. You can unhide it from Settings.', 2500, { title: 'Hidden', type: 'success' });
                        setTimeout(() => {
                            window.location.href = '/settings';
                        }, 900);
                    } catch (error) {
                        console.error('Error hiding Mii:', error);
                        showAlert('Failed to hide Mii', 5000, { title: 'Error', type: 'error' });
                        if (button) button.disabled = false;
                    }
                };

                if (typeof showConfirm === 'function') {
                    showConfirm(
                        'Hide this Mii from your account?',
                        runHide,
                        null,
                        { title: 'Hide Mii', confirmText: 'Hide' }
                    );
                    return;
                }

                if (window.confirm('Hide this Mii from your account?')) {
                    runHide();
                }
            }

            function openReportProblemModal(event, triggerButton = null) {
                event?.preventDefault?.();

                if (typeof createModalOverlay !== 'function' || typeof closeModal !== 'function') {
                    showAlert('Report modal is unavailable on this page.', 4000, { title: 'Error', type: 'error' });
                    return;
                }

                const overlay = createModalOverlay();
                overlay.className = 'custom-modal-overlay custom-modal-report';

                const restoreFocusTarget = triggerButton instanceof HTMLElement
                    ? triggerButton
                    : (document.activeElement instanceof HTMLElement ? document.activeElement : null);

                const modal = document.createElement('div');
                modal.className = 'custom-modal report-problem-modal';
                modal.setAttribute('role', 'dialog');
                modal.setAttribute('aria-modal', 'true');
                modal.setAttribute('aria-labelledby', 'reportProblemTitle');

                const header = document.createElement('div');
                header.className = 'custom-modal-header';
                header.innerHTML = `
                    <h3 id="reportProblemTitle">Report Problem</h3>
                    <button class="custom-modal-close" aria-label="Close">&times;</button>
                `;

                const body = document.createElement('div');
                body.className = 'custom-modal-body report-modal-body';
                body.innerHTML = `
                    <p class="report-modal-intro">Tell us what is wrong with <strong>${escapeHtml(reportProblemContext.miiName)}</strong>. Reports go straight to the InfiniMii admins.</p>
                    <div class="report-modal-support" id="reportProblemSupport">
                        <div class="report-modal-support-copy">
                            <p class="report-modal-support-title">Need faster follow-up?</p>
                            <p>You can also bring the issue to the team in Discord.</p>
                        </div>
                        <a class="btn-secondary report-modal-discord-link" id="reportProblemDiscordLink" target="_blank" rel="noopener noreferrer">Join Discord</a>
                    </div>
                    <form id="reportProblemForm" class="report-modal-form">
                        <label class="report-modal-field" for="reportProblemCategory">
                            <span>Issue Category</span>
                            <select id="reportProblemCategory" name="category" required>
                                <option value="">Select a category</option>
                                ${reportMiiCategories.map((category) => `<option value="${escapeHtml(category)}">${escapeHtml(category)}</option>`).join('')}
                            </select>
                        </label>
                        <label class="report-modal-field" for="reportProblemEmail">
                            <span>Email</span>
                            <input
                                id="reportProblemEmail"
                                name="email"
                                type="email"
                                autocomplete="email"
                                placeholder="Optional email for follow-up"
                            >
                            <small>Email is optional, but it allows InfiniMii to follow up with you.</small>
                        </label>
                        <label class="report-modal-field" for="reportProblemDetails">
                            <span>Extra Details</span>
                            <textarea
                                id="reportProblemDetails"
                                name="details"
                                rows="7"
                                maxlength="4000"
                                required
                                placeholder="Please explain what is wrong with this Mii."
                            ></textarea>
                            <small>This box is required so the admins know what to look for.</small>
                        </label>
                    </form>
                    <p class="report-modal-status" id="reportProblemStatus" hidden></p>
                `;

                const footer = document.createElement('div');
                footer.className = 'custom-modal-footer';
                footer.innerHTML = `
                    <button type="button" class="custom-modal-btn custom-modal-btn-secondary" data-action="cancel">Cancel</button>
                    <button type="submit" class="custom-modal-btn custom-modal-btn-primary report-modal-submit" data-action="submit" form="reportProblemForm">Send Report</button>
                `;

                modal.appendChild(header);
                modal.appendChild(body);
                modal.appendChild(footer);
                overlay.innerHTML = '';
                overlay.appendChild(modal);

                const closeBtn = modal.querySelector('.custom-modal-close');
                const cancelBtn = modal.querySelector('[data-action="cancel"]');
                const submitBtn = modal.querySelector('[data-action="submit"]');
                const form = modal.querySelector('#reportProblemForm');
                const supportPanel = modal.querySelector('#reportProblemSupport');
                const discordLink = modal.querySelector('#reportProblemDiscordLink');
                const categorySelect = modal.querySelector('#reportProblemCategory');
                const emailInput = modal.querySelector('#reportProblemEmail');
                const detailsInput = modal.querySelector('#reportProblemDetails');
                const statusEl = modal.querySelector('#reportProblemStatus');

                let isSubmitting = false;

                if (discordLink && reportProblemContext.discordInvite) {
                    discordLink.href = reportProblemContext.discordInvite;
                } else if (supportPanel) {
                    supportPanel.hidden = true;
                }

                const syncDetailsValidity = () => {
                    const hasDetails = Boolean(detailsInput?.value?.trim());
                    if (detailsInput) {
                        detailsInput.setCustomValidity(hasDetails ? '' : 'Please include extra details about the issue.');
                    }
                    return hasDetails;
                };

                const setStatus = (message = '', type = 'info') => {
                    if (!statusEl) return;
                    statusEl.textContent = message;
                    statusEl.hidden = !message;
                    statusEl.dataset.type = message ? type : '';
                    if (message && type === 'error' && typeof window.scrollToUserError === 'function') {
                        window.scrollToUserError(statusEl);
                    }
                };

                const setSubmitting = (nextSubmitting) => {
                    isSubmitting = Boolean(nextSubmitting);
                    const hasDetails = syncDetailsValidity();

                    if (submitBtn) {
                        submitBtn.disabled = isSubmitting || !hasDetails;
                        submitBtn.textContent = isSubmitting ? 'Sending...' : 'Send Report';
                    }

                    [closeBtn, cancelBtn, categorySelect, emailInput, detailsInput].forEach((element) => {
                        if (element) {
                            element.disabled = isSubmitting;
                        }
                    });
                };

                const handleClose = () => {
                    if (isSubmitting) return;
                    closeModal(overlay);
                    document.removeEventListener('keydown', handleEscape);
                    if (restoreFocusTarget) {
                        setTimeout(() => restoreFocusTarget.focus(), 0);
                    }
                };

                const handleEscape = (e) => {
                    if (e.key === 'Escape') {
                        handleClose();
                    }
                };

                detailsInput?.addEventListener('input', () => {
                    setSubmitting(false);
                });
                form?.addEventListener('input', () => setStatus(''));
                form?.addEventListener('change', () => setStatus(''));

                closeBtn?.addEventListener('click', handleClose);
                cancelBtn?.addEventListener('click', handleClose);
                overlay.addEventListener('click', (e) => {
                    if (e.target === overlay) {
                        handleClose();
                    }
                });

                form?.addEventListener('submit', async (submitEvent) => {
                    submitEvent.preventDefault();
                    syncDetailsValidity();

                    if (!form.reportValidity()) {
                        return;
                    }

                    const payload = {
                        id: reportProblemContext.miiId,
                        category: categorySelect.value,
                        email: emailInput.value.trim(),
                        details: detailsInput.value.trim()
                    };

                    try {
                        setStatus('');
                        setSubmitting(true);

                        const response = await fetch('/reportMii', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify(payload)
                        });
                        const result = await response.json().catch(() => ({}));

                        if (!response.ok || result.error) {
                            throw new Error(result.error || 'Failed to submit report');
                        }

                        isSubmitting = false;
                        handleClose();

                        const successMessage = result.warning
                            ? `Report ${result.reportReference || ''} was sent. ${result.warning}`.trim()
                            : `Report ${result.reportReference || ''} sent successfully.${result.followUpEmailSent ? ' We started a follow-up email thread.' : ''}`;

                        showAlert(successMessage, result.warning ? 7000 : 5000, {
                            title: result.warning ? 'Report Sent With Warning' : 'Report Sent',
                            type: result.warning ? 'info' : 'success'
                        });
                    } catch (error) {
                        console.error('Error submitting Mii report:', error);
                        setStatus(error.message || 'Failed to submit report', 'error');
                        setSubmitting(false);
                    }
                });

                document.addEventListener('keydown', handleEscape);
                setSubmitting(false);
                setTimeout(() => overlay.classList.add('active'), 10);
                categorySelect?.focus();
            }
