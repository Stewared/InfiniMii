                                    <span class="tomodachi-field-label"><%= tomodachiAddressRow.label %></span>
                                    <p class="tomodachi-island-address-value" data-tomodachi-address-display><%= tomodachiAddressRow.value %></p>
                                </div>
                            <% } %>

                            <div class="tomodachi-fields-grid">
