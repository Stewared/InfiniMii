<!DOCTYPE html>
<html lang="en">
    <head>
        <%
        const rawMiiName = (mii?.meta?.name ?? mii?.name ?? '').toString().trim();
        const miiName = rawMiiName || 'Unknown Mii';
        const seo = miiSeo || {};
        const officialSourceLabel = mii.official ? (seo.officialSourceName || officialSourceName || mii.officialSource || mii.uploader || 'Nintendo') : '';
        const categoryDetails = Array.isArray(seo.categoryDetails) ? seo.categoryDetails : [];
        const tagList = Array.isArray(seo.tagList) ? seo.tagList : [];
        const searchTopics = Array.isArray(seo.searchTopicPhrases) ? seo.searchTopicPhrases : [];
        const creatorName = seo.creatorName || '';
        const consoleLabel = seo.consoleLabel || '';
        const favoriteColorName = seo.favoriteColorName || '';
        const genderLabel = seo.genderLabel || '';
        const birthdayLabel = seo.birthdayLabel || '';
        const archiveTypeLabel = seo.archiveTypeLabel || (mii.official ? 'Official Mii' : (isPrivate ? 'Private Mii' : 'Community Mii'));
        const typeLabel = seo.typeLabel || 'Standard Mii';
        const keywordList = Array.isArray(seo.keywordList) ? seo.keywordList : [];
        const pageTitle = `${miiName} Mii QR Code & Download${mii.official ? ` | ${officialSourceLabel}` : ''} - InfiniMii`;
        const pageDesc = seo.metaDescription || mii.desc || `Download ${miiName} Mii character${mii.official ? ` from ${officialSourceLabel}` : ''} for Wii, 3DS, Wii U, and Switch. Get QR code access and convert to supported formats.`;
        const canonicalUrl = `${baseUrl}/mii/${mii.id}`;
        const ogImage = `${baseUrl}/miiImgs/${mii.id}.png`;
        const ogImageAlt = `${miiName} Mii character preview`;
        const ogType = 'article';
        const keywords = keywordList.length > 0
            ? keywordList.join(', ')
            : `${miiName}, ${mii.official ? 'official ' : ''}mii character, download mii, mii qr code`;
        const publishedTime = mii?.uploadedOn ? new Date(mii.uploadedOn).toISOString() : undefined;
        const modifiedTime = pageUpdatedAt || publishedTime;
        const pageRobots = isPrivate ? 'noindex, nofollow, noarchive' : undefined;
        const schemaType = 'ItemPage';
        const breadcrumbs = [
            { name: 'Home', url: '/' },
            { name: mii.official ? 'Official Miis' : 'Community Miis', url: mii.official ? '/official' : '/top' },
            { name: miiName, url: `/mii/${mii.id}` }
        ];
        const archiveOwnerLabel = mii.official ? officialSourceLabel : (seo.uploaderName || mii.uploader || 'InfiniMii User');
        const archiveOwnerStatsLabel = archiveOwnerStats?.totalMiis
            ? `${archiveOwnerLabel} has ${archiveOwnerStats.totalMiis} public Mii${archiveOwnerStats.totalMiis === 1 ? '' : 's'} on InfiniMii${archiveOwnerStats.totalLikes ? ` with ${archiveOwnerStats.totalLikes} total likes` : ''}.`
            : '';
        const archiveIntro = mii.official
            ? `${miiName} is preserved on InfiniMii as an official ${officialSourceLabel} Mii${creatorName ? ` with creator name ${creatorName}` : ''}. This page combines the character preview, QR code, export tools, and archive metadata in one place.`
            : `${miiName} is a community Mii uploaded by ${mii.uploader}${creatorName ? ` with creator name ${creatorName}` : ''}. This page combines the character preview, QR code, export tools, and archive metadata in one place.`;
        const archiveSearchIntro = searchTopics.length > 0
            ? `People often search for this entry using phrases like ${searchTopics.slice(0, 8).join(', ')}.`
            : '';
        const nameSearchUrl = `/searchResults?q=${encodeURIComponent(miiName)}&searchFieldsConfigured=1&searchIn=name`;
        const creatorSearchUrl = creatorName
            ? `/searchResults?q=${encodeURIComponent(creatorName)}&searchFieldsConfigured=1&searchIn=name`
            : '';
        const uploaderSearchUrl = `/searchResults?q=${encodeURIComponent(mii.uploader)}&searchFieldsConfigured=1&searchIn=uploader`;
        const archiveOwnerProfileUrl = `/user/${encodeURIComponent(mii.uploader)}`;
        const faqEntries = [
            {
                question: `How do I download ${miiName}?`,
                answer: `Use the download controls on this page to export ${miiName} as a QR code or another supported Mii format such as charinfo, studio, and other converter-friendly outputs.`
            },
            {
                question: `Who made ${miiName}?`,
                answer: mii.official
                    ? `${miiName} is archived here as an official ${officialSourceLabel} Mii${creatorName ? ` with creator name ${creatorName}` : ''}${mii.contributor ? `, contributed to InfiniMii by ${mii.contributor}` : ''}.`
                    : `${miiName} was uploaded to InfiniMii by ${mii.uploader}${creatorName ? ` and carries the creator name ${creatorName}` : ''}.`
            },
            {
                question: `Where can I use ${miiName}?`,
                answer: `The QR code and converter tools on this page are designed for common Nintendo Mii workflows including 3DS and Wii U QR importing plus compatible export paths for Wii, Switch, and related formats.`
            }
        ];
        const schemaGraphs = !pageRobots
            ? [{
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": faqEntries.map((entry) => ({
                    "@type": "Question",
                    "name": entry.question,
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": entry.answer
                    }
                }))
            }]
            : [];
        %>
        
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, ogImage, ogImageAlt, ogType, keywords, publishedTime, modifiedTime, pageRobots }) %>
        <%- include('structuredData') %>
        <%- include('miiSchema') %>
        
        <link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="/miiPage.css">
        
        <!-- Preload hero image -->
        <link rel="preload" as="image" href="/miiImgs/<%= mii.id %>.png">
    </head>
    <body>
        <%- include('globalStyle') %>
        <% 
            const imgPath = isPrivate ? 'privateMiiImgs' : 'miiImgs';
            const qrPath = isPrivate ? 'privateMiiQRs' : 'miiQRs';
        %>
        <%- include('header') %>
        <%- include('accountDisplay') %>

        <main class="content" role="main">
            <%- include('sidebar') %>

            <article class="mii-id-card" style="--favorite-color: <%= decodeColor(mii.general?.favoriteColor) || decodeColor(0) %>;" itemscope itemtype="https://schema.org/CreativeWork">
                <!-- Card Header -->
                <header class="id-card-header">
                    <h2 itemprop="name">Mii ID Card</h2>
                    <div class="card-number" role="button" tabindex="0" onclick="copyMiiId(this, '<%= mii.id %>')" aria-label="Copy Mii ID">ID: <%= mii.id %></div>
                </header>

                <!-- Main Card Body -->
                <div class="id-card-body">
                    <!-- Left side: Mii Image -->
                    <figure class="id-card-photo">
                        <img src="/<%= imgPath %>/<%= mii.id %>.png" 
                            onerror="this.src='/<%= imgPath %>/<%= mii.id %>.png'"
                            alt="<%= miiName %> Mii character face"
                            itemprop="image"
                            width="400" 
                            height="400"
                            fetchpriority="high">
                        <figcaption class="qr-code">
                            <a href="/<%= qrPath %>/<%= mii.id %>.png" target="_blank" rel="noopener noreferrer">
                                <img src="/<%= qrPath %>/<%= mii.id %>.png" 
                                    onerror="this.src='/<%= qrPath %>/<%= mii.id %>.png'"
                                    alt="QR Code for <%= miiName %> - Scan with 3DS, Wii U, Tomodachi Life, or Miitomo" 
                                    width="200" 
                                    height="200"
                                    loading="lazy">
                            </a>
                            <form id="miiQrExportForm" method="GET" action="/exportMii" style="margin-top: 10px; display: flex; flex-direction: column; gap: 6px; align-items: center;">
                                <input type="hidden" name="id" value="<%= mii.id %>">
                                <input type="hidden" name="format" value="qr">
                                <label for="qr-preview-console-<%= mii.id %>" style="display: inline-flex; align-items: center; gap: 6px;">
                                    QR:
                                    <select id="qr-preview-console-<%= mii.id %>" name="qrConsole">
                                        <option value="3DS">3DS</option>
                                        <option value="WIIU">Wii U</option>
                                    </select>
                                </label>
                                <label style="display: inline-flex; align-items: center; gap: 6px;">
                                    <input type="checkbox" name="special">
                                    Special
                                </label>
                                <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; justify-content: center;">
                                    <button type="submit" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;">Download QR</button>
                                    <button type="button" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;" onclick="copyMiiExportText('miiQrExportForm', 'hex')">Copy Hex</button>
                                    <button type="button" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;" onclick="copyMiiExportText('miiQrExportForm', 'base64')">Copy Base64</button>
                                </div>
                            </form>
                        </figcaption>
                    </figure>

                    <!-- Right side: Information -->
                    <div class="id-card-info">
                        <h1 class="mii-name"><%= miiName %></h1>
                        
                        <div class="info-grid">
                            <% if(creatorName.length > 0){ %>
                            <div class="info-item">
                                <span class="info-label">Creator Name</span>
                                <span class="info-value" itemprop="creator"><%= creatorName %></span>
                            </div>
                            <% } %>

                            <div class="info-item">
                                <span class="info-label">Archive Type</span>
                                <span class="info-value"><%= archiveTypeLabel %></span>
                            </div>

                            <% if(consoleLabel) { %>
                            <div class="info-item">
                                <span class="info-label">Original Console</span>
                                <span class="info-value"><%= consoleLabel %></span>
                            </div>
                            <% } %>

                            <% if(genderLabel) { %>
                            <div class="info-item">
                                <span class="info-label">Gender</span>
                                <span class="info-value"><%= genderLabel %></span>
                            </div>
                            <% } %>
                            
                            <div class="info-item">
                                <span class="info-label">Birthday</span>
                                <span class="info-value"><%= birthdayLabel || 'Not Set' %></span>
                            </div>

                            <% if(mii.general.height !== undefined) { %>
                            <div class="info-item">
                                <span class="info-label">Height</span>
                                <span class="info-value"><%= `${height.feet}' ${height.inches}"` %>, <%= height.centimeters %>cm.</span>
                            </div>
                            <% } %>

                            <% if(mii.general.weight !== undefined) { %>
                            <div class="info-item">
                                <span class="info-label">Weight [Experimental]</span>
                                <span class="info-value"><%= Math.round(weight.pounds) %>lbs, <%= weight.kilograms %>kg.</span>
                            </div>
                            <% } %>

                            <% if(favoriteColorName) { %>
                            <div class="info-item">
                                <span class="info-label">Favorite Color</span>
                                <span class="info-value"><%= favoriteColorName %></span>
                            </div>
                            <% } %>

                            <% if(mii.official && officialSourceLabel) { %>
                            <div class="info-item">
                                <span class="info-label">Official Source</span>
                                <span class="info-value"><%= officialSourceLabel %></span>
                            </div>
                            <% } else if(mii.uploader) { %>
                            <div class="info-item">
                                <span class="info-label">Uploaded By</span>
                                <span class="info-value"><%= mii.uploader %></span>
                            </div>
                            <% } %>

                            <% if(mii.contributor) { %>
                            <div class="info-item">
                                <span class="info-label">Contributor</span>
                                <span class="info-value"><%= mii.contributor %></span>
                            </div>
                            <% } %>
                                <script>
                                const currentCategories = <%- JSON.stringify(mii.officialCategories || []) %>;
                                const currentMiiTags = <%- JSON.stringify(mii.tags || []) %>;
                                const availableMiiTags = <%- JSON.stringify(availableTags || []) %>;
                                let selectedMiiTags = new Set(currentMiiTags);
                                let officialCategories = [];
                                let selectedPaths = new Set(currentCategories);
                                let expandedNodes = new Set();

                                async function loadCategoriesForEditor() {
                                    try {
                                        const response = await fetch('/getOfficialCategories', {
                                            headers: { "Content-Type": "application/json" },
                                        });
                                        const data = await response.json();
                                        
                                        if (!data.error) {
                                            officialCategories = data.categories?.categories || data.categories || [];
                                            // Auto-expand paths that contain selected categories
                                            currentCategories.forEach(path => {
                                                const parts = path.split('/');
                                                let currentPath = '';
                                                parts.forEach((part, index) => {
                                                    currentPath += (index > 0 ? '/' : '') + part;
                                                    if (index < parts.length - 1) {
                                                        expandedNodes.add(currentPath);
                                                    }
                                                });
                                            });
                                            return true;
                                        }
                                        return false;
                                    } catch (error) {
                                        console.error('Error loading categories:', error);
                                        return false;
                                    }
                                }

                                async function openCategoryEditor() {
                                    const loaded = await loadCategoriesForEditor();
                                    
                                    if (!loaded) {
                                        showAlert('Error loading categories', 5000, { title: 'Error', type: 'error' });
                                        return;
                                    }
                                    
                                    const modal = document.createElement('div');
                                    modal.className = 'category-modal-overlay';
                                    modal.id = 'categoryModal';
                                    
                                    const modalContent = document.createElement('div');
                                    modalContent.className = 'category-modal-panel';
                                    
                                    modalContent.innerHTML = `
                                        <h3 class="category-modal-title">Select Categories</h3>
                                        <p class="category-modal-help">Check all categories that apply. Only leaf categories (without children) can be selected.</p>
                                        <div class="category-modal-tree-wrap">
                                            <div id="modalCategoryTree"></div>
                                        </div>
                                        <div class="category-modal-actions">
                                            <button onclick="closeCategoryModal()" class="category-modal-btn category-modal-btn-cancel">
                                                Cancel
                                            </button>
                                            <button onclick="saveCategoriesFromModal()" class="category-modal-btn category-modal-btn-save">
                                                Save Categories
                                            </button>
                                        </div>
                                    `;
                                    
                                    modal.appendChild(modalContent);
                                    document.body.appendChild(modal);
                                    
                                    renderModalTree();
                                    
                                    modal.addEventListener('click', (e) => {
                                        if (e.target === modal) {
                                            modal.remove();
                                        }
                                    });
                                }

                                function renderModalTree() {
                                    const container = document.getElementById('modalCategoryTree');
                                    if (!container) return;
                                    
                                    container.innerHTML = renderModalNodes(officialCategories);
                                }

                                function renderModalNodes(nodes, level = 0) {
                                    let html = '';
                                    
                                    nodes.forEach(node => {
                                        const hasChildren = node.children && node.children.length > 0;
                                        const isExpanded = expandedNodes.has(node.path);
                                        const isLeaf = !hasChildren;
                                        const isSelected = selectedPaths.has(node.path);
                                        const indent = level * 20;
                                        const nodeColor = node.color || '#999999';
                                        
                                        html += `
                                            <div class="modal-category-node" style="--tree-indent: ${indent}px; --node-color: ${nodeColor};">
                                                <div class="modal-category-line">
                                                    ${hasChildren ? `
                                                        <span class="modal-category-toggle" onclick="toggleModalNode('${node.path}')">
                                                            ${isExpanded ? '▼' : '▶'}
                                                        </span>
                                                    ` : '<span class="modal-category-leaf-marker">•</span>'}
                                                    
                                                    ${isLeaf ? `
                                                        <label class="modal-category-label">
                                                            <input type="checkbox" 
                                                                class="category-selector"
                                                                value="${node.path}"
                                                                ${isSelected ? 'checked' : ''}
                                                                onchange="updateModalSelection('${node.path}', this.checked)">
                                                            <span class="modal-category-label-name">${node.name}</span>
                                                            <span class="modal-category-path">${node.path}</span>
                                                        </label>
                                                    ` : `
                                                        <span class="modal-category-parent-name">${node.name}</span>
                                                    `}
                                                </div>
                                                
                                                ${hasChildren && isExpanded ? `
                                                    <div class="modal-category-children">
                                                        ${renderModalNodes(node.children, level + 1)}
                                                    </div>
                                                ` : ''}
                                            </div>
                                        `;
                                    });
                                    
                                    return html;
                                }

                                function toggleModalNode(path) {
                                    if (expandedNodes.has(path)) {
                                        expandedNodes.delete(path);
                                    } else {
                                        expandedNodes.add(path);
                                    }
                                    renderModalTree();
                                }

                                function updateModalSelection(path, checked) {
                                    if (checked) {
                                        selectedPaths.add(path);
                                    } else {
                                        selectedPaths.delete(path);
                                    }
                                }

                                function closeCategoryModal() {
                                    document.getElementById('categoryModal')?.remove();
                                }

                                async function saveCategoriesFromModal() {
                                    const categories = Array.from(selectedPaths);
                                    
                                    await updateCategories(categories);
                                    closeCategoryModal();
                                }

                                async function updateCategories(categories) {
                                    try {
                                        const response = await fetch('/updateOfficialCategories', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({
                                                miiId: '<%= mii.id %>',
                                                categories: categories
                                            })
                                        });
                                        
                                        const data = await response.json();
                                        
                                        if (!data.error) {
                                            showAlert('Categories updated successfully!', 3000, { title: 'Success', type: 'success' });
                                            setTimeout(() => window.location.reload(), 3000);
                                        } else {
                                            showAlert('Error: ' + (data.error || 'Failed to update categories'), 5000, { title: 'Error', type: 'error' });
                                        }
                                    } catch (error) {
                                        console.error('Error:', error);
                                        showAlert('Error updating categories', 5000, { title: 'Error', type: 'error' });
                                    }
                                }
                                </script>
                            <div class="mii-tags-section">
                                <span class="info-label">Tags</span>
                                <% if(tagList.length > 0) { %>
                                    <div class="mii-tags-list">
                                        <% tagList.forEach(tag => { %>
                                            <a class="mii-tag-badge" href="/searchResults?tags=<%= encodeURIComponent(tag) %>"><%= tag %></a>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <span class="no-tags">No tags assigned.</span>
                                <% } %>
                            </div>

                            <% if(categoryDetails.length > 0) { %>
                            <div class="official-categories-section">
                                <span class="info-label">Official Categories</span>
                                <div class="categories-display">
                                    <% categoryDetails.forEach(category => { %>
                                        <a class="category-badge" href="<%= category.url %>" style="--category-color: <%= category.color || '#999999' %>;">
                                            <%= category.fullPath || category.name %>
                                        </a>
                                    <% }); %>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% if(isPrivate) { %>
                        <div style="background: #fff3cd; border: 2px solid #ffc107; padding: 15px; margin: 15px; border-radius: 8px; text-align: center;">
                            <strong><%- include('icon', { name: 'lock', size: 16, class: 'icon-inline' }) %> This is a Private Mii</strong>
                            <p style="margin: 10px 0;">Only you and moderators can view this Mii.</p>
                            <% if(mii.blockedFromPublishing) { %>
                                <div style="background: #ffe6e6; padding: 10px; margin-top: 10px; border-radius: 6px;">
                                    <strong><%- include('icon', { name: 'ban', size: 16, class: 'icon-inline icon-danger' }) %> This Mii has been blocked from publishing</strong>
                                    <% if(mii.blockReason) { %>
                                        <p><%= mii.blockReason %></p>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <button onclick="publishThisMii()" style="background: #00cc00; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 10px;">
                                    <%- include('icon', { name: 'upload', size: 16 }) %> Publish This Mii
                                </button>
                            <% } %>
                        </div>
                        <% if(isModerator) { %>
                            <div style="background: #fff3cd; border: 2px solid #ff6600; padding: 15px; margin: 15px; border-radius: 8px;">
                                <strong><%- include('icon', { name: 'shield', size: 16, class: 'icon-inline' }) %> Moderator Actions</strong>
                                <% if(!mii.blockedFromPublishing) { %>
                                    <button onclick="blockMiiFromPublishing()" style="background: #ff6600; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 10px;">
                                        <%- include('icon', { name: 'ban', size: 16 }) %> Block from Publishing
                                    </button>
                                <% } else { %>
                                    <p style="margin: 10px 0;">This Mii is already blocked from publishing.</p>
                                    <button onclick="unblockMiiFromPublishing()" style="background: #2e7d32; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 10px;">
                                        <%- include('icon', { name: 'check', size: 16 }) %> Unblock Publishing
                                    </button>
                                <% } %>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <!-- Uploader Information -->
                <!-- Footer Section -->
                <div class="id-card-footer">
                    <div class="uploader-info">
                        <% if(mii.official){ %>
                            <span class="official-badge"><%- include('icon', { name: 'star-filled', size: 14, class: 'icon-gold' }) %> Official Mii</span>
                            <span class="label">Source</span>
                            <a class="uploader-with-pfp" href="/user/<%= encodeURIComponent(mii.uploader) %>">
                                <img
                                    class="uploader-pfp"
                                    src="/miiImgs/<%= uploaderPfp %>.png"
                                    alt="<%= officialSourceName %>'s profile Mii"
                                    onerror="this.src='/miiImgs/00000.png'"
                                    loading="lazy"
                                    width="28"
                                    height="28"
                                >
                                <span><%= officialSourceName %></span>
                            </a>
                            <% if(mii.contributor) { %>
                                <small class="uploader-subtext">Uploaded by <a href="/user/<%= encodeURIComponent(mii.contributor) %>"><%= mii.contributor %></a></small>
                            <% } %>
                        <% } else { %>
                            <span class="label">Uploaded by</span>
                            <a class="uploader-with-pfp" href="/user/<%= encodeURIComponent(mii.uploader) %>">
                                <img
                                    class="uploader-pfp"
                                    src="/miiImgs/<%= uploaderPfp %>.png"
                                    alt="<%= mii.uploader %>'s profile Mii"
                                    onerror="this.src='/miiImgs/00000.png'"
                                    loading="lazy"
                                    width="28"
                                    height="28"
                                >
                                <span><%= mii.uploader %></span>
                            </a>
                        <% } %>
                        <time class="date" datetime="<%= new Date(mii.uploadedOn).toISOString() %>" itemprop="datePublished">on <%= new Date(mii.uploadedOn).toLocaleDateString() %></time>
                    </div>
                </div>
                <!-- Description -->
                <div class="id-card-description">
                    <h3 class="info-label">Description</h3>
                    <p itemprop="description"><%= (mii.desc && mii.desc.length > 0) ? mii.desc : `${archiveIntro} ${archiveOwnerStatsLabel}`.trim() %></p>
                </div>

                <!-- Actions -->
                <div class="id-card-actions">
                    <button class="btn-primary" onclick="copyMiiId(this, '<%= mii.id %>')">
                        <svg xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 96 960 960" width="20" fill="currentColor">
                            <path d="M360 816q-33 0-56.5-23.5T280 736V256q0-33 23.5-56.5T360 176h360q33 0 56.5 23.5T800 256v480q0 33-23.5 56.5T720 816H360Zm0-80h360V256H360v480ZM200 976q-33 0-56.5-23.5T120 896V336h80v560h440v80H200Zm160-240V256v480Z"/>
                        </svg>
                        <span class="copy-label">Copy Mii ID</span>
                    </button>

                    <form id="miiExportForm" class="export-form" method="GET" action="/exportMii">
                        <input type="hidden" name="id" value="<%= mii.id %>">
                        <label for="export-format-<%= mii.id %>">Download format</label>
                        <div class="export-row">
                            <input type="text" id="export-format-<%= mii.id %>" name="format" list="exportFormatOptions" placeholder="Search formats..." required>
                            <button type="submit" class="btn-primary">Download</button>
                            <button type="button" class="btn-secondary" onclick="copyMiiExportText('miiExportForm', 'hex')">Copy Hex</button>
                            <button type="button" class="btn-secondary" onclick="copyMiiExportText('miiExportForm', 'base64')">Copy Base64</button>
