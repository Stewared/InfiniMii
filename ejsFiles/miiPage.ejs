            async function saveModeratorEdits() {
                const button = document.getElementById('saveModeratorEditsButton');
                const changes = [];

                const name = document.getElementById('editMiiName')?.value ?? '';
                if (name !== originalMiiEditorState.name) {
                    if (!validateEditorValue(name, 'name')) return;
                    changes.push({
                        label: 'name',
                        run: () => submitMiiFieldUpdate('name', name)
                    });
                }

                const desc = document.getElementById('editDesc')?.value ?? '';
                if (desc !== originalMiiEditorState.desc) {
                    if (!validateEditorValue(desc, 'description')) return;
                    changes.push({
                        label: 'description',
                        run: () => submitMiiFieldUpdate('desc', desc)
                    });
                }

                const creatorName = document.getElementById('editCreatorName')?.value ?? '';
                if (creatorName !== originalMiiEditorState.creatorName) {
                    if (!validateEditorValue(creatorName, 'creator name')) return;
                    changes.push({
                        label: 'creator name',
                        run: () => submitMiiFieldUpdate('creatorName', creatorName)
                    });
                }

                const uploader = document.getElementById('editUploader')?.value ?? '';
                if (uploader !== originalMiiEditorState.uploader) {
                    if (!validateEditorValue(uploader, 'uploader')) return;
                    changes.push({
                        label: 'uploader',
                        run: () => submitMiiFieldUpdate('uploader', uploader)
                    });
                }

                const tags = Array.from(selectedMiiTags);
                if (!arraysEqualAsSets(tags, originalMiiEditorState.tags)) {
                    changes.push({
                        label: 'tags',
                        run: () => submitMiiTagsUpdate(tags)
                    });
                }

                const categories = Array.from(selectedPaths);
                if (!arraysEqualAsSets(categories, originalMiiEditorState.categories) && document.querySelector('.category-trigger-summary')) {
                    changes.push({
                        label: 'official categories',
                        run: () => updateCategories(categories)
                    });
                }

                const officialCheckbox = document.getElementById('officialCheckbox');
                if (officialCheckbox && officialCheckbox.checked !== originalMiiEditorState.official) {
                    changes.push({
                        label: 'official status',
                        run: () => submitOfficialStatusUpdate(officialCheckbox.checked)
                    });
                }

                await saveStagedEditorChanges(changes, button, 'Save Moderator Changes');
            }

            async function saveOfficialEditorChanges() {
