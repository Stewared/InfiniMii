<!DOCTYPE html>
<html lang="en">
    <head>
        <%
        const rawMiiName = (mii?.meta?.name ?? mii?.name ?? '').toString().trim();
        const miiName = rawMiiName || 'Unknown Mii';
        const seo = miiSeo || {};
        const officialSourceLabel = mii.official ? (seo.officialSourceName || officialSourceName || mii.officialSource || mii.uploader || 'Nintendo') : '';
        const categoryDetails = Array.isArray(seo.categoryDetails) ? seo.categoryDetails : [];
        const tagList = Array.isArray(seo.tagList) ? seo.tagList : [];
        const searchTopics = Array.isArray(seo.searchTopicPhrases) ? seo.searchTopicPhrases : [];
        const creatorName = seo.creatorName || '';
        const consoleLabel = seo.consoleLabel || '';
        const favoriteColorName = seo.favoriteColorName || '';
        const genderLabel = seo.genderLabel || '';
        const birthdayLabel = seo.birthdayLabel || '';
        const archiveTypeLabel = seo.archiveTypeLabel || (mii.official ? 'Official Mii' : (isPrivate ? 'Private Mii' : 'Community Mii'));
        const typeLabel = seo.typeLabel || 'Standard Mii';
        const keywordList = Array.isArray(seo.keywordList) ? seo.keywordList : [];
        const pageTitle = `${miiName} Mii QR Code & Download${mii.official ? ` | ${officialSourceLabel}` : ''} - InfiniMii`;
        const pageDesc = seo.metaDescription || mii.desc || `Download ${miiName} Mii character${mii.official ? ` from ${officialSourceLabel}` : ''} for Wii, 3DS, Wii U, and Switch. Get QR code access and convert to supported formats.`;
        const canonicalUrl = `${baseUrl}/mii/${mii.id}`;
        const imgPath = isPrivate ? 'privateMiiImgs' : 'miiImgs';
        const qrPath = isPrivate ? 'privateMiiQRs' : 'miiQRs';
        const previewAssetVersionSource = mii?.updatedAt || pageUpdatedAt || mii?.uploadedOn || Date.now();
        const previewAssetVersionRaw = typeof previewAssetVersionSource === 'number'
            ? previewAssetVersionSource
            : new Date(previewAssetVersionSource).getTime();
        const previewAssetVersion = Number.isFinite(previewAssetVersionRaw)
            ? previewAssetVersionRaw
            : Date.now();
        const previewImagePath = `/${imgPath}/${mii.id}.png?v=${encodeURIComponent(previewAssetVersion)}`;
        const previewQrPath = `/${qrPath}/${mii.id}.png?v=${encodeURIComponent(previewAssetVersion)}`;
        const ogImage = isPrivate
            ? `${baseUrl}/miiImgs/00000.png`
            : `${baseUrl}${previewImagePath}`;
        const ogImageAlt = `${miiName} Mii character preview`;
        const ogType = 'article';
        const keywords = keywordList.length > 0
            ? keywordList.join(', ')
            : `${miiName}, ${mii.official ? 'official ' : ''}mii character, download mii, mii qr code`;
        const publishedTime = mii?.uploadedOn ? new Date(mii.uploadedOn).toISOString() : undefined;
        const modifiedTime = pageUpdatedAt || publishedTime;
        const pageRobots = isPrivate ? 'noindex, nofollow, noarchive' : undefined;
        const schemaType = 'ItemPage';
        const canChangeMiiId = Boolean(isModerator && mii.id !== 'average');
        const canSetMiiIdDirectly = Boolean(isAdmin && mii.id !== 'average');
        const breadcrumbs = [
            { name: 'Home', url: '/' },
            { name: mii.official ? 'Official Miis' : 'Community Miis', url: mii.official ? '/official' : '/top' },
            { name: miiName, url: `/mii/${mii.id}` }
        ];
        const archiveOwnerLabel = mii.official ? officialSourceLabel : (seo.uploaderName || mii.uploader || 'InfiniMii User');
        const archiveOwnerStatsLabel = archiveOwnerStats?.totalMiis
            ? `${archiveOwnerLabel} has ${archiveOwnerStats.totalMiis} public Mii${archiveOwnerStats.totalMiis === 1 ? '' : 's'} on InfiniMii${archiveOwnerStats.totalLikes ? ` with ${archiveOwnerStats.totalLikes} total likes` : ''}.`
            : '';
        const archiveIntro = mii.official
            ? `${miiName} is preserved on InfiniMii as an official ${officialSourceLabel} Mii${creatorName ? ` with creator name ${creatorName}` : ''}. This page combines the character preview, QR code, export tools, and archive metadata in one place.`
            : `${miiName} is a community Mii uploaded by ${mii.uploader}${creatorName ? ` with creator name ${creatorName}` : ''}. This page combines the character preview, QR code, export tools, and archive metadata in one place.`;
        const archiveSearchIntro = searchTopics.length > 0
            ? `People often search for this entry using phrases like ${searchTopics.slice(0, 8).join(', ')}.`
            : '';
        const nameSearchUrl = `/searchResults?q=${encodeURIComponent(miiName)}&searchFieldsConfigured=1&searchIn=name`;
        const creatorSearchUrl = creatorName
            ? `/searchResults?q=${encodeURIComponent(creatorName)}&searchFieldsConfigured=1&searchIn=name`
            : '';
        const uploaderSearchUrl = `/searchResults?q=${encodeURIComponent(mii.uploader)}&searchFieldsConfigured=1&searchIn=uploader`;
        const archiveOwnerProfileUrl = `/user/${encodeURIComponent(mii.uploader)}`;
        const faqEntries = [
            {
                question: `How do I download ${miiName}?`,
                answer: `Use the download controls on this page to export ${miiName} as a QR code or another supported Mii format such as charinfo, studio, and other converter-friendly outputs.`
            },
            {
                question: `Who made ${miiName}?`,
                answer: mii.official
                    ? `${miiName} is archived here as an official ${officialSourceLabel} Mii${creatorName ? ` with creator name ${creatorName}` : ''}${mii.contributor ? `, contributed to InfiniMii by ${mii.contributor}` : ''}.`
                    : `${miiName} was uploaded to InfiniMii by ${mii.uploader}${creatorName ? ` and carries the creator name ${creatorName}` : ''}.`
            },
            {
                question: `Where can I use ${miiName}?`,
                answer: `The QR code and converter tools on this page are designed for common Nintendo Mii workflows including 3DS and Wii U QR importing plus compatible export paths for Wii, Switch, and related formats.`
            }
        ];
        const schemaGraphs = !pageRobots
            ? [{
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": faqEntries.map((entry) => ({
                    "@type": "Question",
                    "name": entry.question,
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": entry.answer
                    }
                }))
            }]
            : [];
        %>
        
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, ogImage, ogImageAlt, ogType, keywords, publishedTime, modifiedTime, pageRobots }) %>
        <%- include('structuredData') %>
        <%- include('miiSchema') %>
        
        <link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="/miiPage.css">
        
        <!-- Preload hero image -->
        <link rel="preload" as="image" href="<%= previewImagePath %>">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>

        <main class="content" role="main">
            <%- include('sidebar') %>

            <article class="mii-id-card" style="--favorite-color: <%= decodeColor(mii.general?.favoriteColor) || decodeColor(0) %>;" itemscope itemtype="https://schema.org/CreativeWork">
                <!-- Card Header -->
                <header class="id-card-header">
                    <h2 itemprop="name">Mii ID Card</h2>
                    <div class="id-card-header-tools">
                        <div class="card-number" role="button" tabindex="0" onclick="copyMiiId(this, '<%= mii.id %>')" aria-label="Copy Mii ID">ID: <%= mii.id %></div>
                        <% if (canChangeMiiId) { %>
                            <button
                                type="button"
                                id="headerRegenerateMiiIdButton"
                                class="mii-id-refresh-button"
                                onclick="regenerateMiiId(this)"
                                aria-label="Generate a new Mii ID"
                                title="Generate a new Mii ID"
                            >
                                <%- include('icon', { name: 'refresh', size: 16 }) %>
                                <span>New ID</span>
                            </button>
                        <% } %>
                    </div>
                </header>

                <!-- Main Card Body -->
                <div class="id-card-body">
                    <!-- Left side: Mii Image -->
                    <figure class="id-card-photo">
                        <img src="<%= previewImagePath %>" 
                            onerror="this.src='<%= previewImagePath %>'"
                            alt="<%= miiName %> Mii character face"
                            itemprop="image"
                            width="400" 
                            height="400"
                            fetchpriority="high">
                        <figcaption class="qr-code">
                            <a href="<%= previewQrPath %>" target="_blank" rel="noopener noreferrer">
                                <img src="<%= previewQrPath %>" 
                                    onerror="this.src='<%= previewQrPath %>'"
                                    alt="QR Code for <%= miiName %> - Scan with 3DS, Wii U, Tomodachi Life, or Miitomo" 
                                    width="200" 
                                    height="200"
                                    loading="lazy">
                            </a>
                            <form id="miiQrExportForm" method="GET" action="/exportMii" style="margin-top: 10px; display: flex; flex-direction: column; gap: 6px; align-items: center;">
                                <input type="hidden" name="id" value="<%= mii.id %>">
                                <input type="hidden" name="format" value="qr">
                                <label for="qr-preview-console-<%= mii.id %>" style="display: inline-flex; align-items: center; gap: 6px;">
                                    QR:
                                    <select id="qr-preview-console-<%= mii.id %>" name="qrConsole">
                                        <option value="3DS">3DS</option>
                                        <option value="WIIU">Wii U</option>
                                    </select>
                                </label>
                                <label style="display: inline-flex; align-items: center; gap: 6px;">
                                    <input type="checkbox" name="special">
                                    Special
                                </label>
                                <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; justify-content: center;">
                                    <button type="submit" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;">Download QR</button>
                                    <button type="button" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;" onclick="copyQrPreviewMnmsText('hex')">Copy Hex</button>
                                    <button type="button" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;" onclick="copyQrPreviewMnmsText('base64')">Copy Base64</button>
                                </div>
                            </form>
                        </figcaption>
                    </figure>

                    <!-- Right side: Information -->
                    <div class="id-card-info">
                        <h1 class="mii-name"><%= miiName %></h1>
                        
                        <div class="info-grid">
                            <% if(creatorName.length > 0){ %>
                            <div class="info-item">
                                <span class="info-label">Creator Name</span>
                                <span class="info-value" itemprop="creator"><%= creatorName %></span>
                            </div>
                            <% } %>

                            <% if(genderLabel) { %>
                            <div class="info-item">
                                <span class="info-label">Gender</span>
                                <span class="info-value"><%= genderLabel %></span>
                            </div>
                            <% } %>
                            
                            <div class="info-item">
                                <span class="info-label">Birthday</span>
                                <span class="info-value"><%= birthdayLabel || 'Not Set' %></span>
                            </div>

                            <% if(mii.general.height !== undefined) { %>
                            <div class="info-item">
                                <span class="info-label">Height</span>
                                <span class="info-value"><%= `${height.feet}' ${height.inches}"` %>, <%= height.centimeters %>cm.</span>
                            </div>
                            <% } %>

                            <% if(mii.general.weight !== undefined) { %>
                            <div class="info-item">
                                <span class="info-label">Weight [Experimental]</span>
                                <span class="info-value"><%= Math.round(weight.pounds) %>lbs, <%= weight.kilograms %>kg.</span>
                            </div>
                            <% } %>

                            <% if(favoriteColorName) { %>
                            <div class="info-item">
                                <span class="info-label">Favorite Color</span>
                                <span class="info-value"><%= favoriteColorName %></span>
                            </div>
                            <% } %>

                            <% if(mii.official && officialSourceLabel) { %>
                            <div class="info-item">
                                <span class="info-label">Official Source</span>
                                <span class="info-value"><%= officialSourceLabel %></span>
                            </div>
                            <% } else if(mii.uploader) { %>
                            <div class="info-item">
                                <span class="info-label">Uploaded By</span>
                                <span class="info-value"><%= mii.uploader %></span>
                            </div>
                            <% } %>

                            <% if(mii.contributor) { %>
                            <div class="info-item">
                                <span class="info-label">Contributor</span>
                                <span class="info-value"><%= mii.contributor %></span>
                            </div>
                            <% } %>
                                <script>
                                const currentCategories = <%- toScriptJson(mii.officialCategories || []) %>;
                                const currentMiiTags = <%- toScriptJson(mii.tags || []) %>;
                                const availableMiiTags = <%- toScriptJson(availableTags || []) %>;
                                const reportMiiCategories = <%- toScriptJson(reportMiiCategories || []) %>;
                                const reportProblemContext = Object.freeze({
                                    miiId: <%- toScriptJson(mii.id) %>,
                                    miiName: <%- toScriptJson(mii.meta?.name || mii.name || "Mii") %>,
                                    discordInvite: <%- toScriptJson(discordInvite || "") %>
                                });
                                function escapeHtml(value) {
                                    return String(value ?? '').replace(/[&<>"']/g, (character) => ({
                                        '&': '&amp;',
                                        '<': '&lt;',
                                        '>': '&gt;',
                                        '"': '&quot;',
                                        "'": '&#39;'
                                    }[character]));
                                }

                                function escapeForSingleQuote(value) {
                                    return String(value ?? '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
                                }

                                const originalMiiEditorState = Object.freeze({
                                    name: <%- toScriptJson(mii.meta?.name || '') %>,
                                    desc: <%- toScriptJson(mii.desc || '') %>,
                                    creatorName: <%- toScriptJson(mii.meta?.creatorName || '') %>,
                                    uploader: <%- toScriptJson(mii.uploader || '') %>,
                                    official: <%- toScriptJson(Boolean(mii.official)) %>,
                                    categories: [...currentCategories].map((value) => String(value ?? '')).sort(),
                                    tags: [...currentMiiTags].map((value) => String(value ?? '')).sort()
                                });
                                let selectedMiiTags = new Set(currentMiiTags);
                                let officialCategories = [];
                                let selectedPaths = new Set(currentCategories);
                                let expandedNodes = new Set();
                                let modalSelectedPaths = null;

                                function sortComparableValues(values) {
                                    return [...new Set((values || []).map((value) => String(value ?? '')))].sort();
                                }

                                function arraysEqualAsSets(a, b) {
                                    const left = sortComparableValues(a);
                                    const right = sortComparableValues(b);
                                    if (left.length !== right.length) return false;
                                    return left.every((value, index) => value === right[index]);
                                }

                                function updateCategoryEditorTriggers() {
                                    const selectedCount = sortComparableValues(Array.from(selectedPaths)).length;
                                    const summary = selectedCount > 0
                                        ? `(${selectedCount} selected)`
                                        : '(none selected)';
                                    document.querySelectorAll('.category-trigger-summary').forEach((el) => {
                                        el.textContent = summary;
                                    });
                                }

                                function updateOfficialCheckboxLabel() {
                                    const checkbox = document.getElementById('officialCheckbox');
                                    const icon = document.getElementById('officialCheckboxIcon');
                                    const label = document.getElementById('officialCheckboxLabel');
                                    if (!checkbox || !label) return;
                                    if (icon) {
                                        icon.textContent = checkbox.checked ? '✅' : '❌';
                                    }
                                    label.textContent = checkbox.checked
                                        ? 'This is an Official Mii'
                                        : 'Not an Official Mii';
                                }

                                async function loadCategoriesForEditor() {
                                    try {
                                        const response = await fetch('/getOfficialCategories', {
                                            headers: { "Content-Type": "application/json" },
                                        });
                                        const data = await response.json();
                                        
                                        if (!data.error) {
                                            officialCategories = data.categories?.categories || data.categories || [];
                                            // Auto-expand paths that contain selected categories
                                            Array.from(selectedPaths).forEach(path => {
                                                const parts = path.split('/');
                                                let currentPath = '';
                                                parts.forEach((part, index) => {
                                                    currentPath += (index > 0 ? '/' : '') + part;
                                                    if (index < parts.length - 1) {
                                                        expandedNodes.add(currentPath);
                                                    }
                                                });
                                            });
                                            return true;
                                        }
                                        return false;
                                    } catch (error) {
                                        console.error('Error loading categories:', error);
                                        return false;
                                    }
                                }

                                async function openCategoryEditor() {
                                    const loaded = await loadCategoriesForEditor();
                                    
                                    if (!loaded) {
                                        showAlert('Error loading categories', 5000, { title: 'Error', type: 'error' });
                                        return;
                                    }
                                    
                                    const modal = document.createElement('div');
                                    modal.className = 'category-modal-overlay';
                                    modal.id = 'categoryModal';
                                    
                                    const modalContent = document.createElement('div');
                                    modalContent.className = 'category-modal-panel';
                                    
                                    modalSelectedPaths = new Set(selectedPaths);

                                    modalContent.innerHTML = `
                                        <h3 class="category-modal-title">Select Categories</h3>
                                        <p class="category-modal-help">Check all categories that apply. Only leaf categories (without children) can be selected.</p>
                                        <div class="category-modal-tree-wrap">
                                            <div id="modalCategoryTree"></div>
                                        </div>
                                        <div class="category-modal-actions">
                                            <button onclick="closeCategoryModal()" class="category-modal-btn category-modal-btn-cancel">
                                                Cancel
                                            </button>
                                            <button onclick="saveCategoriesFromModal()" class="category-modal-btn category-modal-btn-save">
                                                Apply Categories
                                            </button>
                                        </div>
                                    `;
                                    
                                    modal.appendChild(modalContent);
                                    document.body.appendChild(modal);
                                    
                                    renderModalTree();
                                    
                                    modal.addEventListener('click', (e) => {
                                        if (e.target === modal) {
                                            closeCategoryModal();
                                        }
                                    });
                                }

                                function renderModalTree() {
                                    const container = document.getElementById('modalCategoryTree');
                                    if (!container) return;
                                    
                                    container.innerHTML = renderModalNodes(officialCategories);
                                }

                                function renderModalNodes(nodes, level = 0) {
                                    let html = '';
                                    
                                    nodes.forEach(node => {
                                        const hasChildren = node.children && node.children.length > 0;
                                        const isExpanded = expandedNodes.has(node.path);
                                        const isLeaf = !hasChildren;
                                        const activeSelectedPaths = modalSelectedPaths || selectedPaths;
                                        const isSelected = activeSelectedPaths.has(node.path);
                                        const indent = level * 20;
                                        const nodeColor = node.color || '#999999';
                                        const escapedPathForJs = escapeForSingleQuote(node.path);
                                        const escapedPathForHtml = escapeHtml(node.path);
                                        const escapedName = escapeHtml(node.name);
                                        
                                        html += `
                                            <div class="modal-category-node" style="--tree-indent: ${indent}px; --node-color: ${nodeColor};">
                                                <div class="modal-category-line">
                                                    ${hasChildren ? `
                                                        <span class="modal-category-toggle" onclick="toggleModalNode('${escapedPathForJs}')">
                                                            ${isExpanded ? '▼' : '▶'}
                                                        </span>
                                                    ` : '<span class="modal-category-leaf-marker">•</span>'}
                                                    
                                                    ${isLeaf ? `
                                                        <label class="modal-category-label">
                                                            <input type="checkbox" 
                                                                class="category-selector"
                                                                value="${escapedPathForHtml}"
                                                                ${isSelected ? 'checked' : ''}
                                                                onchange="updateModalSelection('${escapedPathForJs}', this.checked)">
                                                            <span class="modal-category-label-name">${escapedName}</span>
                                                            <span class="modal-category-path">${escapedPathForHtml}</span>
                                                        </label>
                                                    ` : `
                                                        <span class="modal-category-parent-name">${escapedName}</span>
                                                    `}
                                                </div>
                                                
                                                ${hasChildren && isExpanded ? `
                                                    <div class="modal-category-children">
                                                        ${renderModalNodes(node.children, level + 1)}
                                                    </div>
                                                ` : ''}
                                            </div>
                                        `;
                                    });
                                    
                                    return html;
                                }

                                function toggleModalNode(path) {
                                    if (expandedNodes.has(path)) {
                                        expandedNodes.delete(path);
                                    } else {
                                        expandedNodes.add(path);
                                    }
                                    renderModalTree();
                                }

                                function updateModalSelection(path, checked) {
                                    if (!modalSelectedPaths) {
                                        modalSelectedPaths = new Set(selectedPaths);
                                    }
                                    if (checked) {
                                        modalSelectedPaths.add(path);
                                    } else {
                                        modalSelectedPaths.delete(path);
                                    }
                                }

                                function closeCategoryModal() {
                                    modalSelectedPaths = null;
                                    document.getElementById('categoryModal')?.remove();
                                }

                                async function saveCategoriesFromModal() {
                                    selectedPaths = new Set(modalSelectedPaths || selectedPaths);
                                    updateCategoryEditorTriggers();
                                    closeCategoryModal();
                                }

                                async function updateCategories(categories) {
                                    try {
                                        const response = await fetch('/updateOfficialCategories', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({
                                                miiId: '<%= mii.id %>',
                                                categories: categories
                                            })
                                        });
                                        
                                        return await response.json();
                                    } catch (error) {
                                        console.error('Error:', error);
                                        return { error: 'Error updating categories' };
                                    }
                                }
                                </script>
                            <div class="mii-tags-section">
                                <span class="info-label">Tags</span>
                                <% if(tagList.length > 0) { %>
                                    <div class="mii-tags-list">
                                        <% tagList.forEach(tag => { %>
                                            <a class="mii-tag-badge" href="/searchResults?tags=<%= encodeURIComponent(tag) %>"><%= tag %></a>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <span class="no-tags">No tags assigned.</span>
                                <% } %>
                            </div>

                            <% if(categoryDetails.length > 0) { %>
                            <div class="official-categories-section">
                                <span class="info-label">Official Categories</span>
                                <div class="categories-display">
                                    <% categoryDetails.forEach(category => { %>
                                        <a class="category-badge" href="<%= category.url %>" style="--category-color: <%= category.color || '#999999' %>;">
                                            <%= category.fullPath || category.name %>
                                        </a>
                                    <% }); %>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% if(isPrivate) { %>
                        <div class="private-mii-panel">
                            <strong class="private-mii-panel-title"><%- include('icon', { name: 'lock', size: 16, class: 'icon-inline' }) %> This is a Private Mii</strong>
                            <p class="private-mii-panel-text">Only you and moderators can view this Mii.</p>
                            <% if(mii.blockedFromPublishing) { %>
                                <div class="private-mii-status">
                                    <strong class="private-mii-status-title"><%- include('icon', { name: 'ban', size: 16, class: 'icon-inline icon-danger' }) %> This Mii has been blocked from publishing</strong>
                                    <% if(mii.blockReason) { %>
                                        <p class="private-mii-status-text"><%= mii.blockReason %></p>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <div class="private-mii-actions">
                                    <button onclick="publishThisMii()" class="btn-primary private-mii-btn">
                                        <%- include('icon', { name: 'upload', size: 16 }) %> Publish This Mii
                                    </button>
                                </div>
                            <% } %>
                        </div>
                        <% if(isModerator) { %>
                            <div class="private-mii-panel private-mii-panel-moderator">
                                <strong class="private-mii-panel-title"><%- include('icon', { name: 'shield', size: 16, class: 'icon-inline' }) %> Moderator Actions</strong>
                                <% if(!mii.blockedFromPublishing) { %>
                                    <div class="private-mii-actions">
                                        <button onclick="blockMiiFromPublishing()" class="private-mii-btn private-mii-btn-warning">
                                            <%- include('icon', { name: 'ban', size: 16 }) %> Block from Publishing
                                        </button>
                                    </div>
                                <% } else { %>
                                    <p class="private-mii-panel-text">This Mii is already blocked from publishing.</p>
                                    <div class="private-mii-actions">
                                        <button onclick="unblockMiiFromPublishing()" class="private-mii-btn private-mii-btn-success">
                                            <%- include('icon', { name: 'check', size: 16 }) %> Unblock Publishing
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <!-- Uploader Information -->
                <!-- Footer Section -->
                <div class="id-card-footer">
                    <div class="uploader-info">
                        <% if(mii.official){ %>
                            <span class="official-badge"><%- include('icon', { name: 'star-filled', size: 14, class: 'icon-gold' }) %> Official Mii</span>
                            <span class="label">Source</span>
                            <a class="uploader-with-pfp" href="/user/<%= encodeURIComponent(mii.uploader) %>">
                                <img
                                    class="uploader-pfp"
                                    src="/miiImgs/<%= uploaderPfp %>.png"
                                    alt="<%= officialSourceName %>'s profile Mii"
                                    onerror="this.src='/miiImgs/00000.png'"
                                    loading="lazy"
                                    width="28"
                                    height="28"
                                >
                                <span><%= officialSourceName %></span>
                            </a>
                            <% if(mii.contributor) { %>
                                <small class="uploader-subtext">Uploaded by <a href="/user/<%= encodeURIComponent(mii.contributor) %>"><%= mii.contributor %></a></small>
                            <% } %>
                        <% } else { %>
                            <span class="label">Uploaded by</span>
                            <a class="uploader-with-pfp" href="/user/<%= encodeURIComponent(mii.uploader) %>">
                                <img
                                    class="uploader-pfp"
                                    src="/miiImgs/<%= uploaderPfp %>.png"
                                    alt="<%= mii.uploader %>'s profile Mii"
                                    onerror="this.src='/miiImgs/00000.png'"
                                    loading="lazy"
                                    width="28"
                                    height="28"
                                >
                                <span><%= mii.uploader %></span>
                            </a>
                        <% } %>
                        <time class="date" datetime="<%= new Date(mii.uploadedOn).toISOString() %>" itemprop="datePublished">on <%= new Date(mii.uploadedOn).toLocaleDateString() %></time>
                    </div>
                </div>
                <!-- Description -->
                <div class="id-card-description">
                    <h3 class="info-label">Description</h3>
                    <p itemprop="description"><%= (mii.desc && mii.desc.length > 0) ? mii.desc : `${archiveIntro} ${archiveOwnerStatsLabel}`.trim() %></p>
                </div>

                <!-- Actions -->
                <div class="id-card-actions">
                    <button class="btn-primary" onclick="copyMiiId(this, '<%= mii.id %>')">
                        <svg xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 96 960 960" width="20" fill="currentColor">
                            <path d="M360 816q-33 0-56.5-23.5T280 736V256q0-33 23.5-56.5T360 176h360q33 0 56.5 23.5T800 256v480q0 33-23.5 56.5T720 816H360Zm0-80h360V256H360v480ZM200 976q-33 0-56.5-23.5T120 896V336h80v560h440v80H200Zm160-240V256v480Z"/>
                        </svg>
                        <span class="copy-label">Copy Mii ID</span>
                    </button>

                    <form id="miiExportForm" class="export-form" method="GET" action="/exportMii">
                        <input type="hidden" name="id" value="<%= mii.id %>">
                        <label for="export-format-<%= mii.id %>">Download format</label>
                        <div class="export-row">
                            <input type="text" id="export-format-<%= mii.id %>" name="format" list="exportFormatOptions" placeholder="Search formats..." required>
                            <button type="submit" class="btn-primary">Download</button>
                            <button type="button" class="btn-secondary" onclick="copyMiiExportText('miiExportForm', 'hex')">Copy Hex</button>
                            <button type="button" class="btn-secondary" onclick="copyMiiExportText('miiExportForm', 'base64')">Copy Base64</button>
                        </div>
                        <div class="export-row" style="margin-top: 10px;">
                            <label style="display: inline-flex; align-items: center; gap: 8px;">
                                <input type="checkbox" name="special">
                                Download as Special Mii
                            </label>
                            <label for="qr-console-<%= mii.id %>" style="display: inline-flex; align-items: center; gap: 8px;">
                                QR Console:
                                <select id="qr-console-<%= mii.id %>" name="qrConsole">
                                    <option value="3DS">3DS</option>
                                    <option value="WIIU">Wii U</option>
                                </select>
                            </label>
                        </div>
                        <p class="note">Search any supported format (except NTAG). Try <code>qr</code>, <code>charinfo</code>, or <code>ffsd</code>.</p>
                    </form>
                    <datalist id="exportFormatOptions">
                        <% exportFormats.forEach(fmt => { %>
                            <option value="<%= fmt.value %>" label="<%= fmt.label %>"></option>
                        <% }) %>
                    </datalist>

                    <div class="export-secondary">
                        <button class="btn-secondary" onclick="openMiiInstructions(event)">Recreation Instructions</button>
                    </div>


                    <div class="vote-section">
                        <%
                            const userVotedFor = Array.isArray(user?.votedFor) ? user.votedFor : [];
                            const isLikeLocked = Boolean(
                                user?.username &&
                                (mii.uploader === user.username || mii.contributor === user.username)
                            );
                            const hasLikedMii = userVotedFor.includes(mii.id) || isLikeLocked;
                        %>
                        <button
                            onclick="likeMii(this,'<%= mii.id %>','<%= highlightedMii %>','<%= isModerator %>')"
                            class="like-button <%= hasLikedMii ? 'is-liked' : 'is-unliked' %><%= isLikeLocked ? ' is-like-locked' : '' %>"
                            data-mii-id="<%= mii.id %>"
                            data-liked="<%= hasLikedMii ? 'true' : 'false' %>"
                            data-like-locked="<%= isLikeLocked ? 'true' : 'false' %>"
                            aria-pressed="<%= hasLikedMii ? 'true' : 'false' %>"
                            aria-label="<%= isLikeLocked ? 'You permanently like Miis you upload' : (hasLikedMii ? 'Unlike this Mii' : 'Like this Mii') %>"
                        >
                            <%- include('icon', { name: 'heart', size: 26, class: 'like-icon' }) %>
                            <span class="vote-count" itemprop="interactionStatistic" itemscope itemtype="https://schema.org/InteractionCounter">
                                <meta itemprop="interactionType" content="https://schema.org/LikeAction">
                                <meta itemprop="userInteractionCount" content="<%= mii.votes || 0 %>">
                                <%= mii.votes||0 %>
                            </span>
                        </button>

                        <% if(isModerator || mii.uploader === user?.username){ %>
                            <button class="trash-button" onclick="deleteMii('<%= mii.id %>')">
                                <svg xmlns="http://www.w3.org/2000/svg" class="trash-icon" viewBox="0 96 960 960" fill="currentColor">
                                    <path d="M261 936q-24.75 0-42.375-17.625T201 876V306h-41v-60h188v-30h264v30h188v60h-41v570q0 24-18 42t-42 18H261Zm438-630H261v570h438V306ZM367 790h60V391h-60v399Zm166 0h60V391h-60v399ZM261 306v570-570Z"/>
                                </svg>
                            </button>
                        <% } %>
                        <button type="button" class="report-button" onclick="openReportProblemModal(event, this)" aria-label="Report a problem with this Mii">
                            <svg xmlns="http://www.w3.org/2000/svg" class="report-icon" viewBox="0 -960 960 960" fill="currentColor">
                                <path d="M200-120v-680h360l16 80h224v400H520l-16-80H280v280h-80Zm300-440Zm86 160h134v-240H510l-16-80H280v240h290l16 80Z"/>
                            </svg>
                            <span class="report-button-label">Report Problem</span>
                        </button>
                    </div>
                </div>

                <div class="mii-seo-sections">
                    <section class="mii-seo-panel" aria-labelledby="mii-archive-heading" hidden>
                        <h2 id="mii-archive-heading">About This <%= miiName %> Mii</h2>
                        <p><%= archiveIntro %></p>
                        <% if(archiveOwnerStatsLabel) { %>
                            <p><%= archiveOwnerStatsLabel %></p>
                        <% } %>
                        <% if(archiveSearchIntro) { %>
                            <p><%= archiveSearchIntro %></p>
                        <% } %>
                    </section>

                    <section class="mii-seo-panel" aria-labelledby="mii-facts-heading" hidden>
                        <h2 id="mii-facts-heading">Searchable Archive Details</h2>
                        <dl class="mii-fact-list">
                            <div class="mii-fact">
                                <dt>Name</dt>
                                <dd><%= miiName %></dd>
                            </div>
                            <div class="mii-fact">
                                <dt>Archive Type</dt>
                                <dd><%= archiveTypeLabel %></dd>
                            </div>
                            <div class="mii-fact">
                                <dt>Mii Type</dt>
                                <dd><%= typeLabel %></dd>
                            </div>
                            <% if(creatorName) { %>
                                <div class="mii-fact">
                                    <dt>Creator Name</dt>
                                    <dd><%= creatorName %></dd>
                                </div>
                            <% } %>
                            <% if(mii.official && officialSourceLabel) { %>
                                <div class="mii-fact">
                                    <dt>Official Source</dt>
                                    <dd><%= officialSourceLabel %></dd>
                                </div>
                            <% } %>
                            <% if(mii.uploader) { %>
                                <div class="mii-fact">
                                    <dt>Uploader</dt>
                                    <dd><%= mii.uploader %></dd>
                                </div>
                            <% } %>
                            <% if(mii.contributor) { %>
                                <div class="mii-fact">
                                    <dt>Contributor</dt>
                                    <dd><%= mii.contributor %></dd>
                                </div>
                            <% } %>
                            <% if(genderLabel) { %>
                                <div class="mii-fact">
                                    <dt>Gender</dt>
                                    <dd><%= genderLabel %></dd>
                                </div>
                            <% } %>
                            <% if(birthdayLabel) { %>
                                <div class="mii-fact">
                                    <dt>Birthday</dt>
                                    <dd><%= birthdayLabel %></dd>
                                </div>
                            <% } %>
                            <% if(favoriteColorName) { %>
                                <div class="mii-fact">
                                    <dt>Favorite Color</dt>
                                    <dd><%= favoriteColorName %></dd>
                                </div>
                            <% } %>
                            <% if(categoryDetails.length > 0) { %>
                                <div class="mii-fact">
                                    <dt>Official Categories</dt>
                                    <dd><%= categoryDetails.map(category => category.fullPath || category.name).join(', ') %></dd>
                                </div>
                            <% } %>
                            <% if(tagList.length > 0) { %>
                                <div class="mii-fact">
                                    <dt>Tags</dt>
                                    <dd><%= tagList.join(', ') %></dd>
                                </div>
                            <% } %>
                        </dl>
                    </section>

                    <section class="mii-seo-panel" aria-labelledby="mii-links-heading" hidden>
                        <h2 id="mii-links-heading">Search Topics And Related Links</h2>
                        <p>Browse by character name, creator name, uploader, tags, and official categories related to <%= miiName %>.</p>
                        <div class="mii-chip-list">
                            <a class="mii-chip mii-chip-link" href="<%= nameSearchUrl %>"><%= miiName %> search</a>
                            <% if(creatorSearchUrl) { %>
                                <a class="mii-chip mii-chip-link" href="<%= creatorSearchUrl %>"><%= creatorName %> creator search</a>
                            <% } %>
                            <a class="mii-chip mii-chip-link" href="<%= archiveOwnerProfileUrl %>"><%= archiveOwnerLabel %> profile</a>
                            <a class="mii-chip mii-chip-link" href="<%= uploaderSearchUrl %>"><%= mii.uploader %> uploader search</a>
                            <% categoryDetails.forEach(category => { %>
                                <a class="mii-chip mii-chip-link" href="<%= category.url %>"><%= category.name %></a>
                            <% }) %>
                            <% tagList.forEach(tag => { %>
                                <a class="mii-chip mii-chip-link" href="/searchResults?tags=<%= encodeURIComponent(tag) %>"><%= tag %></a>
                            <% }) %>
                        </div>
                        <% if(searchTopics.length > 0) { %>
                            <p class="mii-search-topic-copy">Common search phrases: <%= searchTopics.join(', ') %>.</p>
                        <% } %>
                    </section>

                    <section class="mii-seo-panel" aria-labelledby="mii-download-heading" hidden>
                        <h2 id="mii-download-heading">Download And Compatibility</h2>
                        <p>This page includes the preview image, QR code, and export tools for <%= miiName %>. If you are trying to find <%= miiName %> for 3DS, Wii U, Wii, Switch, or another supported Mii format, use the export controls above to download the format you need.</p>
                    </section>

                    <section class="mii-seo-panel" aria-labelledby="mii-faq-heading" hidden>
                        <h2 id="mii-faq-heading">Questions About This Mii</h2>
                        <div class="mii-faq-list">
                            <% faqEntries.forEach((entry) => { %>
                                <article class="mii-faq-item">
                                    <h3><%= entry.question %></h3>
                                    <p><%= entry.answer %></p>
                                </article>
                            <% }) %>
                        </div>
                    </section>

                    <% if(Array.isArray(relatedCollections) && relatedCollections.length > 0) { %>
                        <% relatedCollections.forEach((collection) => { %>
                            <section class="mii-seo-panel" aria-labelledby="related-<%= collection.title.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>">
                                <h2 id="related-<%= collection.title.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"><%= collection.title %></h2>
                                <% if(collection.description) { %>
                                    <p><%= collection.description %></p>
                                <% } %>
                                <div class="related-mii-grid">
                                    <% collection.items.forEach((relatedMii) => { %>
                                        <% const relatedMiiAttribution = getMiiAttribution(relatedMii); %>
                                        <article class="related-mii-card" style="--favorite-color: <%= decodeColor(relatedMii.general?.favoriteColor) || decodeColor(0) %>;">
                                            <a class="related-mii-image" href="/mii/<%= relatedMii.id %>">
                                                <img src="/miiImgs/<%= relatedMii.id %>.png" alt="<%= relatedMii.meta?.name || relatedMii.name %> Mii character" width="256" height="256" loading="lazy" decoding="async" fetchpriority="low">
                                            </a>
                                            <div class="related-mii-body">
                                                <h3><a href="/mii/<%= relatedMii.id %>"><%= relatedMii.meta?.name || relatedMii.name %></a></h3>
                                                <div class="related-mii-meta">
                                                    <p class="mii-card-byline">
                                                        <span><%= relatedMiiAttribution.prefix %></span>
                                                        <% if (relatedMiiAttribution.url) { %>
                                                            <a href="<%= relatedMiiAttribution.url %>"><%= relatedMiiAttribution.label %></a>
                                                        <% } else { %>
                                                            <span><%= relatedMiiAttribution.label %></span>
                                                        <% } %>
                                                    </p>
                                                    <%- include('miiCardLikeButton', { mii: relatedMii, user }) %>
                                                </div>
                                                <p><%= relatedMii.desc && relatedMii.desc.length > 96 ? `${relatedMii.desc.slice(0, 93)}...` : (relatedMii.desc || `${relatedMii.meta?.name || relatedMii.name} Mii character`) %></p>
                                            </div>
                                        </article>
                                    <% }) %>
                                </div>
                            </section>
                        <% }) %>
                    <% } %>
                </div>

                <!-- Moderator Tools -->
                <% if(isModerator){ %>
                    <div class="moderator-tools">
                        <div class="mod-tools-header" onclick="toggleModTools()">
                            <h3><%- include('icon', { name: 'settings', size: 18, class: 'icon-inline' }) %> Moderator Tools</h3>
                            <span class="dropdown-arrow" id="modToolsArrow">▼</span>
                        </div>
                        
                        <div class="mod-tools-content" id="modToolsContent">
                            <div class="mod-tool-grid">
                                <!-- Edit Mii Name -->
                                <div class="mod-tool-item">
                                    <label>Mii Name:</label>
                                    <input type="text" id="editMiiName" value="<%= mii.meta.name %>" placeholder="Mii Name" maxLength="10">
                                </div>

                                <!-- Edit Description -->
                                <div class="mod-tool-item">
                                    <label>Description:</label>
                                    <textarea id="editDesc" rows="3" placeholder="Description"><%= mii.desc %></textarea>
                                </div>

                                <!-- Edit Creator Name -->
                                <div class="mod-tool-item">
                                    <label>Creator Name (in Mii file):</label>
                                    <input type="text" id="editCreatorName" value="<%= mii.meta.creatorName || '' %>" placeholder="Creator Name">
                                </div>

                                <!-- Switch Uploader -->
                                <div class="mod-tool-item">
                                    <label>Change Uploader:</label>
                                    <input type="text" id="editUploader" value="<%= mii.uploader %>" placeholder="Username">
                                </div>

                                <% if (canSetMiiIdDirectly) { %>
                                <div class="mod-tool-item">
                                    <label>Set Mii ID Directly:</label>
                                    <input type="text" id="directMiiIdInput" value="<%= mii.id %>" placeholder="New Mii ID" maxlength="10" inputmode="text" autocomplete="off" spellcheck="false">
                                    <p class="mod-tag-hint mod-id-hint">Admins only. Use 10 alphanumeric characters or fewer.</p>
                                    <button type="button" id="setMiiIdButton" onclick="setMiiIdDirectly()"><%- include('icon', { name: 'check', size: 16 }) %> Set Mii ID</button>
                                </div>
                                <% } %>

                                <!-- Edit Tags -->
                                <div class="mod-tool-item mod-tag-selector">
                                    <label>Mii Tags:</label>
                                    <div id="modMiiTagList" class="mod-tag-list"></div>
                                    <p class="mod-tag-hint">Only existing tags can be assigned. Create or delete tags from the Search page.</p>
                                </div>

                                <% if(canManageOfficialCategories) { %>
                                <div class="mod-tool-item">
                                    <label>Official Categories:</label>
                                    <p class="mod-tag-hint">Assign and update leaf categories for this official entry.</p>
                                    <button type="button" class="category-editor-trigger" onclick="openCategoryEditor()">Edit Categories <span class="category-trigger-summary"></span></button>
                                </div>
                                <% } %>

                                <!-- Toggle Official Status -->
                                <div class="mod-tool-item">
                                    <label>Official Mii Status:</label>
                                    <div class="toggle-container">
                                        <input type="checkbox" id="officialCheckbox" <%= mii.official ? 'checked' : '' %>>
                                        <label for="officialCheckbox">
                                            <span id="officialCheckboxIcon" aria-hidden="true"><%= mii.official ? '✅' : '❌' %></span>
                                            <span id="officialCheckboxLabel"><%= mii.official ? 'This is an Official Mii' : 'Not an Official Mii' %></span>
                                        </label>
                                    </div>
                                </div>

                                <div class="mod-tool-item">
                                    <label>Save Changes:</label>
                                    <button id="saveModeratorEditsButton" class="btn-primary" onclick="saveModeratorEdits()"><%- include('icon', { name: 'check', size: 16 }) %> Save Changes</button>
                                </div>

                                <!-- Regenerate QR Code -->
                                <div class="mod-tool-item">
                                    <label>Regenerate QR Code:</label>
                                    <label for="regenQrConsole" style="display: inline-flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                                        QR Console:
                                        <select id="regenQrConsole">
                                            <option value="3DS">3DS</option>
                                            <option value="WIIU">Wii U</option>
                                        </select>
                                    </label>
                                    <button onclick="regenerateQR()"><%- include('icon', { name: 'refresh', size: 16 }) %> Regenerate QR</button>
                                    <button onclick="regenerateRender()"><%- include('icon', { name: 'refresh', size: 16 }) %> Regenerate Render</button>
                                    <span id="qrStatus"></span>
                                    <span id="renderStatus"></span>
                                </div>

                                <!-- Delete Mii -->
                                <div class="mod-tool-item mod-tool-danger">
                                    <label>Delete Mii:</label>
                                    <button class="danger-btn" onclick="confirmDeleteMii()"><%- include('icon', { name: 'trash', size: 16 }) %> Delete Mii</button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
                <% if(!isModerator && canEditOfficialMii) { %>
                    <div class="moderator-tools">
                        <div class="mod-tools-header" onclick="toggleOfficialEditorTools()">
                            <h3><%- include('icon', { name: 'flask', size: 18, class: 'icon-inline' }) %> Official Editor Tools</h3>
                            <span class="dropdown-arrow" id="officialEditorToolsArrow">▼</span>
                        </div>

                        <div class="mod-tools-content" id="officialEditorToolsContent">
                            <div class="mod-tool-grid">
                                <div class="mod-tool-item">
                                    <label>Mii Name:</label>
                                    <input type="text" id="researcherEditMiiName" value="<%= mii.meta.name %>" placeholder="Mii Name">
                                </div>

                                <div class="mod-tool-item">
                                    <label>Description:</label>
                                    <textarea id="researcherEditDesc" rows="3" placeholder="Description"><%= mii.desc %></textarea>
                                </div>

                                <div class="mod-tool-item">
                                    <label>Creator Name (in Mii file):</label>
                                    <input type="text" id="researcherEditCreatorName" value="<%= mii.meta.creatorName || '' %>" placeholder="Creator Name">
                                </div>

                                <div class="mod-tool-item">
                                    <label>Official Categories:</label>
                                    <p class="mod-tag-hint">Assign and update leaf categories for this official entry.</p>
                                    <button type="button" class="category-editor-trigger" onclick="openCategoryEditor()">Edit Categories <span class="category-trigger-summary"></span></button>
                                </div>

                                <div class="mod-tool-item">
                                    <label>Save Changes:</label>
                                    <button id="saveOfficialEditorButton" class="btn-primary" onclick="saveOfficialEditorChanges()"><%- include('icon', { name: 'check', size: 16 }) %> Save Changes</button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </article>
            <%- include('featuredMiis') %>
        </main>
        
        <%- include('footer') %>

        <!--Due to needing access to EJS variables, we unfortunately cannot move these contents to a dedicated JS file-->
        <script>
            function copyMiiId(el, id){
                const labelEl = el?.querySelector?.('.copy-label') || el;
                const originalText = labelEl?.textContent || '';

                navigator.clipboard.writeText(id).then(() => {
                    if (labelEl) {
                        labelEl.textContent = '✓ Copied!';
                        setTimeout(() => {
                            labelEl.textContent = originalText;
                        }, 2000);
                    }
                }).catch(() => {
                    if (labelEl && typeof showAlert === 'function') {
                        showAlert('Failed to copy Mii ID', 4000, { title: 'Error', type: 'error' });
                    }
                });
            }
            function openReportProblemModal(event, triggerButton = null) {
                event?.preventDefault?.();

                if (typeof createModalOverlay !== 'function' || typeof closeModal !== 'function') {
                    showAlert('Report modal is unavailable on this page.', 4000, { title: 'Error', type: 'error' });
                    return;
                }

                const overlay = createModalOverlay();
                overlay.className = 'custom-modal-overlay custom-modal-report';

                const restoreFocusTarget = triggerButton instanceof HTMLElement
                    ? triggerButton
                    : (document.activeElement instanceof HTMLElement ? document.activeElement : null);

                const modal = document.createElement('div');
                modal.className = 'custom-modal report-problem-modal';
                modal.setAttribute('role', 'dialog');
                modal.setAttribute('aria-modal', 'true');
                modal.setAttribute('aria-labelledby', 'reportProblemTitle');

                const header = document.createElement('div');
                header.className = 'custom-modal-header';
                header.innerHTML = `
                    <h3 id="reportProblemTitle">Report Problem</h3>
                    <button class="custom-modal-close" aria-label="Close">&times;</button>
                `;

                const body = document.createElement('div');
                body.className = 'custom-modal-body report-modal-body';
                body.innerHTML = `
                    <p class="report-modal-intro">Tell us what is wrong with <strong>${escapeHtml(reportProblemContext.miiName)}</strong>. Reports go straight to the InfiniMii admins.</p>
                    <div class="report-modal-support" id="reportProblemSupport">
                        <div class="report-modal-support-copy">
                            <p class="report-modal-support-title">Need faster follow-up?</p>
                            <p>You can also bring the issue to the team in Discord.</p>
                        </div>
                        <a class="btn-secondary report-modal-discord-link" id="reportProblemDiscordLink" target="_blank" rel="noopener noreferrer">Join Discord</a>
                    </div>
                    <form id="reportProblemForm" class="report-modal-form">
                        <label class="report-modal-field" for="reportProblemCategory">
                            <span>Issue Category</span>
                            <select id="reportProblemCategory" name="category" required>
                                <option value="">Select a category</option>
                                ${reportMiiCategories.map((category) => `<option value="${escapeHtml(category)}">${escapeHtml(category)}</option>`).join('')}
                            </select>
                        </label>
                        <label class="report-modal-field" for="reportProblemEmail">
                            <span>Email</span>
                            <input
                                id="reportProblemEmail"
                                name="email"
                                type="email"
                                autocomplete="email"
                                placeholder="Optional email for follow-up"
                            >
                            <small>Email is optional, but it allows InfiniMii to follow up with you.</small>
                        </label>
                        <label class="report-modal-field" for="reportProblemDetails">
                            <span>Extra Details</span>
                            <textarea
                                id="reportProblemDetails"
                                name="details"
                                rows="7"
                                maxlength="4000"
                                required
                                placeholder="Please explain what is wrong with this Mii."
                            ></textarea>
                            <small>This box is required so the admins know what to look for.</small>
                        </label>
                    </form>
                    <p class="report-modal-status" id="reportProblemStatus" hidden></p>
                `;

                const footer = document.createElement('div');
                footer.className = 'custom-modal-footer';
                footer.innerHTML = `
                    <button type="button" class="custom-modal-btn custom-modal-btn-secondary" data-action="cancel">Cancel</button>
                    <button type="submit" class="custom-modal-btn custom-modal-btn-primary report-modal-submit" data-action="submit" form="reportProblemForm">Send Report</button>
                `;

                modal.appendChild(header);
                modal.appendChild(body);
                modal.appendChild(footer);
                overlay.innerHTML = '';
                overlay.appendChild(modal);

                const closeBtn = modal.querySelector('.custom-modal-close');
                const cancelBtn = modal.querySelector('[data-action="cancel"]');
                const submitBtn = modal.querySelector('[data-action="submit"]');
                const form = modal.querySelector('#reportProblemForm');
                const supportPanel = modal.querySelector('#reportProblemSupport');
                const discordLink = modal.querySelector('#reportProblemDiscordLink');
                const categorySelect = modal.querySelector('#reportProblemCategory');
                const emailInput = modal.querySelector('#reportProblemEmail');
                const detailsInput = modal.querySelector('#reportProblemDetails');
                const statusEl = modal.querySelector('#reportProblemStatus');

                let isSubmitting = false;

                if (discordLink && reportProblemContext.discordInvite) {
                    discordLink.href = reportProblemContext.discordInvite;
                } else if (supportPanel) {
                    supportPanel.hidden = true;
                }

                const syncDetailsValidity = () => {
                    const hasDetails = Boolean(detailsInput?.value?.trim());
                    if (detailsInput) {
                        detailsInput.setCustomValidity(hasDetails ? '' : 'Please include extra details about the issue.');
                    }
                    return hasDetails;
                };

                const setStatus = (message = '', type = 'info') => {
                    if (!statusEl) return;
                    statusEl.textContent = message;
                    statusEl.hidden = !message;
                    statusEl.dataset.type = message ? type : '';
                };

                const setSubmitting = (nextSubmitting) => {
                    isSubmitting = Boolean(nextSubmitting);
                    const hasDetails = syncDetailsValidity();

                    if (submitBtn) {
                        submitBtn.disabled = isSubmitting || !hasDetails;
                        submitBtn.textContent = isSubmitting ? 'Sending...' : 'Send Report';
                    }

                    [closeBtn, cancelBtn, categorySelect, emailInput, detailsInput].forEach((element) => {
                        if (element) {
                            element.disabled = isSubmitting;
                        }
                    });
                };

                const handleClose = () => {
                    if (isSubmitting) return;
                    closeModal(overlay);
                    document.removeEventListener('keydown', handleEscape);
                    if (restoreFocusTarget) {
                        setTimeout(() => restoreFocusTarget.focus(), 0);
                    }
                };

                const handleEscape = (e) => {
                    if (e.key === 'Escape') {
                        handleClose();
                    }
                };

                detailsInput?.addEventListener('input', () => {
                    setSubmitting(false);
                });
                form?.addEventListener('input', () => setStatus(''));
                form?.addEventListener('change', () => setStatus(''));

                closeBtn?.addEventListener('click', handleClose);
                cancelBtn?.addEventListener('click', handleClose);
                overlay.addEventListener('click', (e) => {
                    if (e.target === overlay) {
                        handleClose();
                    }
                });

                form?.addEventListener('submit', async (submitEvent) => {
                    submitEvent.preventDefault();
                    syncDetailsValidity();

                    if (!form.reportValidity()) {
                        return;
                    }

                    const payload = {
                        id: reportProblemContext.miiId,
                        category: categorySelect.value,
                        email: emailInput.value.trim(),
                        details: detailsInput.value.trim()
                    };

                    try {
                        setStatus('');
                        setSubmitting(true);

                        const response = await fetch('/reportMii', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify(payload)
                        });
                        const result = await response.json().catch(() => ({}));

                        if (!response.ok || result.error) {
                            throw new Error(result.error || 'Failed to submit report');
                        }

                        isSubmitting = false;
                        handleClose();

                        const successMessage = result.warning
                            ? `Report ${result.reportReference || ''} was sent. ${result.warning}`.trim()
                            : `Report ${result.reportReference || ''} sent successfully.${result.followUpEmailSent ? ' We started a follow-up email thread.' : ''}`;

                        showAlert(successMessage, result.warning ? 7000 : 5000, {
                            title: result.warning ? 'Report Sent With Warning' : 'Report Sent',
                            type: result.warning ? 'info' : 'success'
                        });
                    } catch (error) {
                        console.error('Error submitting Mii report:', error);
                        setStatus(error.message || 'Failed to submit report', 'error');
                        setSubmitting(false);
                    }
                });

                document.addEventListener('keydown', handleEscape);
                setSubmitting(false);
                setTimeout(() => overlay.classList.add('active'), 10);
                categorySelect?.focus();
            }
            async function publishThisMii() {
