                    <div class="vote-section">
                        <%
                            const userVotedFor = Array.isArray(user?.votedFor) ? user.votedFor : [];
                            const isLikeLocked = Boolean(
                                user?.username &&
                                (mii.uploader === user.username || mii.contributor === user.username)
