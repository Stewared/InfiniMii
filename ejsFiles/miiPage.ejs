<!DOCTYPE html>
<html lang="en">
    <head>
        <%
        const rawMiiName = (mii?.meta?.name ?? mii?.name ?? '').toString().trim();
        const miiName = rawMiiName || 'Unknown Mii';
        const showMiiWorkspaceTools = typeof miiWorkspaceToolsEnabled === 'undefined'
            ? true
            : Boolean(miiWorkspaceToolsEnabled);
        const miiPageExportFormats = Array.isArray(exportFormats) ? exportFormats : [];
        const miiPageExportValues = miiPageExportFormats
            .map((format) => String(format?.value || '').trim().toLowerCase())
            .filter(Boolean);
        const miiPageLegacyExportsEnabled = miiPageExportValues.some((value) => value !== 'ltd');
        const miiPageLtdConversionPending = miiPageExportValues.length > 0
            && miiPageExportValues.every((value) => value === 'ltd');
        const miiPageLtdConversionTooltip = 'LTD Mii Conversion is coming soon!';
        const miiPageQrExportsEnabled = miiPageExportValues.includes('qr');
        const miiPageMnmsExportsEnabled = miiPageExportValues.includes('mnms');
        const seo = miiSeo || {};
        const externalSource = (typeof externalMiiSource !== 'undefined' && externalMiiSource)
            ? externalMiiSource
            : getExternalMiiSource(mii);
        const isExternalMii = Boolean(externalSource?.url && externalSource?.title);
        const officialSourceLabel = mii.official ? (seo.officialSourceName || officialSourceName || mii.officialSource || mii.uploader || 'Nintendo') : '';
        const categoryDetails = Array.isArray(seo.categoryDetails) ? seo.categoryDetails : [];
        const tagList = Array.isArray(seo.tagList) ? seo.tagList : [];
        const hasTomodachiLifeData = (() => {
            const tlData = mii?.tl;
            if (tlData === null || tlData === undefined) return false;
            if (typeof tlData !== 'object') return true;
            return Object.keys(tlData).length > 0;
        })();
        const tomodachiRowsForPage = (typeof tomodachiRows !== 'undefined' && Array.isArray(tomodachiRows)) ? tomodachiRows : [];
        const tomodachiAddressRow = tomodachiRowsForPage.find(row => row?.key === 'islandAddress' || row?.label === 'Island Address');
        const tomodachiFeaturedKeys = new Set(['islandAddress']);
        const tomodachiDetailRows = tomodachiRowsForPage.filter(row => !tomodachiFeaturedKeys.has(row?.key));
        const miitopiaWarCry = (mii?.mt?.warCry ?? '').toString().replace(/\s+/g, ' ').trim();
        const tomodachiCatchphraseForMiitopia = (mii?.tl?.catchphrase ?? '').toString().replace(/\s+/g, ' ').trim();
        // MT QR UI is temporarily disabled on the InfiniMii site.
        const enableMiitopiaQrs = false;
        const hasMiitopiaQr = miiPageQrExportsEnabled && enableMiitopiaQrs && Boolean(miitopiaWarCry || tomodachiCatchphraseForMiitopia);
        const defaultQrConsole = hasTomodachiLifeData ? 'TOMODACHI' : (hasMiitopiaQr ? 'MIITOPIA' : '3DS');
        const creatorName = seo.creatorName || '';
        const consoleLabel = seo.consoleLabel || '';
        const favoriteColorName = seo.favoriteColorName || '';
        const birthdayLabel = seo.birthdayLabel || '';
        const archiveTypeLabel = seo.archiveTypeLabel || (mii.official ? 'Official Mii' : (isPrivate ? 'Private Mii' : 'Community Mii'));
        const typeLabel = seo.typeLabel || 'Standard Mii';
        const keywordList = Array.isArray(seo.keywordList) ? seo.keywordList : [];
        const pageSourceLabel = isExternalMii ? externalSource.title : (mii.official ? officialSourceLabel : '');
        const pageTitle = `${miiName}${pageSourceLabel ? ` | ${pageSourceLabel}` : ''} | InfiniMii`;
        const pageDesc = seo.metaDescription || mii.desc || `View ${miiName}${pageSourceLabel ? ` from ${pageSourceLabel}` : ''} on InfiniMii. Download it in any available format.`;
        const canonicalUrl = `${baseUrl}/mii/${mii.id}`;
        const imgPath = isPrivate ? 'privateMiiImgs' : 'miiImgs';
        const qr3dsPath = isPrivate ? 'privateMiiQRs' : 'miiQRs';
        const qrWiiPath = isPrivate ? 'privateMiiQRsWii' : 'miiQRsWii';
        const qrTomodachiPath = isPrivate ? 'privateMiiQRsTomodachi' : 'miiQRsTomodachi';
        // const qrMiitopiaPath = isPrivate ? 'privateMiiQRsMiitopia' : 'miiQRsMiitopia';
        const previewAssetVersionSource = mii?.updatedAt || pageUpdatedAt || mii?.uploadedOn || Date.now();
        const previewAssetVersionRaw = typeof previewAssetVersionSource === 'number'
            ? previewAssetVersionSource
            : new Date(previewAssetVersionSource).getTime();
        const previewAssetVersion = Number.isFinite(previewAssetVersionRaw)
            ? previewAssetVersionRaw
            : Date.now();
        const previewImageCanonicalPath = `/${imgPath}/${mii.id}.png`;
        const previewImagePath = `${previewImageCanonicalPath}?v=${encodeURIComponent(previewAssetVersion)}`;
        const previewQr3dsPath = miiPageQrExportsEnabled ? `/${qr3dsPath}/${mii.id}.png?v=${encodeURIComponent(previewAssetVersion)}` : '';
        const previewQrWiiPath = miiPageQrExportsEnabled ? `/${qrWiiPath}/${mii.id}.png?v=${encodeURIComponent(previewAssetVersion)}` : '';
        const previewQrTomodachiPath = miiPageQrExportsEnabled && hasTomodachiLifeData
            ? `/${qrTomodachiPath}/${mii.id}.png?v=${encodeURIComponent(previewAssetVersion)}`
            : '';
        const previewQrMiitopiaPath = '';
        const defaultQrPreviewPath = defaultQrConsole === 'TOMODACHI'
            ? previewQrTomodachiPath
            : (defaultQrConsole === 'MIITOPIA' ? previewQrMiitopiaPath : previewQr3dsPath);
        const ogImage = isPrivate
            ? `${baseUrl}/miiImgs/00000.png`
            : `${baseUrl}${previewImageCanonicalPath}`;
        const ogImageAlt = `${miiName} Mii character preview`;
        const ogImageWidth = 512;
        const ogImageHeight = 512;
        const ogImageType = 'image/png';
        const ogType = 'article';
        const keywords = keywordList.length > 0
            ? keywordList.join(', ')
            : miiName;
        const miiDateMetadata = getMiiDateMetadata(mii, pageUpdatedAt);
        const publishedTime = miiDateMetadata.publishedIso;
        const modifiedTime = miiDateMetadata.modifiedIso;
        const displayedUploadedDate = publishedTime ? new Date(publishedTime) : null;
        const pageRobots = isPrivate ? 'noindex, nofollow, noarchive' : undefined;
        const schemaType = 'ItemPage';
        const canChangeMiiId = Boolean(isModerator && mii.id !== 'average');
        const canSetMiiIdDirectly = Boolean(isAdmin && mii.id !== 'average');
        const canClearTomodachiLifeData = Boolean(isAdmin);
        const isMiiUploader = Boolean(user?.username && mii.uploader === user.username);
        const isMiiUserEditLocked = Boolean(mii.lockedFromUserEdits);
        const isResearchManagedEntry = Boolean(typeof isResearchManagedMii !== 'undefined' && isResearchManagedMii);
        const canInlineEditMiiMetadata = Boolean(isModerator || (isMiiUploader && !isMiiUserEditLocked));
        const canEditTomodachiLifeFields = Boolean(isModerator || isMiiUploader);
        const canEditMiiTags = Boolean(isModerator || isMiiUploader || (isResearchManagedEntry && isResearcher));
        const canEditMiiCategories = Boolean(isResearchManagedEntry && (isModerator || isResearcher || isMiiUploader));
        const canEditExternalMiiSource = Boolean(isModerator || (isResearchManagedEntry && isResearcher));
        const canHideMiiFromAccount = Boolean(user?.username && !isPrivate);
        const shouldShowCreatorName = creatorName.length > 0 || canInlineEditMiiMetadata;
        const tomodachiRaw = (mii?.tl && typeof mii.tl === 'object') ? mii.tl : {};
        const tomodachiPersonalityRaw = (tomodachiRaw?.personality && typeof tomodachiRaw.personality === 'object') ? tomodachiRaw.personality : {};
        const tomodachiBirthdayMonth = tomodachiRaw.birthMonth ?? mii?.general?.birthMonth ?? '';
        const tomodachiBirthdayDay = tomodachiRaw.birthday ?? mii?.general?.birthday ?? '';
        const breadcrumbs = [
            { name: 'Home', url: '/' },
            { name: mii.official ? 'Official Miis' : 'Community Miis', url: mii.official ? '/official' : '/top' },
            { name: miiName, url: `/mii/${mii.id}` }
        ];
        const archiveOwnerLabel = mii.official ? officialSourceLabel : (seo.uploaderName || mii.uploader || 'InfiniMii User');
        const archiveIntro = isExternalMii
            ? `${miiName} came from ${externalSource.title}${externalSource.user ? `, where ${externalSource.user} uploaded it` : ''}${creatorName ? `. Creator name: ${creatorName}` : ''}.`
            : (mii.official
                ? `${miiName} is an official Mii from ${officialSourceLabel}${creatorName ? `. Creator name: ${creatorName}` : ''}.`
                : `${miiName} was uploaded by ${mii.uploader}${creatorName ? `. Creator name: ${creatorName}` : ''}.`);
        const nameSearchUrl = `/searchResults?q=${encodeURIComponent(miiName)}&searchFieldsConfigured=1&searchIn=name&searchIn=creatorName`;
        const creatorSearchUrl = creatorName
            ? `/searchResults?q=${encodeURIComponent(creatorName)}&searchFieldsConfigured=1&searchIn=creatorName`
            : '';
        const uploaderSearchUrl = `/searchResults?q=${encodeURIComponent(mii.uploader)}&searchFieldsConfigured=1&searchIn=uploader`;
        const archiveOwnerProfileUrl = `/user/${encodeURIComponent(mii.uploader)}`;
        const faqEntries = [
            {
                question: `How do I download ${miiName}?`,
                answer: `Use the Download section on this page. It lists the formats available for this Mii.`
            },
            {
                question: `Who made ${miiName}?`,
                answer: isExternalMii
                    ? `${miiName} came from ${externalSource.title}${externalSource.user ? `, where ${externalSource.user} uploaded it` : ''}${creatorName ? `. Its creator name is ${creatorName}` : ''}.`
                    : (mii.official
                        ? `${miiName} is an official Mii from ${officialSourceLabel}${mii.contributor ? `, contributed by ${mii.contributor}` : ''}${creatorName ? `. Its creator name is ${creatorName}` : ''}.`
                        : `${miiName} was uploaded by ${mii.uploader}${creatorName ? `. Its creator name is ${creatorName}` : ''}.`)
            },
            {
                question: `Which formats are available for ${miiName}?`,
                answer: `The Download section shows every format available for this Mii.`
            }
        ];
        const schemaGraphs = !pageRobots
            ? [{
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": faqEntries.map((entry) => ({
                    "@type": "Question",
                    "name": entry.question,
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": entry.answer
                    }
                }))
            }]
            : [];
        %>
        
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, ogImage, ogImageAlt, ogImageWidth, ogImageHeight, ogImageType, ogType, keywords, publishedTime, modifiedTime, pageUpdatedAt: modifiedTime, pageRobots }) %>
        <%- include('structuredData', { title: pageTitle, description: pageDesc, canonicalUrl, ogImage, ogImageAlt, ogImageWidth, ogImageHeight, ogImageType, ogType, keywords, publishedTime, modifiedTime, pageUpdatedAt: modifiedTime, pageRobots, schemaType, breadcrumbs, schemaGraphs }) %>
        <%- include('miiSchema', { mii, miiSeo: seo, pageRobots, pageUpdatedAt: modifiedTime }) %>
        
        <link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="/miiPage.css">
        
        <!-- Preload hero image -->
        <link rel="preload" as="image" href="<%= previewImagePath %>" fetchpriority="high">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>

        <main class="content" role="main">
            <%- include('sidebar') %>

            <article class="mii-id-card" style="--favorite-color: <%= decodeColor(mii.general?.favoriteColor) || decodeColor(0) %>;" itemscope itemtype="https://schema.org/CreativeWork">
                <!-- Card Header -->
                <header class="id-card-header">
                    <h2 itemprop="name">Mii Information</h2>
                    <div class="id-card-header-tools">
                        <% if (canChangeMiiId) { %>
                            <button
                                type="button"
                                id="headerRegenerateMiiIdButton"
                                class="mii-id-refresh-button"
                                onclick="regenerateMiiId(this)"
                                aria-label="Generate a new Mii ID"
                                title="Generate a new Mii ID"
                            >
                                <%- include('icon', { name: 'refresh', size: 16 }) %>
                                <span>New ID</span>
                            </button>
                        <% } %>
                        <div class="card-number" role="button" tabindex="0" onclick="copyMiiId(this, '<%= mii.id %>')" aria-label="Copy Mii ID">ID: <%= mii.id %></div>
                    </div>
                </header>

                <!-- Main Card Body -->
                <div class="id-card-body">
                    <!-- Left side: Mii Image -->
                    <figure class="id-card-photo<%= miiPageLtdConversionPending ? ' has-ltd-download' : '' %>">
                        <img src="<%= previewImagePath %>" 
                            onerror="this.src='<%= previewImagePath %>'"
                            alt="<%= ogImageAlt %>"
                            itemprop="image"
                            width="400" 
                            height="400"
                            loading="eager"
                            decoding="async"
                            fetchpriority="high">
                        <% if (miiPageQrExportsEnabled) { %>
                            <figcaption class="qr-code">
                                <div class="qr-preview-window <%= defaultQrConsole === 'TOMODACHI' ? 'is-qr-tomodachi' : (defaultQrConsole === 'MIITOPIA' ? 'is-qr-miitopia' : 'is-qr-3ds') %> <%= hasTomodachiLifeData ? 'has-tomodachi-qr' : '' %> <%= hasMiitopiaQr ? 'has-miitopia-qr' : '' %>" data-qr-preview data-default-qr-console="<%= defaultQrConsole %>" data-qr3ds-src="<%= previewQr3dsPath %>" data-qr-wii-src="<%= previewQrWiiPath %>" data-qr-wiiu-src="<%= previewQrWiiPath %>" data-qr-tomodachi-src="<%= previewQrTomodachiPath %>" data-qr-miitopia-src="<%= previewQrMiitopiaPath %>">
                                    <div class="qr-console-tabs" role="tablist" aria-label="QR console type">
                                        <button type="button" class="qr-console-tab <%= defaultQrConsole === '3DS' ? 'is-active' : '' %>" data-qr-tab="3DS" role="tab" aria-selected="<%= defaultQrConsole === '3DS' ? 'true' : 'false' %>" onclick="setQrPreviewConsole(this)">3DS</button>
                                        <button type="button" class="qr-console-tab" data-qr-tab="WIIU" role="tab" aria-selected="false" onclick="setQrPreviewConsole(this)">Wii U</button>
                                        <% if(hasTomodachiLifeData) { %>
                                            <button type="button" class="qr-console-tab <%= defaultQrConsole === 'TOMODACHI' ? 'is-active' : '' %>" data-qr-tab="TOMODACHI" role="tab" aria-selected="<%= defaultQrConsole === 'TOMODACHI' ? 'true' : 'false' %>" onclick="setQrPreviewConsole(this)" aria-label="Tomodachi Life 3DS QR" title="Tomodachi Life 3DS QR">TL</button>
                                        <% } %>
                                        <% /* MT QR tab temporarily disabled. Re-enable with enableMiitopiaQrs above. */ %>
                                        <% if(hasMiitopiaQr) { %>
                                            <button type="button" class="qr-console-tab <%= defaultQrConsole === 'MIITOPIA' ? 'is-active' : '' %>" data-qr-tab="MIITOPIA" role="tab" aria-selected="<%= defaultQrConsole === 'MIITOPIA' ? 'true' : 'false' %>" onclick="setQrPreviewConsole(this)" aria-label="Miitopia 3DS QR" title="Miitopia 3DS QR">MT</button>
                                        <% } %>
                                    </div>
                                    <a class="qr-preview-link" href="<%= defaultQrPreviewPath %>" target="_blank" rel="noopener noreferrer" data-qr-link>
                                        <img
                                            class="qr-code-image"
                                            src="<%= defaultQrPreviewPath %>"
                                            alt="QR Code for <%= miiName %> - Scan with 3DS, Wii U, Tomodachi Life, or Miitomo"
                                            width="200"
                                            height="200"
                                            loading="lazy"
                                            decoding="async"
                                            fetchpriority="low"
                                            data-qr-image
                                            data-qr-console="<%= defaultQrConsole %>"
                                        >
                                    </a>
                                </div>
                                <% if (miiPageMnmsExportsEnabled) { %>
                                    <form id="miiQrExportForm" method="GET" action="/exportMii" style="margin-top: 10px; display: flex; flex-direction: column; gap: 6px; align-items: center;">
                                        <input type="hidden" name="id" value="<%= mii.id %>">
                                        <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; justify-content: center;">
                                            <button type="button" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;" onclick="copyQrPreviewMnmsText('hex')">Copy Hex</button>
                                            <button type="button" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;" onclick="copyQrPreviewMnmsText('base64')">Copy Base64</button>
                                        </div>
                                    </form>
                                <% } %>
                            </figcaption>
                        <% } else if (miiPageLtdConversionPending) { %>
                            <figcaption class="ltd-photo-download">
                                <a
                                    class="btn-primary ltd-photo-download-button"
                                    href="/exportMii?id=<%= encodeURIComponent(mii.id) %>&amp;format=ltd"
                                    aria-label="Download <%= miiName %> as an LTD file"
                                >
                                    <%- include('icon', { name: 'download', size: 18, class: 'icon-inline' }) %>
                                    <span>Download LTD</span>
                                </a>
                            </figcaption>
                        <% } %>
                    </figure>

                    <!-- Right side: Information -->
                    <div class="id-card-info">
                        <div class="mii-inline-edit-block mii-name-edit-block" data-inline-edit-field="name">
                            <div class="editable-label-row">
                                <span class="info-label">Name</span>
                                <% if(canInlineEditMiiMetadata) { %>
                                    <button type="button" class="inline-edit-icon-button" data-inline-edit-trigger="name" onclick="openMiiInlineEditor('name')" aria-label="Edit Mii name" title="Edit Mii name">
                                        <%- include('icon', { name: 'edit', size: 14 }) %>
                                    </button>
                                <% } %>
                            </div>
                            <h1 class="mii-name" data-inline-edit-display="name"><%= miiName %></h1>
                            <% if(canInlineEditMiiMetadata) { %>
                                <div class="inline-edit-controls" data-inline-edit-controls="name" hidden>
                                    <input type="text" id="inlineEditName" class="inline-edit-input inline-edit-input-name" data-inline-edit-input="name" value="<%= mii.meta?.name || '' %>" maxlength="10" autocomplete="off" spellcheck="false">
                                    <div class="inline-edit-actions">
                                        <button type="button" class="inline-edit-save-button" data-inline-edit-save="name" onclick="saveInlineMiiField('name')">
                                            <%- include('icon', { name: 'check', size: 15 }) %> Save
                                        </button>
                                        <button type="button" class="inline-edit-cancel-button" onclick="cancelInlineMiiEdit('name')" aria-label="Cancel name edit" title="Cancel">
                                            <%- include('icon', { name: 'x', size: 15 }) %>
                                        </button>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                        
                        <div class="info-grid">
                            <% if(shouldShowCreatorName){ %>
                            <div class="info-item">
                                <div class="editable-label-row">
                                    <span class="info-label">Creator Name</span>
                                    <% if(canInlineEditMiiMetadata) { %>
                                        <button type="button" class="inline-edit-icon-button" data-inline-edit-trigger="creatorName" onclick="openMiiInlineEditor('creatorName')" aria-label="Edit creator name" title="Edit creator name">
                                            <%- include('icon', { name: 'edit', size: 14 }) %>
                                        </button>
                                    <% } %>
                                </div>
                                <span class="info-value" itemprop="creator" data-inline-edit-display="creatorName"><%= creatorName || 'Not Set' %></span>
                                <% if(canInlineEditMiiMetadata) { %>
                                    <div class="inline-edit-controls inline-edit-controls-compact" data-inline-edit-controls="creatorName" hidden>
                                        <input type="text" id="inlineEditCreatorName" class="inline-edit-input" data-inline-edit-input="creatorName" value="<%= mii.meta?.creatorName || '' %>" maxlength="10" autocomplete="off" spellcheck="false">
                                        <div class="inline-edit-actions">
                                            <button type="button" class="inline-edit-save-button" data-inline-edit-save="creatorName" onclick="saveInlineMiiField('creatorName')">
                                                <%- include('icon', { name: 'check', size: 15 }) %> Save
                                            </button>
                                            <button type="button" class="inline-edit-cancel-button" onclick="cancelInlineMiiEdit('creatorName')" aria-label="Cancel creator name edit" title="Cancel">
                                                <%- include('icon', { name: 'x', size: 15 }) %>
                                            </button>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                            <% } %>

                            <div class="info-item">
                                <span class="info-label">Birthday</span>
                                <span class="info-value" data-mii-birthday-display><%= birthdayLabel || 'Not Set' %></span>
                            </div>

                            <% if(mii.general.height !== undefined) { %>
                            <div class="info-item">
                                <span class="info-label">Height</span>
                                <span class="info-value"><%= `${height.feet}' ${height.inches}"` %>, <%= height.centimeters %>cm.</span>
                            </div>
                            <% } %>

                            <% if(mii.general.weight !== undefined) { %>
                            <div class="info-item">
                                <span class="info-label">Weight [Experimental]</span>
                                <span class="info-value"><%= Math.round(weight.pounds) %>lbs, <%= weight.kilograms %>kg.</span>
                            </div>
                            <% } %>

                            <% if(favoriteColorName) { %>
                            <div class="info-item">
                                <span class="info-label">Favorite Color</span>
                                <span class="info-value"><%= favoriteColorName %></span>
                            </div>
                            <% } %>

                            <% if(miitopiaWarCry) { %>
                            <div class="info-item">
                                <span class="info-label">Miitopia War Cry</span>
                                <span class="info-value"><%= miitopiaWarCry %></span>
                            </div>
                            <% } %>

                            <% if(isExternalMii) { %>
                            <div class="info-item">
                                <span class="info-label">From</span>
                                <a class="info-value external-source-link" href="<%= externalSource.url %>" target="_blank" rel="noopener noreferrer external"><%= externalSource.title %></a>
                            </div>
                            <% } else if(mii.official && officialSourceLabel) { %>
                            <div class="info-item">
                                <span class="info-label">Official Source</span>
                                <span class="info-value"><%= officialSourceLabel %></span>
                            </div>
                            <% } else if(mii.uploader) { %>
                            <div class="info-item">
                                <span class="info-label">Uploaded By</span>
                                <span class="info-value"><%= mii.uploader %></span>
                            </div>
                            <% } %>

                            <% if(mii.contributor) { %>
                            <div class="info-item">
                                <span class="info-label">Contributor</span>
                                <span class="info-value"><%= mii.contributor %></span>
                            </div>
                            <% } %>
                                <script>
                                const currentCategories = <%- toScriptJson(mii.officialCategories || []) %>;
                                const currentMiiTags = <%- toScriptJson(isModerator ? (mii.tags || []).filter((tag) => String(tag || '').toLowerCase() !== 'tomodachi life') : tagList) %>;
                                const availableMiiTags = <%- toScriptJson(isModerator ? (blockableTags || []) : (availableTags || [])) %>;
                                const reportMiiCategories = <%- toScriptJson(reportMiiCategories || []) %>;
                                const reportProblemContext = Object.freeze({
                                    miiId: <%- toScriptJson(mii.id) %>,
                                    miiName: <%- toScriptJson(mii.meta?.name || mii.name || "Mii") %>,
                                    discordInvite: <%- toScriptJson(discordInvite || "") %>
                                });
                                function escapeHtml(value) {
                                    return String(value ?? '').replace(/[&<>"']/g, (character) => ({
                                        '&': '&amp;',
                                        '<': '&lt;',
                                        '>': '&gt;',
                                        '"': '&quot;',
                                        "'": '&#39;'
                                    }[character]));
                                }

                                function escapeForSingleQuote(value) {
                                    return String(value ?? '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
                                }

                                const originalMiiEditorState = Object.freeze({
                                    name: <%- toScriptJson(mii.meta?.name || '') %>,
                                    desc: <%- toScriptJson(mii.desc || '') %>,
                                    creatorName: <%- toScriptJson(mii.meta?.creatorName || '') %>,
                                    uploader: <%- toScriptJson(mii.uploader || '') %>,
                                    official: <%- toScriptJson(Boolean(mii.official)) %>,
                                    lockedFromUserEdits: <%- toScriptJson(Boolean(mii.lockedFromUserEdits)) %>,
                                    categories: [...currentCategories].map((value) => String(value ?? '')).sort(),
                                    tags: [...currentMiiTags].map((value) => String(value ?? '')).sort()
                                });
                                const inlineMiiEditorState = {
                                    name: originalMiiEditorState.name,
                                    desc: originalMiiEditorState.desc,
                                    creatorName: originalMiiEditorState.creatorName
                                };
                                const tomodachiMiiEditorState = {
                                    tomodachiFullName: {
                                        firstName: <%- toScriptJson(tomodachiRaw.firstName || '') %>,
                                        lastName: <%- toScriptJson(tomodachiRaw.lastName || '') %>
                                    },
                                    tomodachiFullBirthday: {
                                        birthMonth: <%- toScriptJson(tomodachiBirthdayMonth ? String(tomodachiBirthdayMonth) : '') %>,
                                        birthday: <%- toScriptJson(tomodachiBirthdayDay ? String(tomodachiBirthdayDay) : '') %>
                                    },
                                    tomodachiIslandName: <%- toScriptJson(tomodachiRaw?.island?.name || '') %>,
                                    tomodachiAgeGroup: <%- toScriptJson(tomodachiRaw.isAdult === true ? 'adult' : (tomodachiRaw.isAdult === false ? 'child' : '')) %>,
                                    tomodachiPersonality: {
                                        movement: Number.parseInt(<%- toScriptJson(tomodachiPersonalityRaw.movement || 4) %>, 10) || 4,
                                        speech: Number.parseInt(<%- toScriptJson(tomodachiPersonalityRaw.speech || 4) %>, 10) || 4,
                                        expressiveness: Number.parseInt(<%- toScriptJson(tomodachiPersonalityRaw.expressiveness || 4) %>, 10) || 4,
                                        attitude: Number.parseInt(<%- toScriptJson(tomodachiPersonalityRaw.attitude || 4) %>, 10) || 4
                                    },
                                    tomodachiCatchphrase: <%- toScriptJson(tomodachiRaw.catchphrase || '') %>
                                };
                                let selectedMiiTags = new Set(currentMiiTags);
                                let officialCategories = [];
                                let selectedPaths = new Set(currentCategories);
                                let expandedNodes = new Set();
                                let modalSelectedPaths = null;
                                let modalSelectedMiiTags = null;

                                function sortComparableValues(values) {
                                    return [...new Set((values || []).map((value) => String(value ?? '')))].sort();
                                }

                                function arraysEqualAsSets(a, b) {
                                    const left = sortComparableValues(a);
                                    const right = sortComparableValues(b);
                                    if (left.length !== right.length) return false;
                                    return left.every((value, index) => value === right[index]);
                                }

                                function updateCategoryEditorTriggers() {
                                    const selectedCount = sortComparableValues(Array.from(selectedPaths)).length;
                                    const summary = selectedCount > 0
                                        ? `(${selectedCount} selected)`
                                        : '(none selected)';
                                    document.querySelectorAll('.category-trigger-summary').forEach((el) => {
                                        el.textContent = summary;
                                    });
                                }

                                function updateTagEditorTriggers() {
                                    const selectedCount = sortComparableValues(Array.from(selectedMiiTags)).length;
                                    const summary = selectedCount > 0
                                        ? `(${selectedCount} selected)`
                                        : '(none selected)';
                                    document.querySelectorAll('.tag-trigger-summary').forEach((el) => {
                                        el.textContent = summary;
                                    });
                                }

                                function updateOfficialCheckboxLabel() {
                                    const checkbox = document.getElementById('officialCheckbox');
                                    const label = document.getElementById('officialCheckboxLabel');
                                    if (!checkbox || !label) return;
                                    label.textContent = checkbox.checked
                                        ? 'This is an Official Mii'
                                        : 'Not an Official Mii';
                                }

                                async function loadCategoriesForEditor() {
                                    try {
                                        const response = await fetch('/getOfficialCategories', {
                                            headers: { "Content-Type": "application/json" },
                                        });
                                        const data = await response.json();
                                        
                                        if (!data.error) {
                                            officialCategories = data.categories?.categories || data.categories || [];
                                            // Auto-expand paths that contain selected categories
                                            Array.from(selectedPaths).forEach(path => {
                                                const parts = path.split('/');
                                                let currentPath = '';
                                                parts.forEach((part, index) => {
                                                    currentPath += (index > 0 ? '/' : '') + part;
                                                    if (index < parts.length - 1) {
                                                        expandedNodes.add(currentPath);
                                                    }
                                                });
                                            });
                                            return true;
                                        }
                                        return false;
                                    } catch (error) {
                                        console.error('Error loading categories:', error);
                                        return false;
                                    }
                                }

                                async function openCategoryEditor() {
                                    const loaded = await loadCategoriesForEditor();
                                    
                                    if (!loaded) {
                                        showAlert('Error loading categories', 5000, { title: 'Error', type: 'error' });
                                        return;
                                    }
                                    
                                    const modal = document.createElement('div');
                                    modal.className = 'category-modal-overlay';
                                    modal.id = 'categoryModal';
                                    
                                    const modalContent = document.createElement('div');
                                    modalContent.className = 'category-modal-panel';
                                    
                                    modalSelectedPaths = new Set(selectedPaths);

                                    modalContent.innerHTML = `
                                        <h3 class="category-modal-title">Select Categories</h3>
                                        <p class="category-modal-help">Check all categories that apply.</p>
                                        <div class="category-modal-tree-wrap">
                                            <div id="modalCategoryTree"></div>
                                        </div>
                                        <div class="category-modal-actions">
                                            <button onclick="closeCategoryModal()" class="category-modal-btn category-modal-btn-cancel">
                                                Cancel
                                            </button>
                                            <button onclick="saveCategoriesFromModal(this)" class="category-modal-btn category-modal-btn-save">
                                                Save Categories
                                            </button>
                                        </div>
                                    `;
                                    
                                    modal.appendChild(modalContent);
                                    document.body.appendChild(modal);
                                    
                                    renderModalTree();
                                    
                                    modal.addEventListener('click', (e) => {
                                        if (e.target === modal) {
                                            closeCategoryModal();
                                        }
                                    });
                                }

                                function renderModalTree() {
                                    const container = document.getElementById('modalCategoryTree');
                                    if (!container) return;
                                    
                                    container.innerHTML = renderModalNodes(officialCategories);
                                }

                                function renderModalNodes(nodes, level = 0) {
                                    let html = '';
                                    
                                    nodes.forEach(node => {
                                        const hasChildren = node.children && node.children.length > 0;
                                        const isExpanded = expandedNodes.has(node.path);
                                        const activeSelectedPaths = modalSelectedPaths || selectedPaths;
                                        const isSelected = activeSelectedPaths.has(node.path);
                                        const indent = level * 20;
                                        const nodeColor = node.color || '#999999';
                                        const escapedPathForJs = escapeForSingleQuote(node.path);
                                        const escapedPathForHtml = escapeHtml(node.path);
                                        const escapedName = escapeHtml(node.name);
                                        
                                        html += `
                                            <div class="modal-category-node" style="--tree-indent: ${indent}px; --node-color: ${nodeColor};">
                                                <div class="modal-category-line">
                                                    ${hasChildren ? `
                                                        <span class="modal-category-toggle" onclick="toggleModalNode('${escapedPathForJs}')">
                                                            ${isExpanded ? '▼' : '▶'}
                                                        </span>
                                                    ` : '<span class="modal-category-leaf-marker">•</span>'}
                                                    
                                                    <label class="modal-category-label">
                                                        <input type="checkbox" 
                                                            class="category-selector"
                                                            value="${escapedPathForHtml}"
                                                            ${isSelected ? 'checked' : ''}
                                                            onchange="updateModalSelection('${escapedPathForJs}', this.checked)">
                                                        <span class="modal-category-label-name">${escapedName}</span>
                                                        <span class="modal-category-path">${escapedPathForHtml}</span>
                                                    </label>
                                                </div>
                                                
                                                ${hasChildren && isExpanded ? `
                                                    <div class="modal-category-children">
                                                        ${renderModalNodes(node.children, level + 1)}
                                                    </div>
                                                ` : ''}
                                            </div>
                                        `;
                                    });
                                    
                                    return html;
                                }

                                function toggleModalNode(path) {
                                    if (expandedNodes.has(path)) {
                                        expandedNodes.delete(path);
                                    } else {
                                        expandedNodes.add(path);
                                    }
                                    renderModalTree();
                                }

                                function updateModalSelection(path, checked) {
                                    if (!modalSelectedPaths) {
                                        modalSelectedPaths = new Set(selectedPaths);
                                    }
                                    if (checked) {
                                        modalSelectedPaths.add(path);
                                    } else {
                                        modalSelectedPaths.delete(path);
                                    }
                                }

                                function closeCategoryModal() {
                                    modalSelectedPaths = null;
                                    document.getElementById('categoryModal')?.remove();
                                }

                                async function saveCategoriesFromModal(button = null) {
                                    const categories = Array.from(modalSelectedPaths || selectedPaths);
                                    setSaveButtonBusy(button, true);
                                    try {
                                        const result = await updateCategories(categories);
                                        if (result?.error) {
                                            showAlert(`Error: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                                            return;
                                        }

                                        selectedPaths = new Set(result.categories || categories);
                                        updateCategoryEditorTriggers();
                                        closeCategoryModal();
                                        showAlert('Categories saved.', 2500, { title: 'Success', type: 'success' });
                                        setTimeout(() => location.reload(), 900);
                                    } catch (error) {
                                        console.error('Error saving categories:', error);
                                        showAlert('Failed to save categories.', 6000, { title: 'Error', type: 'error' });
                                    } finally {
                                        setSaveButtonBusy(button, false);
                                    }
                                }

                                async function updateCategories(categories) {
                                    try {
                                        const response = await fetch('/updateOfficialCategories', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({
                                                miiId: '<%= mii.id %>',
                                                categories: categories
                                            })
                                        });
                                        
                                        return await response.json();
                                    } catch (error) {
                                        console.error('Error:', error);
                                        return { error: 'Error updating categories' };
                                    }
                                }

                                function openMiiTagEditor() {
                                    const modal = document.createElement('div');
                                    modal.className = 'category-modal-overlay';
                                    modal.id = 'miiTagModal';

                                    const modalContent = document.createElement('div');
                                    modalContent.className = 'category-modal-panel tag-modal-panel';

                                    modalSelectedMiiTags = new Set(selectedMiiTags);
                                    modalContent.innerHTML = `
                                        <h3 class="category-modal-title">Select Tags</h3>
                                        <p class="category-modal-help">Check all tags that apply. Only existing tags can be assigned.</p>
                                        <div class="category-modal-tree-wrap tag-modal-list-wrap">
                                            <div id="modalMiiTagList" class="tag-modal-list"></div>
                                        </div>
                                        <div class="category-modal-actions">
                                            <button onclick="closeMiiTagModal()" class="category-modal-btn category-modal-btn-cancel">
                                                Cancel
                                            </button>
                                            <button onclick="saveMiiTagsFromModal(this)" class="category-modal-btn category-modal-btn-save">
                                                Save Tags
                                            </button>
                                        </div>
                                    `;

                                    modal.appendChild(modalContent);
                                    document.body.appendChild(modal);
                                    renderMiiTagModalList();

                                    modal.addEventListener('click', (e) => {
                                        if (e.target === modal) {
                                            closeMiiTagModal();
                                        }
                                    });
                                }

                                function renderMiiTagModalList() {
                                    const container = document.getElementById('modalMiiTagList');
                                    if (!container) return;

                                    container.innerHTML = '';

                                    if (!Array.isArray(availableMiiTags) || availableMiiTags.length === 0) {
                                        const emptyState = document.createElement('p');
                                        emptyState.className = 'mod-tag-empty';
                                        emptyState.textContent = 'No tags have been created yet.';
                                        container.appendChild(emptyState);
                                        return;
                                    }

                                    const activeSelectedTags = modalSelectedMiiTags || selectedMiiTags;
                                    availableMiiTags.forEach((tag) => {
                                        const label = document.createElement('label');
                                        label.className = 'tag-modal-option';

                                        const checkbox = document.createElement('input');
                                        checkbox.type = 'checkbox';
                                        checkbox.value = tag;
                                        checkbox.checked = activeSelectedTags.has(tag);
                                        checkbox.addEventListener('change', (event) => {
                                            updateModalMiiTagSelection(tag, event.target.checked);
                                        });

                                        const text = document.createElement('span');
                                        text.textContent = tag;

                                        label.appendChild(checkbox);
                                        label.appendChild(text);
                                        container.appendChild(label);
                                    });
                                }

                                function updateModalMiiTagSelection(tag, checked) {
                                    if (!modalSelectedMiiTags) {
                                        modalSelectedMiiTags = new Set(selectedMiiTags);
                                    }

                                    if (checked) {
                                        modalSelectedMiiTags.add(tag);
                                    } else {
                                        modalSelectedMiiTags.delete(tag);
                                    }
                                }

                                function closeMiiTagModal() {
                                    modalSelectedMiiTags = null;
                                    document.getElementById('miiTagModal')?.remove();
                                }

                                async function saveMiiTagsFromModal(button = null) {
                                    const tags = Array.from(modalSelectedMiiTags || selectedMiiTags);
                                    setSaveButtonBusy(button, true);
                                    try {
                                        const result = await submitMiiTagsUpdate(tags);
                                        if (result?.error) {
                                            showAlert(`Error: ${result.error}`, 6000, { title: 'Error', type: 'error' });
                                            return;
                                        }

                                        selectedMiiTags = new Set(result.tags || tags);
                                        updateTagEditorTriggers();
                                        closeMiiTagModal();
                                        showAlert('Tags saved.', 2500, { title: 'Success', type: 'success' });
                                        setTimeout(() => location.reload(), 900);
                                    } catch (error) {
                                        console.error('Error saving tags:', error);
                                        showAlert('Failed to save tags.', 6000, { title: 'Error', type: 'error' });
                                    } finally {
                                        setSaveButtonBusy(button, false);
                                    }
                                }
                                </script>
                            <% if(mii.official || canEditMiiCategories) { %>
                                <div class="official-categories-section">
                                    <div class="mii-classification-header">
                                        <span class="info-label">Official Categories</span>
                                        <% if(canEditMiiCategories) { %>
                                            <button type="button" class="mii-classification-edit-button" onclick="openCategoryEditor()" aria-label="Edit official categories" title="Edit official categories">
                                                <%- include('icon', { name: 'edit', size: 14 }) %>
                                            </button>
                                        <% } %>
                                    </div>
                                    <div class="categories-display mii-card-tags mii-categories">
                                        <% if(mii.official) { %>
                                            <span class="mii-card-tag official-badge"><span class="tag-marquee-content">Official</span></span>
                                        <% } %>
                                        <% if(categoryDetails.length > 0) { %>
                                            <% categoryDetails.forEach(category => { %>
                                                <a class="mii-card-tag category-tag" href="<%= category.url %>" style="--category-color: <%= category.color || '#999999' %>;">
                                                    <span class="tag-marquee-content"><%= category.fullPath || category.name %></span>
                                                </a>
                                            <% }); %>
                                        <% } else { %>
                                            <span class="no-categories">No categories assigned.</span>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>
                            <div class="mii-tags-section">
                                <div class="mii-classification-header">
                                    <span class="info-label">Tags</span>
                                    <% if(canEditMiiTags) { %>
                                        <button type="button" class="mii-classification-edit-button" onclick="openMiiTagEditor()" aria-label="Edit tags" title="Edit tags">
                                            <%- include('icon', { name: 'edit', size: 14 }) %>
                                        </button>
                                    <% } %>
                                </div>
                                <% if(tagList.length > 0) { %>
                                    <div class="mii-tags-list">
                                        <% tagList.forEach(tag => { %>
                                            <a class="mii-tag-badge" href="/searchResults?tags=<%= encodeURIComponent(tag) %>"><span class="tag-marquee-content"><%= tag %></span></a>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <span class="no-tags">No tags assigned.</span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% if(isPrivate) { %>
                        <div class="private-mii-panel">
                            <strong class="private-mii-panel-title"><%- include('icon', { name: 'lock', size: 16, class: 'icon-inline' }) %> This is a Private Mii</strong>
                            <p class="private-mii-panel-text">Only you and moderators can view this Mii.</p>
                            <% if(mii.blockedFromPublishing) { %>
                                <div class="private-mii-status">
                                    <strong class="private-mii-status-title"><%- include('icon', { name: 'ban', size: 16, class: 'icon-inline icon-danger' }) %> This Mii has been blocked from publishing</strong>
                                    <% if(mii.blockReason) { %>
                                        <p class="private-mii-status-text"><%= mii.blockReason %></p>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <div class="private-mii-actions">
                                    <button onclick="publishThisMii()" class="btn-primary private-mii-btn">
                                        <%- include('icon', { name: 'upload', size: 16 }) %> Publish This Mii
                                    </button>
                                </div>
                            <% } %>
                        </div>
                        <% if(isModerator) { %>
                            <div class="private-mii-panel private-mii-panel-moderator">
                                <strong class="private-mii-panel-title"><%- include('icon', { name: 'shield', size: 16, class: 'icon-inline' }) %> Moderator Actions</strong>
                                <% if(!mii.blockedFromPublishing) { %>
                                    <div class="private-mii-actions">
                                        <button onclick="blockMiiFromPublishing()" class="private-mii-btn private-mii-btn-warning">
                                            <%- include('icon', { name: 'ban', size: 16 }) %> Block from Publishing
                                        </button>
                                    </div>
                                <% } else { %>
                                    <p class="private-mii-panel-text">This Mii is already blocked from publishing.</p>
                                    <div class="private-mii-actions">
                                        <button onclick="unblockMiiFromPublishing()" class="private-mii-btn private-mii-btn-success">
                                            <%- include('icon', { name: 'check', size: 16 }) %> Unblock Publishing
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <% if(hasTomodachiLifeData && tomodachiRowsForPage.length > 0) { %>
                    <section class="tomodachi-life-panel" aria-labelledby="tomodachiLifeHeading">
                        <div class="tomodachi-life-panel-header">
                            <div class="tomodachi-life-title">
                                <div class="tomodachi-life-title-copy">
                                    <span class="tomodachi-life-eyebrow">Tomodachi Life</span>
                                    <h3 id="tomodachiLifeHeading">Resident Data</h3>
                                </div>
                            </div>
                        </div>

                        <div class="tomodachi-life-content <%= tomodachiAddressRow ? '' : 'without-address' %>">
