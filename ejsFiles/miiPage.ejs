            function normalizeQrPreviewConsole(consoleType) {
                const normalizedConsole = String(consoleType || '').trim().toUpperCase().replace(/[\s_-]+/g, '');
                if (['TOMODACHI', 'TOMODACHILIFE', 'TL', 'TLE'].includes(normalizedConsole)) return 'TOMODACHI';
                // MT QR previews are temporarily disabled on-site.
                // if (['MIITOPIA', 'MT', 'MTE'].includes(normalizedConsole)) return 'MIITOPIA';
                return normalizedConsole === 'WII' || normalizedConsole === 'WIIU' ? 'WIIU' : '3DS';
            }

            function getQrPreviewSources(preview) {
                if (!(preview instanceof HTMLElement)) return null;
                const source3ds = String(preview.dataset.qr3dsSrc || '').trim();
                const sourceWiiu = String(preview.dataset.qrWiiuSrc || preview.dataset.qrWiiSrc || '').trim() || source3ds;
                const sourceTomodachi = String(preview.dataset.qrTomodachiSrc || '').trim();
                const sourceMiitopia = String(preview.dataset.qrMiitopiaSrc || '').trim();
                if (!source3ds) return null;

                const sources = {
                    '3DS': source3ds,
                    'WIIU': sourceWiiu,
                    'WII': sourceWiiu
                };
                if (sourceTomodachi) {
                    sources.TOMODACHI = sourceTomodachi;
                }
                // MT QR previews are temporarily disabled on-site.
                // if (sourceMiitopia) {
                //     sources.MIITOPIA = sourceMiitopia;
                // }
                return sources;
            }

            function setQrPreviewConsole(tabOrPreview, consoleType) {
                let preview = null;
                let targetConsole = consoleType;

                if (tabOrPreview instanceof HTMLElement && tabOrPreview.matches('[data-qr-tab]')) {
                    preview = tabOrPreview.closest('[data-qr-preview]');
                    targetConsole = tabOrPreview.dataset.qrTab || consoleType;
                } else if (tabOrPreview instanceof HTMLElement && tabOrPreview.matches('[data-qr-preview]')) {
                    preview = tabOrPreview;
                } else {
                    preview = document.querySelector('[data-qr-preview]');
                }

                if (!preview) return false;

                const image = preview.querySelector('[data-qr-image]');
                const link = preview.querySelector('[data-qr-link]');
                const tabs = Array.from(preview.querySelectorAll('[data-qr-tab]'));
                const sourceByConsole = getQrPreviewSources(preview);

                if (!image || tabs.length === 0 || !sourceByConsole) {
                    return false;
                }

                const normalizedConsole = normalizeQrPreviewConsole(targetConsole || image.dataset.qrConsole || '3DS');
                const nextSrc = sourceByConsole[normalizedConsole];
                if (!nextSrc) {
                    return false;
                }

                preview.classList.toggle('is-qr-3ds', normalizedConsole === '3DS');
                preview.classList.toggle('is-qr-wiiu', normalizedConsole === 'WIIU');
                preview.classList.toggle('is-qr-tomodachi', normalizedConsole === 'TOMODACHI');
                preview.classList.toggle('is-qr-miitopia', normalizedConsole === 'MIITOPIA');

                tabs.forEach((tab) => {
                    const tabConsole = normalizeQrPreviewConsole(tab.dataset.qrTab || '');
                    const isSelected = tabConsole === normalizedConsole;
                    tab.classList.toggle('is-active', isSelected);
                    tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
                });

                image.dataset.qrConsole = normalizedConsole;
                if (link) {
                    link.href = nextSrc;
                }

                if (image.src !== nextSrc) {
                    image.classList.remove('is-loaded');
                    image.classList.add('is-switching');
                    image.src = nextSrc;
                } else if (image.complete && image.naturalWidth > 0) {
                    image.classList.remove('is-switching');
                    image.classList.add('is-loaded');
                }

                return true;
            }

            function initializeQrPreviewTabs() {
                const preview = document.querySelector('[data-qr-preview]');
                if (!preview) return;
                if (preview.dataset.qrTabsInitialized === 'true') return;
                preview.dataset.qrTabsInitialized = 'true';

                const image = preview.querySelector('[data-qr-image]');
                const tabs = Array.from(preview.querySelectorAll('[data-qr-tab]'));
                const sourceByConsole = getQrPreviewSources(preview);

                if (!image || tabs.length === 0 || !sourceByConsole) {
                    return;
                }

                const loadedConsoles = new Set();

                const setLoadedState = () => {
                    image.classList.remove('is-switching');
                    image.classList.add('is-loaded');
                    const currentConsole = normalizeQrPreviewConsole(image.dataset.qrConsole || '');
                    if (currentConsole) {
                        loadedConsoles.add(currentConsole);
                    }
                };

                image.addEventListener('load', () => {
                    setLoadedState();
                });

                tabs.forEach((tab) => {
                    const tabConsole = normalizeQrPreviewConsole(tab.dataset.qrTab || '');
                    tab.addEventListener('keydown', (event) => {
                        if (event.key !== 'Enter' && event.key !== ' ') {
                            return;
                        }
                        event.preventDefault();
                        setQrPreviewConsole(preview, tabConsole);
                    });

                    tab.addEventListener('mouseenter', () => {
                        const src = sourceByConsole[tabConsole];
                        if (!src || loadedConsoles.has(tabConsole)) return;
                        const preload = new Image();
                        preload.decoding = 'async';
                        preload.loading = 'lazy';
                        preload.src = src;
                    });
                });

                if (image.complete && image.naturalWidth > 0) {
                    setLoadedState();
                } else {
                    image.classList.add('is-switching');
                }

                setQrPreviewConsole(preview, preview.dataset.defaultQrConsole || '3DS');
            }

