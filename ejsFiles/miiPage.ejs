<!DOCTYPE html>
<html>
    <head>
        <%
        // Set page-specific variables for meta tags
        const pageTitle = `${mii.meta.name} - InfiniMii | Download Mii Character`;
        const pageDesc = mii.desc || `Download ${mii.meta.name} Mii character${mii.official ? ' (Official Nintendo Mii)' : ''} for Wii, 3DS, Wii U, Switch. Get QR code and convert to any format.`;
        const canonicalUrl = `${baseUrl}/mii/${mii.id}`;
        const ogImage = `${baseUrl}/miiImgs/${mii.id}.png`;
        const ogType = 'article';
        const keywords = `${mii.meta.name}, ${mii.official ? 'official ' : ''}mii character, download mii, mii qr code`;
        const breadcrumbs = [
            { name: 'Home', url: '/' },
            { name: mii.official ? 'Official Miis' : 'Community Miis', url: mii.official ? '/official' : '/top' },
            { name: mii.meta.name, url: `/mii/${mii.id}` }
        ];
        %>
        
        <%- include('metaTags') %>
        <%- include('structuredData') %>
        <%- include('miiSchema') %>
        
        <link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="/miiPage.css">
        
        <!-- Preload hero image -->
        <link rel="preload" as="image" href="/miiImgs/<%= mii.id %>.png">
    </head>
    <body>
        <%- include('globalStyle') %>
        <% 
            const imgPath = isPrivate ? 'privateMiiImgs' : 'miiImgs';
            const qrPath = isPrivate ? 'privateMiiQRs' : 'miiQRs';
        %>
        <%- include('header') %>
        <%- include('accountDisplay') %>

        <main class="content" role="main">
            <%- include('sidebar') %>

            <article class="mii-id-card" style="--favorite-color: <%= decodeColor(mii.general?.favoriteColor) || decodeColor(0) %>;" itemscope itemtype="https://schema.org/CreativeWork">
                <!-- Card Header -->
                <header class="id-card-header">
                    <h2 itemprop="name">Mii ID Card</h2>
                    <div class="card-number" role="button" tabindex="0" onclick="copyMiiId(this, '<%= mii.id %>')" aria-label="Copy Mii ID">ID: <%= mii.id %></div>
                </header>

                <!-- Main Card Body -->
                <div class="id-card-body">
                    <!-- Left side: Mii Image -->
                    <figure class="id-card-photo">
                        <img src="/<%= imgPath %>/<%= mii.id %>.png" 
                            onerror="this.src='/<%= imgPath %>/<%= mii.id %>.png'"
                            alt="<%= mii.meta.name %> Mii Character Face"
                            itemprop="image"
                            width="400" 
                            height="400"
                            fetchpriority="high">
                        <figcaption class="qr-code">
                            <a href="/<%= qrPath %>/<%= mii.id %>.png" target="_blank">
                                <img src="/<%= qrPath %>/<%= mii.id %>.png" 
                                    onerror="this.src='/<%= qrPath %>/<%= mii.id %>.png'"
                                    alt="QR Code for <%= mii.meta.name %> - Scan with 3DS, Wii U, Tomodachi Life, or Miitomo" 
                                    width="200" 
                                    height="200"
                                    loading="lazy">
                            </a>
                            <form id="miiQrExportForm" method="GET" action="/exportMii" style="margin-top: 10px; display: flex; flex-direction: column; gap: 6px; align-items: center;">
                                <input type="hidden" name="id" value="<%= mii.id %>">
                                <input type="hidden" name="format" value="qr">
                                <label for="qr-preview-console-<%= mii.id %>" style="display: inline-flex; align-items: center; gap: 6px;">
                                    QR:
                                    <select id="qr-preview-console-<%= mii.id %>" name="qrConsole">
                                        <option value="3DS">3DS</option>
                                        <option value="WIIU">Wii U</option>
                                    </select>
                                </label>
                                <label style="display: inline-flex; align-items: center; gap: 6px;">
                                    <input type="checkbox" name="special">
                                    Special
                                </label>
                                <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; justify-content: center;">
                                    <button type="submit" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;">Download QR</button>
                                    <button type="button" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;" onclick="copyMiiExportText('miiQrExportForm', 'hex')">Copy Hex</button>
                                    <button type="button" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.9rem;" onclick="copyMiiExportText('miiQrExportForm', 'base64')">Copy Base64</button>
                                </div>
                            </form>
                        </figcaption>
                    </figure>

                    <!-- Right side: Information -->
                    <div class="id-card-info">
                        <h1 class="mii-name"><%= mii.meta.name %></h1>
                        
                        <div class="info-grid">
                            <% if(mii.meta.creatorName?.length>0){ %>
                            <div class="info-item">
                                <span class="info-label">Creator Name</span>
                                <span class="info-value" itemprop="creator"><%= mii.meta.creatorName %></span>
                            </div>
                            <% } %>
                            
                            <div class="info-item">
                                <span class="info-label">Birthday</span>
                                <span class="info-value"><%= ["","Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"][mii.general.birthMonth] %> <%= mii.general.birthday>0?mii.general.birthday:"Not Set" %></span>
                            </div>

                            <% if(mii.general.height !== undefined) { %>
                            <div class="info-item">
                                <span class="info-label">Height</span>
                                <span class="info-value"><%= `${height.feet}' ${height.inches}"` %>, <%= height.centimeters %>cm.</span>
                            </div>
                            <% } %>

                            <% if(mii.general.weight !== undefined) { %>
                            <div class="info-item">
                                <span class="info-label">Weight [Experimental]</span>
                                <span class="info-value"><%= Math.round(weight.pounds) %>lbs, <%= weight.kilograms %>kg.</span>
                            </div>
                            <% } %>

                            <% if(mii.general.favoriteColor !== undefined) { %>
                            <div class="info-item">
                                <span class="info-label">Favorite Color</span>
                                <span class="info-value"><%= ["Red", "Orange", "Yellow", "Lime", "Green", "Blue", "Cyan", "Pink", "Purple", "Brown", "White", "Black"][mii.general.favoriteColor] %></span>
                            </div>
                            <% } %>
                                <script>
                                const currentCategories = <%- JSON.stringify(mii.officialCategories || []) %>;
                                const currentMiiTags = <%- JSON.stringify(mii.tags || []) %>;
                                const availableMiiTags = <%- JSON.stringify(availableTags || []) %>;
                                let selectedMiiTags = new Set(currentMiiTags);
                                let officialCategories = [];
                                let selectedPaths = new Set(currentCategories);
                                let expandedNodes = new Set();

                                async function loadCategoriesForEditor() {
                                    try {
                                        const response = await fetch('/getOfficialCategories', {
                                            headers: { "Content-Type": "application/json" },
                                        });
                                        const data = await response.json();
                                        
                                        if (!data.error) {
                                            officialCategories = data.categories?.categories || data.categories || [];
                                            // Auto-expand paths that contain selected categories
                                            currentCategories.forEach(path => {
                                                const parts = path.split('/');
                                                let currentPath = '';
                                                parts.forEach((part, index) => {
                                                    currentPath += (index > 0 ? '/' : '') + part;
                                                    if (index < parts.length - 1) {
                                                        expandedNodes.add(currentPath);
                                                    }
                                                });
                                            });
                                            return true;
                                        }
                                        return false;
                                    } catch (error) {
                                        console.error('Error loading categories:', error);
                                        return false;
                                    }
                                }

                                async function openCategoryEditor() {
                                    const loaded = await loadCategoriesForEditor();
                                    
                                    if (!loaded) {
                                        showAlert('Error loading categories', 5000, { title: 'Error', type: 'error' });
                                        return;
                                    }
                                    
                                    const modal = document.createElement('div');
                                    modal.className = 'category-modal-overlay';
                                    modal.id = 'categoryModal';
                                    
                                    const modalContent = document.createElement('div');
                                    modalContent.className = 'category-modal-panel';
                                    
                                    modalContent.innerHTML = `
                                        <h3 class="category-modal-title">Select Categories</h3>
                                        <p class="category-modal-help">Check all categories that apply. Only leaf categories (without children) can be selected.</p>
                                        <div class="category-modal-tree-wrap">
                                            <div id="modalCategoryTree"></div>
                                        </div>
                                        <div class="category-modal-actions">
                                            <button onclick="closeCategoryModal()" class="category-modal-btn category-modal-btn-cancel">
                                                Cancel
                                            </button>
                                            <button onclick="saveCategoriesFromModal()" class="category-modal-btn category-modal-btn-save">
                                                Save Categories
                                            </button>
                                        </div>
                                    `;
                                    
                                    modal.appendChild(modalContent);
                                    document.body.appendChild(modal);
                                    
                                    renderModalTree();
                                    
                                    modal.addEventListener('click', (e) => {
                                        if (e.target === modal) {
                                            modal.remove();
                                        }
                                    });
                                }

                                function renderModalTree() {
                                    const container = document.getElementById('modalCategoryTree');
                                    if (!container) return;
                                    
                                    container.innerHTML = renderModalNodes(officialCategories);
                                }

                                function renderModalNodes(nodes, level = 0) {
                                    let html = '';
                                    
                                    nodes.forEach(node => {
                                        const hasChildren = node.children && node.children.length > 0;
                                        const isExpanded = expandedNodes.has(node.path);
                                        const isLeaf = !hasChildren;
                                        const isSelected = selectedPaths.has(node.path);
                                        const indent = level * 20;
                                        const nodeColor = node.color || '#999999';
                                        
                                        html += `
                                            <div class="modal-category-node" style="--tree-indent: ${indent}px; --node-color: ${nodeColor};">
                                                <div class="modal-category-line">
                                                    ${hasChildren ? `
                                                        <span class="modal-category-toggle" onclick="toggleModalNode('${node.path}')">
                                                            ${isExpanded ? '▼' : '▶'}
                                                        </span>
                                                    ` : '<span class="modal-category-leaf-marker">•</span>'}
                                                    
                                                    ${isLeaf ? `
                                                        <label class="modal-category-label">
                                                            <input type="checkbox" 
                                                                class="category-selector"
                                                                value="${node.path}"
                                                                ${isSelected ? 'checked' : ''}
                                                                onchange="updateModalSelection('${node.path}', this.checked)">
                                                            <span class="modal-category-label-name">${node.name}</span>
                                                            <span class="modal-category-path">${node.path}</span>
                                                        </label>
                                                    ` : `
                                                        <span class="modal-category-parent-name">${node.name}</span>
                                                    `}
                                                </div>
                                                
                                                ${hasChildren && isExpanded ? `
                                                    <div class="modal-category-children">
                                                        ${renderModalNodes(node.children, level + 1)}
                                                    </div>
                                                ` : ''}
                                            </div>
                                        `;
                                    });
                                    
                                    return html;
                                }

                                function toggleModalNode(path) {
                                    if (expandedNodes.has(path)) {
                                        expandedNodes.delete(path);
                                    } else {
                                        expandedNodes.add(path);
                                    }
                                    renderModalTree();
                                }

                                function updateModalSelection(path, checked) {
                                    if (checked) {
                                        selectedPaths.add(path);
                                    } else {
                                        selectedPaths.delete(path);
                                    }
                                }

                                function closeCategoryModal() {
                                    document.getElementById('categoryModal')?.remove();
                                }

                                async function saveCategoriesFromModal() {
                                    const categories = Array.from(selectedPaths);
                                    
                                    await updateCategories(categories);
                                    closeCategoryModal();
                                }

                                async function updateCategories(categories) {
                                    try {
                                        const response = await fetch('/updateOfficialCategories', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({
                                                miiId: '<%= mii.id %>',
                                                categories: categories
                                            })
                                        });
                                        
                                        const data = await response.json();
                                        
                                        if (!data.error) {
                                            showAlert('Categories updated successfully!', 3000, { title: 'Success', type: 'success' });
                                            setTimeout(() => window.location.reload(), 3000);
                                        } else {
                                            showAlert('Error: ' + (data.error || 'Failed to update categories'), 5000, { title: 'Error', type: 'error' });
                                        }
                                    } catch (error) {
                                        console.error('Error:', error);
                                        showAlert('Error updating categories', 5000, { title: 'Error', type: 'error' });
                                    }
                                }
                                </script>
                            <div class="mii-tags-section">
                                <span class="info-label">Tags</span>
                                <% if(Array.isArray(mii.tags) && mii.tags.length > 0) { %>
                                    <div class="mii-tags-list">
                                        <% mii.tags.forEach(tag => { %>
                                            <a class="mii-tag-badge" href="/searchResults?tags=<%= encodeURIComponent(tag) %>"><%= tag %></a>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <span class="no-tags">No tags assigned.</span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% if(isPrivate) { %>
                        <div style="background: #fff3cd; border: 2px solid #ffc107; padding: 15px; margin: 15px; border-radius: 8px; text-align: center;">
                            <strong><%- include('icon', { name: 'lock', size: 16, class: 'icon-inline' }) %> This is a Private Mii</strong>
                            <p style="margin: 10px 0;">Only you and moderators can view this Mii.</p>
                            <% if(mii.blockedFromPublishing) { %>
                                <div style="background: #ffe6e6; padding: 10px; margin-top: 10px; border-radius: 6px;">
                                    <strong><%- include('icon', { name: 'ban', size: 16, class: 'icon-inline icon-danger' }) %> This Mii has been blocked from publishing</strong>
                                    <% if(mii.blockReason) { %>
                                        <p><%= mii.blockReason %></p>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <button onclick="publishThisMii()" style="background: #00cc00; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 10px;">
                                    <%- include('icon', { name: 'upload', size: 16 }) %> Publish This Mii
                                </button>
                            <% } %>
                        </div>
                        <% if(isModerator) { %>
                            <div style="background: #fff3cd; border: 2px solid #ff6600; padding: 15px; margin: 15px; border-radius: 8px;">
                                <strong><%- include('icon', { name: 'shield', size: 16, class: 'icon-inline' }) %> Moderator Actions</strong>
                                <% if(!mii.blockedFromPublishing) { %>
                                    <button onclick="blockMiiFromPublishing()" style="background: #ff6600; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 10px;">
                                        <%- include('icon', { name: 'ban', size: 16 }) %> Block from Publishing
                                    </button>
                                <% } else { %>
                                    <p style="margin: 10px 0;">This Mii is already blocked from publishing.</p>
                                    <button onclick="unblockMiiFromPublishing()" style="background: #2e7d32; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 10px;">
                                        <%- include('icon', { name: 'check', size: 16 }) %> Unblock Publishing
                                    </button>
                                <% } %>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <!-- Uploader Information -->
                <!-- Footer Section -->
                <div class="id-card-footer">
                    <div class="uploader-info">
                        <% if(mii.official){ %>
                            <span class="official-badge"><%- include('icon', { name: 'star-filled', size: 14, class: 'icon-gold' }) %> Official Nintendo Mii</span>
                        <% } %>
                        <span class="label">Uploaded by</span>
                        <a class="uploader-with-pfp" href="/user/<%= encodeURIComponent(mii.uploader) %>">
                            <img
                                class="uploader-pfp"
                                src="/miiImgs/<%= uploaderPfp %>.png"
                                alt="<%= mii.uploader %>'s profile Mii"
                                onerror="this.src='/miiImgs/00000.png'"
                                loading="lazy"
                                width="28"
                                height="28"
                            >
                            <span><%= mii.uploader %></span>
                        </a>
                        <% if(mii.official && mii.contributor) { %>
                            <small class="uploader-subtext">(Contributed by <a href="/user/<%= encodeURIComponent(mii.contributor) %>"><%= mii.contributor %></a>)</small>
                        <% } %>
                        <time class="date" datetime="<%= new Date(mii.uploadedOn).toISOString() %>" itemprop="datePublished">on <%= new Date(mii.uploadedOn).toLocaleDateString() %></time>
                    </div>
                </div>
                <!-- Description -->
                <% if(mii.desc && mii.desc.length > 0) { %>
                    <div class="id-card-description">
                        <h3 class="info-label">Description</h3>
                        <p itemprop="description"><%= mii.desc %></p>
                    </div>
                <% } %>

                <!-- Actions -->
                <div class="id-card-actions">
                    <button class="btn-primary" onclick="copyMiiId(this, '<%= mii.id %>')">
                        <svg xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 96 960 960" width="20" fill="currentColor">
                            <path d="M360 816q-33 0-56.5-23.5T280 736V256q0-33 23.5-56.5T360 176h360q33 0 56.5 23.5T800 256v480q0 33-23.5 56.5T720 816H360Zm0-80h360V256H360v480ZM200 976q-33 0-56.5-23.5T120 896V336h80v560h440v80H200Zm160-240V256v480Z"/>
                        </svg>
                        <span class="copy-label">Copy Mii ID</span>
                    </button>

                    <form id="miiExportForm" class="export-form" method="GET" action="/exportMii">
                        <input type="hidden" name="id" value="<%= mii.id %>">
                        <label for="export-format-<%= mii.id %>">Download format</label>
                        <div class="export-row">
                            <input type="text" id="export-format-<%= mii.id %>" name="format" list="exportFormatOptions" placeholder="Search formats..." required>
                            <button type="submit" class="btn-primary">Download</button>
                            <button type="button" class="btn-secondary" onclick="copyMiiExportText('miiExportForm', 'hex')">Copy Hex</button>
                            <button type="button" class="btn-secondary" onclick="copyMiiExportText('miiExportForm', 'base64')">Copy Base64</button>
                        </div>
                        <div class="export-row" style="margin-top: 10px;">
                            <label style="display: inline-flex; align-items: center; gap: 8px;">
                                <input type="checkbox" name="special">
                                Download as Special Mii
                            </label>
                            <label for="qr-console-<%= mii.id %>" style="display: inline-flex; align-items: center; gap: 8px;">
                                QR Console:
                                <select id="qr-console-<%= mii.id %>" name="qrConsole">
                                    <option value="3DS">3DS</option>
                                    <option value="WIIU">Wii U</option>
                                </select>
                            </label>
                        </div>
                        <p class="note">Search any supported format (except NTAG). Try <code>qr</code>, <code>charinfo</code>, or <code>ffsd</code>.</p>
                    </form>
                    <datalist id="exportFormatOptions">
                        <% exportFormats.forEach(fmt => { %>
                            <option value="<%= fmt.value %>" label="<%= fmt.label %>"></option>
                        <% }) %>
                    </datalist>

                    <div class="export-secondary">
                        <button class="btn-secondary" onclick="openMiiInstructions(event)">Recreation Instructions</button>
                    </div>


                    <div class="vote-section">
                        <button onclick="likeMii(this,'<%= mii.id %>','<%= highlightedMii %>','<%= isModerator %>')" class="like-button">
                            <!-- TODO check -->
                            <% if(!user?.votedFor.includes(mii.id) && mii.uploader !== user?.username){ %> 
                                <svg xmlns="http://www.w3.org/2000/svg" class="like-icon" viewBox="0 96 960 960" fill="currentColor">
                                    <path d="m480 935-41-37q-105.768-97.121-174.884-167.561Q195 660 154 604.5T96.5 504Q80 459 80 413q0-90.155 60.5-150.577Q201 202 290 202q57 0 105.5 27t84.5 78q42-54 89-79.5T670 202q89 0 149.5 60.423Q880 322.845 880 413q0 46-16.5 91T806 604.5Q765 660 695.884 730.439 626.768 800.879 521 898l-41 37Zm0-79q101.236-92.995 166.618-159.498Q712 630 750.5 580t54-89.135q15.5-39.136 15.5-77.72Q820 347 778 304.5T670.225 262q-51.524 0-95.375 31.5Q531 325 504 382h-49q-26-56-69.85-88-43.851-32-95.375-32Q224 262 182 304.5t-42 108.816Q140 452 155.5 491.5t54 90Q248 632 314 698t166 158Zm0-297Z"/>
                                </svg>
                            <% } else { %>
                                <svg class="like-icon liked" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M0 0h24v24H0V0z" fill="none"/>
                                    <path d="M13.35 20.13c-.76.69-1.93.69-2.69-.01l-.11-.1C5.3 15.27 1.87 12.16 2 8.28c.06-1.7.93-3.33 2.34-4.29 2.64-1.8 5.9-.96 7.66 1.1 1.76-2.06 5.02-2.91 7.66-1.1 1.41.96 2.28 2.59 2.34 4.29.14 3.88-3.3 6.99-8.55 11.76l-.1.09z"/>
                                </svg>
                            <% } %>
                            <span class="vote-count" itemprop="interactionStatistic" itemscope itemtype="https://schema.org/InteractionCounter">
                                <meta itemprop="interactionType" content="https://schema.org/LikeAction">
                                <meta itemprop="userInteractionCount" content="<%= mii.votes || 0 %>">
                                <%= mii.votes||0 %>
                            </span>
                        </button>

                        <% if(isModerator || mii.uploader === user?.username){ %>
                            <button class="trash-button" onclick="deleteMii('<%= mii.id %>')">
                                <svg xmlns="http://www.w3.org/2000/svg" class="trash-icon" viewBox="0 96 960 960" fill="currentColor">
                                    <path d="M261 936q-24.75 0-42.375-17.625T201 876V306h-41v-60h188v-30h264v30h188v60h-41v570q0 24-18 42t-42 18H261Zm438-630H261v570h438V306ZM367 790h60V391h-60v399Zm166 0h60V391h-60v399ZM261 306v570-570Z"/>
                                </svg>
                            </button>
                        <% } else { %>
                            <button class="report-button" onclick="report()">
                                <svg xmlns="http://www.w3.org/2000/svg" class="report-icon" viewBox="0 -960 960 960" fill="currentColor">
                                    <path d="M200-120v-680h360l16 80h224v400H520l-16-80H280v280h-80Zm300-440Zm86 160h134v-240H510l-16-80H280v240h290l16 80Z"/>
                                </svg>
                            </button>
                        <% } %>
                    </div>
                </div>

                <!-- Moderator Tools -->
                <% if(isModerator){ %>
                    <div class="moderator-tools">
                        <div class="mod-tools-header" onclick="toggleModTools()">
                            <h3><%- include('icon', { name: 'settings', size: 18, class: 'icon-inline' }) %> Moderator Tools</h3>
                            <span class="dropdown-arrow" id="modToolsArrow">▼</span>
                        </div>
                        
                        <div class="mod-tools-content" id="modToolsContent">
                            <div class="mod-tool-grid">
                                <!-- Edit Mii Name -->
                                <div class="mod-tool-item">
                                    <label>Mii Name:</label>
                                    <input type="text" id="editMiiName" value="<%= mii.meta.name %>" placeholder="Mii Name">
                                    <button onclick="updateMiiField('name', document.getElementById('editMiiName').value)">Update Name</button>
                                </div>

                                <!-- Edit Description -->
                                <div class="mod-tool-item">
                                    <label>Description:</label>
                                    <textarea id="editDesc" rows="3" placeholder="Description"><%= mii.desc %></textarea>
                                    <button onclick="updateMiiField('desc', document.getElementById('editDesc').value)">Update Description</button>
                                </div>

                                <!-- Edit Creator Name -->
                                <div class="mod-tool-item">
                                    <label>Creator Name (in Mii file):</label>
                                    <input type="text" id="editCreatorName" value="<%= mii.meta.creatorName || '' %>" placeholder="Creator Name">
                                    <button onclick="updateMiiField('creatorName', document.getElementById('editCreatorName').value)">Update Creator</button>
                                </div>

                                <!-- Switch Uploader -->
                                <div class="mod-tool-item">
                                    <label>Change Uploader:</label>
                                    <input type="text" id="editUploader" value="<%= mii.uploader %>" placeholder="Username">
                                    <button onclick="updateMiiField('uploader', document.getElementById('editUploader').value)">Change Uploader</button>
                                </div>

                                <!-- Edit Tags -->
                                <div class="mod-tool-item mod-tag-selector">
                                    <label>Mii Tags:</label>
                                    <div id="modMiiTagList" class="mod-tag-list"></div>
                                    <p class="mod-tag-hint">Only existing tags can be assigned. Create or delete tags from the Search page.</p>
                                    <button onclick="saveMiiTags()">Update Tags</button>
                                </div>

                                <!-- Toggle Official Status -->
                                <div class="mod-tool-item">
                                    <label>Official Mii Status:</label>
                                    <div class="toggle-container">
                                        <input type="checkbox" id="officialCheckbox" <%= mii.official ? 'checked' : '' %>>
                                        <label for="officialCheckbox">
                                            <% if(mii.official) { %>
                                                ✅ This is an Official Mii
                                            <% } else { %>
                                                ❌ Not an Official Mii
                                            <% } %>
                                        </label>
                                    </div>
                                    <button onclick="toggleOfficial()">Update Official Status</button>
                                </div>

                                <!-- Regenerate QR Code -->
                                <div class="mod-tool-item">
                                    <label>Regenerate QR Code:</label>
                                    <label for="regenQrConsole" style="display: inline-flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                                        QR Console:
                                        <select id="regenQrConsole">
                                            <option value="3DS">3DS</option>
                                            <option value="WIIU">Wii U</option>
                                        </select>
                                    </label>
                                    <button onclick="regenerateQR()"><%- include('icon', { name: 'refresh', size: 16 }) %> Regenerate QR</button>
                                    <span id="qrStatus"></span>
                                </div>

                                <!-- Delete Mii -->
                                <div class="mod-tool-item mod-tool-danger">
                                    <label>Delete Mii:</label>
                                    <button class="danger-btn" onclick="confirmDeleteMii()"><%- include('icon', { name: 'trash', size: 16 }) %> Delete Mii</button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </article>
            <%- include('featuredMiis') %>
        </main>
        
        <%- include('footer') %>

        <!--Due to needing access to EJS variables, we unfortunately cannot move these contents to a dedicated JS file-->
        <script>
            function copyMiiId(el, id){
                const labelEl = el?.querySelector?.('.copy-label') || el;
                const originalText = labelEl?.textContent || '';

                navigator.clipboard.writeText(id).then(() => {
                    if (labelEl) {
                        labelEl.textContent = '✓ Copied!';
                        setTimeout(() => {
                            labelEl.textContent = originalText;
                        }, 2000);
                    }
                }).catch(() => {
                    if (labelEl && typeof showAlert === 'function') {
                        showAlert('Failed to copy Mii ID', 4000, { title: 'Error', type: 'error' });
                    }
                });
            }
            function report(){
                var what=prompt("What would you like to report this Mii for?");
                fetch("/reportMii", {
                    method: "POST",
                    body: JSON.stringify({
                        id: "<%= mii.id %>",
                        what: what
                    }),
                    headers: { "Content-Type": "application/json" },
                });
            }
            async function publishThisMii() {
                showConfirm('Are you sure you want to publish this Mii? It will become visible to everyone.', async () => {
                    try {
                        const response = await fetch('/publishMii', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ miiId: '<%= mii.id %>' })
                        });
                        const result = await response.json();

                        if (!result.error) {
                            showAlert('Mii published successfully!', 3000, { title: 'Success', type: 'success' });
                            setTimeout(() => location.reload(), 3000);
                        } else {
                            showAlert(`Error: ${result.error || 'Failed to publish Mii'}`, 5000, { title: 'Error', type: 'error' });
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        showAlert('Error publishing Mii', 5000, { title: 'Error', type: 'error' });
                    }
                }, null, { title: 'Publish Mii', confirmText: 'Publish' });
            }
            async function openMiiInstructions(event) {
                event.preventDefault();
                if (typeof showMiiInstructionsModal !== 'function') {
                    if (typeof showAlert === 'function') {
                        showAlert('Instructions modal is unavailable on this page.', 4000, { title: 'Error', type: 'error' });
                    }
                    return;
                }

                showMiiInstructionsModal(async ({ consoleType }) => {
                    const response = await fetch(`/getInstructions?id=<%= mii.id %>&console=${encodeURIComponent(consoleType)}`, {
                        headers: { "Content-Type": "application/json" },
                    });
                    return await response.json();
                }, {
                    title: "Recreation Instructions",
                    defaultConsole: "3DS",
                    miiName: <%- JSON.stringify(mii.meta.name || "Mii") %>
                });
            }

            async function copyMiiExportText(formId, encoding) {
                const form = document.getElementById(formId);
                if (!form) return;
                const normalizedEncoding = String(encoding || '').trim().toLowerCase();
                if (normalizedEncoding === 'base64') {
                    await copyExportBase64FromForm(form);
                    return;
                }
                await copyExportHexFromForm(form);
            }
        </script>

        <!--Moderator Tools Functions - Because EJS runs server side, and the client only sees the result of the compilation, this prevents unnecessary JS from loading that doesn't need to be sent-->
        <% if (isModerator) { %>
            <script>
                async function blockMiiFromPublishing() {
                    const reason = prompt('Enter reason for blocking (optional):');
                    if (reason === null) return; // User cancelled
                    
                    try {
                        const response = await fetch('/blockMiiFromPublishing', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                miiId: '<%= mii.id %>',
                                reason: reason 
                            })
                        });
                        
                        const result = await response.json();
                        if (!result.error) {
                            showAlert('Mii blocked from publishing', 3000, { title: 'Success', type: 'success' });
                            setTimeout(() => location.reload(), 3000);
                        } else {
                            showAlert('Error: ' + (result.error || 'Failed to block Mii'), 5000, { title: 'Error', type: 'error' });
                        }
                    } catch (error) {
                        showAlert('Error blocking Mii', 5000, { title: 'Error', type: 'error' });
                    }
                }
                
                async function unblockMiiFromPublishing() {
                    showConfirm('Unblock this Mii from publishing?', async () => {
                        try {
                            const response = await fetch('/unblockMiiFromPublishing', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ miiId: '<%= mii.id %>' })
                            });
                            
                            const result = await response.json();
                            if (!result.error) {
                                showAlert('Mii unblocked', 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            } else {
                                showAlert('Error: ' + (result.error || 'Failed to unblock Mii'), 5000, { title: 'Error', type: 'error' });
                            }
                        } catch (error) {
                            showAlert('Error unblocking Mii', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Unblock Mii', confirmText: 'Unblock' });
                }
                function toggleModTools() {
                    const content = document.getElementById('modToolsContent');
                    const arrow = document.getElementById('modToolsArrow');
                    
                    content.classList.toggle('expanded');
                    arrow.classList.toggle('rotated');
                }

                function renderModMiiTagList() {
                    const container = document.getElementById('modMiiTagList');
                    if (!container) return;

                    container.innerHTML = '';

                    if (!Array.isArray(availableMiiTags) || availableMiiTags.length === 0) {
                        const emptyState = document.createElement('p');
                        emptyState.className = 'mod-tag-empty';
                        emptyState.innerHTML = 'No tags created yet. <a href="/search">Create tags on the Search page</a>.';
                        container.appendChild(emptyState);
                        return;
                    }

                    availableMiiTags.forEach((tag) => {
                        const label = document.createElement('label');
                        label.className = 'mod-tag-option';

                        const checkbox = document.createElement('input');
                        checkbox.type = 'checkbox';
                        checkbox.value = tag;
                        checkbox.checked = selectedMiiTags.has(tag);
                        checkbox.addEventListener('change', (event) => {
                            if (event.target.checked) {
                                selectedMiiTags.add(tag);
                            } else {
                                selectedMiiTags.delete(tag);
                            }
                        });

                        const text = document.createElement('span');
                        text.textContent = tag;

                        label.appendChild(checkbox);
                        label.appendChild(text);
                        container.appendChild(label);
                    });
                }

                async function saveMiiTags() {
                    if (!Array.isArray(availableMiiTags) || availableMiiTags.length === 0) {
                        showAlert('Create at least one tag on the Search page first.', 5000, { title: 'Error', type: 'error' });
                        return;
                    }

                    const tags = Array.from(selectedMiiTags);

                    showConfirm('Update tags for this Mii?', async () => {
                        try {
                            const response = await fetch('/updateMiiTags', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    miiId: '<%= mii.id %>',
                                    tags
                                })
                            });

                            const result = await response.json();
                            if (!result.error) {
                                showAlert('Tags updated successfully!', 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            } else {
                                showAlert(`Error: ${result.error || 'Failed to update tags'}`, 5000, { title: 'Error', type: 'error' });
                            }
                        } catch (error) {
                            console.error('Error updating tags:', error);
                            showAlert('Failed to update tags', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Update Mii Tags', confirmText: 'Update' });
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', renderModMiiTagList);
                } else {
                    renderModMiiTagList();
                }

                async function updateMiiField(field, value) {
                    if (!value || value.trim() === '') {
                        showAlert('Please enter a valid value', 5000, { title: 'Error', type: 'error' });
                        return;
                    }

                    showConfirm(`Are you sure you want to update the ${field}?`, async () => {
                        try {
                            const response = await fetch('/updateMiiField', {
                                method: 'POST',
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    id: '<%= mii.id %>',
                                    field: field,
                                    value: value
                                })
                            });

                            const result = await response.json();
                            
                            if (!result.error) {
                                showAlert(`Successfully updated ${field}!`, 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            }
                            else {
                                showAlert(`Error: ${result.error || 'Unknown error'}`, 5000, { title: 'Error', type: 'error' });
                            }
                        }
                        catch (error) {
                            console.error('Error:', error);
                            showAlert('Failed to update. Please try again.', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Update Field', confirmText: 'Update' });
                }

                async function regenerateQR() {
                    showConfirm('Are you sure you want to regenerate the QR code?', async () => {
                        const statusEl = document.getElementById('qrStatus');
                        const qrConsole = document.getElementById('regenQrConsole')?.value || '3DS';
                        statusEl.textContent = 'Regenerating...';
                        statusEl.style.color = '#FFA500';

                        try {
                            const response = await fetch('/regenerateQR', {
                                method: "POST",
                                body: JSON.stringify({ id: "<%= mii.id %>", qrConsole }),
                                headers: { "Content-Type": "application/json" },
                            });
                            const result = await response.json();
                            
                            if (!result.error) {
                                statusEl.textContent = '✓ Done!';
                                statusEl.style.color = '#4CAF50';
                                setTimeout(() => {
                                    location.reload();
                                }, 1000);
                            }
                            else {
                                statusEl.textContent = `Error: ${result.error}`;
                                statusEl.style.color = '#f44336';
                            }
                        }
                        catch (error) {
                            console.error('Error:', error);
                            statusEl.textContent = '✗ Failed';
                            statusEl.style.color = '#f44336';
                        }
                    }, null, { title: 'Regenerate QR Code', confirmText: 'Regenerate' });
                }

                async function confirmDeleteMii() {
                    const miiName = '<%= mii.meta.name %>';
                    showConfirm(`Are you ABSOLUTELY SURE you want to DELETE the Mii "${miiName}"?\n\nThis action CANNOT be undone!`, () => {
                        const doubleCheck = prompt(`Type "DELETE" to confirm deletion of ${miiName}:`);
                        if (doubleCheck !== 'DELETE') {
                            showAlert('Deletion cancelled.', 3000, { title: 'Cancelled' });
                            return;
                        }

                        (async () => {
                            try {
                                const response = await fetch('/deleteMii', {
                                    method: 'POST',
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ id: '<%= mii.id %>' })
                                });
                                const result = await response.json();
                                
                                if (!result.error) {
                                    showAlert('Mii deleted successfully', 2000, { title: 'Success', type: 'success' });
                                    setTimeout(() => window.location.href = result.redirect || '/', 2000);
                                }
                                else {
                                    showAlert('Error deleting Mii', 5000, { title: 'Error', type: 'error' });
                                }
                            }
                            catch (error) {
                                console.error('Error:', error);
                                showAlert('Failed to delete Mii', 5000, { title: 'Error', type: 'error' });
                            }
                        })();
                    }, null, { title: 'Delete Mii', confirmText: 'Continue' });
                }

                async function toggleOfficial() {
                    const isOfficial = document.getElementById('officialCheckbox').checked;
                    
                    showConfirm(`Are you sure you want to mark this Mii as ${isOfficial ? 'OFFICIAL' : 'NOT OFFICIAL'}?\n\nOfficial Miis are shown with a special badge.`, async () => {
                        try {
                            const response = await fetch('/toggleMiiOfficial', {
                                method: 'POST',
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    id: '<%= mii.id %>',
                                    official: isOfficial
                                })
                            });

                            const result = await response.json();
                            
                            if (!result.error) {
                                showAlert(`Mii official status updated!`, 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            }
                            else {
                                showAlert(`Error: ${result.error || 'Unknown error'}`, 5000, { title: 'Error', type: 'error' });
                            }
                        } 
                        catch (error) {
                            console.error('Error:', error);
                            showAlert('Failed to update official status', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Toggle Official Status', confirmText: 'Update' });
            }
            </script>
        <% } %>
    </body>
</html>
