<!DOCTYPE html>
<html lang="en">

<head>
    <%
    const pageTitle = 'Sign Up - InfiniMii';
    const pageDesc = 'Create an InfiniMii account to upload Miis, save private collections, and manage your profile.';
    const canonicalUrl = `${baseUrl}/signup`;
    const pageRobots = 'noindex, nofollow, noarchive';
    %>
    <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, pageRobots }) %>
    <%- include('structuredData') %>
    <link href="/global.css" rel="stylesheet">
    <link href="/utilityPages.css" rel="stylesheet">
</head>

<body>
    <%- include('globalStyle') %>
    <%- include('header') %>
    <%- include('accountDisplay') %>
    <main class="content" role="main">
        <%- include('sidebar') %>
        <section class="utility-container auth-shell" aria-labelledby="signup-heading">
            <div class="auth-panel">
                <div class="auth-copy">
                    <p class="auth-kicker">Create your account</p>
                    <h1 id="signup-heading">Build your InfiniMii profile</h1>
                    <p class="auth-lede">Share your best creations with the world, and access a suite of tools to amplify all of your Mii needs!</p>
                </div>

                <form id="signupForm" class="auth-form">
                    <fieldset class="auth-fieldset">
                        <legend>Sign Up</legend>
                        <div id="errorMessage" class="form-message <%= oauthStatus?.type || '' %>" style="display: <%= oauthStatus ? 'block' : 'none' %>;"><%= oauthStatus?.message || '' %></div>

                        <label class="sr-only" for="username">Username</label>
                        <input placeholder="Username" required name="username" type="text" id="username" autocomplete="username" minlength="3" maxlength="20" pattern="[A-Za-z0-9_.-]{3,20}">
                        <p id="usernameRules" class="auth-note" style="margin-top: 6px;">Username must be 3-20 characters and can only use letters, numbers, underscores, hyphens, and periods.</p>

                        <label class="sr-only" for="password">Password</label>
                        <input type="password" placeholder="Password" required name="pass" id="password" autocomplete="new-password">

                        <label class="sr-only" for="email">Email</label>
                        <input placeholder="Email" required name="email" type="email" id="email" autocomplete="email">

                        <input type="submit" value="Create Account">
                        <p class="auth-links">Already have an account? <a href="/login">Log In</a></p>
                        <%- include('oauthButtons', { mode: 'signup', next: '/', heading: 'Sign up with' }) %>
                        <p class="auth-note">It can take up to 10 minutes for the verification email to arrive, especially with Gmail.</p>
                    </fieldset>
                </form>
            </div>
        </section>
        <%- include('featuredMiis') %>
    </main>
    <%- include('footer') %>
    <script>
        const USERNAME_REGEX = /^[A-Za-z0-9_.-]{3,20}$/;

        function sanitizeUsernameInput(value) {
            return String(value || '').replace(/[^A-Za-z0-9_.-]/g, '');
        }

        const signupForm = document.getElementById('signupForm');
        const usernameInput = document.getElementById('username');
        const usernameRules = document.getElementById('usernameRules');

        usernameInput.addEventListener('input', () => {
            const rawValue = usernameInput.value;
            const cleanedValue = sanitizeUsernameInput(rawValue);
            if (rawValue !== cleanedValue) {
                usernameInput.value = cleanedValue;
                usernameRules.textContent = 'Special characters and spaces are not allowed in usernames.';
            } else {
                usernameRules.textContent = 'Username must be 3-20 characters and can only use letters, numbers, underscores, hyphens, and periods.';
            }
        });

        signupForm.addEventListener('submit', function(e) {
            const normalizedUsername = sanitizeUsernameInput(usernameInput.value.trim());
            usernameInput.value = normalizedUsername;
            if (!USERNAME_REGEX.test(normalizedUsername)) {
                e.preventDefault();
                const messageDiv = document.getElementById('errorMessage');
                messageDiv.textContent = 'Username invalid. Use 3-20 characters: letters, numbers, underscores, hyphens, or periods only.';
                messageDiv.className = 'form-message error';
                messageDiv.style.display = 'block';
                if (typeof window.scrollToUserError === 'function') {
                    window.scrollToUserError(messageDiv);
                }
                return;
            }

            handleFormSubmit(e, '/signup', 'Signing up...', 'errorMessage', {
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                bodyFormatter: (formData) => {
                    return new URLSearchParams({
                        username: sanitizeUsernameInput(String(formData.get('username') || '').trim()),
                        pass: formData.get('pass'),
                        email: formData.get('email')
                    });
                },
                onSuccess: (result, messageDiv) => {
                    messageDiv.textContent = result.message || 'Account created successfully! Check your email to verify.';
                    messageDiv.className = 'form-message success';
                    messageDiv.style.display = 'block';
                }
            });
        });
    </script>
</body>

</html>
