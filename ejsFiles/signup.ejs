<!DOCTYPE html>
<html>

<head>
    <title>Signup - InfiniMii</title>
    <%- include('metaTags') %>
    <%- include('structuredData') %>
    <link href="./global.css" rel="stylesheet">
    <link href="./index.css" rel="stylesheet">
</head>

<body>
    <%- include('header') %>
    <div class="content">
        <%- include('sidebar') %>
        <form id="signupForm">
            <fieldset>
                <legend>Sign Up</legend>
                <div id="errorMessage" class="form-message" style="display: none;"></div>
                <input placeholder="Username" required name="username" type="text" id="username">
                <input type="password" placeholder="Password" required name="pass" id="password">
                <input placeholder="Email" required name="email" type="email" id="email">
                <input type="submit" value="Sign Up"><br>
                <h6>*Note: It can take up to 10 minutes for the email to propagate, especially for gmail emails. Please be patient.</h6>
            </fieldset>
        </form>
    </div>
    <%- include('footer') %>
    <script>
        document.getElementById('signupForm').addEventListener('submit', function(e) {
            handleFormSubmit(e, '/signup', 'Signing up...', 'errorMessage', {
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                bodyFormatter: (formData) => {
                    return new URLSearchParams({
                        username: formData.get('username'),
                        pass: formData.get('pass'),
                        email: formData.get('email')
                    });
                },
                onSuccess: (result, messageDiv) => {
                    // Show success message
                    messageDiv.textContent = result.message || 'Account created successfully! Check your email to verify.';
                    messageDiv.className = 'form-message success';
                    messageDiv.style.display = 'block';
                }
            });
        });
    </script>
</body>

</html>