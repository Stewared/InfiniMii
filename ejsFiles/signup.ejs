<!DOCTYPE html>
<html>

<head>
    <title>Signup - InfiniMii</title>
    <%- include('metaTags') %>
    <%- include('structuredData') %>
    <link href="/global.css" rel="stylesheet">
    <link href="/utilityPages.css" rel="stylesheet">
</head>

<body>
    <%- include('globalStyle') %>
    <%- include('header') %>
    <%- include('accountDisplay') %>
    <main class="content" role="main">
        <%- include('sidebar') %>
        <section class="utility-container auth-shell" aria-labelledby="signup-heading">
            <div class="auth-panel">
                <div class="auth-copy">
                    <p class="auth-kicker">Create your account</p>
                    <h1 id="signup-heading">Build your InfiniMii profile</h1>
                    <p class="auth-lede">Share your best creations with the world, and access a suite of tools to amplify all of your Mii needs!</p>
                </div>

                <form id="signupForm" class="auth-form">
                    <fieldset class="auth-fieldset">
                        <legend>Sign Up</legend>
                        <div id="errorMessage" class="form-message" style="display: none;"></div>

                        <label class="sr-only" for="username">Username</label>
                        <input placeholder="Username" required name="username" type="text" id="username" autocomplete="username">

                        <label class="sr-only" for="password">Password</label>
                        <input type="password" placeholder="Password" required name="pass" id="password" autocomplete="new-password">

                        <label class="sr-only" for="email">Email</label>
                        <input placeholder="Email" required name="email" type="email" id="email" autocomplete="email">

                        <input type="submit" value="Create Account">
                        <p class="auth-links">Already have an account? <a href="/login">Log In</a></p>
                        <p class="auth-note">It can take up to 10 minutes for the verification email to arrive, especially with Gmail.</p>
                    </fieldset>
                </form>
            </div>
        </section>
        <%- include('featuredMiis') %>
    </main>
    <%- include('footer') %>
    <script>
        document.getElementById('signupForm').addEventListener('submit', function(e) {
            handleFormSubmit(e, '/signup', 'Signing up...', 'errorMessage', {
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                bodyFormatter: (formData) => {
                    return new URLSearchParams({
                        username: formData.get('username'),
                        pass: formData.get('pass'),
                        email: formData.get('email')
                    });
                },
                onSuccess: (result, messageDiv) => {
                    messageDiv.textContent = result.message || 'Account created successfully! Check your email to verify.';
                    messageDiv.className = 'form-message success';
                    messageDiv.style.display = 'block';
                }
            });
        });
    </script>
</body>

</html>
