<!DOCTYPE html>
<html>
<head>
    <title>Reset Password - InfiniMii</title>
    <%- include('metaTags') %>
    <link href="./global.css" rel="stylesheet">
    <link href="./index.css" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <%- include('header') %>
    <div class="content">
        <%- include('sidebar') %>
        <form id="resetRequestForm">
            <fieldset>
                <legend>Reset Password</legend>
                <div id="message" class="form-message" style="display: none;"></div>
                <p style="color: var(--text-2); margin-bottom: 15px;">
                    Enter your email address and we'll send you a link to reset your password.
                </p>
                <input placeholder="Email" required name="email" type="email" id="email">
                <input type="submit" value="Send Reset Link">
                <p style="margin-top: 15px;">
                    <a href="/login">Back to Login</a>
                </p>
            </fieldset>
        </form>
    </div>
    <%- include('footer') %>
    <script>
        document.getElementById('resetRequestForm').addEventListener('submit', function(e) {
            handleFormSubmit(e, '/requestPasswordReset', 'Sending...', 'message', {
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                bodyFormatter: (formData) => {
                    return new URLSearchParams({ email: formData.get('email') });
                },
                onSuccess: (result, messageDiv) => {
                    messageDiv.textContent = result.message || 'Reset link sent! Check your email.';
                    messageDiv.className = 'form-message success';
                    messageDiv.style.display = 'block';
                    document.getElementById('email').value = '';
                }
            });
        });
    </script>
</body>
</html>
