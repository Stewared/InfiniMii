<!DOCTYPE html>
<html lang="en">
<head>
    <%
    const pageTitle = 'Reset Password - InfiniMii';
    const pageDesc = 'Set a new password for your InfiniMii account.';
    const canonicalUrl = `${baseUrl}/resetPassword`;
    const pageRobots = 'noindex, nofollow, noarchive';
    %>
    <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, pageRobots }) %>
    <link href="/global.css" rel="stylesheet">
    <link href="/index.css" rel="stylesheet">
</head>
<body>
    <%- include('globalStyle') %>
    <%- include('header') %>
    <div class="content">
        <%- include('sidebar') %>
        <form id="resetPasswordForm">
            <fieldset>
                <legend>Reset Password</legend>
                <div id="message" class="form-message" style="display: none;"></div>
                <p style="color: var(--text-2); margin-bottom: 15px;">
                    Enter your new password below.
                </p>
                <input type="hidden" name="username" id="username" value="<%= username || '' %>">
                <input type="hidden" name="token" id="token" value="<%= token || '' %>">
                <input placeholder="New Password (min 8 characters)" required name="newPassword" type="password" id="newPassword" minlength="8">
                <input placeholder="Confirm New Password" required type="password" id="confirmPassword">
                <input type="submit" value="Reset Password">
                <p style="margin-top: 15px;">
                    <a href="/login">Back to Login</a>
                </p>
            </fieldset>
        </form>
    </div>
    <%- include('footer') %>
    <script>
        document.getElementById('resetPasswordForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            
            if (newPassword !== confirmPassword) {
                const messageDiv = document.getElementById('message');
                messageDiv.textContent = 'Passwords do not match';
                messageDiv.className = 'form-message error';
                messageDiv.style.display = 'block';
                return;
            }
            
            handleFormSubmit(e, '/resetPassword', 'Resetting...', 'message', {
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                bodyFormatter: (formData) => {
                    return new URLSearchParams({
                        username: formData.get('username'),
                        token: formData.get('token'),
                        newPassword: formData.get('newPassword')
                    });
                }
            });
        });
    </script>
</body>
</html>
