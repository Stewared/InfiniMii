<!DOCTYPE html>
<html lang="en">
	<head>
		<%
		const pageTitle = 'Account Settings - InfiniMii';
		const pageDesc = 'Manage your InfiniMii profile, email, password, and account preferences.';
		const canonicalUrl = `${baseUrl}/settings`;
		const pageRobots = 'noindex, nofollow, noarchive';
		%>
		<%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, pageRobots }) %>
		<%- include('structuredData') %>
		<link rel="stylesheet" href="/global.css">
		<link rel="stylesheet" href="/utilityPages.css">
		<link rel="stylesheet" href="/settings.css?v=<%= encodeURIComponent(assetVersion || '1') %>">
	</head>
	<body class="settings-page">
        <%- include('globalStyle') %>
		<%- include('header') %>
		<%- include('accountDisplay') %>
		<div class="content">
			<%- include('sidebar') %>
			<main class="settings-container">
				<%
				const passwordLoginEnabled = Boolean(user?.salt && user?.pass);
				const linkedIdentities = Array.isArray(user?.oauthIdentities) ? user.oauthIdentities : [];
				const linkedProviderKeys = linkedIdentities.map(identity => identity.provider);
				const oauthProviderMap = Object.fromEntries((Array.isArray(oauthProviders) ? oauthProviders : []).map(provider => [provider.key, provider]));
				const safeBlockableTags = Array.isArray(blockableTags) ? blockableTags : [];
				const safeBlockedTags = Array.isArray(blockedTags) ? blockedTags : [];
				const blockedTagSet = new Set(safeBlockedTags);
				const safeBlockableCategories = Array.isArray(blockableOfficialCategories) ? blockableOfficialCategories : [];
				const safeBlockedCategories = Array.isArray(blockedOfficialCategories) ? blockedOfficialCategories : [];
				const blockedCategorySet = new Set(safeBlockedCategories);
				const safeMiiEraOptions = Array.isArray(miiEraFilterOptions) ? miiEraFilterOptions : [];
				const blockedMiiEraSet = new Set(Array.isArray(blockedMiiEras) ? blockedMiiEras : []);
				const safeFacepaintOptions = Array.isArray(miiFacepaintFilterOptions) ? miiFacepaintFilterOptions : [];
				const blockedFacepaintSet = new Set(Array.isArray(blockedFacepaintUsages) ? blockedFacepaintUsages : []);
				const safeExternalMiiPreference = ['ask', 'stay', 'go'].includes(
					String(typeof externalMiiPreference !== 'undefined' ? externalMiiPreference : user?.externalMiiPreference || '').trim().toLowerCase()
				)
					? String(typeof externalMiiPreference !== 'undefined' ? externalMiiPreference : user?.externalMiiPreference).trim().toLowerCase()
					: 'ask';
				const categoryGroupMap = new Map();
				safeBlockableCategories.forEach((category) => {
					const categoryPath = String(category?.path || category || '').trim();
					if (!categoryPath) return;

					const categoryName = String(category?.name || categoryPath.split('/').filter(Boolean).pop() || categoryPath).trim();
					const categoryColor = String(category?.color || '#999999').trim();
					const pathSegments = categoryPath.split('/').map(segment => segment.trim()).filter(Boolean);
					const groupName = pathSegments[0] || categoryName || categoryPath;
					const groupKey = groupName.toLowerCase();
					const groupPath = groupName;

					if (!categoryGroupMap.has(groupKey)) {
						categoryGroupMap.set(groupKey, {
							name: groupName,
							path: groupPath,
							color: categoryColor,
							topLevel: null,
							selectedCount: 0,
							categories: []
						});
					}

					const group = categoryGroupMap.get(groupKey);
					const isTopLevel = categoryPath.toLowerCase() === groupPath.toLowerCase();
					const categoryLabel = String(category?.fullPath || categoryPath).trim();
					const groupPrefix = `${groupName}/`;
					const displayLabel = isTopLevel
						? categoryName
						: (categoryLabel.startsWith(groupPrefix) ? categoryLabel.slice(groupPrefix.length) : categoryLabel);
					const option = {
						path: categoryPath,
						label: displayLabel || categoryName || categoryPath,
						color: categoryColor,
						checked: blockedCategorySet.has(categoryPath)
					};

					if (option.checked) {
						group.selectedCount += 1;
					}
					if (isTopLevel) {
						group.topLevel = option;
						group.color = categoryColor;
					} else {
						group.categories.push(option);
					}
				});
				const safeBlockableCategoryGroups = [...categoryGroupMap.values()].map((group) => {
					if (!group.topLevel) {
						group.topLevel = {
							path: group.path,
							label: group.name,
							color: group.color || '#999999',
							checked: blockedCategorySet.has(group.path)
						};
						if (group.topLevel.checked) group.selectedCount += 1;
					}
					group.categories.sort((a, b) => a.path.localeCompare(b.path, undefined, { sensitivity: 'base' }));
					return group;
				}).sort((a, b) => a.path.localeCompare(b.path, undefined, { sensitivity: 'base' }));
				const safeHiddenMiis = Array.isArray(hiddenMiis) ? hiddenMiis : [];
				const formatOAuthProviderName = (key) => oauthProviderMap[key]?.displayName || String(key || 'OAuth').split(/[-_]+/g).filter(Boolean).map(part => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
				const getOAuthProviderIconUrl = (key) => {
					const iconUrl = oauthProviderMap[key]?.iconUrl;
					return typeof iconUrl === 'string' ? iconUrl.trim() : '';
				};
				const getOAuthProviderIconText = (key, providerName) => oauthProviderMap[key]?.iconText || providerName.slice(0, 2);
				%>
				<header class="settings-heading">
					<h1>Settings</h1>
					<p>Manage your profile, sign-in methods, and what appears while you browse InfiniMii.</p>
				</header>

				<nav class="settings-section-nav" aria-label="Settings sections">
					<a href="#profile-settings">Profile</a>
					<a href="#account-settings">Account</a>
					<a href="#content-preferences">Content</a>
					<a href="#danger-zone">Deletion</a>
				</nav>

				<div
					id="settings-message"
					class="form-message settings-message <%= oauthStatus?.type || '' %>"
					role="status"
					aria-live="polite"
					aria-atomic="true"
					style="display: <%= oauthStatus ? 'block' : 'none' %>;"
				><%= oauthStatus?.message || '' %></div>
				
				<fieldset class="settings-panel" id="profile-settings">
					<legend>Profile</legend>
					<p class="settings-panel-copy">Update the name and Mii other people see.</p>
					<div class="settings-grid">
						<form class="setting-group" onsubmit="changePfp(); return false;">
							<div class="setting-group-header">
								<h2>Profile picture</h2>
								<p>Use the ID of a Mii already available on InfiniMii.</p>
							</div>
							<p class="setting-current">Current Mii ID <code><%= user?.miiPfp || '00000' %></code></p>
							<div class="settings-field">
								<label for="pfpId">New Mii ID</label>
								<input type="text" placeholder="Enter a Mii ID" id="pfpId" autocomplete="off" spellcheck="false">
							</div>
							<div class="setting-actions">
								<button type="submit">Update picture</button>
							</div>
						</form>

						<form class="setting-group" onsubmit="changeUser(); return false;">
							<div class="setting-group-header">
								<h2>Username</h2>
								<p>Usernames can be changed once every 30 days.</p>
							</div>
							<p class="setting-current">Current username <strong><%= user?.username || '' %></strong></p>
							<div class="settings-field">
								<label for="nUser">New username</label>
								<input type="text" placeholder="Enter a new username" id="nUser" autocomplete="username" autocapitalize="none" spellcheck="false">
							</div>
							<div class="settings-field">
								<label for="userChangePassword">Current password</label>
								<input type="password" placeholder="Confirm with your password" id="userChangePassword" autocomplete="current-password">
							</div>
							<div class="setting-actions">
								<button type="submit">Update username</button>
							</div>
						</form>
					</div>
				</fieldset>

				<fieldset class="settings-panel" id="account-settings">
					<legend>Account and sign-in</legend>
					<p class="settings-panel-copy">Keep your contact address and ways to sign in up to date.</p>
					<div class="settings-grid">
						<form class="setting-group" onsubmit="changeEmail(); return false;">
							<div class="setting-group-header">
								<h2>Email address</h2>
								<p>We will send a verification message to the new address.</p>
							</div>
							<p class="setting-current">Current email <strong><%= user?.email || '' %></strong></p>
							<div class="settings-field">
								<label for="nEmail">New email address</label>
								<input type="email" placeholder="name@example.com" id="nEmail" autocomplete="email" autocapitalize="none" spellcheck="false">
							</div>
							<div class="setting-actions">
								<button type="submit">Update email</button>
							</div>
						</form>
					
						<form class="setting-group" onsubmit="<%= passwordLoginEnabled ? 'changePassword()' : 'setPassword()' %>; return false;">
							<div class="setting-group-header">
								<h2><%= passwordLoginEnabled ? 'Change password' : 'Add a password' %></h2>
								<p><%= passwordLoginEnabled ? 'Use at least 6 characters for the new password.' : 'Add password sign-in and enable password-protected account actions.' %></p>
							</div>
							<% if (passwordLoginEnabled) { %>
								<div class="settings-field">
									<label for="oPass">Current password</label>
									<input type="password" placeholder="Enter your current password" id="oPass" autocomplete="current-password">
								</div>
								<div class="settings-field">
									<label for="nPass">New password</label>
									<input type="password" placeholder="At least 6 characters" id="nPass" autocomplete="new-password" minlength="6">
								</div>
								<div class="setting-actions">
									<button type="submit">Update password</button>
								</div>
							<% } else { %>
								<div class="settings-field">
									<label for="setPass">New password</label>
									<input type="password" placeholder="At least 6 characters" id="setPass" autocomplete="new-password" minlength="6">
								</div>
								<div class="setting-actions">
									<button type="submit">Add password</button>
								</div>
							<% } %>
						</form>

						<div class="setting-group setting-group-wide">
							<div class="setting-group-header">
								<h2>Connected login methods</h2>
								<p>Link another provider or remove one you no longer use.</p>
							</div>
						<div class="linked-oauth-list">
							<% if (passwordLoginEnabled) { %>
								<div class="linked-oauth-item">
									<span class="linked-oauth-main">
										<span class="oauth-provider-mark oauth-provider-mark-password" aria-hidden="true"><%- include('icon', { name: 'key', size: 16 }) %></span>
										<span>Password</span>
									</span>
									<span class="linked-oauth-status">Enabled</span>
								</div>
							<% } %>
							<% if (linkedIdentities.length === 0 && !passwordLoginEnabled) { %>
								<p class="auth-note">No login methods are connected yet.</p>
							<% } %>
							<% linkedIdentities.forEach((identity) => {
								const providerName = formatOAuthProviderName(identity.provider);
								const providerIconUrl = getOAuthProviderIconUrl(identity.provider);
								const providerIconText = getOAuthProviderIconText(identity.provider, providerName);
							%>
								<div class="linked-oauth-item oauth-provider-<%= identity.provider %>">
									<span class="linked-oauth-main">
										<span class="oauth-provider-mark" aria-hidden="true">
											<% if (providerIconUrl) { %>
												<img class="oauth-provider-icon-img" src="<%= providerIconUrl %>" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.hidden=true; this.nextElementSibling.hidden=false;">
												<span class="oauth-provider-fallback" hidden><%= providerIconText %></span>
											<% } else { %>
												<span class="oauth-provider-fallback"><%= providerIconText %></span>
											<% } %>
										</span>
										<span>
											<span class="linked-oauth-name"><%= providerName %></span>
											<% if (identity.email) { %>
												<small><%= identity.email %></small>
											<% } %>
										</span>
									</span>
									<button type="button" class="oauth-unlink-button" onclick="unlinkOAuthProvider(<%- toScriptJson(identity.provider) %>, <%- toScriptJson(providerName) %>)">Unlink</button>
								</div>
							<% }) %>
						</div>
						<%- include('oauthButtons', { mode: 'link', next: '/settings', heading: 'Link another provider', linkedProviderKeys }) %>
						</div>
					</div>
				</fieldset>

				<fieldset class="settings-panel" id="content-preferences">
					<legend>Content preferences</legend>
					<p class="settings-panel-copy">Choose how links behave and which Miis are left out of archive pages.</p>

					<div class="setting-group setting-group-wide content-preference-group">
						<div class="setting-group-header">
							<h2 id="externalMiiPreferenceLabel">External Mii links</h2>
							<p>Choose what happens when a Mii links back to another website.</p>
						</div>
						<div class="preference-selector-list preference-radio-list" role="radiogroup" aria-labelledby="externalMiiPreferenceLabel">
							<label class="preference-selector-option">
								<input type="radio" name="externalMiiPreference" value="ask" <%= safeExternalMiiPreference === 'ask' ? 'checked' : '' %>>
								<span><strong>Ask every time</strong><small>Let me decide for each link.</small></span>
							</label>
							<label class="preference-selector-option">
								<input type="radio" name="externalMiiPreference" value="stay" <%= safeExternalMiiPreference === 'stay' ? 'checked' : '' %>>
								<span><strong>Stay on InfiniMii</strong><small>Open the local InfiniMii page.</small></span>
							</label>
							<label class="preference-selector-option">
								<input type="radio" name="externalMiiPreference" value="go" <%= safeExternalMiiPreference === 'go' ? 'checked' : '' %>>
								<span><strong>Go to the original site</strong><small>Follow the source link directly.</small></span>
							</label>
						</div>
					</div>

					<details class="settings-preference-block" open>
						<summary>
							<span>
								<strong>Mii eras</strong>
								<small>Hide Miis from selected systems or periods.</small>
							</span>
							<span class="preference-selection-count" data-selection-count="[data-blocked-mii-era]" aria-live="polite"></span>
						</summary>
						<div class="settings-preference-body">
							<div class="preference-toolbar">
								<p>Your profile Mii and the Average Mii always remain visible.</p>
								<button type="button" class="settings-text-button" data-clear-selector="[data-blocked-mii-era]">Clear selection</button>
							</div>
							<div class="preference-selector-list" role="group" aria-label="Hidden Mii eras">
							<% safeMiiEraOptions.forEach((option) => { %>
								<label class="preference-selector-option">
									<input type="checkbox" data-blocked-mii-era value="<%= option.value %>" <%= blockedMiiEraSet.has(option.value) ? 'checked' : '' %>>
									<span><%= option.label %></span>
								</label>
							<% }) %>
							</div>
						</div>
					</details>

					<details class="settings-preference-block">
						<summary>
							<span>
								<strong>Facepaint use</strong>
								<small>Hide Miis by how much facepaint they use.</small>
							</span>
							<span class="preference-selection-count" data-selection-count="[data-blocked-facepaint-usage]" aria-live="polite"></span>
						</summary>
						<div class="settings-preference-body">
							<div class="preference-toolbar">
								<p>Facepaint coverage is read from LTD data and grouped as partial or full.</p>
								<button type="button" class="settings-text-button" data-clear-selector="[data-blocked-facepaint-usage]">Clear selection</button>
							</div>
							<div class="preference-selector-list" role="group" aria-label="Hidden facepaint use">
							<% safeFacepaintOptions.forEach((option) => { %>
								<label class="preference-selector-option">
									<input type="checkbox" data-blocked-facepaint-usage value="<%= option.value %>" <%= blockedFacepaintSet.has(option.value) ? 'checked' : '' %>>
									<span><%= option.label %></span>
								</label>
							<% }) %>
							</div>
						</div>
					</details>

					<details class="settings-preference-block" <%= blockedTagSet.size > 0 ? 'open' : '' %>>
						<summary>
							<span>
								<strong>Tags</strong>
								<small>Hide Miis carrying selected community tags.</small>
							</span>
							<span class="preference-selection-count" data-selection-count="[data-blocked-tag]" aria-live="polite"></span>
						</summary>
						<div class="settings-preference-body">
							<% if (safeBlockableTags.length > 0) { %>
								<div class="preference-toolbar preference-toolbar-search">
									<label class="preference-search-field">
										<span>Find a tag</span>
										<input type="search" placeholder="Search tags" autocomplete="off" data-preference-filter="[data-blocked-tag]">
									</label>
									<button type="button" class="settings-text-button" data-clear-selector="[data-blocked-tag]">Clear selection</button>
								</div>
								<div class="preference-selector-list preference-selector-list-scroll" role="group" aria-label="Hidden tags">
								<% safeBlockableTags.forEach((tag) => { %>
									<label class="preference-selector-option">
										<input type="checkbox" data-blocked-tag value="<%= tag %>" <%= blockedTagSet.has(tag) ? 'checked' : '' %>>
										<span><%= tag %></span>
									</label>
								<% }) %>
									<p class="preference-no-results" hidden>No matching tags.</p>
								</div>
							<% } else { %>
								<p class="preference-empty">No tags are available yet.</p>
							<% } %>
						</div>
					</details>

					<details class="settings-preference-block" <%= blockedCategorySet.size > 0 ? 'open' : '' %>>
						<summary>
							<span>
								<strong>Official categories</strong>
								<small>Hide groups from the curated archive.</small>
							</span>
							<span class="preference-selection-count" data-selection-count="[data-blocked-category]" aria-live="polite"></span>
						</summary>
						<div class="settings-preference-body">
							<% if (safeBlockableCategoryGroups.length > 0) { %>
								<div class="preference-toolbar">
									<p>Open a category to choose the whole group or individual sections.</p>
									<button type="button" class="settings-text-button" data-clear-selector="[data-blocked-category]">Clear selection</button>
								</div>
								<div class="preference-selector-list preference-selector-list-tall preference-category-selector">
								<div class="preference-category-groups category-filter-groups">
									<% safeBlockableCategoryGroups.forEach((group) => { %>
										<%
											const groupTopLevel = group.topLevel;
											const groupHasChildren = group.categories.length > 0;
											const groupHasSelection = group.selectedCount > 0;
											const groupBadge = groupTopLevel.checked && groupHasChildren ? 'All' : group.selectedCount;
											const topLevelLabel = groupHasChildren ? `All ${group.name}` : groupTopLevel.label;
										%>
										<details class="category-filter-group preference-category-group" <%= groupHasSelection ? 'open' : '' %>>
											<summary>
												<span><%= group.name %></span>
											<span class="category-filter-group-counts" data-category-selection-count <%= groupHasSelection ? '' : 'hidden' %>>
												<span class="category-filter-group-count is-include"><%= groupBadge %></span>
											</span>
											</summary>
											<div class="category-filter-options preference-category-options">
												<label class="preference-selector-option preference-category-option preference-category-option-top-level" style="--category-color: <%= groupTopLevel.color || '#999999' %>;">
													<input type="checkbox" data-blocked-category value="<%= groupTopLevel.path %>" <%= groupTopLevel.checked ? 'checked' : '' %>>
													<span><%= topLevelLabel %></span>
												</label>
												<% group.categories.forEach((category) => { %>
													<label class="preference-selector-option preference-category-option" style="--category-color: <%= category.color || '#999999' %>;">
														<input type="checkbox" data-blocked-category value="<%= category.path %>" <%= category.checked ? 'checked' : '' %>>
														<span><%= category.label %></span>
													</label>
												<% }) %>
											</div>
										</details>
									<% }) %>
								</div>
								</div>
							<% } else { %>
								<p class="preference-empty">No official categories are available yet.</p>
							<% } %>
						</div>
					</details>

					<div class="content-preference-actions">
						<div class="preference-save-copy">
							<strong id="preferenceSaveState">No unsaved changes</strong>
							<span>Changes take effect after you save.</span>
						</div>
						<div class="setting-actions">
							<% if (safeHiddenMiis.length > 0) { %>
								<button type="button" class="secondary-settings-button" id="openHiddenMiisButton" onclick="openHiddenMiisModal(this)">Manage hidden Miis</button>
							<% } %>
							<button type="button" id="saveContentPreferencesButton" onclick="saveContentPreferences()">Save preferences</button>
						</div>
					</div>
				</fieldset>

				<fieldset class="settings-panel danger-zone" id="danger-zone">
					<legend><%- include('icon', { name: 'alert-triangle', size: 20, class: 'icon-warning' }) %> Delete content or account</legend>
					<p class="settings-panel-copy">These actions are permanent. Review what each one removes before continuing.</p>

					<div class="settings-grid">
						<div class="setting-group danger-setting">
							<div class="setting-group-header">
								<h2>Delete all uploaded Miis</h2>
								<p>Your account remains active, but every Mii you uploaded is permanently removed.</p>
							</div>
							<div class="setting-actions">
								<button type="button" class="danger-btn" onclick="deleteAllMiis()"><%- include('icon', { name: 'trash', size: 16 }) %> Delete uploaded Miis</button>
							</div>
						</div>

						<form class="setting-group danger-setting" onsubmit="deleteAccount(); return false;">
							<div class="setting-group-header">
								<h2>Delete account</h2>
								<p>Your Miis remain in the archive and are credited to “[Deleted User].” Your account is permanently removed.</p>
							</div>
							<div class="settings-field">
								<label for="deleteAccountPassword">Current password</label>
								<input type="password" placeholder="Enter your password to confirm" id="deleteAccountPassword" autocomplete="current-password">
							</div>
							<div class="setting-actions">
								<button type="submit" class="danger-btn"><%- include('icon', { name: 'ban', size: 16 }) %> Delete account</button>
							</div>
						</form>
					</div>
				</fieldset>
			</main>

            <%- include('featuredMiis') %>
		</div>
		<% if (safeHiddenMiis.length > 0) { %>
			<div id="hiddenMiisModal" class="custom-modal-overlay" aria-hidden="true">
				<div class="custom-modal hidden-miis-modal" role="dialog" aria-modal="true" aria-labelledby="hiddenMiisTitle" aria-describedby="hiddenMiisDescription" tabindex="-1">
					<div class="custom-modal-header">
						<div>
							<h3 id="hiddenMiisTitle">Hidden Miis</h3>
							<p id="hiddenMiisDescription">Restore a Mii to your archive pages.</p>
						</div>
						<button type="button" class="custom-modal-close" onclick="closeHiddenMiisModal()" aria-label="Close">&times;</button>
					</div>
					<div class="custom-modal-body">
						<div id="hiddenMiisStatus" class="form-message" role="status" aria-live="polite" aria-atomic="true" style="display: none;"></div>
						<div class="hidden-miis-list" id="hiddenMiisList">
							<% safeHiddenMiis.forEach((hiddenMii) => { %>
								<div class="hidden-mii-row" data-hidden-mii-id="<%= hiddenMii.id %>">
									<span class="hidden-mii-id"><%= hiddenMii.id %></span>
									<span class="hidden-mii-name"><%= hiddenMii.name %></span>
									<button type="button" class="hidden-mii-unhide" data-unhide-mii-id="<%= hiddenMii.id %>">Unhide</button>
								</div>
							<% }) %>
						</div>
					</div>
					<div class="custom-modal-footer">
						<button type="button" class="custom-modal-btn custom-modal-btn-secondary" onclick="closeHiddenMiisModal()">Close</button>
					</div>
				</div>
			</div>
		<% } %>
		<%- include('footer') %>
		<script>
			const contentPreferenceInputSelector = [
				'[data-blocked-tag]',
				'[data-blocked-category]',
				'[data-blocked-mii-era]',
				'[data-blocked-facepaint-usage]',
				'input[name="externalMiiPreference"]'
			].join(', ');
			let savedContentPreferenceState = '';
			let hiddenMiisModalTrigger = null;

			function showMessage(text, type = 'error') {
				const messageDiv = document.getElementById('settings-message');
				messageDiv.textContent = text;
				messageDiv.className = `form-message settings-message ${type}`;
				messageDiv.setAttribute('role', type === 'error' ? 'alert' : 'status');
				messageDiv.style.display = 'block';
				if (type === 'error' && typeof window.scrollToUserError === 'function') {
					window.scrollToUserError(messageDiv);
				} else {
					messageDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				}
			}

			function showHiddenMiisStatus(text, type = 'error') {
				const status = document.getElementById('hiddenMiisStatus');
				if (!status) {
					showMessage(text, type);
					return;
				}

				status.textContent = text;
				status.className = `form-message ${type}`;
				status.setAttribute('role', type === 'error' ? 'alert' : 'status');
				status.style.display = 'block';
			}

			function getContentPreferenceState() {
				return JSON.stringify(Array.from(document.querySelectorAll(contentPreferenceInputSelector)).map((input) => ({
					name: input.name || input.dataset.blockedTag || input.dataset.blockedCategory || input.dataset.blockedMiiEra || input.dataset.blockedFacepaintUsage || '',
					value: input.value,
					checked: input.checked
				})));
			}

			function updatePreferenceCounts() {
				document.querySelectorAll('[data-selection-count]').forEach((counter) => {
					const selector = counter.dataset.selectionCount;
					const count = selector ? document.querySelectorAll(`${selector}:checked`).length : 0;
					counter.textContent = count === 0 ? 'None hidden' : `${count} hidden`;
					counter.classList.toggle('has-selection', count > 0);
				});

				document.querySelectorAll('.preference-category-group').forEach((group) => {
					const inputs = Array.from(group.querySelectorAll('[data-blocked-category]'));
					const checkedInputs = inputs.filter((input) => input.checked);
					const countWrap = group.querySelector('[data-category-selection-count]');
					const countLabel = countWrap?.querySelector('.category-filter-group-count');
					if (!countWrap || !countLabel) return;

					countWrap.hidden = checkedInputs.length === 0;
					countLabel.textContent = checkedInputs[0]?.closest('.preference-category-option-top-level') && inputs.length > 1
						? 'All'
						: String(checkedInputs.length);
				});
			}

			function updateContentPreferenceState() {
				const state = document.getElementById('preferenceSaveState');
				if (!state) return;
				const isDirty = getContentPreferenceState() !== savedContentPreferenceState;
				state.textContent = isDirty ? 'Unsaved changes' : 'No unsaved changes';
				state.classList.toggle('is-dirty', isDirty);
			}

			function markContentPreferencesSaved() {
				savedContentPreferenceState = getContentPreferenceState();
				updateContentPreferenceState();
			}

			function initializeContentPreferenceControls() {
				markContentPreferencesSaved();
				updatePreferenceCounts();

				document.querySelectorAll(contentPreferenceInputSelector).forEach((input) => {
					input.addEventListener('change', () => {
						updatePreferenceCounts();
						updateContentPreferenceState();
					});
				});

				document.querySelectorAll('[data-clear-selector]').forEach((button) => {
					button.addEventListener('click', () => {
						const selector = button.dataset.clearSelector;
						if (!selector) return;
						document.querySelectorAll(selector).forEach((input) => {
							input.checked = false;
						});
						updatePreferenceCounts();
						updateContentPreferenceState();
					});
				});

				document.querySelectorAll('[data-preference-filter]').forEach((searchInput) => {
					searchInput.addEventListener('input', () => {
						const query = searchInput.value.trim().toLocaleLowerCase();
						const selector = searchInput.dataset.preferenceFilter;
						const preferenceBody = searchInput.closest('.settings-preference-body');
						const matchingInputs = selector && preferenceBody
							? Array.from(preferenceBody.querySelectorAll(selector))
							: [];
						let visibleCount = 0;
						matchingInputs.forEach((input) => {
							const option = input.closest('.preference-selector-option');
							if (!option) return;
							const matches = !query || option.textContent.toLocaleLowerCase().includes(query);
							option.hidden = !matches;
							if (matches) visibleCount += 1;
						});
						const noResults = preferenceBody?.querySelector('.preference-no-results');
						if (noResults) noResults.hidden = visibleCount > 0;
					});
				});
			}

			async function saveContentPreferences() {
				const blockedTags = Array.from(document.querySelectorAll('[data-blocked-tag]:checked')).map(input => input.value);
				const blockedOfficialCategories = Array.from(document.querySelectorAll('[data-blocked-category]:checked')).map(input => input.value);
				const blockedMiiEras = Array.from(document.querySelectorAll('[data-blocked-mii-era]:checked')).map(input => input.value);
				const blockedFacepaintUsages = Array.from(document.querySelectorAll('[data-blocked-facepaint-usage]:checked')).map(input => input.value);
				const externalMiiPreference = document.querySelector('input[name="externalMiiPreference"]:checked')?.value || 'ask';

				const saveButton = document.getElementById('saveContentPreferencesButton');
				const saveState = document.getElementById('preferenceSaveState');
				if (saveButton) {
					saveButton.disabled = true;
					saveButton.setAttribute('aria-busy', 'true');
					saveButton.dataset.defaultLabel = saveButton.textContent;
					saveButton.textContent = 'Saving…';
				}
				if (saveState) saveState.textContent = 'Saving changes…';

				try {
					const response = await fetch('/updateContentPreferences', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							blockedTags,
							blockedOfficialCategories,
							blockedMiiEras,
							blockedFacepaintUsages,
							externalMiiPreference
						})
					});
					const result = await response.json();

					if (!response.ok || result.error) {
						showMessage(result.error || 'Failed to save content preferences.', 'error');
						return;
					}

					markContentPreferencesSaved();
					showMessage('Content preferences saved.', 'success');
				} catch (error) {
					console.error('Error saving content preferences:', error);
					showMessage('Failed to save content preferences.', 'error');
				} finally {
					if (saveButton) {
						saveButton.disabled = false;
						saveButton.removeAttribute('aria-busy');
						saveButton.textContent = saveButton.dataset.defaultLabel || 'Save preferences';
					}
					updateContentPreferenceState();
				}
			}

			function openHiddenMiisModal(trigger) {
				const modal = document.getElementById('hiddenMiisModal');
				if (!modal) return;
				hiddenMiisModalTrigger = trigger || document.activeElement;
				modal.classList.add('active');
				modal.setAttribute('aria-hidden', 'false');
				modal.querySelector('.custom-modal-close')?.focus();
			}

			function closeHiddenMiisModal() {
				const modal = document.getElementById('hiddenMiisModal');
				if (!modal) return;
				modal.classList.remove('active');
				modal.setAttribute('aria-hidden', 'true');
				hiddenMiisModalTrigger?.focus?.();
				hiddenMiisModalTrigger = null;
			}

			async function unhideMiiFromSettings(miiId, button) {
				if (!miiId) return;
				if (button) button.disabled = true;

				try {
					const response = await fetch('/unhideMii', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id: miiId })
					});
					const responseText = await response.text();
					let result = {};
					try {
						result = responseText ? JSON.parse(responseText) : {};
					} catch (error) {
						throw new Error(response.ok ? 'Unexpected response while unhiding Mii' : 'Failed to unhide Mii');
					}

					if (!response.ok || result.error) {
						showHiddenMiisStatus(result.error || 'Failed to unhide Mii', 'error');
						if (button) button.disabled = false;
						return;
					}

					const row = button?.closest?.('[data-hidden-mii-id]')
						|| Array.from(document.querySelectorAll('[data-hidden-mii-id]'))
							.find((candidate) => candidate.getAttribute('data-hidden-mii-id') === String(miiId));
					row?.remove();
					if (!document.querySelector('[data-hidden-mii-id]')) {
						document.getElementById('openHiddenMiisButton')?.remove();
						closeHiddenMiisModal();
					}
					showHiddenMiisStatus('Mii unhidden.', 'success');
					showMessage('Mii unhidden.', 'success');
				} catch (error) {
					console.error('Error unhiding Mii:', error);
					showHiddenMiisStatus(error.message || 'Failed to unhide Mii', 'error');
					if (button) button.disabled = false;
				}
			}

			function initializeHiddenMiiButtons() {
				document.querySelectorAll('[data-unhide-mii-id]').forEach((button) => {
					if (button.dataset.unhideBound === 'true') return;
					button.dataset.unhideBound = 'true';
					button.addEventListener('click', () => {
						unhideMiiFromSettings(button.dataset.unhideMiiId, button);
					});
				});
			}

			function initializeHiddenMiisModal() {
				const modal = document.getElementById('hiddenMiisModal');
				if (!modal) return;

				modal.addEventListener('click', (event) => {
					if (event.target === modal) closeHiddenMiisModal();
				});

				document.addEventListener('keydown', (event) => {
					if (!modal.classList.contains('active')) return;
					if (event.key === 'Escape') {
						event.preventDefault();
						closeHiddenMiisModal();
						return;
					}

					if (event.key !== 'Tab') return;
					const focusable = Array.from(modal.querySelectorAll('button:not([disabled]), a[href], input:not([disabled])'));
					if (focusable.length === 0) return;
					const first = focusable[0];
					const last = focusable[focusable.length - 1];
					if (event.shiftKey && document.activeElement === first) {
						event.preventDefault();
						last.focus();
					} else if (!event.shiftKey && document.activeElement === last) {
						event.preventDefault();
						first.focus();
					}
				});
			}

			initializeContentPreferenceControls();
			initializeHiddenMiiButtons();
			initializeHiddenMiisModal();
			
			async function changePfp() {
				const pfpId = document.getElementById('pfpId').value.trim();
				if (!pfpId) {
					showAlert('Enter a Mii ID.', 5000, { title: 'Profile picture', type: 'error' });
					return;
				}

				try {
					const response = await fetch(`/changePfp`, {
						method: "POST",
						body: JSON.stringify({ id: encodeURIComponent(pfpId) }),
						headers: { "Content-Type": "application/json" },
					});
					const result = await response.json();
					
					if (!result.error) {
						showAlert('Profile picture updated.', 2000, { title: 'Profile picture', type: 'success' });
						setTimeout(() => location.reload(), 2000);
					}
                    else {
						showAlert(result.error || 'Could not update the profile picture.', 5000, { title: 'Profile picture', type: 'error' });
					}
				} catch (error) {
					console.error('Error:', error);
					showAlert('Could not update the profile picture.', 5000, { title: 'Profile picture', type: 'error' });
				}
			}

			async function changeUser() {
				const newUsername = document.getElementById('nUser').value.trim();
				const password = document.getElementById('userChangePassword').value;
				
				if (!newUsername || !password) {
					showMessage('Enter a new username and your current password.', 'error');
					return;
				}

				showConfirm(`Are you sure you want to change your username to "${newUsername}"?\nYou won't be able to change it again for 30 days.`, async () => {
					const response = await fetch('/changeSelfUsername', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ newUsername, password })
					});
					const result = await response.json();
					
					if (!result.error) {
						showMessage(result.message || 'Username updated.', 'success');
						document.getElementById('nUser').value = '';
						document.getElementById('userChangePassword').value = '';
						setTimeout(() => {
							if (result.redirect) window.location.href = result.redirect;
							else location.reload();
						}, 2000);
					} else {
						showMessage(result.error, 'error');
					}
				}, null, { title: 'Change Username', confirmText: 'Change' });
			}			
			async function changeEmail() {
				const newEmail = document.getElementById('nEmail').value.trim();

				if (!newEmail) {
					showAlert('Enter a new email address.', 5000, { title: 'Email address', type: 'error' });
					return;
				}

				try {
					const response = await fetch('/changeEmail', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ newEmail })
					});

					const result = await response.json();
					
					if (!result.error) {
						showAlert('Verification sent to your new email address.', 4000, { title: 'Email address', type: 'success' });
						document.getElementById('nEmail').value = '';
					}
                    else {
						showAlert(result.error || 'Could not update the email address.', 5000, { title: 'Email address', type: 'error' });
					}
				} catch (error) {
					console.error('Error:', error);
					showAlert('Could not update the email address.', 5000, { title: 'Email address', type: 'error' });
				}
			}

			async function setPassword() {
				const newPass = document.getElementById('setPass')?.value || '';

				if (!newPass) {
					showAlert('Enter a new password.', 5000, { title: 'Password', type: 'error' });
					return;
				}

				if (newPass.length < 6) {
					showAlert('Your password must be at least 6 characters.', 5000, { title: 'Password', type: 'error' });
					return;
				}

				try {
					const response = await fetch('/setPassword', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ newPassword: newPass })
					});
					const result = await response.json();

					if (!result.error) {
						showMessage(result.message || 'Password sign-in added.', 'success');
						setTimeout(() => location.reload(), 1500);
					} else {
						showMessage(result.error, 'error');
					}
				} catch (error) {
					console.error('Error:', error);
					showMessage('Could not add password sign-in.', 'error');
				}
			}

			async function changePassword() {
				const oldPass = document.getElementById('oPass').value;
				const newPass = document.getElementById('nPass').value;

				if (!oldPass || !newPass) {
					showAlert('Enter your current and new passwords.', 5000, { title: 'Password', type: 'error' });
					return;
				}

				if (newPass.length < 6) {
					showAlert('Your new password must be at least 6 characters.', 5000, { title: 'Password', type: 'error' });
					return;
				}

				try {
					const response = await fetch('/changePassword', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ oldPassword: oldPass, newPassword: newPass })
					});

					const result = await response.json();
					
					if (!result.error) {
						showAlert('Password updated.', 3000, { title: 'Password', type: 'success' });
						document.getElementById('oPass').value = '';
						document.getElementById('nPass').value = '';
					}
                    else {
						showAlert(result.error || 'Could not update the password.', 5000, { title: 'Password', type: 'error' });
					}
				} catch (error) {
					console.error('Error:', error);
					showAlert('Could not update the password.', 5000, { title: 'Password', type: 'error' });
				}
			}

			async function unlinkOAuthProvider(providerKey, providerName) {
				showConfirm(`Unlink ${providerName} from your account?`, async () => {
					try {
						const response = await fetch(`/auth/${encodeURIComponent(providerKey)}/unlink`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' }
						});
						const result = await response.json();

						if (!result.error) {
							showMessage(result.message || `${providerName} has been unlinked.`, 'success');
							setTimeout(() => location.reload(), 1500);
						} else {
							showMessage(result.error, 'error');
						}
					} catch (error) {
						console.error('Error:', error);
						showMessage(`Failed to unlink ${providerName}`, 'error');
					}
				}, null, { title: 'Unlink Provider', confirmText: 'Unlink' });
			}

			async function deleteAllMiis() {
				showConfirm('Delete every Mii you uploaded? This cannot be undone.', () => {
					const doubleCheck = prompt('Type "DELETE ALL" to confirm:');
					if (doubleCheck !== 'DELETE ALL') {
						showAlert('Nothing was deleted.', 3000, { title: 'Deletion cancelled' });
						return;
					}

					(async () => {
						try {
							const response = await fetch('/deleteAllMyMiis', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' }
							});

							const result = await response.json();
							
							if (!result.error) {
								showAlert(`Deleted ${result.deletedCount} Miis.`, 2000, { title: 'Miis deleted', type: 'success' });
								setTimeout(() => location.reload(), 2000);
							}
                    else {
								showAlert(result.error || 'Could not delete your Miis.', 5000, { title: 'Delete Miis', type: 'error' });
							}
						} catch (error) {
							console.error('Error:', error);
							showAlert('Could not delete your Miis.', 5000, { title: 'Delete Miis', type: 'error' });
						}
					})();
				}, null, { title: 'Delete All Miis', confirmText: 'Continue' });
			}

			async function deleteAccount() {
				const password = document.getElementById('deleteAccountPassword').value;

				if (!password) {
					showAlert('Enter your password to confirm account deletion.', 5000, { title: 'Delete account', type: 'error' });
					return;
				}

				showConfirm('Delete your account? Your Miis will remain in the archive under “[Deleted User].” This cannot be undone.', () => {
					const tripleCheck = prompt('Type "DELETE MY ACCOUNT" to confirm:');
					if (tripleCheck !== 'DELETE MY ACCOUNT') {
						showAlert('Your account was not deleted.', 3000, { title: 'Deletion cancelled' });
						return;
					}

					(async () => {
						try {
							const response = await fetch('/deleteAccount', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ password })
							});

							const result = await response.json();
							
							if (!result.error) {
								showAlert('Account deleted.', 2000, { title: 'Account deleted', type: 'success' });
								setTimeout(() => window.location.href = '/', 2000);
							}
                    else {
								showAlert(result.error || 'Could not delete your account.', 5000, { title: 'Delete account', type: 'error' });
							}
						} catch (error) {
							console.error('Error:', error);
							showAlert('Could not delete your account.', 5000, { title: 'Delete account', type: 'error' });
						}
					})();
				}, null, { title: 'Delete account', confirmText: 'Continue' });
			}
		</script>
	</body>
</html>
