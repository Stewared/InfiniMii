<!DOCTYPE html>
<html lang="en">
	<head>
		<%
		const pageTitle = 'Account Settings - InfiniMii';
		const pageDesc = 'Manage your InfiniMii profile, email, password, and account preferences.';
		const canonicalUrl = `${baseUrl}/settings`;
		const pageRobots = 'noindex, nofollow, noarchive';
		%>
		<%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, pageRobots }) %>
		<%- include('structuredData') %>
		<link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="/utilityPages.css">
	</head>
	<body>
        <%- include('globalStyle') %>
		<%- include('header') %>
		<%- include('accountDisplay') %>
		<div class="content">
			<%- include('sidebar') %>
			<div class="settings-container">
				<%
				const passwordLoginEnabled = Boolean(user?.salt && user?.pass);
				const linkedIdentities = Array.isArray(user?.oauthIdentities) ? user.oauthIdentities : [];
				const linkedProviderKeys = linkedIdentities.map(identity => identity.provider);
				const oauthProviderMap = Object.fromEntries((Array.isArray(oauthProviders) ? oauthProviders : []).map(provider => [provider.key, provider]));
				const safeBlockableTags = Array.isArray(blockableTags) ? blockableTags : [];
				const safeBlockedTags = Array.isArray(blockedTags) ? blockedTags : [];
				const blockedTagSet = new Set(safeBlockedTags);
				const safeBlockableCategories = Array.isArray(blockableOfficialCategories) ? blockableOfficialCategories : [];
				const safeBlockedCategories = Array.isArray(blockedOfficialCategories) ? blockedOfficialCategories : [];
				const blockedCategorySet = new Set(safeBlockedCategories);
				const safeExternalMiiPreference = ['ask', 'stay', 'go'].includes(
					String(typeof externalMiiPreference !== 'undefined' ? externalMiiPreference : user?.externalMiiPreference || '').trim().toLowerCase()
				)
					? String(typeof externalMiiPreference !== 'undefined' ? externalMiiPreference : user?.externalMiiPreference).trim().toLowerCase()
					: 'ask';
				const categoryGroupMap = new Map();
				safeBlockableCategories.forEach((category) => {
					const categoryPath = String(category?.path || category || '').trim();
					if (!categoryPath) return;

					const categoryName = String(category?.name || categoryPath.split('/').filter(Boolean).pop() || categoryPath).trim();
					const categoryColor = String(category?.color || '#999999').trim();
					const pathSegments = categoryPath.split('/').map(segment => segment.trim()).filter(Boolean);
					const groupName = pathSegments[0] || categoryName || categoryPath;
					const groupKey = groupName.toLowerCase();
					const groupPath = groupName;

					if (!categoryGroupMap.has(groupKey)) {
						categoryGroupMap.set(groupKey, {
							name: groupName,
							path: groupPath,
							color: categoryColor,
							topLevel: null,
							selectedCount: 0,
							categories: []
						});
					}

					const group = categoryGroupMap.get(groupKey);
					const isTopLevel = categoryPath.toLowerCase() === groupPath.toLowerCase();
					const categoryLabel = String(category?.fullPath || categoryPath).trim();
					const groupPrefix = `${groupName}/`;
					const displayLabel = isTopLevel
						? categoryName
						: (categoryLabel.startsWith(groupPrefix) ? categoryLabel.slice(groupPrefix.length) : categoryLabel);
					const option = {
						path: categoryPath,
						label: displayLabel || categoryName || categoryPath,
						color: categoryColor,
						checked: blockedCategorySet.has(categoryPath)
					};

					if (option.checked) {
						group.selectedCount += 1;
					}
					if (isTopLevel) {
						group.topLevel = option;
						group.color = categoryColor;
					} else {
						group.categories.push(option);
					}
				});
				const safeBlockableCategoryGroups = [...categoryGroupMap.values()].map((group) => {
					if (!group.topLevel) {
						group.topLevel = {
							path: group.path,
							label: group.name,
							color: group.color || '#999999',
							checked: blockedCategorySet.has(group.path)
						};
						if (group.topLevel.checked) group.selectedCount += 1;
					}
					group.categories.sort((a, b) => a.path.localeCompare(b.path, undefined, { sensitivity: 'base' }));
					return group;
				}).sort((a, b) => a.path.localeCompare(b.path, undefined, { sensitivity: 'base' }));
				const safeHiddenMiis = Array.isArray(hiddenMiis) ? hiddenMiis : [];
				const formatOAuthProviderName = (key) => oauthProviderMap[key]?.displayName || String(key || 'OAuth').split(/[-_]+/g).filter(Boolean).map(part => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
				const getOAuthProviderIconUrl = (key) => {
					const iconUrl = oauthProviderMap[key]?.iconUrl;
					return typeof iconUrl === 'string' ? iconUrl.trim() : '';
				};
				const getOAuthProviderIconText = (key, providerName) => oauthProviderMap[key]?.iconText || providerName.slice(0, 2);
				%>
				<div id="settings-message" class="form-message <%= oauthStatus?.type || '' %>" style="display: <%= oauthStatus ? 'block' : 'none' %>; margin-bottom: 20px;"><%= oauthStatus?.message || '' %></div>
				
				<fieldset>
					<legend>Profile Settings</legend>
					
					<!-- Change Profile Picture -->
					<div class="setting-group">
						<label>Profile Picture (Mii ID)</label>
						<small style="color: var(--text-2); display: block; margin-bottom: 6px;">Current: <%= user?.miiPfp || '00000' %></small>
						<input type="text" placeholder="Mii ID for new Profile Picture" id="pfpId">
						<button onclick="changePfp()">Change Profile Picture</button>
					</div>

					<!-- Change Username -->
					<div class="setting-group">
						<label>Username</label>
						<small style="color: var(--text-2); display: block; margin-bottom: 6px;">Current: <%= user?.username || '' %></small>
						<p style="color: var(--text-2); font-size: 0.9em; margin: 5px 0;">ℹ️ You can only change your username once per month.</p>
						<input type="text" placeholder="New Username" id="nUser">
						<input type="password" placeholder="Current Password" id="userChangePassword">
						<button onclick="changeUser()">Change Username</button>
					</div>
				</fieldset>

				<fieldset>
					<legend>Account Settings</legend>

					<!-- Change Email -->
					<div class="setting-group">
						<label>Email Address</label>
						<small style="color: var(--text-2); display: block; margin-bottom: 6px;">Current: <%= user?.email || '' %></small>
						<input type="email" placeholder="New Email" id="nEmail">
						<button onclick="changeEmail()">Change Email</button>
					</div>
					
					<!-- Change Password -->
					<div class="setting-group">
						<label>Password</label>
						<% if (passwordLoginEnabled) { %>
							<input type="password" placeholder="Old Password" id="oPass">
							<input type="password" placeholder="New Password" id="nPass">
							<button onclick="changePassword()">Change Password</button>
						<% } else { %>
							<small style="color: var(--text-2); display: block; margin-bottom: 6px;">Add a password if you want username/password login or password-protected account actions.</small>
							<input type="password" placeholder="New Password" id="setPass">
							<button onclick="setPassword()">Set Password</button>
						<% } %>
					</div>

					<div class="setting-group">
						<label>Connected Login Methods</label>
						<div class="linked-oauth-list">
							<% if (passwordLoginEnabled) { %>
								<div class="linked-oauth-item">
									<span class="linked-oauth-main">
										<span class="oauth-provider-mark oauth-provider-mark-password" aria-hidden="true"><%- include('icon', { name: 'key', size: 16 }) %></span>
										<span>Password</span>
									</span>
									<span class="linked-oauth-status">Enabled</span>
								</div>
							<% } %>
							<% if (linkedIdentities.length === 0 && !passwordLoginEnabled) { %>
								<p class="auth-note">No login methods are connected yet.</p>
							<% } %>
							<% linkedIdentities.forEach((identity) => {
								const providerName = formatOAuthProviderName(identity.provider);
								const providerIconUrl = getOAuthProviderIconUrl(identity.provider);
								const providerIconText = getOAuthProviderIconText(identity.provider, providerName);
							%>
								<div class="linked-oauth-item oauth-provider-<%= identity.provider %>">
									<span class="linked-oauth-main">
										<span class="oauth-provider-mark" aria-hidden="true">
											<% if (providerIconUrl) { %>
												<img class="oauth-provider-icon-img" src="<%= providerIconUrl %>" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.hidden=true; this.nextElementSibling.hidden=false;">
												<span class="oauth-provider-fallback" hidden><%= providerIconText %></span>
											<% } else { %>
												<span class="oauth-provider-fallback"><%= providerIconText %></span>
											<% } %>
										</span>
										<span>
											<span class="linked-oauth-name"><%= providerName %></span>
											<% if (identity.email) { %>
												<small><%= identity.email %></small>
											<% } %>
										</span>
									</span>
									<button type="button" class="oauth-unlink-button" onclick="unlinkOAuthProvider(<%- toScriptJson(identity.provider) %>, <%- toScriptJson(providerName) %>)">Unlink</button>
								</div>
							<% }) %>
						</div>
						<%- include('oauthButtons', { mode: 'link', next: '/settings', heading: 'Link another provider', linkedProviderKeys }) %>
					</div>
				</fieldset>

				<fieldset>
					<legend>Content Preferences</legend>

					<div class="setting-group">
						<label id="externalMiiPreferenceLabel">External Mii links</label>
						<small style="color: var(--text-2); display: block; margin-bottom: 10px;">Choose what InfiniMii should do when you visit a Mii that comes from another website.</small>
						<div class="preference-selector-list" role="radiogroup" aria-labelledby="externalMiiPreferenceLabel">
							<label class="preference-selector-option">
								<input type="radio" name="externalMiiPreference" value="ask" <%= safeExternalMiiPreference === 'ask' ? 'checked' : '' %>>
								<span>Ask every time</span>
							</label>
							<label class="preference-selector-option">
								<input type="radio" name="externalMiiPreference" value="stay" <%= safeExternalMiiPreference === 'stay' ? 'checked' : '' %>>
								<span>Stay on InfiniMii</span>
							</label>
							<label class="preference-selector-option">
								<input type="radio" name="externalMiiPreference" value="go" <%= safeExternalMiiPreference === 'go' ? 'checked' : '' %>>
								<span>Go to the original site</span>
							</label>
						</div>
					</div>

					<div class="setting-group">
						<label>Hidden Tags</label>
						<div class="preference-selector-list">
							<% if (safeBlockableTags.length > 0) { %>
								<% safeBlockableTags.forEach((tag) => { %>
									<label class="preference-selector-option">
										<input type="checkbox" data-blocked-tag value="<%= tag %>" <%= blockedTagSet.has(tag) ? 'checked' : '' %>>
										<span><%= tag %></span>
									</label>
								<% }) %>
							<% } else { %>
								<p class="preference-empty">No tags are available yet.</p>
							<% } %>
						</div>
					</div>

					<div class="setting-group">
						<label>Hidden Official Categories</label>
						<div class="preference-selector-list preference-selector-list-tall preference-category-selector">
							<% if (safeBlockableCategoryGroups.length > 0) { %>
								<div class="preference-category-groups category-filter-groups">
									<% safeBlockableCategoryGroups.forEach((group) => { %>
										<%
											const groupTopLevel = group.topLevel;
											const groupHasChildren = group.categories.length > 0;
											const groupHasSelection = group.selectedCount > 0;
											const groupBadge = groupTopLevel.checked && groupHasChildren ? 'All' : group.selectedCount;
											const topLevelLabel = groupHasChildren ? `All ${group.name}` : groupTopLevel.label;
										%>
										<details class="category-filter-group preference-category-group" <%= groupHasSelection ? 'open' : '' %>>
											<summary>
												<span><%= group.name %></span>
												<% if (groupHasSelection) { %>
													<span class="category-filter-group-counts">
														<span class="category-filter-group-count is-include"><%= groupBadge %></span>
													</span>
												<% } %>
											</summary>
											<div class="category-filter-options preference-category-options">
												<label class="preference-selector-option preference-category-option preference-category-option-top-level" style="--category-color: <%= groupTopLevel.color || '#999999' %>;">
													<input type="checkbox" data-blocked-category value="<%= groupTopLevel.path %>" <%= groupTopLevel.checked ? 'checked' : '' %>>
													<span><%= topLevelLabel %></span>
												</label>
												<% group.categories.forEach((category) => { %>
													<label class="preference-selector-option preference-category-option" style="--category-color: <%= category.color || '#999999' %>;">
														<input type="checkbox" data-blocked-category value="<%= category.path %>" <%= category.checked ? 'checked' : '' %>>
														<span><%= category.label %></span>
													</label>
												<% }) %>
											</div>
										</details>
									<% }) %>
								</div>
							<% } else { %>
								<p class="preference-empty">No official categories are available yet.</p>
							<% } %>
						</div>
					</div>

					<div class="setting-group content-preference-actions">
						<button type="button" onclick="saveContentPreferences()">Save Content Preferences</button>
						<% if (safeHiddenMiis.length > 0) { %>
							<button type="button" class="secondary-settings-button" id="openHiddenMiisButton" onclick="openHiddenMiisModal()">Manage Hidden Miis</button>
						<% } %>
					</div>
				</fieldset>

				<fieldset class="danger-zone">
					<legend><%- include('icon', { name: 'alert-triangle', size: 20, class: 'icon-warning' }) %> Danger Zone</legend>

					<!-- Delete All Miis -->
					<div class="setting-group">
						<label>Delete All Your Miis</label>
						<p class="warning-text">This will permanently delete ALL Miis you have uploaded. This action cannot be undone!</p>
						<button class="danger-btn" onclick="deleteAllMiis()"><%- include('icon', { name: 'trash', size: 16 }) %> Delete All My Miis</button>
					</div>

					<!-- Delete Account -->
					<div class="setting-group">
						<label>Delete Account</label>
						<p class="warning-text">This will permanently delete your account. Your Miis will remain on the site but will be attributed to "[Deleted User]". This action cannot be undone!</p>
						<input type="password" placeholder="Enter Password to Confirm" id="deleteAccountPassword">
						<button class="danger-btn" onclick="deleteAccount()"><%- include('icon', { name: 'ban', size: 16 }) %> Delete Account</button>
					</div>
				</fieldset>
			</div>

            <%- include('featuredMiis') %>
		</div>
		<% if (safeHiddenMiis.length > 0) { %>
			<div id="hiddenMiisModal" class="custom-modal-overlay" aria-hidden="true">
				<div class="custom-modal hidden-miis-modal" role="dialog" aria-modal="true" aria-labelledby="hiddenMiisTitle">
					<div class="custom-modal-header">
						<h3 id="hiddenMiisTitle">Hidden Miis</h3>
						<button type="button" class="custom-modal-close" onclick="closeHiddenMiisModal()" aria-label="Close">&times;</button>
					</div>
					<div class="custom-modal-body">
						<div id="hiddenMiisStatus" class="form-message" style="display: none; margin-bottom: 0.75rem;"></div>
						<div class="hidden-miis-list" id="hiddenMiisList">
							<% safeHiddenMiis.forEach((hiddenMii) => { %>
								<div class="hidden-mii-row" data-hidden-mii-id="<%= hiddenMii.id %>">
									<span class="hidden-mii-id"><%= hiddenMii.id %></span>
									<span class="hidden-mii-name"><%= hiddenMii.name %></span>
									<button type="button" class="hidden-mii-unhide" data-unhide-mii-id="<%= hiddenMii.id %>">Unhide</button>
								</div>
							<% }) %>
						</div>
					</div>
					<div class="custom-modal-footer">
						<button type="button" class="custom-modal-btn custom-modal-btn-secondary" onclick="closeHiddenMiisModal()">Close</button>
					</div>
				</div>
			</div>
		<% } %>
		<%- include('footer') %>
		<script>
			function showMessage(text, type = 'error') {
				const messageDiv = document.getElementById('settings-message');
				messageDiv.textContent = text;
				messageDiv.className = `form-message ${type}`;
				messageDiv.style.display = 'block';
				if (type === 'error' && typeof window.scrollToUserError === 'function') {
					window.scrollToUserError(messageDiv);
				} else {
					messageDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				}
			}

			function showHiddenMiisStatus(text, type = 'error') {
				const status = document.getElementById('hiddenMiisStatus');
				if (!status) {
					showMessage(text, type);
					return;
				}

				status.textContent = text;
				status.className = `form-message ${type}`;
				status.style.display = 'block';
			}

			async function saveContentPreferences() {
				const blockedTags = Array.from(document.querySelectorAll('[data-blocked-tag]:checked')).map(input => input.value);
				const blockedOfficialCategories = Array.from(document.querySelectorAll('[data-blocked-category]:checked')).map(input => input.value);
				const externalMiiPreference = document.querySelector('input[name="externalMiiPreference"]:checked')?.value || 'ask';

				try {
					const response = await fetch('/updateContentPreferences', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ blockedTags, blockedOfficialCategories, externalMiiPreference })
					});
					const result = await response.json();

					if (!response.ok || result.error) {
						showMessage(result.error || 'Failed to save content preferences.', 'error');
						return;
					}

					showMessage('Content preferences saved.', 'success');
				} catch (error) {
					console.error('Error saving content preferences:', error);
					showMessage('Failed to save content preferences', 'error');
				}
			}

			function openHiddenMiisModal() {
				const modal = document.getElementById('hiddenMiisModal');
				if (!modal) return;
				modal.classList.add('active');
				modal.setAttribute('aria-hidden', 'false');
			}

			function closeHiddenMiisModal() {
				const modal = document.getElementById('hiddenMiisModal');
				if (!modal) return;
				modal.classList.remove('active');
				modal.setAttribute('aria-hidden', 'true');
			}

			async function unhideMiiFromSettings(miiId, button) {
				if (!miiId) return;
				if (button) button.disabled = true;

				try {
					const response = await fetch('/unhideMii', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id: miiId })
					});
					const responseText = await response.text();
					let result = {};
					try {
						result = responseText ? JSON.parse(responseText) : {};
					} catch (error) {
						throw new Error(response.ok ? 'Unexpected response while unhiding Mii' : 'Failed to unhide Mii');
					}

					if (!response.ok || result.error) {
						showHiddenMiisStatus(result.error || 'Failed to unhide Mii', 'error');
						if (button) button.disabled = false;
						return;
					}

					const row = button?.closest?.('[data-hidden-mii-id]')
						|| Array.from(document.querySelectorAll('[data-hidden-mii-id]'))
							.find((candidate) => candidate.getAttribute('data-hidden-mii-id') === String(miiId));
					row?.remove();
					if (!document.querySelector('[data-hidden-mii-id]')) {
						document.getElementById('openHiddenMiisButton')?.remove();
						closeHiddenMiisModal();
					}
					showHiddenMiisStatus('Mii unhidden.', 'success');
					showMessage('Mii unhidden.', 'success');
				} catch (error) {
					console.error('Error unhiding Mii:', error);
					showHiddenMiisStatus(error.message || 'Failed to unhide Mii', 'error');
					if (button) button.disabled = false;
				}
			}

			function initializeHiddenMiiButtons() {
				document.querySelectorAll('[data-unhide-mii-id]').forEach((button) => {
					if (button.dataset.unhideBound === 'true') return;
					button.dataset.unhideBound = 'true';
					button.addEventListener('click', () => {
						unhideMiiFromSettings(button.dataset.unhideMiiId, button);
					});
				});
			}

			initializeHiddenMiiButtons();
			
			async function changePfp() {
				const pfpId = document.getElementById('pfpId').value;
				if (!pfpId) {
					showAlert('Please enter a Mii ID', 5000, { title: 'Error', type: 'error' });
					return;
				}

				try {
					const response = await fetch(`/changePfp`, {
						method: "POST",
						body: JSON.stringify({ id: encodeURIComponent(pfpId) }),
						headers: { "Content-Type": "application/json" },
					});
					const result = await response.json();
					
					if (!result.error) {
						showAlert('Profile picture changed successfully!', 2000, { title: 'Success', type: 'success' });
						setTimeout(() => location.reload(), 2000);
					}
                    else {
						showAlert(result.error || 'Error changing profile picture', 5000, { title: 'Error', type: 'error' });
					}
				} catch (error) {
					console.error('Error:', error);
					showAlert('Failed to change profile picture', 5000, { title: 'Error', type: 'error' });
				}
			}

			async function changeUser() {
				const newUsername = document.getElementById('nUser').value;
				const password = document.getElementById('userChangePassword').value;
				const messageDiv = document.getElementById('settings-message');
				
				if (!newUsername || !password) {
					showMessage('Please enter both a new username and your password', 'error');
					return;
				}

				showConfirm(`Are you sure you want to change your username to "${newUsername}"?\nYou won't be able to change it again for 30 days.`, async () => {
					const response = await fetch('/changeSelfUsername', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ newUsername, password })
					});
					const result = await response.json();
					
					if (!result.error) {
						showMessage(result.message || 'Username changed successfully!', 'success');
						document.getElementById('nUser').value = '';
						document.getElementById('userChangePassword').value = '';
						setTimeout(() => {
							if (result.redirect) window.location.href = result.redirect;
							else location.reload();
						}, 2000);
					} else {
						showMessage(result.error, 'error');
					}
				}, null, { title: 'Change Username', confirmText: 'Change' });
			}			
			async function changeEmail() {
				const newEmail = document.getElementById('nEmail').value;

				if (!newEmail) {
					showAlert('Please enter a new email address', 5000, { title: 'Error', type: 'error' });
					return;
				}

				try {
					const response = await fetch('/changeEmail', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ newEmail })
					});

					const result = await response.json();
					
					if (!result.error) {
						showAlert('Email change verification sent! Please check your email.', 4000, { title: 'Success', type: 'success' });
						document.getElementById('nEmail').value = '';
					}
                    else {
						showAlert(result.error || 'Error changing email', 5000, { title: 'Error', type: 'error' });
					}
				} catch (error) {
					console.error('Error:', error);
					showAlert('Failed to change email', 5000, { title: 'Error', type: 'error' });
				}
			}

			async function setPassword() {
				const newPass = document.getElementById('setPass')?.value || '';

				if (!newPass) {
					showAlert('Please enter a password', 5000, { title: 'Error', type: 'error' });
					return;
				}

				if (newPass.length < 6) {
					showAlert('New password must be at least 6 characters', 5000, { title: 'Error', type: 'error' });
					return;
				}

				try {
					const response = await fetch('/setPassword', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ newPassword: newPass })
					});
					const result = await response.json();

					if (!result.error) {
						showMessage(result.message || 'Password login added successfully.', 'success');
						setTimeout(() => location.reload(), 1500);
					} else {
						showMessage(result.error, 'error');
					}
				} catch (error) {
					console.error('Error:', error);
					showMessage('Failed to set password', 'error');
				}
			}

			async function changePassword() {
				const oldPass = document.getElementById('oPass').value;
				const newPass = document.getElementById('nPass').value;

				if (!oldPass || !newPass) {
					showAlert('Please fill in both old and new password', 5000, { title: 'Error', type: 'error' });
					return;
				}

				if (newPass.length < 6) {
					showAlert('New password must be at least 6 characters', 5000, { title: 'Error', type: 'error' });
					return;
				}

				try {
					const response = await fetch('/changePassword', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ oldPassword: oldPass, newPassword: newPass })
					});

					const result = await response.json();
					
					if (!result.error) {
						showAlert('Password changed successfully!', 3000, { title: 'Success', type: 'success' });
						document.getElementById('oPass').value = '';
						document.getElementById('nPass').value = '';
					}
                    else {
						showAlert(result.error || 'Error changing password', 5000, { title: 'Error', type: 'error' });
					}
				} catch (error) {
					console.error('Error:', error);
					showAlert('Failed to change password', 5000, { title: 'Error', type: 'error' });
				}
			}

			async function unlinkOAuthProvider(providerKey, providerName) {
				showConfirm(`Unlink ${providerName} from your account?`, async () => {
					try {
						const response = await fetch(`/auth/${encodeURIComponent(providerKey)}/unlink`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' }
						});
						const result = await response.json();

						if (!result.error) {
							showMessage(result.message || `${providerName} has been unlinked.`, 'success');
							setTimeout(() => location.reload(), 1500);
						} else {
							showMessage(result.error, 'error');
						}
					} catch (error) {
						console.error('Error:', error);
						showMessage(`Failed to unlink ${providerName}`, 'error');
					}
				}, null, { title: 'Unlink Provider', confirmText: 'Unlink' });
			}

			async function deleteAllMiis() {
				showConfirm('WARNING\n\nAre you ABSOLUTELY SURE you want to DELETE ALL YOUR MIIS?\n\nThis action CANNOT be undone!', () => {
					const doubleCheck = prompt('Type "DELETE ALL" to confirm:');
					if (doubleCheck !== 'DELETE ALL') {
						showAlert('Deletion cancelled.', 3000, { title: 'Cancelled' });
						return;
					}

					(async () => {
						try {
							const response = await fetch('/deleteAllMyMiis', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' }
							});

							const result = await response.json();
							
							if (!result.error) {
								showAlert(`Successfully deleted ${result.deletedCount} Miis`, 2000, { title: 'Success', type: 'success' });
								setTimeout(() => location.reload(), 2000);
							}
                    else {
								showAlert(result.error || 'Error deleting Miis', 5000, { title: 'Error', type: 'error' });
							}
						} catch (error) {
							console.error('Error:', error);
							showAlert('Failed to delete Miis', 5000, { title: 'Error', type: 'error' });
						}
					})();
				}, null, { title: 'Delete All Miis', confirmText: 'Continue' });
			}

			async function deleteAccount() {
				const password = document.getElementById('deleteAccountPassword').value;

				if (!password) {
					showAlert('Please enter your password to confirm account deletion', 5000, { title: 'Error', type: 'error' });
					return;
				}

				showConfirm('FINAL WARNING\n\nAre you ABSOLUTELY SURE you want to DELETE YOUR ACCOUNT?\n\nYour Miis will remain on the site but will be attributed to "[Deleted User]".\n\nThis action CANNOT be undone!', () => {
					const tripleCheck = prompt('Type "DELETE MY ACCOUNT" to confirm:');
					if (tripleCheck !== 'DELETE MY ACCOUNT') {
						showAlert('Account deletion cancelled.', 3000, { title: 'Cancelled' });
						return;
					}

					(async () => {
						try {
							const response = await fetch('/deleteAccount', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ password })
							});

							const result = await response.json();
							
							if (!result.error) {
								showAlert('Account deleted successfully. Goodbye!', 2000, { title: 'Success', type: 'success' });
								setTimeout(() => window.location.href = '/', 2000);
							}
                    else {
								showAlert(result.error || 'Error deleting account', 5000, { title: 'Error', type: 'error' });
							}
						} catch (error) {
							console.error('Error:', error);
							showAlert('Failed to delete account', 5000, { title: 'Error', type: 'error' });
						}
					})();
				}, null, { title: '⚠️ DELETE ACCOUNT', confirmText: 'Continue' });
			}
		</script>
	</body>
</html>
