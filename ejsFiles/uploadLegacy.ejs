<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Legacy Upload - InfiniMii</title>
    <meta name="robots" content="noindex, nofollow, noarchive">
</head>
<body bgcolor="#0E0C10" text="#FFFFFF" link="#DE4362" vlink="#DE4362">
    <table width="100%" border="0" cellspacing="0" cellpadding="8" bgcolor="#0E0C10">
        <tr>
            <td align="center">
                <table width="340" border="1" cellspacing="0" cellpadding="0" bordercolor="#DE4362" bgcolor="#211F25">
                    <tr>
                        <td bgcolor="#DE4362" align="center">
                            <font color="#ffffff"><b>InfiniMii Legacy Upload</b></font>
                        </td>
                    </tr>
                    <tr>
                        <td bgcolor="#3A3640">
                            <font color="#E2DDE0">Legacy browser mode. File upload only.</font>
                        </td>
                    </tr>

                    <% if (legacyUploadError) { %>
                        <tr>
                            <td bgcolor="#45222A">
                                <font color="#FFD9DF"><b>Error:</b> <% if (legacyUploadErrorHtml) { %><%- legacyUploadErrorHtml %><% } else { %><%= legacyUploadError %><% } %></font>
                            </td>
                        </tr>
                    <% } %>

                    <% if (legacyUploadSuccess) { %>
                        <tr>
                            <td bgcolor="#253A2A">
                                <font color="#D8F3DE"><%= legacyUploadSuccess %></font>
                                <% if (legacyUploadedMii) { %>
                                    <br>
                                    <font color="#D8F3DE">Name: <b><%= legacyUploadedMii.name %></b> (<%= legacyUploadedMii.published ? "Published" : "Private" %>)</font>
                                <% } %>
                            </td>
                        </tr>
                    <% } %>

                    <tr>
                        <td bgcolor="#2D2A34">
                            <font color="#FFFFFF"><b>Upload Form</b></font>
                        </td>
                    </tr>
                    <tr>
                        <td bgcolor="#211F25">
                            <form action="/legacy-upload" method="post" enctype="multipart/form-data">
                                <font color="#FFFFFF">Username</font><br>
                                <input type="text" name="username" value="<%= (legacyFormValues && legacyFormValues.username) || '' %>" size="30" required><br><br>

                                <font color="#FFFFFF">Password</font><br>
                                <input type="password" name="password" size="30" required><br><br>

                                <font color="#FFFFFF">Mii file (native .ltd or supported older input)</font><br>
                                <input type="file" name="mii" required><br><br>

                                <font color="#FFFFFF">Description</font><br>
                                <textarea name="desc" cols="30" rows="3" maxlength="<%= miiDescriptionMaxLength %>" required><%= (legacyFormValues && legacyFormValues.desc) || '' %></textarea><br><br>

                                <input type="radio" name="visibility" value="private" <%= (legacyFormValues && legacyFormValues.visibility) !== 'published' ? 'checked' : '' %>> Private
                                &nbsp;
                                <input type="radio" name="visibility" value="published" <%= (legacyFormValues && legacyFormValues.visibility) === 'published' ? 'checked' : '' %>> Published
                                <br><br>

                                <input type="submit" value="Upload">
                            </form>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#2A2730">
                            <font color="#FFFFFF"><b>Highlighted Mii</b></font><br>
                            <img src="/highlighted.png?v=<%= legacyCacheBuster %>" alt="Highlighted Mii" width="96" height="96" border="1"><br>
                            <font color="#C9C1C6">
                                <% if (highlightedMiiData) { %>
                                    <%= (highlightedMiiData.meta && highlightedMiiData.meta.name) || "Unknown" %>
                                <% } else { %>
                                    No highlighted Mii.
                                <% } %>
                            </font>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#2A2730">
                            <font color="#FFFFFF"><b>Average Mii</b></font><br>
                            <img src="/average.png?v=<%= legacyCacheBuster %>" alt="Average Mii" width="96" height="96" border="1"><br>
                            <font color="#C9C1C6">
                                <% if (averageMiiData) { %>
                                    Average preview.
                                <% } else { %>
                                    Average Mii unavailable.
                                <% } %>
                            </font>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
