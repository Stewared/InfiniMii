<!DOCTYPE html>
<html lang="en">
    <head>
        <%
        const pageTitle = 'Search Mii Characters - InfiniMii';
        const pageDesc = 'Search our vast collection of Mii characters for all Nintendo systems. Find official Nintendo Miis, community creations, and celebrity Miis for Wii, 3DS, Wii U, and Switch.';
        const canonicalUrl = baseUrl + '/search';
        const keywords = 'search mii, find mii character, mii database, mii search engine';
        const breadcrumbs = [
            { name: 'Home', url: '/' },
            { name: 'Search', url: '/search' }
        ];
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, keywords }) %>
        <%- include('structuredData') %>
        
        <link rel="stylesheet" href="/global.css?v=<%= encodeURIComponent(assetVersion || '20260513-tri-state-search-filters') %>">
        <link rel="stylesheet" href="/utilityPages.css">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <main class="content" role="main">
            <%- include('sidebar') %>
            <section class="utility-container" aria-labelledby="search-heading">
                <header class="search-page-intro">
                    <h1>Search Mii Characters</h1>
                    <p>Search by character name, uploader, description, and tags to find Miis anywhere in the InfiniMii archive.</p>
                </header>
                <%- include('advancedSearchControls', {
                    formAction: '/searchResults',
                    query,
                    controlUiIdPrefix: 'search-page',
                    searchAriaLabel: 'Search Mii characters',
                    searchInputPlaceholder: 'Search by text...',
                    submitLabel: 'Search',
                    selectedSearchFields,
                    searchFieldsExplicitlyConfigured,
                    availableTags,
                    selectedTags,
                    excludedTags,
                    isModerator,
                    renderSearchFields: true,
                    renderTagFilters: true,
                    renderCategoryFilters: false
                }) %>

                <!-- This is here for SEO/LLM-O -->
                <div class="search-tips" hidden>
                        <h3>Search Tips:</h3>
                        <ul>
                            <li>Search by character name (e.g., "Mario", "Link", "Pikachu")</li>
                            <li>Find official Nintendo Miis by searching for game titles</li>
                            <li>Use creator names to find all Miis by a specific user</li>
                            <li>Browse by console: "Wii", "3DS", "Switch"</li>
                        </ul>
                </div>
                <%- include('tagFilters', {
                    availableTags,
                    selectedTags,
                    isModerator,
                    tagUiIdPrefix: 'search-page',
                    renderTagFilters: false,
                    renderTagManagement: true
                }) %>
            </section>
            <%- include('featuredMiis') %>
        </main>
        <%- include('footer') %>
    </body>
</html>
