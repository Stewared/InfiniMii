<!DOCTYPE html>
<html lang="en">
    <head>
        <%
            const normalizeKeywordList = (values) => {
                const seen = new Set();
                return (Array.isArray(values) ? values : [values]).flatMap((value) => Array.isArray(value) ? value : [value]).filter((value) => {
                    const normalized = String(value || '').trim();
                    if (!normalized) return false;
                    const key = normalized.toLowerCase();
                    if (seen.has(key)) return false;
                    seen.add(key);
                    return true;
                }).map((value) => String(value).trim());
            };
            const totalUploaded = (profileStats && typeof profileStats.totalMiis === 'number')
                ? profileStats.totalMiis
                : displayedMiis.length;
            const totalLikes = (profileStats && typeof profileStats.totalLikes === 'number')
                ? profileStats.totalLikes
                : displayedMiis.reduce((sum, mii) => sum + (mii.votes || 0), 0);
            const officialCount = profileStats?.officialCount || 0;
            const communityCount = typeof profileStats?.communityCount === 'number'
                ? profileStats.communityCount
                : Math.max(0, totalUploaded - officialCount);
            const memberSince = profileStats?.memberSince;
            const latestUploadOn = profileStats?.latestUploadOn;
            const firstUploadOn = profileStats?.firstUploadOn;
            const topTags = Array.isArray(profileHighlights?.topTags) ? profileHighlights.topTags : [];
            const topCategories = Array.isArray(profileHighlights?.topCategories) ? profileHighlights.topCategories : [];
            const creatorNames = Array.isArray(profileHighlights?.creatorNames) ? profileHighlights.creatorNames : [];
            const profileFeaturedMiis = Array.isArray(profileHighlights?.featuredMiis) ? profileHighlights.featuredMiis : [];
            const featuredNames = Array.isArray(profileHighlights?.featuredNames) ? profileHighlights.featuredNames : [];
            const selectedProfileSort = profileSort === 'latest' ? 'latest' : 'popular';
            const currentPageNumber = pagination?.currentPage || 1;
            const pageSuffix = currentPageNumber > 1 ? ` - Page ${currentPageNumber}` : '';
            const memberSinceLabel = memberSince
                ? new Date(memberSince).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })
                : '';
            const latestUploadLabel = latestUploadOn
                ? new Date(latestUploadOn).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
                : '';
            const firstUploadLabel = firstUploadOn
                ? new Date(firstUploadOn).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
                : '';
            const canonicalParams = new URLSearchParams();
            if (selectedProfileSort === 'latest') {
                canonicalParams.set('sort', 'latest');
            }
            if (currentPageNumber > 1) {
                canonicalParams.set('page', String(currentPageNumber));
            }
            const canonicalQuery = canonicalParams.toString();
            const pageTitle = `${targetUser.username} Mii Profile${selectedProfileSort === 'latest' ? ' - Latest' : ''}${pageSuffix} - InfiniMii`;
            const profileLead = totalUploaded > 0
                ? `${targetUser.username} has published ${totalUploaded} public Mii character${totalUploaded === 1 ? '' : 's'} on InfiniMii with ${totalLikes} total likes.`
                : `${targetUser.username} has a public InfiniMii creator profile.`;
            const profileArchiveSummary = totalUploaded > 0
                ? `${officialCount > 0 ? `${officialCount} official` : '0 official'} and ${communityCount} community uploads${firstUploadLabel ? ` dating back to ${firstUploadLabel}` : ''}${latestUploadLabel ? `, with recent activity on ${latestUploadLabel}` : ''}.`
                : '';
            const themeSummary = topTags.length > 0
                ? `Common tags include ${topTags.slice(0, 5).join(', ')}.`
                : '';
            const categorySummary = topCategories.length > 0
                ? `Official archive categories include ${topCategories.slice(0, 4).map((category) => category.name).join(', ')}.`
                : '';
            const featuredSummary = featuredNames.length > 0
                ? `Popular uploads include ${featuredNames.slice(0, 4).join(', ')}.`
                : '';
            const pageDesc = totalUploaded > 0
                ? `${profileLead} ${profileArchiveSummary} ${themeSummary} ${categorySummary} ${featuredSummary}`.replace(/\s+/g, ' ').trim()
                : `Public profile for ${targetUser.username} on InfiniMii.`;
            const canonicalUrl = `${baseUrl}/user/${encodeURIComponent(targetUser.username)}${canonicalQuery ? `?${canonicalQuery}` : ''}`;
            const ogImage = `${baseUrl}/miiImgs/${targetUser.miiPfp || '00000'}.png`;
            const keywords = normalizeKeywordList([
                targetUser.username,
                `${targetUser.username} Mii`,
                `${targetUser.username} Miis`,
                `${targetUser.username} Mii profile`,
                'InfiniMii creator',
                topTags,
                topCategories.map((category) => category.name),
                creatorNames.map((name) => `${name} Mii`),
                featuredNames.map((name) => `${name} Mii`)
            ]).join(', ');
            const pageRobots = totalUploaded > 0 ? undefined : 'noindex, follow, noarchive';
            const breadcrumbs = [
                { name: 'Home', url: '/' },
                { name: 'Creators', url: '/search' },
                { name: targetUser.username, url: `/user/${encodeURIComponent(targetUser.username)}` }
            ];
            const schemaType = 'ProfilePage';
            const listOffset = ((pagination?.currentPage || 1) - 1) * (pagination?.perPage || displayedMiis.length || 0);
            const uploaderSearchUrl = `/searchResults?q=${encodeURIComponent(targetUser.username)}&searchFieldsConfigured=1&searchIn=uploader`;
            const faqEntries = totalUploaded > 0
                ? [
                    {
                        question: `What kind of Miis does ${targetUser.username} upload?`,
                        answer: `${targetUser.username} has published ${totalUploaded} public Miis on InfiniMii.${topTags.length > 0 ? ` Frequent tags include ${topTags.slice(0, 5).join(', ')}.` : ''}${topCategories.length > 0 ? ` Official archive categories include ${topCategories.slice(0, 4).map((category) => category.name).join(', ')}.` : ''}${creatorNames.length > 0 ? ` Creator names found in this archive include ${creatorNames.slice(0, 5).join(', ')}.` : ''}`
                    },
                    {
                        question: `How many Miis has ${targetUser.username} published?`,
                        answer: `${targetUser.username} has ${totalUploaded} public Mii character${totalUploaded === 1 ? '' : 's'} on InfiniMii with ${totalLikes} total likes.${officialCount > 0 ? ` ${officialCount} of those are official archive entries.` : ''}${communityCount > 0 ? ` ${communityCount} are community uploads.` : ''}`
                    },
                    {
                        question: `How do I browse all Miis from ${targetUser.username}?`,
                        answer: `Use this profile page to browse the archive grid, or run an uploader search for ${targetUser.username} to jump directly into search results filtered to this creator.`
                    }
                ]
                : [];
            const schemaGraphs = [];
            if (!pageRobots) {
                schemaGraphs.push({
                    "@context": "https://schema.org",
                    "@type": "Person",
                    "name": targetUser.username,
                    "url": `${baseUrl}/user/${encodeURIComponent(targetUser.username)}`,
                    "image": ogImage,
                    "description": pageDesc,
                    "knowsAbout": normalizeKeywordList([
                        topTags,
                        topCategories.map((category) => category.name),
                        creatorNames
                    ]).slice(0, 20),
                    "interactionStatistic": {
                        "@type": "InteractionCounter",
                        "interactionType": "https://schema.org/LikeAction",
                        "userInteractionCount": totalLikes
                    }
                });
                schemaGraphs.push({
                    "@context": "https://schema.org",
                    "@type": "CollectionPage",
                    "name": `${targetUser.username}'s Mii archive`,
                    "url": canonicalUrl,
                    "description": pageDesc,
                    "about": {
                        "@type": "Person",
                        "name": targetUser.username,
                        "url": `${baseUrl}/user/${encodeURIComponent(targetUser.username)}`
                    },
                    "keywords": keywords
                });
            }
            if (!pageRobots && Array.isArray(displayedMiis) && displayedMiis.length > 0) {
                schemaGraphs.push({
                    "@context": "https://schema.org",
                    "@type": "ItemList",
                    "name": `${targetUser.username}'s Miis`,
                    "numberOfItems": pagination?.total || displayedMiis.length,
                    "itemListElement": displayedMiis
                        .filter((miiItem) => miiItem && miiItem.id)
                        .map((miiItem, index) => ({
                            "@type": "ListItem",
                            "position": listOffset + index + 1,
                            "url": `${baseUrl}/mii/${miiItem.id}`,
                            "name": miiItem?.meta?.name || miiItem?.name || 'Unknown Mii'
                        }))
                });
            }
            if (!pageRobots && faqEntries.length > 0) {
                schemaGraphs.push({
                    "@context": "https://schema.org",
                    "@type": "FAQPage",
                    "mainEntity": faqEntries.map((entry) => ({
                        "@type": "Question",
                        "name": entry.question,
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": entry.answer
                        }
                    }))
                });
            }
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, ogImage, keywords, pageRobots, prevUrl, nextUrl }) %>
        <%- include('structuredData') %>
        <link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="/profile.css">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <div class="content">
            <%- include('sidebar') %>
            <div class="profile-container">
                <%
                    const profileBasePath = '/user/' + encodeURIComponent(targetUser.username);
                    const buildProfilePageUrl = (pageNumber = 1, sortName = selectedProfileSort) => {
                        const params = new URLSearchParams();
                        if (sortName === 'latest') {
                            params.set('sort', 'latest');
                        }
                        if (pageNumber > 1) {
                            params.set('page', String(pageNumber));
                        }
                        const queryString = params.toString();
                        return queryString ? `${profileBasePath}?${queryString}` : profileBasePath;
                    };
                %>
                <!-- Profile Header -->
                <div class="profile-header">
                    <a class="profile-avatar-link" href="/mii/<%= targetUser.miiPfp || '00000' %>" title="View <%= targetUser.username %>'s profile Mii">
                        <img src="/miiImgs/<%= targetUser.miiPfp || '00000' %>.png" alt="<%= targetUser.username %> Mii character profile" class="profile-avatar" onerror="this.src='/miiImgs/00000.png'">
                    </a>
                    <div class="profile-info">
                        <div class="profile-name">
                            <h1><%= targetUser.username %></h1>
                            <%
                                // Role icons rendered inline
                                const roleConfigs = {
                                    'tempBanned': { label: 'Temp Banned', class: 'banned-badge' },
                                    'permBanned': { label: 'Perm Banned', class: 'banned-badge' },
                                    'basic': null,
                                    'supporter': { label: 'Supporter', class: 'supporter-badge' },
                                    'researcher': { label: 'Researcher', class: 'researcher-badge' },
                                    'moderator': { label: 'Moderator', class: 'mod-badge' },
                                    'administrator': { label: 'Administrator', class: 'admin-badge' }
                                };
                            %>
                            <% (targetUser.roles || ['basic']).forEach(role => { %>
                                <% if(roleConfigs[role]) { %>
                                    <span class="role-badge <%= roleConfigs[role].class %>" data-role="<%= role %>">
                                        <%= roleConfigs[role].label %>
                                    </span>
                                <% } %>
                            <% }); %>
                        </div>

                        <div class="profile-stats">
                            <div class="stat-item">
                                <span class="stat-label">Miis Uploaded</span>
                                <span class="stat-value">
                                    <%= totalUploaded %>
                                </span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Total Likes</span>
                                <span class="stat-value">
                                    <%= totalLikes-totalUploaded %>
                                </span>
                            </div>
                            <% if(memberSinceLabel) { %>
                                <!-- div class="stat-item">
                                    <span class="stat-label">Member Since</span>
                                    <span class="stat-value">
                                        <%= memberSinceLabel %>
                                    </span>
                                </div-->
                            <% } %>
                            <% if(latestUploadLabel) { %>
                                <div class="stat-item">
                                    <span class="stat-label">Latest Upload</span>
                                    <span class="stat-value">
                                        <%= latestUploadLabel %>
                                    </span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="profile-discovery" hidden>
                    <section class="profile-panel" aria-labelledby="profile-summary-heading" hidden>
                        <h2 id="profile-summary-heading">About <%= targetUser.username %>'s Mii Archive</h2>
                        <p><%= profileLead %></p>
                        <% if(profileArchiveSummary) { %>
                            <p><%= profileArchiveSummary %></p>
                        <% } %>
                        <% if(themeSummary || categorySummary || featuredSummary) { %>
                            <p><%= `${themeSummary} ${categorySummary} ${featuredSummary}`.replace(/\s+/g, ' ').trim() %></p>
                        <% } %>
                    </section>

                    <section class="profile-panel" aria-labelledby="profile-topics-heading" hidden>
                        <h2 id="profile-topics-heading">Search Topics And Archive Themes</h2>
                        <p>Browse this creator by uploader name, recurring tags, official categories, creator names, and standout character uploads.</p>
                        <div class="profile-chip-list">
                            <a class="profile-chip" href="<%= uploaderSearchUrl %>"><%= targetUser.username %> uploader search</a>
                            <% topTags.forEach((tag) => { %>
                                <a class="profile-chip" href="/searchResults?tags=<%= encodeURIComponent(tag) %>"><%= tag %></a>
                            <% }) %>
                            <% topCategories.forEach((category) => { %>
                                <a class="profile-chip" href="<%= category.url %>"><%= category.name %></a>
                            <% }) %>
                            <% creatorNames.forEach((name) => { %>
                                <a class="profile-chip" href="/searchResults?q=<%= encodeURIComponent(name) %>&searchFieldsConfigured=1&searchIn=name"><%= name %></a>
                            <% }) %>
                            <% featuredNames.forEach((name) => { %>
                                <a class="profile-chip" href="/searchResults?q=<%= encodeURIComponent(name) %>&searchFieldsConfigured=1&searchIn=name"><%= name %></a>
                            <% }) %>
                        </div>
                    </section>

                    <% if(profileFeaturedMiis.length > 0) { %>
                        <section class="profile-panel" aria-labelledby="profile-featured-heading" hidden>
                            <h2 id="profile-featured-heading">Popular Uploads From <%= targetUser.username %></h2>
                            <p>These uploads are currently the strongest search and discovery signals on this profile.</p>
                            <div class="profile-featured-grid">
                                <% profileFeaturedMiis.forEach((featuredMii, featuredIndex) => { %>
                                    <article class="profile-featured-card" style="--favorite-color: <%= decodeColor(featuredMii.general?.favoriteColor) || decodeColor(0) %>;">
                                        <a class="profile-featured-image" href="/mii/<%= featuredMii.id %>">
                                            <img
                                                src="/miiImgs/<%= featuredMii.id %>.png"
                                                alt="<%= featuredMii.meta?.name || featuredMii.name %> Mii character"
                                                width="256"
                                                height="256"
                                                loading="<%= featuredIndex < 4 ? 'eager' : 'lazy' %>"
                                                decoding="async"
                                                fetchpriority="<%= featuredIndex < 2 ? 'high' : (featuredIndex < 4 ? 'auto' : 'low') %>"
                                            >
                                        </a>
                                        <div class="profile-featured-body">
                                            <h3><a href="/mii/<%= featuredMii.id %>"><%= featuredMii.meta?.name || featuredMii.name %></a></h3>
                                            <p><%= featuredMii.desc && featuredMii.desc.length > 92 ? `${featuredMii.desc.slice(0, 89)}...` : (featuredMii.desc || `${featuredMii.meta?.name || featuredMii.name} Mii character`) %></p>
                                        </div>
                                    </article>
                                <% }) %>
                            </div>
                        </section>
                    <% } %>

                    <% if(faqEntries.length > 0) { %>
                        <section class="profile-panel" aria-labelledby="profile-faq-heading" hidden>
                            <h2 id="profile-faq-heading">Questions About This Creator</h2>
                            <div class="profile-faq-list">
                                <% faqEntries.forEach((entry) => { %>
                                    <article class="profile-faq-item">
                                        <h3><%= entry.question %></h3>
                                        <p><%= entry.answer %></p>
                                    </article>
                                <% }) %>
                            </div>
                        </section>
                    <% } %>
                </div>

                <!-- Moderator Tools for Profiles -->
                <% if(isModerator && thisUser !== targetUser.username) { %>
                    <div class="moderator-tools">
                        <div class="mod-tools-header" onclick="toggleModTools()">
                            <h3><%- include('icon', { name: 'settings', size: 18, class: 'icon-inline' }) %> Moderator Tools</h3>
                            <span class="dropdown-arrow" id="modToolsArrow">▼</span>
                        </div>

                        <div class="mod-tools-content" id="modToolsContent">
                            <div class="mod-tool-grid">
                                <!-- Change Role (Admin Only) -->
                                <% if(isAdmin) { %>
                                    <div class="mod-tool-item mod-tool-roles">
                                        <label>User Roles (check multiple):</label>
                                        <div class="role-checkboxes">
                                            <% const userRoles = targetUser.roles || ['basic']; %>
                                                <label class="role-checkbox">
                                                    <input type="checkbox" value="supporter" <%= userRoles.includes('supporter') ? 'checked' : '' %>>
                                                    <%- include('icon', { name: 'heart', size: 14, class: 'icon-inline' }) %> Supporter
                                                </label>
                                                <label class="role-checkbox">
                                                    <input type="checkbox" value="researcher" <%= userRoles.includes('researcher') ? 'checked' : '' %>>
                                                    <%- include('icon', { name: 'flask', size: 14, class: 'icon-inline' }) %> Researcher
                                                </label>
                                                <label class="role-checkbox">
                                                    <input type="checkbox" value="moderator" <%=userRoles.includes('moderator') ? 'checked' : '' %>>
                                                    <%- include('icon', { name: 'shield', size: 14, class: 'icon-inline' }) %> Moderator
                                                </label>
                                                <label class="role-checkbox">
                                                    <input type="checkbox" value="administrator" <%=userRoles.includes('administrator') ? 'checked' : '' %>>
                                                    <%- include('icon', { name: 'crown', size: 14, class: 'icon-inline' }) %> Administrator
                                                </label>
                                        </div>
                                        <button onclick="updateUserRoles()">Update Roles</button>
                                    </div>
                                <% } %>

                                <!-- Temporary Ban -->
                                <div class="mod-tool-item">
                                    <label>Temporary Ban:</label>
                                    <input type="number" id="banHours" placeholder="Hours" min="24">
                                    <input type="text" id="tempBanReason" placeholder="Reason">
                                    <button onclick="tempBanUser()"><%- include('icon', { name: 'timer', size: 14 }) %> Temp Ban</button>
                                </div>

                                <!-- Permanent Ban (Admin Only) -->
                                <% if(isAdmin ) { %>
                                    <div class="mod-tool-item mod-tool-danger">
                                        <label>Permanent Ban (deletes account & all Miis):</label>
                                        <input type="text" id="permBanReason" placeholder="Reason">
                                        <button class="danger-btn" onclick="permBanUser()"><%- include('icon', { name: 'ban', size: 14 }) %>
                                            Permanent Ban</button>
                                    </div>
                                <% } %>

                                <!-- Delete All Miis -->
                                <div class="mod-tool-item mod-tool-danger">
                                    <label>Delete All User's Miis:</label>
                                    <button class="danger-btn"
                                        onclick="deleteAllUserMiis()"><%- include('icon', { name: 'trash', size: 14 }) %> Delete All Miis (
                                        <%= totalUploaded %>)
                                    </button>
                                </div>

                                <!-- Change Username -->
                                <div class="mod-tool-item">
                                    <label>Change Username:</label>
                                    <input type="text" id="newUsername"
                                        value="<%= targetUser.username %>" placeholder="New Username">
                                    <button onclick="changeUsername()"><%- include('icon', { name: 'edit', size: 14 }) %> Change
                                        Username</button>
                                </div>

                                <!-- Change Profile Picture -->
                                <div class="mod-tool-item">
                                    <label>Change Profile Picture (Mii ID):</label>
                                    <input type="text" id="newPfp"
                                        value="<%= targetUser.miiPfp %>" placeholder="Mii ID">
                                    <button onclick="changeUserPfp()"><%- include('icon', { name: 'image', size: 14 }) %> Change
                                        PFP</button>
                                </div>

                            </div>
                        </div>
                    </div>
                <% } %>

                <!-- Profile Content -->
                <div class="profile-content">
                    <h2 class="profile-section-title">
                        <form class="profile-sort-form" method="GET" action="<%= profileBasePath %>">
                            <label class="sr-only" for="profile-sort-select">Sort uploads</label>
                            <select
                                id="profile-sort-select"
                                class="profile-sort-select"
                                name="sort"
                                aria-label="Sort uploads"
                                onchange="if (this.form) { if (this.form.requestSubmit) { this.form.requestSubmit(); } else { this.form.submit(); } }"
                            >
                                <option value="latest" <%= selectedProfileSort === 'latest' ? 'selected' : '' %>>Latest</option>
                                <option value="popular" <%= selectedProfileSort === 'popular' ? 'selected' : '' %>>Popular</option>
                            </select>
                        </form>
                        Uploads From <%= targetUser.username %>
                    </h2>
                    <% if(totalUploaded > 0) { %>
                        <p class="profile-section-copy" hidden>
                            <% if (selectedProfileSort === 'popular') { %>
                                This grid lists the public Miis on <%= targetUser.username %>'s profile by like count, with newer uploads breaking ties.
                            <% } else { %>
                                This grid lists the public Miis on <%= targetUser.username %>'s profile in reverse chronological order, with older uploads available through pagination.
                            <% } %>
                        </p>
                    <% } %>

                    <% if(displayedMiis.length> 0) { %>
                        <div id="browse-miis">
                            <% for(var i=0; i<displayedMiis.length; i++){ %>
                                <%
                                    const profileMii = displayedMiis[i];
                                    const profileMiiAttribution = getMiiAttribution(profileMii);
                                    const shouldEagerLoadImage = i < 6;
                                    const shouldPrioritizeImage = i < 3;
                                %>
                                <div class="mii-card" id="<%= displayedMiis[i].id %>" style="--favorite-color: <%= decodeColor(displayedMiis[i].general?.favoriteColor) || decodeColor(0) %>;">
                                    <a href="<%= '/mii/'+displayedMiis[i].id %>">
                                        <img
                                            src="/miiImgs/<%= displayedMiis[i].id %>.png"
                                            alt="<%= displayedMiis[i].meta?.name || displayedMiis[i].name %> Mii: <%= displayedMiis[i]?.description %>"
                                            width="256"
                                            height="256"
                                            loading="<%= shouldEagerLoadImage ? 'eager' : 'lazy' %>"
                                            decoding="async"
                                            fetchpriority="<%= shouldPrioritizeImage ? 'high' : (shouldEagerLoadImage ? 'auto' : 'low') %>"
                                        >
                                    </a>
                                    <div class="flex">
                                        <div>
                                            <h3>
                                                <%= displayedMiis[i].meta?.name || displayedMiis[i].name %>
                                            </h3>
                                            <p class="mii-card-byline">
                                                <span><%= profileMiiAttribution.prefix %></span>
                                                <% if (profileMiiAttribution.url) { %>
                                                    <a href="<%= profileMiiAttribution.url %>"><%= profileMiiAttribution.label %></a>
                                                <% } else { %>
                                                    <span><%= profileMiiAttribution.label %></span>
                                                <% } %>
                                            </p>
                                        </div>
                                        <%- include('miiCardLikeButton', { mii: profileMii, user }) %>
                                    </div>
                                    <p>
                                        <%= displayedMiis[i].desc && displayedMiis[i].desc.length> 75 ? displayedMiis[i].desc.slice(0,73) + "..." : displayedMiis[i].desc %>
                                    </p>
                                </div>
                            <% } %>
                        </div>

                        <% if (pagination && pagination.totalPages > 1) { %>
                            <div class="pagination">
                                <% if (pagination.currentPage > 1) { %>
                                    <a href="<%= buildProfilePageUrl(pagination.currentPage - 1) %>" class="pagination-btn">&larr; Previous</a>
                                <% } %>

                                <span class="pagination-info" data-current-page="<%= pagination.currentPage %>" data-total-pages="<%= pagination.totalPages %>">
                                    Page
                                    <button type="button" class="pagination-current-page" aria-label="Jump to page">
                                        <%= pagination.currentPage %>
                                    </button>
                                    <input
                                        type="number"
                                        class="pagination-page-input"
                                        min="1"
                                        max="<%= pagination.totalPages %>"
                                        value="<%= pagination.currentPage %>"
                                        inputmode="numeric"
                                        aria-label="Type page number"
                                    >
                                    of <%= pagination.totalPages %>
                                    (<%= pagination.total %> Miis)
                                </span>

                                <% if (pagination.currentPage < pagination.totalPages) { %>
                                    <a href="<%= buildProfilePageUrl(pagination.currentPage + 1) %>" class="pagination-btn">Next &rarr;</a>
                                <% } %>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="empty-state">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 96 960 960">
                                <path d="M480 976q-33 0-56.5-23.5T400 896q0-33 23.5-56.5T480 816q33 0 56.5 23.5T560 896q0 33-23.5 56.5T480 976Zm0-240q-33 0-56.5-23.5T400 656V256q0-33 23.5-56.5T480 176q33 0 56.5 23.5T560 256v400q0 33-23.5 56.5T480 736Z" />
                            </svg>
                            <h3>No Published Miis Yet</h3>
                            <p>This user hasn't uploaded any Miis.</p>
                        </div>
                    <% } %>
                </div>
            </div>
            <%- include('featuredMiis') %>
        </div>
        <%- include('footer') %>

        <% if(isModerator) { %>
            <script id="target-user-roles" type="application/json"><%- toScriptJson(targetUser.roles || ['basic']) %></script>
            <script>
                const targetUsername = <%- toScriptJson(targetUser.username) %>;

                function toggleModTools() {
                    const content = document.getElementById('modToolsContent');
                    const arrow = document.getElementById('modToolsArrow');

                    content.classList.toggle('expanded');
                    arrow.classList.toggle('rotated');
                }

                async function updateUserRoles() {
                    const checkboxes = document.querySelectorAll('.role-checkboxes input[type="checkbox"]');
                    const selectedRoles = Array.from(checkboxes)
                        .filter(cb => cb.checked)
                        .map(cb => cb.value);

                    // Always include basic role if no roles selected
                    if (selectedRoles.length === 0) {
                        selectedRoles.push('basic');
                    }

                    showConfirm(`Update ${targetUsername}'s roles to:\n${selectedRoles.join(', ')}\n\nAre you sure?`, async () => {
                        try {
                            // Remove all current non-basic roles
                            const currentRoles = JSON.parse(document.getElementById('target-user-roles').textContent || '[]');
                            // TODO: make sure this works - I think user should be the user being looked at... not the current user

                            // Calculate roles to remove
                            const rolesToRemove = currentRoles.filter(r => r !== 'basic' && !selectedRoles.includes(r));

                            // Calculate roles to add
                            const rolesToAdd = selectedRoles.filter(r => !currentRoles.includes(r));

                            // Remove old roles
                        for (const role of rolesToRemove) {
                            const response = await fetch('/removeUserRole', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ 
                                    username: targetUsername, 
                                    role
                                })
                            });
                            const result = await response.json();
                            if (result.error) {
                                showAlert(`Error removing role ${role}: ${result.error}`, 5000, { title: 'Error', type: 'error' });
                                return;
                            }
                        }

                        // Add new roles
                        for (const role of rolesToAdd) {
                            const response = await fetch('/addUserRole', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ username: targetUsername, role })
                            });
                            const result = await response.json();
                            if (result.error) {
                                showAlert(`Error adding role ${role}: ${result.error}`, 5000, { title: 'Error', type: 'error' });
                                return;
                            }
                        }

                        showAlert('Roles updated successfully!', 3000, { title: 'Success', type: 'success' });
                        setTimeout(() => location.reload(), 3000);
                    } catch (error) {
                        console.error('Error:', error);
                        showAlert('Failed to update roles', 5000, { title: 'Error', type: 'error' });
                    }
                    }, null, { title: 'Update Roles', confirmText: 'Update' });
                }

                async function tempBanUser() {
                    const hours = parseInt(document.getElementById('banHours').value);
                    const reason = document.getElementById('tempBanReason').value;

                    if (!hours || hours < 1) {
                        showAlert('Please enter a valid number of hours', 5000, { title: 'Error', type: 'error' });
                        return;
                    }

                    showConfirm(`Are you sure you want to temporarily ban ${targetUsername} for ${hours} hours?\n\nReason: ${reason || 'No reason provided'}`, async () => {
                        try {
                            const response = await fetch('/tempBanUser', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ username: targetUsername, hours, reason })
                            });

                            const result = await response.json();

                            if (!result.error) {
                                showAlert(`User temporarily banned for ${hours} hours`, 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            }
                            else {
                                showAlert(`Error: ${result.error}`, 5000, { title: 'Error', type: 'error' });
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            showAlert('Failed to ban user', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Temporary Ban', confirmText: 'Ban User' });
                }

                async function permBanUser() {
                    const reason = document.getElementById('permBanReason').value;

                    showConfirm(`WARNING\n\nAre you ABSOLUTELY SURE you want to PERMANENTLY BAN ${targetUsername}?\n\nThis will:\n- Delete their account\n- Delete ALL their Miis (${'<%= totalUploaded %>'})\n- Ban their IP address from creating new accounts\n\nThis action CANNOT be undone!\n\nReason: ${reason || 'No reason provided'}`, () => {
                        const doubleCheck = prompt(`Type "PERMANENT BAN" to confirm:`);
                        if (doubleCheck !== 'PERMANENT BAN') {
                            showAlert('Permanent ban cancelled.', 3000, { title: 'Cancelled' });
                            return;
                        }

                        (async () => {
                            try {
                                const response = await fetch('/permBanUser', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ username: targetUsername, reason })
                                });

                                const result = await response.json();

                                if (!result.error) {
                                    showAlert('User permanently banned and deleted', 2000, { title: 'Success', type: 'success' });
                                    setTimeout(() => window.location.href = '/', 2000);
                                }
                                else {
                                    showAlert(`Error: ${result.error}`, 5000, { title: 'Error', type: 'error' });
                                }
                            } catch (error) {
                                console.error('Error:', error);
                                showAlert('Failed to permanently ban user', 5000, { title: 'Error', type: 'error' });
                            }
                        })();
                    }, null, { title: '⚠️ PERMANENT BAN', confirmText: 'Continue' });
                }

                async function deleteAllUserMiis() {
                    showConfirm(`Are you sure you want to delete ALL ${'<%= totalUploaded %>'} Miis from ${targetUsername}?\n\nThis action CANNOT be undone!`, () => {
                        const doubleCheck = prompt(`Type "DELETE ALL" to confirm:`);
                        if (doubleCheck !== 'DELETE ALL') {
                            showAlert('Deletion cancelled.', 3000, { title: 'Cancelled' });
                            return;
                        }

                        (async () => {
                            try {
                                const response = await fetch('/deleteAllUserMiis', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ username: targetUsername })
                                });

                                const result = await response.json();

                                if (!result.error) {
                                    showAlert(`Deleted ${result.deletedCount} Miis`, 3000, { title: 'Success', type: 'success' });
                                    setTimeout(() => location.reload(), 3000);
                                }
                                else {
                                    showAlert(`Error: ${result.error}`, 5000, { title: 'Error', type: 'error' });
                                }
                            } catch (error) {
                                console.error('Error:', error);
                                showAlert('Failed to delete Miis', 5000, { title: 'Error', type: 'error' });
                            }
                        })();
                    }, null, { title: 'Delete All Miis', confirmText: 'Continue' });
                }

                async function changeUsername() {
                    const newUsername = document.getElementById('newUsername').value;

                    if (!newUsername || newUsername === targetUsername) {
                        showAlert('Please enter a new username', 5000, { title: 'Error', type: 'error' });
                        return;
                    }

                    showConfirm(`Are you sure you want to change username from "${targetUsername}" to "${newUsername}"?`, async () => {
                        try {
                            const response = await fetch('/changeUsername', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ oldUsername: targetUsername, newUsername })
                            });

                            const result = await response.json();

                            if (!result.error) {
                                showAlert('Username changed successfully!', 2000, { title: 'Success', type: 'success' });
                                setTimeout(() => window.location.href = `/user/${encodeURIComponent(newUsername)}`, 2000);
                            }
                            else {
                                showAlert(`Error: ${result.error}`, 5000, { title: 'Error', type: 'error' });
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            showAlert('Failed to change username', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Change Username', confirmText: 'Change' });
                }

                async function changeUserPfp() {
                    const newPfp = document.getElementById('newPfp').value;

                    if (!newPfp) {
                        showAlert('Please enter a Mii ID', 5000, { title: 'Error', type: 'error' });
                        return;
                    }

                    showConfirm(`Are you sure you want to change ${targetUsername}'s profile picture to Mii ID: ${newPfp}?`, async () => {
                        try {
                            const response = await fetch('/changeUserPfp', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ username: targetUsername, miiId: newPfp })
                            });

                            const result = await response.json();

                            if (!result.error) {
                                showAlert('Profile picture changed successfully!', 3000, { title: 'Success', type: 'success' });
                                setTimeout(() => location.reload(), 3000);
                            }
                            else {
                                showAlert(`Error: ${result.error}`, 5000, { title: 'Error', type: 'error' });
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            showAlert('Failed to change profile picture', 5000, { title: 'Error', type: 'error' });
                        }
                    }, null, { title: 'Change Profile Picture', confirmText: 'Change' });
                }
            </script>
        <% } %>
    </body>
</html>
