<!DOCTYPE html>
<html lang="en">
    <head>
        <%
        const pageTitle = 'Amiibo Mii Tools - InfiniMii';
        const pageDesc = 'Extract a Mii from an Amiibo dump or insert a Mii into an Amiibo backup with InfiniMii\'s browser-based Amiibo tools.';
        const canonicalUrl = `${baseUrl}/amiibo`;
        const keywords = 'amiibo mii tool, extract mii from amiibo, insert mii into amiibo, amiibo backup';
        const breadcrumbs = [
            { name: 'Home', url: '/' },
            { name: 'Amiibo Tools', url: '/amiibo' }
        ];
        const schemaGraphs = [{
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "InfiniMii Amiibo Tools",
            "applicationCategory": "UtilitiesApplication",
            "operatingSystem": "Web Browser",
            "url": `${baseUrl}/amiibo`,
            "description": pageDesc,
            "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "USD"
            }
        }];
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, keywords }) %>
        <%- include('structuredData') %>
        <link rel='stylesheet' href="/global.css">
        <link rel="stylesheet" href="/utilityPages.css">
        <style>
            .amiibo-tools {
                display: flex;
                flex-direction: column;
                gap: 2rem;
                max-width: 800px;
                margin: 0 auto;
            }
            
            .tool-section {
                background-color: var(--layer-2-um);
                padding: 2rem;
                border-radius: 10px;
            }
            
            .tool-section h3 {
                color: var(--brand-color);
                margin-top: 0;
                margin-bottom: 1.5rem;
                font-size: 24px;
            }
            
            .upload-area {
                border: 2px dashed var(--layer-3-um);
                border-radius: 8px;
                padding: 2rem;
                text-align: center;
                margin-bottom: 1rem;
                background-color: var(--layer-1-um);
                transition: all 0.3s ease;
            }
            
            .upload-area:hover {
                border-color: var(--brand-color);
                background-color: rgba(255, 255, 255, 0.05);
            }
            
            .upload-area.dragover {
                border-color: var(--brand-color);
                background-color: rgba(37, 211, 102, 0.1);
            }
            
            .extracted-mii {
                display: none;
                margin-top: 1.5rem;
                padding: 1.5rem;
                background-color: var(--layer-1-um);
                border-radius: 8px;
            }
            
            .extracted-mii.active {
                display: block;
            }
            
            .mii-preview {
                display: flex;
                gap: 1.5rem;
                align-items: center;
                margin-bottom: 1rem;
            }
            
            .mii-preview img {
                width: 120px;
                height: 120px;
                border-radius: 8px;
                background-color: var(--layer-3-um);
            }
            
            .mii-info {
                flex: 1;
            }
            
            .mii-info h4 {
                margin: 0 0 0.5rem 0;
                font-size: 20px;
                color: var(--brand-color);
            }
            
            .mii-info p {
                margin: 0.25rem 0;
                color: var(--text-2);
            }
            
            .action-buttons {
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
            }
            
            .btn {
                display: inline-block;
                padding: 0.75rem 1.5rem;
                border: none;
                border-radius: 6px;
                font-family: Poppins, sans-serif;
                font-size: 16px;
                font-weight: 500;
                cursor: pointer;
                transition: all 0.3s ease;
                text-decoration: none;
            }
            
            .btn-primary {
                background-color: var(--brand-color);
                color: white;
            }
            
            .btn-primary:hover {
                opacity: 0.9;
                transform: translateY(-1px);
            }
            
            .btn-secondary {
                background-color: var(--layer-3-um);
                color: var(--text-1);
            }
            
            .btn-secondary:hover {
                background-color: var(--layer-4);
            }
            
            .insert-options {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                margin-top: 1rem;
            }
            
            .radio-group {
                display: flex;
                gap: 2rem;
                margin: 1rem 0;
            }
            
            .radio-option {
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }
            
            .radio-option input[type="radio"] {
                width: auto;
                margin: 0;
            }
            
            .error-message {
                color: #ff4444;
                background-color: rgba(255, 68, 68, 0.1);
                padding: 1rem;
                border-radius: 6px;
                margin-top: 1rem;
                display: none;
            }
            
            .error-message.active {
                display: block;
            }
            
            .success-message {
                color: var(--brand-color);
                background-color: rgba(37, 211, 102, 0.1);
                padding: 1rem;
                border-radius: 6px;
                margin-top: 1rem;
                display: none;
            }
            
            .success-message.active {
                display: block;
            }
            .export-form {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .export-form input[type="text"] {
                flex: 1;
                min-width: 180px;
                width: auto;
            }
        </style>
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <div class='content'>
            <%- include('sidebar') %>
            <div class='amiibo-tools'>
                <section class="tool-section" aria-labelledby="amiibo-heading">
                    <h1 id="amiibo-heading">Amiibo Mii Tools</h1>
                    <p>Work with Amiibo backups that store Mii owner data. Extract a Mii for export or upload, or insert a new Mii into the dump.</p>
                </section>
                <!-- Extract Mii from Amiibo -->
                <div class="tool-section">
                    <h3><%- include('icon', { name: 'upload', size: 20, class: 'icon-inline' }) %> Extract Mii from Amiibo</h3>
                    <p style="color: var(--text-2); margin-bottom: 1.5rem;">
                        Upload an Amiibo dump (.bin file) to extract the Mii character stored on it.
                    </p>
                    
                    <form id="extractForm" enctype="multipart/form-data">
                        <div class="upload-area" id="extractDropZone">
                            <p style="margin: 0 0 1rem 0;"><%- include('icon', { name: 'file-up', size: 16, class: 'icon-inline' }) %> Drag & drop your Amiibo dump here, or click to browse</p>
                            <input type="file" name="amiibo" id="extractFile"  style="display: none;" onchange="document.getElementById('extrAction').click()">
                            <button type="button" class="btn btn-secondary" onclick="document.getElementById('extractFile').click()">
                                Choose File
                            </button>
                        </div>
                        <button type="submit" class="btn btn-primary" id="extrAction" hidden="true">Extract Mii</button>
                    </form>
                    
                    <div id="extractedMii" class="extracted-mii">
                        <h4>Extracted Mii</h4>
                        <div class="mii-preview">
                            <img id="extractedMiiImage" alt="Extracted Mii preview" width="128" height="128" loading="eager" decoding="async">
                            <div class="mii-info">
                                <h4 id="extractedMiiName">Mii Name</h4>
                                <p id="extractedMiiCreator">Creator: Unknown</p>
                            </div>
                        </div>
                        <div class="action-buttons">
                            <a class="btn btn-primary" href="/upload">Upload to InfiniMii</a>
                            <form id="extractedExportForm" class="export-form" method="GET" action="/exportMii">
                                <input type="hidden" name="id" id="extractedMiiId">
                                <input type="text" name="format" list="exportFormatOptions" placeholder="Search formats..." required>
                                <label style="display: inline-flex; align-items: center; gap: 6px;">
                                    <input type="checkbox" name="special">
                                    Special
                                </label>
                                <label style="display: inline-flex; align-items: center; gap: 6px;">
                                    QR:
                                    <select name="qrConsole">
                                        <option value="3DS">3DS</option>
                                        <option value="WIIU">Wii U</option>
                                    </select>
                                </label>
                                <button type="submit" class="btn btn-secondary">Download</button>
                                <button type="button" class="btn btn-secondary" onclick="copyExportHexFromForm(document.getElementById('extractedExportForm'))">Copy Hex</button>
                                <button type="button" class="btn btn-secondary" onclick="copyExportBase64FromForm(document.getElementById('extractedExportForm'))">Copy Base64</button>
                            </form>
                            <button type="button" class="btn btn-secondary" id="extractedInstructionsBtn" onclick="openExtractedInstructions()">Recreation Instructions</button>
                        </div>
                        <datalist id="exportFormatOptions">
                            <% exportFormats.forEach(fmt => { %>
                                <option value="<%= fmt.value %>" label="<%= fmt.label %>"></option>
                            <% }) %>
                        </datalist>
                    </div>
                    
                    <div id="extractError" class="error-message"></div>
                </div>
                
                <!-- Insert Mii into Amiibo -->
                <div class="tool-section">
                    <h3><%- include('icon', { name: 'download', size: 20, class: 'icon-inline' }) %> Insert Mii into Amiibo</h3>
                    <p style="color: var(--text-2); margin-bottom: 1.5rem;">
                        Upload an Amiibo dump and choose a Mii to insert into it.
                    </p>
                    
                    <form id="insertForm" enctype="multipart/form-data">
                        <div class="upload-area" id="insertDropZone">
                            <p style="margin: 0 0 1rem 0;"><%- include('icon', { name: 'file-up', size: 16, class: 'icon-inline' }) %> Upload Amiibo dump (.bin file)</p>
                            <input type="file" name="amiibo" id="insertAmiiboFile"  style="display: none;">
                            <button type="button" class="btn btn-secondary" onclick="document.getElementById('insertAmiiboFile').click()">
                                Choose Amiibo File
                            </button>
                            <p id="insertAmiiboName" style="margin-top: 0.5rem; color: var(--text-2);"></p>
                        </div>
                        
                        <div class="insert-options">
                            <h4>Mii Source (Auto-Detected)</h4>
                            <p style="color: var(--text-2); font-size: 0.95em; margin-top: 0;">
                                Fill any one source below. No source type selection is required.
                            </p>

                            <div id="fileUploadSection">
                                <label for="insertMiiFile">Upload Mii file (optional):</label>
                                <input type="file" name="mii" id="insertMiiFile">
                            </div>

                            <div id="miiIdSection">
                                <label for="insertMiiId">Use Mii ID (optional):</label>
                                <input type="text" id="insertMiiId" name="miiId" placeholder="Enter Mii ID from InfiniMii">
                            </div>

                            <div id="rawDataSection">
                                <label for="insertRawMiiData">Paste raw Mii data (base64 or hex):</label>
                                <textarea id="insertRawMiiData" name="miiData" rows="4" placeholder="Paste base64 or hex (spaces are ignored for hex)"></textarea>
                            </div>
                        </div>
                        
                        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 12px;">
                            <button type="submit" class="btn btn-primary">Insert Mii & Download</button>
                            <button type="button" class="btn btn-secondary" onclick="copyExportHexFromForm(document.getElementById('insertForm'), { url: '/insertMiiIntoAmiibo', method: 'POST' })">Copy Hex</button>
                            <button type="button" class="btn btn-secondary" onclick="copyExportBase64FromForm(document.getElementById('insertForm'), { url: '/insertMiiIntoAmiibo', method: 'POST' })">Copy Base64</button>
                            <button type="button" class="btn btn-secondary" id="insertInstructionsBtn" onclick="openInsertInstructions()">Recreation Instructions</button>
                        </div>
                    </form>
                    
                    <div id="insertError" class="error-message"></div>
                    <div id="insertSuccess" class="success-message"></div>
                </div>
            </div>
            <%- include('featuredMiis') %>
        </div>
        <%- include('footer') %>
        
        <script>
            let extractedMiiData = null;

            function showAmiiboError(elementId, message) {
                const errorElement = document.getElementById(elementId);
                if (!errorElement) return;
                errorElement.textContent = message;
                errorElement.classList.add('active');
                if (typeof window.scrollToUserError === 'function') {
                    window.scrollToUserError(errorElement);
                }
            }

            function openExtractedInstructions() {
                const extractedId = document.getElementById('extractedMiiId')?.value?.trim() || '';
                if (!extractedId) {
                    showAmiiboError('extractError', 'Extract a Mii first before requesting instructions.');
                    return;
                }

                const extractedName = document.getElementById('extractedMiiName')?.textContent?.trim() || 'Mii';
                showMiiInstructionsModal(async ({ consoleType }) => {
                    const response = await fetch(`/getInstructions?id=${encodeURIComponent(extractedId)}&console=${encodeURIComponent(consoleType)}`, {
                        headers: { "Content-Type": "application/json" }
                    });
                    return await response.json();
                }, {
                    title: 'Recreation Instructions',
                    defaultConsole: '3DS',
                    miiName: extractedName
                });
            }

            function openInsertInstructions() {
                const miiFile = document.getElementById('insertMiiFile')?.files?.[0] || null;
                const miiId = document.getElementById('insertMiiId')?.value?.trim() || '';
                const rawMiiData = document.getElementById('insertRawMiiData')?.value?.trim() || '';

                if (!miiFile && !miiId && !rawMiiData) {
                    showAmiiboError('insertError', 'Provide a Mii source first (file, Mii ID, or raw data).');
                    return;
                }

                showMiiInstructionsModal(async ({ consoleType }) => {
                    const requestData = new FormData();
                    if (miiFile) requestData.append('mii', miiFile);
                    if (miiId) requestData.append('miiId', miiId);
                    if (rawMiiData) requestData.append('miiData', rawMiiData);
                    requestData.append('console', consoleType);

                    const response = await fetch('/getInstructions', {
                        method: 'POST',
                        body: requestData
                    });
                    return await response.json();
                }, {
                    title: 'Recreation Instructions',
                    defaultConsole: '3DS'
                });
            }
            
            // Extract form handling
            document.getElementById('extractForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(e.target);
                
                try {
                    const response = await fetch('/extractMiiFromAmiibo', {
                        method: 'POST',
                        //headers: { "Content-Type": "application/json" }, qk Claude
                        body: formData
                    });
                    
                    const result = await response.json();
                    
                    if (result.mii) {
                        extractedMiiData = result.mii;
                        document.getElementById('extractedMiiImage').src = '/miiImgs/' + result.mii.id + '.png';
                        document.getElementById('extractedMiiName').textContent = result.mii.meta.name;
                        document.getElementById('extractedMiiCreator').textContent = 'Creator: ' + result.mii.meta.creatorName;
                        document.getElementById('extractedMiiId').value = result.mii.id;
                        const formatInput = document.querySelector('#extractedExportForm input[name="format"]');
                        if (formatInput) formatInput.value = 'qr';
                        document.getElementById('extractedMii').classList.add('active');
                        document.getElementById('extractError').classList.remove('active');
                    } else {
                        showAmiiboError('extractError', result.error || 'Failed to extract Mii');
                        document.getElementById('extractedMii').classList.remove('active');
                    }
                } catch (error) {
                    showAmiiboError('extractError', 'Error: ' + error.message);
                }
            });
            
            // Insert form handling
            document.getElementById('insertForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(e.target);
                
                try {
                    const response = await fetch('/insertMiiIntoAmiibo', {
                        method: 'POST',
                        //headers: { "Content-Type": "application/json" }, qk Claude
                        body: formData
                    });
                    
                    if (response.ok) {
                        const blob = await response.blob();
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = 'amiibo_modified.bin';
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        document.body.removeChild(a);

                        document.getElementById('insertSuccess').textContent = 'Amiibo modified successfully! Download started.';
                        document.getElementById('insertSuccess').classList.add('active');
                        document.getElementById('insertError').classList.remove('active');
                    } else {
                        const result = await response.json();
                        showAmiiboError('insertError', result.error || 'Failed to insert Mii');
                        document.getElementById('insertSuccess').classList.remove('active');
                    }
                } catch (error) {
                    showAmiiboError('insertError', 'Error: ' + error.message);
                }
            });
            
            // File name display
            document.getElementById('insertAmiiboFile').addEventListener('change', (e) => {
                if (e.target.files[0]) {
                    document.getElementById('insertAmiiboName').textContent = 'Selected: ' + e.target.files[0].name;
                }
            });
            
            // Drag and drop for extract
            const extractZone = document.getElementById('extractDropZone');
            extractZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                extractZone.classList.add('dragover');
            });
            extractZone.addEventListener('dragleave', () => {
                extractZone.classList.remove('dragover');
            });
            extractZone.addEventListener('drop', (e) => {
                e.preventDefault();
                extractZone.classList.remove('dragover');
                document.getElementById('extractFile').files = e.dataTransfer.files;
            });
            
            // Drag and drop for insert
            const insertZone = document.getElementById('insertDropZone');
            insertZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                insertZone.classList.add('dragover');
            });
            insertZone.addEventListener('dragleave', () => {
                insertZone.classList.remove('dragover');
            });
            insertZone.addEventListener('drop', (e) => {
                e.preventDefault();
                insertZone.classList.remove('dragover');
                document.getElementById('insertAmiiboFile').files = e.dataTransfer.files;
                if (e.dataTransfer.files[0]) {
                    document.getElementById('insertAmiiboName').textContent = 'Selected: ' + e.dataTransfer.files[0].name;
                }
            });
            
        </script>
    </body>
</html>
