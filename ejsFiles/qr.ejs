<!DOCTYPE html>
<html lang="en">
    <head>
        <%
        const pageTitle = 'Scan Mii QR Codes - InfiniMii';
        const qrScannerExportFormats = Array.isArray(exportFormats) ? exportFormats : [];
        const qrScannerExportValues = qrScannerExportFormats
            .map((format) => String(format?.value || '').trim().toLowerCase())
            .filter(Boolean);
        const qrScannerLegacyExportsEnabled = qrScannerExportValues.some((value) => value !== 'ltd');
        const qrScannerQrExportsEnabled = qrScannerExportValues.includes('qr');
        const defaultQrScannerExportFormat = qrScannerExportValues[0] || '';
        const pageDesc = 'Use your camera to scan a Mii QR code, then export the decoded data or upload the Mii through InfiniMii.';
        const canonicalUrl = `${baseUrl}/qr`;
        const keywords = 'scan mii qr code, mii qr scanner, 3ds qr code, wii u qr code';
        const breadcrumbs = [
            { name: 'Home', url: '/' },
            { name: 'QR Scanner', url: '/qr' }
        ];
        const schemaGraphs = [{
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "InfiniMii QR Scanner",
            "applicationCategory": "UtilitiesApplication",
            "operatingSystem": "Web Browser",
            "url": `${baseUrl}/qr`,
            "description": pageDesc,
            "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "USD"
            }
        }];
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, keywords }) %>
        <%- include('structuredData') %>
        <link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="/utilityPages.css">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <main class="content" role="main">
            <%- include('sidebar') %>
            <section class="qr-page" aria-labelledby="qr-heading">
                <section class="utility-container qr-intro-card" aria-labelledby="qr-heading">
                    <h1 id="qr-heading">Scan a Mii QR Code</h1>
                    <p>Point your camera at a compatible Mii QR code to decode it, then export it as LTD or upload it to InfiniMii.</p>
                </section><br>

                <form method="POST" enctype="multipart/form-data" action="/exportMii" class="convert qr-panel" hidden>
                    <fieldset>
                        <legend>Convert</legend>
                        <div id="convert-error-message" class="form-message" style="display: none;"></div>
                        <input type="hidden" name="miiData" class="convert-miidata">
                        <label for="qr-output-format">Export format:</label>
                        <input type="text" id="qr-output-format" name="format" list="exportFormatOptions" value="<%= defaultQrScannerExportFormat %>" placeholder="Choose an export format..." required<%- qrScannerLegacyExportsEnabled ? '' : ' readonly aria-readonly="true"' %>>
                        <datalist id="exportFormatOptions">
                            <% qrScannerExportFormats.forEach(fmt => { %>
                                <option value="<%= fmt.value %>" label="<%= fmt.label %>"></option>
                            <% }) %>
                        </datalist>
                        <% if (qrScannerLegacyExportsEnabled || qrScannerQrExportsEnabled) { %>
                            <div class="qr-inline-options">
                                <% if (qrScannerLegacyExportsEnabled) { %>
                                    <label class="qr-inline-option">
                                        <input type="checkbox" name="special">
                                        <span>Download as Special Mii</span>
                                    </label>
                                <% } %>
                                <% if (qrScannerQrExportsEnabled) { %>
                                    <label class="qr-inline-option qr-inline-select" for="qr-export-console">
                                        <span>QR Console:</span>
                                        <select id="qr-export-console" name="qrConsole">
                                            <option value="3DS">3DS</option>
                                            <option value="WIIU">Wii U</option>
                                        </select>
                                    </label>
                                <% } %>
                            </div>
                        <% } %>
                        <div class="qr-button-row">
                            <input type="submit" value="Export">
                            <button type="button" id="qrCopyHexBtn">Copy Hex</button>
                            <button type="button" id="qrCopyBase64Btn">Copy Base64</button>
                            <button type="button" id="qrInstructionsBtn">Recreation Instructions</button>
                        </div>
                        <h6><%= qrScannerLegacyExportsEnabled ? 'Some details may change when converting to an older Mii format.' : 'Living the Dream Miis keep their original LTD download.' %></h6>
                    </fieldset>
                </form>

                <form action="/uploadMii" method="post" enctype="multipart/form-data" class="upload qr-panel" hidden>
                    <fieldset>
                        <legend>Upload a Mii to the Website</legend>
                        <div id="upload-error-message" class="form-message" style="display: none;"></div>
                        <input type="hidden" name="miiData" class="upload-miidata">
                        <label for="qr-upload-desc">Description (max <%= miiDescriptionMaxLength %> characters)</label>
                        <input id="qr-upload-desc" size="50" placeholder="Description..." name="desc" type="text" maxlength="<%= miiDescriptionMaxLength %>" required aria-required="true">
                        <input type="submit" value="Upload">
                    </fieldset>
                </form>

                <section class="qr qr-panel" aria-label="QR scanner">
                    <div class="qr-button-row qr-primary-actions">
                        <input type="button" value="Start Scanning" onclick="start(this)">
                    </div>

                    <div class="after qr-button-row" hidden>
                        <input type="button" value="Upload Mii" onclick="after('upload')">
                        <input type="button" value="Open Dashboard" onclick="after('convert')">
                        <input type="button" value="Scan Again" onclick="start()">
                    </div>

                    <div id="loadingMessage"><%- include('icon', { name: 'camera', size: 18, class: 'icon-inline' }) %> Select Start Scanning to use the camera</div>
                    <canvas id="canvas" hidden></canvas>
                    <div id="output" hidden>
                        <div id="outputMessage">No QR code detected.</div>
                    </div>
                </section>
            </section>
            <%- include('featuredMiis') %>
        </main>
        <%- include('footer') %>
        <script src="./easy.qrcode.js" type="text/javascript" charset="utf-8"></script>
        <script src="./jsQR.js"></script>
        <script>
            var stored;
            var going = false;
            var video = document.createElement("video");
            var canvasElement = document.getElementById("canvas");
            var canvas = canvasElement.getContext("2d", { willReadFrequently: true });
            var loadingMessage = document.getElementById("loadingMessage");
            var outputContainer = document.getElementById("output");
            var outputMessage = document.getElementById("outputMessage");
            let camStream;
            let convertFormBound = false;
            let uploadFormBound = false;
            
            function drawLine(begin, end, color) {
                canvas.beginPath();
                canvas.moveTo(begin.x, begin.y);
                canvas.lineTo(end.x, end.y);
                canvas.lineWidth = 4;
                canvas.strokeStyle = color;
                canvas.stroke();
            }

            function start(el) {
                if (el) {
                    el.hidden = true;
                }
                going = true;
                document.querySelector(".after").hidden = true;
                loadingMessage.hidden = false;
                canvasElement.hidden = true;
                outputContainer.hidden = true;
                
                navigator.mediaDevices.getUserMedia({ 
                    audio: false, 
                    video: { facingMode: "environment" } 
                }).then(function (stream) {
                    camStream = stream;
                    video.srcObject = stream;
                    video.setAttribute("playsinline", true);
                    video.play();
                    requestAnimationFrame(tick);
                }).catch(function(err) {
                    loadingMessage.innerText = "Camera access denied or not available";
                    console.error(err);
                });
            }
            
            function stop(bin) {
                console.log("QR Code scanned, binary data length:", bin.length);
                if (camStream) {
                    camStream.getTracks().forEach((track) => track.stop());
                }
                document.querySelector(".after").hidden = false;
                stored = bin;
                video.pause();
                going = false;
                outputMessage.innerText = "QR Code scanned successfully!";
            }
            
            function after(act) {
                // Convert binary data to base64 for server processing
                var binary = "";
                stored.forEach(byte => {
                    binary += String.fromCharCode(byte);
                });
                var base64Data = btoa(binary);
                
                switch (act) {
                    case 'convert':
                        window.location.href = `/miiDashboard?miiData=${encodeURIComponent(base64Data)}`;
                        break;
                        
                    case 'upload':
                        console.log("Uploading Mii");
                        document.querySelector(".upload-miidata").value = base64Data;
                        document.querySelector(".qr").hidden = true;
                        document.querySelector(".upload").hidden = false;
                        document.querySelector(".after").hidden = true;
                        
                        // Add AJAX handling to the upload form
                        const uploadForm = document.querySelector(".upload");
                        if (!uploadFormBound) {
                            uploadForm.addEventListener('submit', function(e) {
                                handleFormSubmit(e, '/uploadMii', 'Uploading...', 'upload-error-message');
                            });
                            uploadFormBound = true;
                        }
                        break;
                }
            }

            function openQrInstructions() {
                const convertForm = document.querySelector('.convert');
                const miiData = convertForm?.querySelector('.convert-miidata')?.value?.trim() || '';
                if (!miiData) {
                    showAlert('Scan a QR code first, then open the dashboard.', 4000, { title: 'Missing Input', type: 'error' });
                    return;
                }

                showMiiInstructionsModal(async ({ consoleType }) => {
                    const requestData = new FormData(convertForm);
                    requestData.append('console', consoleType);

                    const response = await fetch('/getInstructions', {
                        method: 'POST',
                        body: requestData
                    });
                    return await response.json();
                }, {
                    title: 'Recreation Instructions',
                    defaultConsole: '3DS'
                });
            }

            document.getElementById('qrInstructionsBtn')?.addEventListener('click', openQrInstructions);
            document.getElementById('qrCopyHexBtn')?.addEventListener('click', async () => {
                const convertForm = document.querySelector('.convert');
                await copyExportHexFromForm(convertForm);
            });
            document.getElementById('qrCopyBase64Btn')?.addEventListener('click', async () => {
                const convertForm = document.querySelector('.convert');
                await copyExportBase64FromForm(convertForm);
            });

            function tick() {
                if (!going) return;
                
                loadingMessage.innerText = "⌛ Loading video...";
                
                if (video.readyState === video.HAVE_ENOUGH_DATA) {
                    loadingMessage.hidden = true;
                    canvasElement.hidden = false;
                    outputContainer.hidden = false;

                    canvasElement.height = video.videoHeight;
                    canvasElement.width = video.videoWidth;
                    canvas.drawImage(video, 0, 0, canvasElement.width, canvasElement.height);
                    
                    var imageData = canvas.getImageData(0, 0, canvasElement.width, canvasElement.height);
                    var code = jsQR(imageData.data, imageData.width, imageData.height, {
                        inversionAttempts: "dontInvert",
                    });
                    
                    if (code) {
                        drawLine(code.location.topLeftCorner, code.location.topRightCorner, "#00FF00");
                        drawLine(code.location.topRightCorner, code.location.bottomRightCorner, "#00FF00");
                        drawLine(code.location.bottomRightCorner, code.location.bottomLeftCorner, "#00FF00");
                        drawLine(code.location.bottomLeftCorner, code.location.topLeftCorner, "#00FF00");
                        outputMessage.hidden = true;
                        stop(code.binaryData);
                    } else {
                        outputMessage.hidden = false;
                        outputMessage.innerText = "No QR code detected.";
                    }
                }
                requestAnimationFrame(tick);
            }
        </script>
    </body>
</html>
