<!DOCTYPE html>
<html lang="en">
    <head>
        <%
        const homeExportValues = (Array.isArray(exportFormats) ? exportFormats : [])
            .map((format) => String(format?.value || '').trim().toLowerCase())
            .filter(Boolean);
        const homeLegacyExportsEnabled = homeExportValues.some((value) => value !== 'ltd');
        const homeQrExportsEnabled = homeExportValues.includes('qr');
        const pageTitle = 'InfiniMii - Mii Character Archive and Tools';
        const pageDesc = homeLegacyExportsEnabled
            ? 'Browse official and community-made Miis, convert supported files, and read transfer guides for Nintendo systems.'
            : 'Browse official and community-made Miis, convert supported files to LTD, and read transfer guides for Nintendo systems.';
        const canonicalUrl = `${baseUrl}/`;
        const keywords = homeQrExportsEnabled
            ? 'mii characters, nintendo miis, download miis, mii converter, mii qr codes, official miis'
            : 'mii characters, nintendo miis, download miis, ltd mii converter, ltd mii downloads, official miis';
        const schemaType = 'CollectionPage';
        const schemaGraphs = [{
            "@context": "https://schema.org",
            "@type": "ItemList",
            "name": "InfiniMii Homepage Sections",
            "itemListElement": Object.keys(miiCategories || {}).map((cat, index) => ({
                "@type": "ListItem",
                "position": index + 1,
                "name": cat,
                "url": `${baseUrl}${miiCategories[cat].link.replace(/^\./, '')}`
            }))
        }];
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, keywords }) %>
        <%- include('structuredData') %>
        <link href="/global.css" rel="stylesheet">
        <link href="/index.css" rel="stylesheet">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <main class="content" role="main">
            <%- include('sidebar') %>
            <div class="main-content">
                <section class="home-hero" aria-labelledby="home-heading" hidden>
                    <p class="home-kicker">Mii archive and tools</p>
                    <h1 id="home-heading">Browse and convert Nintendo Mii characters</h1>
                    <p class="home-lede">InfiniMii archives Miis from Wii, DS, 3DS, Wii U, Switch, Switch 2, Miitomo, Tomodachi Life, and Nintendo Mii Studio. <%= homeLegacyExportsEnabled ? 'Browse official Miis, publish your own, or convert a supported Mii file.' : 'Browse official Miis, publish your own, or convert a supported Mii file to LTD.' %></p>
                    <p class="home-links">
                        <a href="/trending">Browse trending Miis</a>
                        <span aria-hidden="true"> | </span>
                        <a href="/miiDashboard">Open the Mii Dashboard</a>
                        <span aria-hidden="true"> | </span>
                        <a href="/guides/transfer">Read the transfer guide</a>
                    </p>
                </section>

                <section class="home-highlights" aria-labelledby="highlights-heading" hidden>
                    <h2 id="highlights-heading">What InfiniMii does</h2>
                    <ul>
                        <li>Browse official Nintendo Miis and community recreations.</li>
                        <li><%= homeLegacyExportsEnabled ? 'Convert between the Mii formats listed in the dashboard.' : 'Convert supported Mii files to LTD.' %></li>
                        <li><%= homeQrExportsEnabled ? 'Generate and scan QR codes for compatible Mii formats.' : 'Scan compatible QR codes and download the resulting LTD files.' %></li>
                        <li>Follow transfer guides for Wii, 3DS, Wii U, Switch, and Amiibo.</li>
                    </ul>
                </section>

                <section aria-labelledby="browse-sections-heading">
                    <h2 id="browse-sections-heading">Browse Mii collections</h2>
                    <div id="browse-miis" class="homepage-preview-grid">
                        <% Object.keys(miiCategories).forEach(cat=>{ %>
                            <section class="miiCategory" data-home-preview-row aria-labelledby="section-<%= cat.toLowerCase() %>">
                                <h1 id="section-<%= cat.toLowerCase() %>"><a href="<%= miiCategories[cat].link %>"><%= cat %></a></h1>
                                <% miiCategories[cat].miis.forEach((mii, miiIndex)=>{ %>
                                    <%
                                        if (!mii || !mii.id) {
                                            return;
                                        }
                                        const shouldEagerLoadImage = miiIndex < 3;
                                        const shouldPrioritizeImage = miiIndex === 0;
                                    %>
                                    <%- include('miiCard', {
                                        mii,
                                        user,
                                        imageEagerLoad: shouldEagerLoadImage,
                                        imagePriorityLoad: shouldPrioritizeImage,
                                        descriptionMaxLength: 75,
                                        metadataType: 'tags',
                                        metadataItemLimit: 3
                                    }) %>
                                <% }); %>
                            </section>
                        <% }); %>
                    </div>
                </section>
            </div>
            <%- include('featuredMiis') %>
        </main>
        <%- include('footer') %>
    </body>
</html>
