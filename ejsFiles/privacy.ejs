<!DOCTYPE html>
<html>
    <head>
        <%
        const pageTitle = 'Privacy Policy - InfiniMii';
        const pageDesc = 'Read how InfiniMii handles account data, cookies, moderation records, and data deletion.';
        const canonicalUrl = `${baseUrl}/privacy`;
        const keywords = 'privacy policy, infinimii privacy, account data, cookies, moderation records, data deletion';
        const breadcrumbs = [
            { name: 'Home', url: '/' },
            { name: 'Privacy Policy', url: '/privacy' }
        ];
        %>
        <%- include('metaTags', { title: pageTitle, description: pageDesc, canonicalUrl, keywords }) %>
        <%- include('structuredData') %>
        
        <link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="/utilityPages.css">
    </head>
    <body>
        <%- include('globalStyle') %>
        <%- include('header') %>
        <%- include('accountDisplay') %>
        <main class="content" role="main">
            <%- include('sidebar') %>
            
            <div class="guide-container">
                <article>
                    <h1>Privacy Policy</h1>
                    <p>InfiniMii will not store any data on you that is not absolutely required for site functionality. This includes, but is not limited to, things such as cookies to keep you logged in, or settings you would like us to remember. We will never sell your data, and should you delete your account, all of your data will be forgotten forever. The one exception to this is if you are banned, in which case we may store a small and encrypted amount of identifying data for the purposes of blocking you from ever making a new account.</p>
                </article>
            </div>

            <%- include('featuredMiis') %>
        </main>
        <%- include('footer') %>
    </body>
</html>
