<!DOCTYPE html>
<html>

<head>
    <title>Login - InfiniMii</title>
    <%- include('metaTags') %>
    <%- include('structuredData') %>
    <link href="./global.css" rel="stylesheet">
    <link href="./index.css" rel="stylesheet">
</head>

<body>
    <%- include('header') %>
    <div class="content">
        <%- include('sidebar') %>
        <form id="loginForm">
            <fieldset>
                <legend>Login</legend>
                <div id="errorMessage" class="form-message" style="display: none;"></div>
                <input placeholder="Username" required name="username" type="text" id="username"> <input type="password" placeholder="Password" required name="pass" id="password"> <input type="submit" value="Login">
                <p style="margin-top: 15px;">
                    <a href="/requestPasswordReset">Forgot Password?</a>
                </p>
            </fieldset>
        </form>
    </div>
    <%- include('footer') %>
    <script>
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            handleFormSubmit(e, '/login', 'Logging in...', 'errorMessage', {
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                bodyFormatter: (formData) => {
                    const username = formData.get('username');
                    const password = formData.get('pass');
                    return new URLSearchParams({ username, pass: password });
                },
                next: "<%= next %>"
            });
        });
    </script>
</body>

</html>