<%
    const safeAvailableTags = Array.isArray(availableTags) ? availableTags : [];
    const safeSelectedTags = Array.isArray(selectedTags) ? selectedTags : [];
    const selectedTagSet = new Set(safeSelectedTags);
    const panelPrefix = (typeof tagUiIdPrefix === 'string' && tagUiIdPrefix.trim())
        ? tagUiIdPrefix.trim()
        : 'search-tags';
    const showTagFilters = (typeof renderTagFilters === 'boolean') ? renderTagFilters : true;
    const showTagManagement = (typeof renderTagManagement === 'boolean') ? renderTagManagement : true;
%>
<% if (showTagFilters) { %>
    <section class="search-tags-panel" aria-label="Filter by tags">
        <h3 class="search-tags-title">Filter by Tags</h3>
        <% if (safeAvailableTags.length > 0) { %>
            <div class="tag-filter-options">
                <% safeAvailableTags.forEach(tag => { %>
                    <label class="tag-filter-option">
                        <input
                            type="checkbox"
                            name="tags"
                            value="<%= tag %>"
                            <%= selectedTagSet.has(tag) ? 'checked' : '' %>
                        >
                        <span class="tag-marquee-content"><%= tag %></span>
                    </label>
                <% }) %>
            </div>
        <% } else { %>
            <p class="tag-filter-empty">No tags are available yet.</p>
        <% } %>
    </section>
<% } %>

<% if (showTagManagement && isModerator) { %>
    <section class="tag-management-panel" id="<%= panelPrefix %>-tag-management" aria-label="Manage tags">
        <h3 class="tag-management-title">Tag Management</h3>
        <p class="tag-management-help">Create, rename, or remove global tags. Removing a tag also removes it from all Miis.</p>

        <div class="tag-management-actions">
            <label class="sr-only" for="<%= panelPrefix %>-new-tag">New tag name</label>
            <input
                type="text"
                id="<%= panelPrefix %>-new-tag"
                data-tag-new-input
                placeholder="New tag name"
                maxlength="40"
            >
            <button type="button" data-tag-add>Add Tag</button>
        </div>

        <% if (safeAvailableTags.length > 0) { %>
            <div class="tag-admin-list">
                <% safeAvailableTags.forEach((tag, index) => { %>
                    <div class="tag-admin-item" data-tag-item data-tag-original="<%= tag %>">
                        <div class="tag-admin-display">
                            <span class="tag-admin-name" data-tag-name><%= tag %></span>
                            <div class="tag-admin-actions">
                                <button type="button" class="tag-admin-edit" data-tag-edit="<%= tag %>">Edit</button>
                                <button type="button" class="tag-admin-delete" data-tag-delete="<%= tag %>">Delete</button>
                            </div>
                        </div>
                        <div class="tag-admin-editor" data-tag-editor hidden>
                            <label class="sr-only" for="<%= panelPrefix %>-edit-tag-<%= index %>">Rename tag</label>
                            <input
                                type="text"
                                id="<%= panelPrefix %>-edit-tag-<%= index %>"
                                data-tag-edit-input
                                value="<%= tag %>"
                                maxlength="40"
                            >
                            <div class="tag-admin-editor-actions">
                                <button type="button" class="tag-admin-save" data-tag-save>Save</button>
                                <button type="button" class="tag-admin-cancel" data-tag-cancel>Cancel</button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p class="tag-filter-empty">No tags created yet.</p>
        <% } %>
    </section>

    <script>
        (() => {
            const root = document.getElementById('<%= panelPrefix %>-tag-management');
            if (!root) return;

            const input = root.querySelector('[data-tag-new-input]');
            const addButton = root.querySelector('[data-tag-add]');
            const getTagItem = (target) => target?.closest?.('[data-tag-item]') || null;

            const showMessage = (message, type = 'info') => {
                if (typeof showAlert === 'function') {
                    const title = type === 'error' ? 'Error' : (type === 'success' ? 'Success' : 'Notice');
                    showAlert(message, 3500, { title, type });
                    return;
                }
                alert(message);
            };

            const closeEditor = (item, resetValue = true) => {
                if (!item) return;

                const editor = item.querySelector('[data-tag-editor]');
                const inputField = item.querySelector('[data-tag-edit-input]');
                const originalTag = item.getAttribute('data-tag-original') || '';

                item.classList.remove('is-editing');
                if (editor) {
                    editor.hidden = true;
                }
                if (resetValue && inputField) {
                    inputField.value = originalTag;
                }
            };

            const closeAllEditors = (exceptItem = null) => {
                root.querySelectorAll('[data-tag-item]').forEach((item) => {
                    if (item !== exceptItem) {
                        closeEditor(item);
                    }
                });
            };

            const openEditor = (item) => {
                if (!item) return;

                closeAllEditors(item);

                const editor = item.querySelector('[data-tag-editor]');
                const inputField = item.querySelector('[data-tag-edit-input]');
                const originalTag = item.getAttribute('data-tag-original') || '';

                item.classList.add('is-editing');
                if (editor) {
                    editor.hidden = false;
                }
                if (inputField) {
                    inputField.value = originalTag;
                    inputField.focus();
                    inputField.select();
                }
            };

            const addTag = async () => {
                const tag = (input?.value || '').trim();
                if (!tag) {
                    showMessage('Please enter a tag name.', 'error');
                    return;
                }

                try {
                    const response = await fetch('/addMiiTag', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ tag })
                    });
                    const result = await response.json();

                    if (result.error) {
                        showMessage(result.error, 'error');
                        return;
                    }

                    showMessage('Tag created.', 'success');
                    setTimeout(() => location.reload(), 650);
                } catch (error) {
                    console.error('Error adding tag:', error);
                    showMessage('Failed to create tag.', 'error');
                }
            };

            const renameTag = async (item) => {
                if (!item) return;

                const oldTag = item.getAttribute('data-tag-original') || '';
                const inputField = item.querySelector('[data-tag-edit-input]');
                const newTag = (inputField?.value || '').trim();

                if (!oldTag) return;
                if (!newTag) {
                    showMessage('Please enter a tag name.', 'error');
                    return;
                }

                try {
                    const response = await fetch('/renameMiiTag', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ oldTag, newTag })
                    });
                    const result = await response.json();

                    if (result.error) {
                        showMessage(result.error, 'error');
                        return;
                    }

                    showMessage('Tag updated.', 'success');
                    setTimeout(() => location.reload(), 650);
                } catch (error) {
                    console.error('Error renaming tag:', error);
                    showMessage('Failed to update tag.', 'error');
                }
            };

            const deleteTag = async (tag) => {
                if (!tag) return;

                const runDelete = async () => {
                    try {
                        const response = await fetch('/deleteMiiTag', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ tag })
                        });
                        const result = await response.json();

                        if (result.error) {
                            showMessage(result.error, 'error');
                            return;
                        }

                        showMessage('Tag deleted.', 'success');
                        setTimeout(() => location.reload(), 650);
                    } catch (error) {
                        console.error('Error deleting tag:', error);
                        showMessage('Failed to delete tag.', 'error');
                    }
                };

                if (typeof showConfirm === 'function') {
                    showConfirm(
                        `Delete tag "${tag}" from the catalog and every Mii that uses it?`,
                        runDelete,
                        null,
                        { title: 'Delete Tag', confirmText: 'Delete' }
                    );
                    return;
                }

                if (window.confirm(`Delete tag "${tag}" from the catalog and every Mii that uses it?`)) {
                    await runDelete();
                }
            };

            addButton?.addEventListener('click', addTag);
            input?.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    addTag();
                }
            });

            root.addEventListener('click', async (event) => {
                const editButton = event.target.closest('[data-tag-edit]');
                if (editButton) {
                    openEditor(getTagItem(editButton));
                    return;
                }

                const saveButton = event.target.closest('[data-tag-save]');
                if (saveButton) {
                    await renameTag(getTagItem(saveButton));
                    return;
                }

                const cancelButton = event.target.closest('[data-tag-cancel]');
                if (cancelButton) {
                    closeEditor(getTagItem(cancelButton));
                    return;
                }

                const deleteButton = event.target.closest('[data-tag-delete]');
                if (!deleteButton) return;

                const tag = deleteButton.getAttribute('data-tag-delete') || '';
                await deleteTag(tag);
            });

            root.addEventListener('keydown', async (event) => {
                const inputField = event.target.closest('[data-tag-edit-input]');
                if (!inputField) return;

                const item = getTagItem(inputField);
                if (!item) return;

                if (event.key === 'Enter') {
                    event.preventDefault();
                    await renameTag(item);
                    return;
                }

                if (event.key === 'Escape') {
                    event.preventDefault();
                    closeEditor(item);
                }
            });
        })();
    </script>
<% } %>
