<%
    const safeAvailableTags = Array.isArray(availableTags) ? availableTags : [];
    const safeSelectedTags = Array.isArray(selectedTags) ? selectedTags : [];
    const safeExcludedTags = (typeof excludedTags !== 'undefined' && Array.isArray(excludedTags)) ? excludedTags : [];
    const selectedTagSet = new Set(safeSelectedTags.map(tag => String(tag || '').trim().toLowerCase()).filter(Boolean));
    const excludedTagSet = new Set(safeExcludedTags.map(tag => String(tag || '').trim().toLowerCase()).filter(Boolean));
    const filterTagCatalog = [];
    const seenFilterTags = new Set();
    [...safeAvailableTags, ...safeSelectedTags].forEach((tag) => {
        const tagLabel = String(tag || '').trim();
        const tagKey = tagLabel.toLowerCase();
        if (!tagLabel || seenFilterTags.has(tagKey) || (excludedTagSet.has(tagKey) && !selectedTagSet.has(tagKey))) return;
        seenFilterTags.add(tagKey);
        filterTagCatalog.push(tagLabel);
    });
    const activeExcludedTags = safeExcludedTags.filter((tag, index, values) => {
        const tagKey = String(tag || '').trim().toLowerCase();
        return tagKey
            && !selectedTagSet.has(tagKey)
            && values.findIndex(value => String(value || '').trim().toLowerCase() === tagKey) === index;
    });
    const activeTagFilterCount = selectedTagSet.size + activeExcludedTags.length;
    const panelPrefix = (typeof tagUiIdPrefix === 'string' && tagUiIdPrefix.trim())
        ? tagUiIdPrefix.trim()
        : 'search-tags';
    const showTagFilters = (typeof renderTagFilters === 'boolean') ? renderTagFilters : true;
    const showTagManagement = (typeof renderTagManagement === 'boolean') ? renderTagManagement : true;
%>
<% if (showTagFilters) { %>
    <section class="search-tags-panel" aria-labelledby="<%= panelPrefix %>-filter-title" data-tag-filter-panel>
        <header class="advanced-filter-heading search-tags-heading">
            <div>
                <h3 class="search-tags-title" id="<%= panelPrefix %>-filter-title">Tags</h3>
                <p id="<%= panelPrefix %>-filter-help">Choose tags that every result should include.</p>
            </div>
            <output class="tag-filter-count" data-tag-filter-count aria-live="polite"><%= activeTagFilterCount %> active</output>
        </header>

        <% if (filterTagCatalog.length > 0) { %>
            <div class="tag-filter-toolbar">
                <label class="tag-filter-search" for="<%= panelPrefix %>-filter-search">
                    <span class="sr-only">Find a tag</span>
                    <input
                        id="<%= panelPrefix %>-filter-search"
                        type="search"
                        inputmode="search"
                        autocomplete="off"
                        placeholder="Find a tag"
                        data-tag-filter-search
                    >
                </label>
                <button type="button" class="tag-filter-clear" data-tag-filter-clear <%= activeTagFilterCount === 0 ? 'disabled' : '' %>>Clear</button>
            </div>

            <div class="tag-filter-options" aria-describedby="<%= panelPrefix %>-filter-help" data-tag-filter-options>
                <% filterTagCatalog.forEach((tag, index) => { %>
                    <% const tagKey = String(tag || '').toLowerCase(); %>
                    <label
                        class="advanced-search-check tag-filter-check"
                        for="<%= panelPrefix %>-filter-<%= index %>"
                        data-tag-filter-entry
                        data-tag-filter-value="<%= tagKey %>"
                    >
                        <input
                            id="<%= panelPrefix %>-filter-<%= index %>"
                            type="checkbox"
                            name="tags"
                            value="<%= tag %>"
                            data-tag-filter-checkbox
                            <%= selectedTagSet.has(tagKey) ? 'checked' : '' %>
                        >
                        <span><%= tag %></span>
                    </label>
                <% }) %>
            </div>
            <p class="tag-filter-no-match" data-tag-filter-no-match hidden>No tags match that search.</p>

            <% if (activeExcludedTags.length > 0) { %>
                <fieldset class="advanced-era-filters tag-exclusion-filters">
                    <legend>Excluded tags</legend>
                    <p>These tags are excluded by the current search. Uncheck one to remove that exclusion.</p>
                    <div class="advanced-era-filter-options">
                        <% activeExcludedTags.forEach((tag, index) => { %>
                            <label
                                class="advanced-search-check tag-filter-check tag-filter-check-excluded"
                                for="<%= panelPrefix %>-excluded-<%= index %>"
                                data-tag-filter-entry
                                data-tag-filter-value="<%= String(tag || '').toLowerCase() %>"
                            >
                                <input
                                    id="<%= panelPrefix %>-excluded-<%= index %>"
                                    type="checkbox"
                                    name="excludeTags"
                                    value="<%= tag %>"
                                    data-tag-filter-checkbox
                                    checked
                                >
                                <span><%= tag %></span>
                            </label>
                        <% }) %>
                    </div>
                </fieldset>
            <% } %>
        <% } else { %>
            <p class="tag-filter-empty">No tags are available yet.</p>
        <% } %>
    </section>

    <script>
        (() => {
            document.querySelectorAll('[data-tag-filter-panel]').forEach((panel) => {
                if (panel.dataset.tagFilterReady === 'true') return;
                panel.dataset.tagFilterReady = 'true';

                const searchInput = panel.querySelector('[data-tag-filter-search]');
                const clearButton = panel.querySelector('[data-tag-filter-clear]');
                const countOutput = panel.querySelector('[data-tag-filter-count]');
                const noMatchMessage = panel.querySelector('[data-tag-filter-no-match]');
                const entries = Array.from(panel.querySelectorAll('[data-tag-filter-entry]'));
                const checkboxes = Array.from(panel.querySelectorAll('[data-tag-filter-checkbox]'));

                const updateCount = () => {
                    const activeCount = checkboxes.filter((checkbox) => checkbox.checked).length;
                    if (countOutput) countOutput.textContent = `${activeCount} active`;
                    if (clearButton) clearButton.disabled = activeCount === 0;
                };

                const filterEntries = () => {
                    const searchValue = (searchInput?.value || '').trim().toLocaleLowerCase();
                    let visibleCount = 0;

                    entries.forEach((entry) => {
                        const isVisible = !searchValue || (entry.dataset.tagFilterValue || '').includes(searchValue);
                        entry.hidden = !isVisible;
                        if (isVisible) visibleCount += 1;
                    });

                    if (noMatchMessage) noMatchMessage.hidden = visibleCount !== 0;
                };

                searchInput?.addEventListener('input', filterEntries);
                searchInput?.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter') event.preventDefault();
                    if (event.key === 'Escape' && searchInput.value) {
                        event.preventDefault();
                        searchInput.value = '';
                        filterEntries();
                    }
                });

                panel.addEventListener('change', (event) => {
                    if (event.target.matches('[data-tag-filter-checkbox]')) updateCount();
                });

                clearButton?.addEventListener('click', () => {
                    checkboxes.forEach((checkbox) => {
                        checkbox.checked = false;
                    });
                    updateCount();
                    searchInput?.focus();
                });

                updateCount();
            });
        })();
    </script>
<% } %>

<% if (showTagManagement && isModerator) { %>
    <section class="tag-management-panel" id="<%= panelPrefix %>-tag-management" aria-label="Manage tags">
        <h3 class="tag-management-title">Tag Management</h3>
        <p class="tag-management-help">Create, rename, or remove global tags. Removing a tag also removes it from all Miis.</p>

        <div class="tag-management-actions">
            <label class="sr-only" for="<%= panelPrefix %>-new-tag">New tag name</label>
            <input
                type="text"
                id="<%= panelPrefix %>-new-tag"
                data-tag-new-input
                placeholder="New tag name"
                maxlength="40"
            >
            <button type="button" data-tag-add>Add Tag</button>
        </div>

        <% if (safeAvailableTags.length > 0) { %>
            <div class="tag-admin-list">
                <% safeAvailableTags.forEach((tag, index) => { %>
                    <div class="tag-admin-item" data-tag-item data-tag-original="<%= tag %>">
                        <div class="tag-admin-display">
                            <span class="tag-admin-name" data-tag-name><%= tag %></span>
                            <div class="tag-admin-actions">
                                <button type="button" class="tag-admin-edit" data-tag-edit="<%= tag %>">Edit</button>
                                <button type="button" class="tag-admin-delete" data-tag-delete="<%= tag %>">Delete</button>
                            </div>
                        </div>
                        <div class="tag-admin-editor" data-tag-editor hidden>
                            <label class="sr-only" for="<%= panelPrefix %>-edit-tag-<%= index %>">Rename tag</label>
                            <input
                                type="text"
                                id="<%= panelPrefix %>-edit-tag-<%= index %>"
                                data-tag-edit-input
                                value="<%= tag %>"
                                maxlength="40"
                            >
                            <div class="tag-admin-editor-actions">
                                <button type="button" class="tag-admin-save" data-tag-save>Save</button>
                                <button type="button" class="tag-admin-cancel" data-tag-cancel>Cancel</button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p class="tag-filter-empty">No tags created yet.</p>
        <% } %>
    </section>

    <script>
        (() => {
            const root = document.getElementById('<%= panelPrefix %>-tag-management');
            if (!root) return;

            const input = root.querySelector('[data-tag-new-input]');
            const addButton = root.querySelector('[data-tag-add]');
            const getTagItem = (target) => target?.closest?.('[data-tag-item]') || null;

            const showMessage = (message, type = 'info') => {
                if (typeof showAlert === 'function') {
                    const title = type === 'error' ? 'Error' : (type === 'success' ? 'Success' : 'Notice');
                    showAlert(message, 3500, { title, type });
                    return;
                }
                alert(message);
            };

            const closeEditor = (item, resetValue = true) => {
                if (!item) return;

                const editor = item.querySelector('[data-tag-editor]');
                const inputField = item.querySelector('[data-tag-edit-input]');
                const originalTag = item.getAttribute('data-tag-original') || '';

                item.classList.remove('is-editing');
                if (editor) {
                    editor.hidden = true;
                }
                if (resetValue && inputField) {
                    inputField.value = originalTag;
                }
            };

            const closeAllEditors = (exceptItem = null) => {
                root.querySelectorAll('[data-tag-item]').forEach((item) => {
                    if (item !== exceptItem) {
                        closeEditor(item);
                    }
                });
            };

            const openEditor = (item) => {
                if (!item) return;

                closeAllEditors(item);

                const editor = item.querySelector('[data-tag-editor]');
                const inputField = item.querySelector('[data-tag-edit-input]');
                const originalTag = item.getAttribute('data-tag-original') || '';

                item.classList.add('is-editing');
                if (editor) {
                    editor.hidden = false;
                }
                if (inputField) {
                    inputField.value = originalTag;
                    inputField.focus();
                    inputField.select();
                }
            };

            const addTag = async () => {
                const tag = (input?.value || '').trim();
                if (!tag) {
                    showMessage('Please enter a tag name.', 'error');
                    return;
                }

                try {
                    const response = await fetch('/addMiiTag', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ tag })
                    });
                    const result = await response.json();

                    if (result.error) {
                        showMessage(result.error, 'error');
                        return;
                    }

                    showMessage('Tag created.', 'success');
                    setTimeout(() => location.reload(), 650);
                } catch (error) {
                    console.error('Error adding tag:', error);
                    showMessage('Failed to create tag.', 'error');
                }
            };

            const renameTag = async (item) => {
                if (!item) return;

                const oldTag = item.getAttribute('data-tag-original') || '';
                const inputField = item.querySelector('[data-tag-edit-input]');
                const newTag = (inputField?.value || '').trim();

                if (!oldTag) return;
                if (!newTag) {
                    showMessage('Please enter a tag name.', 'error');
                    return;
                }

                try {
                    const response = await fetch('/renameMiiTag', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ oldTag, newTag })
                    });
                    const result = await response.json();

                    if (result.error) {
                        showMessage(result.error, 'error');
                        return;
                    }

                    showMessage('Tag updated.', 'success');
                    setTimeout(() => location.reload(), 650);
                } catch (error) {
                    console.error('Error renaming tag:', error);
                    showMessage('Failed to update tag.', 'error');
                }
            };

            const deleteTag = async (tag) => {
                if (!tag) return;

                const runDelete = async () => {
                    try {
                        const response = await fetch('/deleteMiiTag', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ tag })
                        });
                        const result = await response.json();

                        if (result.error) {
                            showMessage(result.error, 'error');
                            return;
                        }

                        showMessage('Tag deleted.', 'success');
                        setTimeout(() => location.reload(), 650);
                    } catch (error) {
                        console.error('Error deleting tag:', error);
                        showMessage('Failed to delete tag.', 'error');
                    }
                };

                if (typeof showConfirm === 'function') {
                    showConfirm(
                        `Delete tag "${tag}" from the catalog and every Mii that uses it?`,
                        runDelete,
                        null,
                        { title: 'Delete Tag', confirmText: 'Delete' }
                    );
                    return;
                }

                if (window.confirm(`Delete tag "${tag}" from the catalog and every Mii that uses it?`)) {
                    await runDelete();
                }
            };

            addButton?.addEventListener('click', addTag);
            input?.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    addTag();
                }
            });

            root.addEventListener('click', async (event) => {
                const editButton = event.target.closest('[data-tag-edit]');
                if (editButton) {
                    openEditor(getTagItem(editButton));
                    return;
                }

                const saveButton = event.target.closest('[data-tag-save]');
                if (saveButton) {
                    await renameTag(getTagItem(saveButton));
                    return;
                }

                const cancelButton = event.target.closest('[data-tag-cancel]');
                if (cancelButton) {
                    closeEditor(getTagItem(cancelButton));
                    return;
                }

                const deleteButton = event.target.closest('[data-tag-delete]');
                if (!deleteButton) return;

                const tag = deleteButton.getAttribute('data-tag-delete') || '';
                await deleteTag(tag);
            });

            root.addEventListener('keydown', async (event) => {
                const inputField = event.target.closest('[data-tag-edit-input]');
                if (!inputField) return;

                const item = getTagItem(inputField);
                if (!item) return;

                if (event.key === 'Enter') {
                    event.preventDefault();
                    await renameTag(item);
                    return;
                }

                if (event.key === 'Escape') {
                    event.preventDefault();
                    closeEditor(item);
                }
            });
        })();
    </script>
<% } %>
