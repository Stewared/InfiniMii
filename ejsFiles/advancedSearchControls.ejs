<%
    const resolvedFormAction = (typeof formAction === 'string' && formAction.trim())
        ? formAction.trim()
        : '/searchResults';
    const resolvedQuery = (typeof query !== 'undefined' && query) ? query : {};
    const searchControlIdPrefix = (typeof controlUiIdPrefix === 'string' && controlUiIdPrefix.trim())
        ? controlUiIdPrefix.trim()
        : 'search-controls';
    const searchInputId = `${searchControlIdPrefix}-query`;
    const searchValue = typeof searchQueryValue === 'string'
        ? searchQueryValue
        : (typeof resolvedQuery.q === 'string' ? resolvedQuery.q : '');
    const searchPlaceholder = (typeof searchInputPlaceholder === 'string' && searchInputPlaceholder.trim())
        ? searchInputPlaceholder.trim()
        : 'Search by text...';
    const resolvedSubmitLabel = (typeof submitLabel === 'string' && submitLabel.trim())
        ? submitLabel.trim()
        : 'Search';
    const resolvedSearchAriaLabel = (typeof searchAriaLabel === 'string' && searchAriaLabel.trim())
        ? searchAriaLabel.trim()
        : 'Search Mii characters';
    const showSearchFields = typeof renderSearchFields === 'undefined' || renderSearchFields !== false;
    const showMiiAdvancedFilters = typeof renderMiiAdvancedFilters !== 'undefined' && renderMiiAdvancedFilters === true;
    const showTagFilters = typeof renderTagFilters !== 'undefined' && renderTagFilters === true;
    const showCategoryFilters = typeof renderCategoryFilters !== 'undefined' && renderCategoryFilters === true;
    const filters = (typeof advancedSearchFilters !== 'undefined' && advancedSearchFilters)
        ? advancedSearchFilters
        : {};
    const safeFavoriteColorOptions = (typeof favoriteColorOptions !== 'undefined' && Array.isArray(favoriteColorOptions)) ? favoriteColorOptions : [];
    const safeBirthdayMonthOptions = (typeof birthdayMonthOptions !== 'undefined' && Array.isArray(birthdayMonthOptions)) ? birthdayMonthOptions : [];
    const safeBirthdayDayOptions = (typeof birthdayDayOptions !== 'undefined' && Array.isArray(birthdayDayOptions)) ? birthdayDayOptions : [];
    const heightMinValue = filters.heightMin || '0';
    const heightMaxValue = filters.heightMax || '127';
    const weightMinValue = filters.weightMin || '0';
    const weightMaxValue = filters.weightMax || '127';
    const selectedTagList = (typeof selectedTags !== 'undefined' && Array.isArray(selectedTags)) ? selectedTags : [];
    const excludedTagList = (typeof excludedTags !== 'undefined' && Array.isArray(excludedTags)) ? excludedTags : [];
    const selectedTagCount = selectedTagList.length;
    const excludedTagCount = excludedTagList.length;
    const selectedCategoryList = (typeof selectedCategories !== 'undefined' && Array.isArray(selectedCategories))
        ? selectedCategories
        : ((typeof selectedOfficialCategories !== 'undefined' && Array.isArray(selectedOfficialCategories)) ? selectedOfficialCategories : []);
    const excludedCategoryList = (typeof excludedCategories !== 'undefined' && Array.isArray(excludedCategories))
        ? excludedCategories
        : ((typeof excludedOfficialCategories !== 'undefined' && Array.isArray(excludedOfficialCategories)) ? excludedOfficialCategories : []);
    const selectedCategoryCount = selectedCategoryList.length;
    const excludedCategoryCount = excludedCategoryList.length;
    const selectedFieldSource = (typeof selectedSearchFields !== 'undefined' && Array.isArray(selectedSearchFields)) ? selectedSearchFields : [];
    const advancedCount = selectedTagCount + excludedTagCount + selectedCategoryCount + excludedCategoryCount + (filters.isActive ? 1 : 0);
%>

<section class="search-control-panel" aria-label="<%= resolvedSearchAriaLabel %>">
    <form class="search-control-form" method="GET" action="<%= resolvedFormAction %>" role="search">
        <div class="search-control-main">
            <label for="<%= searchInputId %>" class="sr-only"><%= resolvedSearchAriaLabel %></label>
            <input
                id="<%= searchInputId %>"
                name="q"
                autocomplete="off"
                placeholder="<%= searchPlaceholder %>"
                type="search"
                value="<%= searchValue %>"
            >
            <input type="submit" value="<%= resolvedSubmitLabel %>">
        </div>

        <% if (showSearchFields || showMiiAdvancedFilters || showTagFilters || showCategoryFilters) { %>
            <details class="advanced-search-dropdown">
                <summary>
                    <span>Advanced Search</span>
                    <% if (advancedCount > 0) { %>
                        <span class="advanced-search-count"><%= advancedCount %></span>
                    <% } %>
                </summary>
                <div class="advanced-search-body">
                    <% if (showSearchFields) { %>
                        <%- include('searchFieldFilters', {
                            selectedSearchFields: selectedFieldSource,
                            searchFieldsExplicitlyConfigured,
                            searchFieldUiIdPrefix: `${searchControlIdPrefix}-fields`
                        }) %>
                    <% } %>

                    <% if (showMiiAdvancedFilters) { %>
                        <section class="advanced-search-options" aria-label="Advanced filters">
                            <label class="advanced-search-control" for="<%= searchControlIdPrefix %>-gender">
                                <span>Gender</span>
                                <select id="<%= searchControlIdPrefix %>-gender" name="gender">
                                    <option value="">Any</option>
                                    <option value="0" <%= filters.gender === '0' ? 'selected' : '' %>>Male</option>
                                    <option value="1" <%= filters.gender === '1' ? 'selected' : '' %>>Female</option>
                                </select>
                            </label>

                            <label class="advanced-search-control" for="<%= searchControlIdPrefix %>-favorite-color">
                                <span>Favorite Color</span>
                                <select id="<%= searchControlIdPrefix %>-favorite-color" name="favoriteColor">
                                    <option value="">Any</option>
                                    <% safeFavoriteColorOptions.forEach((color) => { %>
                                        <option value="<%= color.value %>" <%= filters.favoriteColor === String(color.value) ? 'selected' : '' %>><%= color.label %></option>
                                    <% }) %>
                                </select>
                            </label>

                            <label class="advanced-search-control" for="<%= searchControlIdPrefix %>-birth-month">
                                <span>Birthday Month</span>
                                <select id="<%= searchControlIdPrefix %>-birth-month" name="birthMonth">
                                    <option value="">Any</option>
                                    <% safeBirthdayMonthOptions.forEach((month) => { %>
                                        <option value="<%= month.value %>" <%= filters.birthMonth === String(month.value) ? 'selected' : '' %>><%= month.label %></option>
                                    <% }) %>
                                </select>
                            </label>

                            <label class="advanced-search-control" for="<%= searchControlIdPrefix %>-birthday">
                                <span>Birthday Day</span>
                                <select id="<%= searchControlIdPrefix %>-birthday" name="birthday">
                                    <option value="">Any</option>
                                    <% safeBirthdayDayOptions.forEach((day) => { %>
                                        <option value="<%= day.value %>" <%= filters.birthday === String(day.value) ? 'selected' : '' %>><%= day.label %></option>
                                    <% }) %>
                                </select>
                            </label>

                            <label class="advanced-search-check">
                                <input type="checkbox" name="hasTlData" value="1" <%= filters.mustHaveTomodachiLifeData ? 'checked' : '' %>>
                                <span>Must Have Tomodachi Life Data</span>
                            </label>

                            <div class="advanced-range-control" data-advanced-range>
                                <div class="advanced-range-heading">
                                    <span>Height</span>
                                    <output data-range-output for="<%= searchControlIdPrefix %>-height-min <%= searchControlIdPrefix %>-height-max"><%= heightMinValue %>-<%= heightMaxValue %></output>
                                </div>
                                <div class="advanced-range-sliders">
                                    <input id="<%= searchControlIdPrefix %>-height-min" type="range" name="heightMin" min="0" max="127" value="<%= heightMinValue %>" data-range-min aria-label="Minimum height">
                                    <input id="<%= searchControlIdPrefix %>-height-max" type="range" name="heightMax" min="0" max="127" value="<%= heightMaxValue %>" data-range-max aria-label="Maximum height">
                                </div>
                            </div>

                            <div class="advanced-range-control" data-advanced-range>
                                <div class="advanced-range-heading">
                                    <span>Weight</span>
                                    <output data-range-output for="<%= searchControlIdPrefix %>-weight-min <%= searchControlIdPrefix %>-weight-max"><%= weightMinValue %>-<%= weightMaxValue %></output>
                                </div>
                                <div class="advanced-range-sliders">
                                    <input id="<%= searchControlIdPrefix %>-weight-min" type="range" name="weightMin" min="0" max="127" value="<%= weightMinValue %>" data-range-min aria-label="Minimum weight">
                                    <input id="<%= searchControlIdPrefix %>-weight-max" type="range" name="weightMax" min="0" max="127" value="<%= weightMaxValue %>" data-range-max aria-label="Maximum weight">
                                </div>
                            </div>
                        </section>
                    <% } %>

                    <% if (showTagFilters) { %>
                        <%- include('tagFilters', {
                            availableTags: typeof availableTags !== 'undefined' ? availableTags : [],
                            selectedTags: selectedTagList,
                            excludedTags: excludedTagList,
                            isModerator: Boolean(typeof isModerator !== 'undefined' && isModerator),
                            tagUiIdPrefix: `${searchControlIdPrefix}-tags`,
                            renderTagFilters: true,
                            renderTagManagement: false
                        }) %>
                    <% } %>

                    <% if (showCategoryFilters) { %>
                        <%- include('categoryFilters', {
                            availableCategories: typeof availableCategories !== 'undefined' ? availableCategories : [],
                            selectedCategories: selectedCategoryList,
                            excludedCategories: excludedCategoryList,
                            categoryName: typeof categoryName === 'string' ? categoryName : 'category',
                            excludeCategoryName: typeof excludeCategoryName === 'string' ? excludeCategoryName : 'excludeCategory'
                        }) %>
                    <% } %>
                </div>
            </details>
        <% } %>
    </form>

    <% if (showMiiAdvancedFilters) { %>
        <script>
            (() => {
                document.querySelectorAll('[data-advanced-range]').forEach((rangeControl) => {
                    const minInput = rangeControl.querySelector('[data-range-min]');
                    const maxInput = rangeControl.querySelector('[data-range-max]');
                    const output = rangeControl.querySelector('[data-range-output]');
                    if (!minInput || !maxInput || !output) return;

                    const updateRangeOutput = (changedInput = null) => {
                        let minValue = Number.parseInt(minInput.value, 10);
                        let maxValue = Number.parseInt(maxInput.value, 10);

                        if (Number.isNaN(minValue)) minValue = 0;
                        if (Number.isNaN(maxValue)) maxValue = 127;

                        if (minValue > maxValue) {
                            if (changedInput === minInput) {
                                maxValue = minValue;
                                maxInput.value = String(maxValue);
                            } else {
                                minValue = maxValue;
                                minInput.value = String(minValue);
                            }
                        }

                        output.value = `${minValue}-${maxValue}`;
                        output.textContent = output.value;
                    };

                    minInput.addEventListener('input', () => updateRangeOutput(minInput));
                    maxInput.addEventListener('input', () => updateRangeOutput(maxInput));
                    updateRangeOutput();
                });
            })();
        </script>
    <% } %>

    <% if (showTagFilters || showCategoryFilters) { %>
        <script>
            (() => {
                const STATES = ['neutral', 'include', 'exclude'];
                const STATE_CLASS_NAMES = ['is-neutral', 'is-include', 'is-exclude'];

                const getNextState = (state) => {
                    const currentIndex = STATES.indexOf(state);
                    return STATES[(currentIndex + 1) % STATES.length];
                };

                const getActionLabel = (state) => {
                    if (state === 'neutral') return 'include';
                    if (state === 'include') return 'exclude';
                    return 'reset';
                };

                const syncControl = (control) => {
                    const state = STATES.includes(control.dataset.state) ? control.dataset.state : 'neutral';
                    const button = control.querySelector('[data-tri-filter-button]');
                    const input = control.querySelector('[data-tri-filter-input]');
                    if (!button || !input) return;

                    const includeName = control.dataset.includeName || input.name;
                    const excludeName = control.dataset.excludeName || input.name;
                    const label = control.dataset.filterLabel || input.value;
                    const kind = control.dataset.filterKind || 'filter';

                    input.disabled = state === 'neutral';
                    input.name = state === 'exclude' ? excludeName : includeName;

                    button.classList.remove(...STATE_CLASS_NAMES);
                    button.classList.add(`is-${state}`);
                    button.dataset.state = state;
                    button.setAttribute('aria-pressed', state === 'include' ? 'true' : (state === 'exclude' ? 'mixed' : 'false'));
                    button.setAttribute('aria-label', `${label} ${kind}: ${state}. Click to ${getActionLabel(state)}.`);
                };

                document.querySelectorAll('[data-tri-filter]').forEach(syncControl);

                if (window.__infiniMiiTriFilterBound) return;
                window.__infiniMiiTriFilterBound = true;

                document.addEventListener('click', (event) => {
                    const button = event.target.closest('[data-tri-filter-button]');
                    if (!button) return;

                    const control = button.closest('[data-tri-filter]');
                    if (!control) return;

                    event.preventDefault();
                    control.dataset.state = getNextState(control.dataset.state);
                    syncControl(control);
                });
            })();
        </script>
    <% } %>
</section>
