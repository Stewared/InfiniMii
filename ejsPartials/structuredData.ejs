<%
const firstNonEmpty = (...values) => {
    for (const value of values) {
        if (typeof value === 'string') {
            if (value.trim().length > 0) return value.trim();
            continue;
        }
        if (value !== null && typeof value !== 'undefined') {
            return value;
        }
    }
    return undefined;
};

const resolvedBaseUrl = typeof baseUrl === 'string' && baseUrl.trim()
    ? baseUrl.replace(/\/+$/, '')
    : '';
const rawCurrentPath = typeof currentPath === 'string' && currentPath.trim()
    ? currentPath.trim()
    : '/';
const currentPathValue = rawCurrentPath.startsWith('/') ? rawCurrentPath : `/${rawCurrentPath}`;
const currentPathWithoutHash = currentPathValue.split('#')[0];
const resolvedPageTitle = firstNonEmpty(
    typeof pageTitle !== 'undefined' ? pageTitle : undefined,
    typeof title !== 'undefined' ? title : undefined,
    'InfiniMii'
);
const resolvedPageDesc = firstNonEmpty(
    typeof pageDesc !== 'undefined' ? pageDesc : undefined,
    typeof description !== 'undefined' ? description : undefined,
    'Create, convert, and share Mii characters across Nintendo systems.'
);
const toAbsoluteUrl = (value, fallbackPath = '/') => {
    const trimmed = typeof value === 'string' ? value.trim() : '';
    if (!trimmed) {
        if (!resolvedBaseUrl) return fallbackPath;
        return fallbackPath.startsWith('/')
            ? `${resolvedBaseUrl}${fallbackPath}`
            : `${resolvedBaseUrl}/${fallbackPath.replace(/^\/+/, '')}`;
    }
    if (/^https?:\/\//i.test(trimmed)) return trimmed;
    if (!resolvedBaseUrl) return trimmed.startsWith('/') ? trimmed : `/${trimmed.replace(/^\/+/, '')}`;
    return trimmed.startsWith('/')
        ? `${resolvedBaseUrl}${trimmed}`
        : `${resolvedBaseUrl}/${trimmed.replace(/^\/+/, '')}`;
};
const resolvedPageUrl = toAbsoluteUrl(
    firstNonEmpty(
        typeof canonicalUrl !== 'undefined' ? canonicalUrl : undefined,
        currentPathWithoutHash
    )
);
const resolvedPageImage = toAbsoluteUrl(
    firstNonEmpty(
        typeof ogImage !== 'undefined' ? ogImage : undefined,
        '/banner.png'
    ),
    '/banner.png'
);
const resolvedSchemaType = firstNonEmpty(
    typeof schemaType !== 'undefined' ? schemaType : undefined,
    'WebPage'
);
const sameAsLinks = [
    typeof githubLink === 'string' ? githubLink.trim() : '',
    typeof discordInvite === 'string' ? discordInvite.trim() : ''
].filter(Boolean);
const pageRobotsValue = String(
    firstNonEmpty(
        typeof robots !== 'undefined' ? robots : undefined,
        typeof pageRobots !== 'undefined' ? pageRobots : undefined,
        ''
    ) || ''
).toLowerCase();
const shouldSuppressSchema = pageRobotsValue.includes('noindex') || Boolean(
    typeof structuredDataDisabled !== 'undefined' ? structuredDataDisabled : false
);
const splitKeywordText = (value) => String(value || '')
    .split(',')
    .map((keyword) => keyword.trim())
    .filter(Boolean);
const basePageKeywords = firstNonEmpty(
    typeof keywords !== 'undefined' ? keywords : undefined,
    'mii, mii characters, nintendo'
);
const websiteKeywordList = typeof buildSeoKeywordList === 'function'
    ? buildSeoKeywordList('infinimii, mii characters, nintendo miis, mii converter, mii qr codes, mii transfer guide', {
        context: ['InfiniMii', 'Mii database', 'Mii QR codes', 'Mii converter', 'Nintendo Mii tools'],
        limit: 36,
        asArray: true
    })
    : splitKeywordText('infinimii, mii characters, nintendo miis, mii converter, mii qr codes, mii transfer guide');
const pageKeywordList = typeof buildSeoKeywordList === 'function'
    ? buildSeoKeywordList(basePageKeywords, {
        context: [resolvedPageTitle, resolvedPageDesc, currentPathWithoutHash],
        limit: 36,
        asArray: true
    })
    : splitKeywordText(basePageKeywords);

const websiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${resolvedBaseUrl}/#website`,
    "url": resolvedBaseUrl,
    "name": "InfiniMii",
    "description": "InfiniMii is a searchable Mii character database and toolkit for converting, sharing, and downloading Miis across Nintendo systems.",
    "keywords": websiteKeywordList,
    "publisher": { "@id": `${resolvedBaseUrl}/#organization` },
    "potentialAction": {
        "@type": "SearchAction",
        "target": {
            "@type": "EntryPoint",
            "urlTemplate": `${resolvedBaseUrl}/searchResults?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
    }
};

const organizationSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${resolvedBaseUrl}/#organization`,
    "name": "InfiniMii",
    "url": resolvedBaseUrl,
    "logo": {
        "@type": "ImageObject",
        "url": `${resolvedBaseUrl}/banner.png`
    },
    "sameAs": sameAsLinks.length ? sameAsLinks : undefined
};

const pageSchema = {
    "@context": "https://schema.org",
    "@type": resolvedSchemaType,
    "@id": `${resolvedPageUrl}#webpage`,
    "url": resolvedPageUrl,
    "name": resolvedPageTitle,
    "description": resolvedPageDesc,
    "keywords": pageKeywordList,
    "image": resolvedPageImage,
    "isPartOf": { "@id": `${resolvedBaseUrl}/#website` },
    "about": {
        "@type": "Thing",
        "name": "Mii characters"
    }
};

if (typeof publishedTime !== 'undefined' && publishedTime) {
    pageSchema.datePublished = publishedTime;
}
if (typeof modifiedTime !== 'undefined' && modifiedTime) {
    pageSchema.dateModified = modifiedTime;
} else if (typeof pageUpdatedAt !== 'undefined' && pageUpdatedAt) {
    pageSchema.dateModified = pageUpdatedAt;
}

const breadcrumbItems = typeof breadcrumbs !== 'undefined' && Array.isArray(breadcrumbs)
    ? breadcrumbs
    : [];
const breadcrumbSchema = breadcrumbItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbItems.map((breadcrumb, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "name": breadcrumb.name,
            "item": toAbsoluteUrl(breadcrumb.url || '/')
        }))
    }
    : null;

const extraSchemaGraphs = typeof schemaGraphs !== 'undefined' && Array.isArray(schemaGraphs)
    ? schemaGraphs.filter(Boolean)
    : [];
%>
<% if (!shouldSuppressSchema) { %>
<script type="application/ld+json"><%- JSON.stringify(websiteSchema, null, 2) %></script>
<script type="application/ld+json"><%- JSON.stringify(organizationSchema, null, 2) %></script>
<script type="application/ld+json"><%- JSON.stringify(pageSchema, null, 2) %></script>
<% if (breadcrumbSchema) { %><script type="application/ld+json"><%- JSON.stringify(breadcrumbSchema, null, 2) %></script><% } %>
<% extraSchemaGraphs.forEach((schemaGraph) => { %>
<script type="application/ld+json"><%- JSON.stringify(schemaGraph, null, 2) %></script>
<% }); %>
<% } %>
