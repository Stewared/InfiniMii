<button
    type="button"
    class="mobile-drawer-toggle mobile-drawer-toggle-right"
    data-drawer-target="featuredMiisDrawer"
    aria-controls="featuredMiisDrawer"
    aria-expanded="false"
>
    Featured <%- include('icon', { name: 'arrow-left', size: 14 }) %>
</button>

<aside class="browse-featured-miis mobile-drawer mobile-drawer-right" id="featuredMiisDrawer" aria-label="Featured Miis">
    <!--Higlighted Mii-->
    <div class="title-container">
        <h2>Featured Mii</h2>
        <img src="data:image/png;base64," height='20' width='205' />
    </div>
    <div class="mii-card"  style="--favorite-color: <%= highlightedMiiData ? decodeColor(highlightedMiiData.general?.favoriteColor) || decodeColor(0) : decodeColor(0) %>;">
        <% if(isModerator){ %>
            <input type="text" placeholder="New Highlighted Mii ID?" id="highlightedMiiID"> <input type="button" onclick="highlightedMiiChange()" value="Change Highlighted Mii">
        <% } %>
        <% if (highlightedMiiData) { %>
        <%
            const highlightedUserVotedFor = Array.isArray(user?.votedFor) ? user.votedFor : [];
            const highlightedIsLikeLocked = Boolean(
                !highlightedMiiData.official &&
                user?.username &&
                (highlightedMiiData.uploader === user.username || highlightedMiiData.contributor === user.username)
            );
            const highlightedHasLikedMii = highlightedUserVotedFor.includes(highlightedMii) || highlightedIsLikeLocked;
            const highlightedAttribution = getMiiAttribution(highlightedMiiData);
        %>
        <a href='/mii/<%= highlightedMii %>'><img src="/miiImgs/<%= highlightedMii %>.png" alt="<%= highlightedMiiData.name %> Mii: <%= highlightedMiiData.description %>" width="256" height="256" loading="eager" decoding="async" fetchpriority="high"></a>
        <div class="flex">
            <div>
                <h3><%= highlightedMiiData.meta.name %></h3>
                <p class="mii-card-byline">
                    <span><%= highlightedAttribution.prefix %></span>
                    <% if (highlightedAttribution.url) { %>
                        <a
                            class="<%= highlightedAttribution.isExternal ? 'external-source-link' : '' %>"
                            href="<%= highlightedAttribution.url %>"
                            <% if (highlightedAttribution.opensInNewTab) { %>target="_blank" rel="noopener noreferrer external"<% } %>
                        ><%= highlightedAttribution.label %></a>
                    <% } else { %>
                        <span><%= highlightedAttribution.label %></span>
                    <% } %>
                </p>
            </div>
            <button
                type="button"
                onclick="likeMii(this,'<%= highlightedMii %>')"
                class="featured-like-button like-button <%= highlightedHasLikedMii ? 'is-liked' : 'is-unliked' %><%= highlightedIsLikeLocked ? ' is-like-locked' : '' %>"
                data-mii-id="<%= highlightedMii %>"
                data-liked="<%= highlightedHasLikedMii ? 'true' : 'false' %>"
                data-like-locked="<%= highlightedIsLikeLocked ? 'true' : 'false' %>"
                aria-pressed="<%= highlightedHasLikedMii ? 'true' : 'false' %>"
                aria-label="<%= highlightedIsLikeLocked ? 'You permanently like Miis you upload' : (highlightedHasLikedMii ? 'Unlike this Mii' : 'Like this Mii') %>"
            >
                <%- include('icon', { name: 'heart', size: 20, class: 'like-icon' }) %>
                <span class="vote-count"><%= highlightedMiiData.votes || 0 %></span>
            </button>
        </div>
        <p><%= highlightedMiiData.desc.length>75?highlightedMiiData.desc.slice(0,73)+"...":highlightedMiiData.desc %></p>
        <% } %>
    </div>
    <br>
    <!-- Average Mii -->
    <div class="title-container">
        <h2>Average Mii</h2>
        <img src="data:image/png;base64," height='20' width='205' />
    </div>
    <div class="mii-card" style="--favorite-color: <%= averageMiiData ? decodeColor(averageMiiData.general?.favoriteColor) || decodeColor(0) : decodeColor(0) %>;">
        <% if (averageMiiData) { %>
        <a href='/mii/average'><img src="/miiImgs/average.png?v=<%= encodeURIComponent(averageMiiData.updatedAt ? new Date(averageMiiData.updatedAt).getTime() : (averageMiiData.uploadedOn || Date.now())) %>" alt="The average face of all Miis in the InfiniMii database." width="256" height="256" loading="eager" decoding="async" fetchpriority="high"></a>
        <div class="flex">
            <div>
                <h3>Average Mii</h3>
                <p class="mii-card-byline">
                    <a href="/user/Community">Community</a>
                </p>
            </div>
        </div>
        <p>Built from the most common feature choices and placements among Miis on InfiniMii.</p>
        <% } %>
    </div>
</aside>
