<%
const footerHasMii = typeof mii !== 'undefined' && mii;
const footerMiiDateMetadata = footerHasMii && typeof getMiiDateMetadata === 'function'
    ? getMiiDateMetadata(mii, typeof pageUpdatedAt !== 'undefined' ? pageUpdatedAt : undefined)
    : null;
const resolvedUpdatedAt = (() => {
    if (footerMiiDateMetadata) {
        const miiTimestamp = footerMiiDateMetadata.modifiedIso || footerMiiDateMetadata.publishedIso;
        return miiTimestamp ? new Date(miiTimestamp) : null;
    }
    if (typeof pageUpdatedAt !== 'undefined' && pageUpdatedAt) return new Date(pageUpdatedAt);
    if (typeof modifiedTime !== 'undefined' && modifiedTime) return new Date(modifiedTime);
    if (footerHasMii && mii?.uploadedOn) return new Date(mii.uploadedOn);
    return null;
})();
const hasResolvedUpdatedAt = resolvedUpdatedAt instanceof Date && !Number.isNaN(resolvedUpdatedAt.getTime());
%>
<div class="content-metadata" hidden>
    <p><strong>Site Summary:</strong> InfiniMii is a searchable database and toolkit for Nintendo Mii characters, including browsing, downloads, QR codes, conversion tools, transfer guides, and official Mii preservation.</p>
    <% if (hasResolvedUpdatedAt) { %>
    <p class="last-updated">
        <strong>Last Updated:</strong>
        <time datetime="<%= resolvedUpdatedAt.toISOString() %>">
            <%= resolvedUpdatedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
        </time>
    </p>
    <% } %>
</div>

<footer class="site-footer">
