<div class="account <%= thisUser === 'Default' ? 'account-guest' : '' %>">
    <% if(thisUser!=="Default"){ %>
        <img class="account-image-small" src="/miiImgs/<%= pfp %>.png"> <%= thisUser %>
        <div class="accDropdown">
            <a href="/user/<%= encodeURIComponent(thisUser) %>">Profile</a>
            <a href="/myLikedMiis">My Liked Miis</a>
            <a href="/settings">Settings</a>
            <a href="/logout">Logout</a>
        </div>
    <% } else{ %>
        <span class="account-login-prompt">
            <a class="account-login-link account-login-link-primary" href="/signup">Sign Up</a>
            <a class="account-login-link" href="/login">Log In</a>
        </span>
    <% } %>
</div>
