<%
const pageRobotsValue = typeof pageRobots !== 'undefined' ? pageRobots : '';
const seo = typeof miiSeo !== 'undefined' && miiSeo ? miiSeo : {};
const resolvedBaseUrl = typeof baseUrl !== 'undefined' && baseUrl
  ? String(baseUrl).replace(/\/+$/, '')
  : '';
const resolvedPageUpdatedAt = typeof pageUpdatedAt !== 'undefined' ? pageUpdatedAt : undefined;
if (typeof mii !== 'undefined' && !(String(pageRobotsValue).toLowerCase().includes('noindex'))) {
%>
<%
const officialSourceName = mii.official
  ? (seo.officialSourceName || mii.officialSource || mii.uploader || "Nintendo")
  : "";
const structuredExternalSource = typeof getExternalMiiSource === "function"
  ? getExternalMiiSource(mii)
  : null;
const miiName = seo.name || mii?.meta?.name || "Unknown Mii";
const structuredDateMetadata = typeof getMiiDateMetadata === "function"
  ? getMiiDateMetadata(mii, resolvedPageUpdatedAt)
  : {
      publishedIso: structuredExternalSource ? undefined : (mii?.uploadedOn ? new Date(mii.uploadedOn).toISOString() : undefined),
      modifiedIso: structuredExternalSource
        ? undefined
        : (resolvedPageUpdatedAt || (mii?.uploadedOn ? new Date(mii.uploadedOn).toISOString() : undefined))
    };
const publishedIso = structuredDateMetadata.publishedIso;
const modifiedIso = structuredDateMetadata.modifiedIso;
const miiUrl = `${resolvedBaseUrl}/mii/${mii.id}`;
const miiImageUrl = `${resolvedBaseUrl}/miiImgs/${mii.id}.png`;
const miiQrUrl = `${resolvedBaseUrl}/miiQRs/${mii.id}.png`;
const miiImageWidth = 512;
const miiImageHeight = 512;
const miiDescription = seo.metaDescription || mii.desc || `${miiName} Mii character${structuredExternalSource ? ` from ${structuredExternalSource.title}` : (mii.official ? ` from ${officialSourceName}` : '')} for Nintendo systems.`;
const creatorName = seo.creatorName || "";
const baseKeywordList = Array.isArray(seo.keywordList) && seo.keywordList.length > 0
  ? seo.keywordList
  : [
      miiName,
      "Mii character",
      "Nintendo Mii",
      mii.official ? "Official Mii" : "Community Mii"
    ];
const keywordList = typeof buildSeoKeywordList === "function"
  ? buildSeoKeywordList(baseKeywordList, {
      context: [
        miiName,
        miiDescription,
        Array.isArray(seo.searchTopicPhrases) ? seo.searchTopicPhrases : [],
        Array.isArray(seo.tagList) ? seo.tagList : [],
        Array.isArray(seo.categoryNames) ? seo.categoryNames : []
      ],
      limit: 36,
      asArray: true,
      fallbackToGeneral: false
    })
  : baseKeywordList;
const relatedTopicThings = [
  ...(Array.isArray(seo.tagList) ? seo.tagList : []),
  ...(Array.isArray(seo.categoryNames) ? seo.categoryNames : [])
].map((name) => ({
  "@type": "Thing",
  "name": name
}));
const additionalProperties = [
  seo.archiveTypeLabel ? { "@type": "PropertyValue", "name": "Archive type", "value": seo.archiveTypeLabel } : null,
  seo.typeLabel ? { "@type": "PropertyValue", "name": "Mii type", "value": seo.typeLabel } : null,
  seo.consoleLabel ? { "@type": "PropertyValue", "name": "Original console", "value": seo.consoleLabel } : null,
  seo.genderLabel ? { "@type": "PropertyValue", "name": "Gender", "value": seo.genderLabel } : null,
  seo.favoriteColorName ? { "@type": "PropertyValue", "name": "Favorite color", "value": seo.favoriteColorName } : null,
  seo.birthdayLabel ? { "@type": "PropertyValue", "name": "Birthday", "value": seo.birthdayLabel } : null,
  structuredExternalSource ? { "@type": "PropertyValue", "name": "External source", "value": structuredExternalSource.title, "url": structuredExternalSource.url } : null
].filter(Boolean);
const archiveOwnerEntity = {
  "@type": (structuredExternalSource || mii.official) ? "Organization" : "Person",
  "name": structuredExternalSource?.title || (mii.official ? officialSourceName : (mii.uploader || "InfiniMii User")),
  "url": structuredExternalSource?.url || `${resolvedBaseUrl}/user/${encodeURIComponent(mii.uploader || "")}`
};
const externalUploaderEntity = structuredExternalSource?.user
  ? { "@type": "Person", "name": structuredExternalSource.user, "url": structuredExternalSource.userUrl }
  : null;
const characterSchema = {
  "@context": "https://schema.org",
  "@type": "Character",
  "@id": `${miiUrl}#character`,
  "name": miiName,
  "description": miiDescription,
  "url": miiUrl,
  "image": miiImageUrl,
  "mainEntityOfPage": miiUrl,
  "publisher": { "@id": `${resolvedBaseUrl}/#organization` },
  "creator": creatorName
    ? { "@type": "Person", "name": creatorName }
    : archiveOwnerEntity,
  "contributor": externalUploaderEntity || (mii.contributor
    ? { "@type": "Person", "name": mii.contributor, "url": `${resolvedBaseUrl}/user/${encodeURIComponent(mii.contributor)}` }
    : archiveOwnerEntity),
  "isPartOf": structuredExternalSource ? archiveOwnerEntity : undefined,
  "keywords": keywordList,
  "genre": Array.isArray(seo.tagList) && seo.tagList.length > 0 ? seo.tagList : undefined,
  "about": relatedTopicThings.length > 0 ? relatedTopicThings : undefined,
  "additionalProperty": additionalProperties.length > 0 ? additionalProperties : undefined
};

const miiCreativeWorkSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${miiUrl}#creativework`,
  "name": `${miiName} Mii Character`,
  "description": miiDescription,
  "url": miiUrl,
  "image": miiImageUrl,
  "thumbnailUrl": miiImageUrl,
  "about": { "@id": `${miiUrl}#character` },
  "creator": characterSchema.creator,
  "contributor": characterSchema.contributor,
  "datePublished": publishedIso,
  "dateModified": modifiedIso,
  "keywords": keywordList,
  "interactionStatistic": {
    "@type": "InteractionCounter",
    "interactionType": "https://schema.org/LikeAction",
    "userInteractionCount": mii.votes || 0
  }
};

const miiPreviewSchema = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "@id": `${miiUrl}#preview`,
  "name": `${miiName} Mii Preview`,
  "url": miiImageUrl,
  "contentUrl": miiImageUrl,
  "thumbnailUrl": miiImageUrl,
  "width": miiImageWidth,
  "height": miiImageHeight,
  "encodingFormat": "image/png",
  "representativeOfPage": true,
  "caption": `${miiName} Mii character preview image.`
};

const miiQrSchema = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "@id": `${miiUrl}#qr`,
  "name": `${miiName} Mii QR Code`,
  "url": miiQrUrl,
  "contentUrl": miiQrUrl,
  "width": miiImageWidth,
  "height": miiImageHeight,
  "encodingFormat": "image/png",
  "caption": `QR code for ${miiName}. Scan with compatible Nintendo systems to import the Mii.`
};
const scriptJson = typeof toScriptJson === 'function'
  ? toScriptJson
  : ((value, space = 0) => JSON.stringify(value, null, space)
      .replace(/</g, '\\u003C')
      .replace(/>/g, '\\u003E')
      .replace(/&/g, '\\u0026')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029'));
%>
<script type="application/ld+json"><%- scriptJson(characterSchema, 2) %></script>
<script type="application/ld+json"><%- scriptJson(miiCreativeWorkSchema, 2) %></script>
<script type="application/ld+json"><%- scriptJson(miiPreviewSchema, 2) %></script>
<script type="application/ld+json"><%- scriptJson(miiQrSchema, 2) %></script>
<% } %>
