<%
const faqSchemaExportValues = (typeof exportFormats !== 'undefined' && Array.isArray(exportFormats) ? exportFormats : [])
  .map((format) => String(format?.value || '').trim().toLowerCase())
  .filter(Boolean);
const faqSchemaLegacyExportsEnabled = faqSchemaExportValues.some((value) => value !== 'ltd');
const faqSchemaQrExportsEnabled = faqSchemaExportValues.includes('qr');
const faqSchemaStringify = typeof toScriptJson === 'function' ? toScriptJson : JSON.stringify;
%>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is InfiniMii?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": <%- faqSchemaStringify(faqSchemaLegacyExportsEnabled
          ? "InfiniMii is a Mii archive with tools for sharing, rendering, and converting supported Mii formats."
          : "InfiniMii is a Mii archive with tools for sharing Miis, converting supported files to LTD, creating transparent previews for compatible LTD Miis, and downloading original LTD files. If an LTD file uses data the renderer has not verified, InfiniMii does not generate a preview.") %>
      }
    },
    {
      "@type": "Question",
      "name": "How do I download a Mii character?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": <%- faqSchemaStringify(faqSchemaLegacyExportsEnabled
          ? "Browse the collection, open a Mii page, and choose one of its listed download formats."
          : "Browse the collection, open a Mii page, and use the download control to save its LTD file.") %>
      }
    },
    {
      "@type": "Question",
      "name": "Can I convert Miis between different Nintendo systems?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": <%- faqSchemaStringify(faqSchemaLegacyExportsEnabled
          ? "InfiniMii accepts supported Mii files and converts them to the formats listed in its export tools."
          : "Miis from Living the Dream keep their original LTD files. Miis from other systems can use the compatible export formats listed on the site.") %>
      }
    },
    {
      "@type": "Question",
      "name": "What are Official Miis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Official Miis are characters created by Nintendo for games, promotions, system software, or other official materials. InfiniMii records where each verified Mii appeared when that information is known."
      }
    },
    {
      "@type": "Question",
      "name": "How do I use QR codes with my 3DS or Wii U?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": <%- faqSchemaStringify(faqSchemaQrExportsEnabled
          ? "On your 3DS or Wii U, open Mii Maker, select QR Code/Image Options, choose Scan QR Code, and point the camera at a compatible QR export."
          : "QR output is not available for Living the Dream Miis. Their original download format is LTD.") %>
      }
    },
    {
      "@type": "Question",
      "name": "Can I upload my own Mii creations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Create an account and use the Upload page to add a Mii. New uploads are private by default and can be published later. Supported inputs include Mii files from several Nintendo systems and compatible QR codes."
      }
    }
  ]
}
</script>
